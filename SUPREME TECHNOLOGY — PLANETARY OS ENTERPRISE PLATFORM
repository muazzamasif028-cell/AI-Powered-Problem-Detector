                    agents: tier.agents,
                    sla: tier.sla,
                    modules: tier.modules,
                    features: tier.features,
                    purchasedAt: new Date().toISOString(),
                    expiresAt: new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString(),
                    status: 'ACTIVE',
                    renewalRequired: true
                };

                this.activeLicense = license;
                this.licenseHistory.push(license);
                
                // Save to localStorage
                localStorage.setItem('supreme_license', JSON.stringify(license));
                localStorage.setItem('supreme_license_history', JSON.stringify(this.licenseHistory));

                console.log('🤫 [LICENSE]: Activated -', license.tier, license.id);
                return license;
            }

            loadLicense() {
                const saved = localStorage.getItem('supreme_license');
                if (saved) {
                    this.activeLicense = JSON.parse(saved);
                    const savedHistory = localStorage.getItem('supreme_license_history');
                    if (savedHistory) this.licenseHistory = JSON.parse(savedHistory);
                }
                return this.activeLicense;
            }

            getDaysRemaining() {
                if (!this.activeLicense) return 0;
                const now = new Date();
                const expiry = new Date(this.activeLicense.expiresAt);
                return Math.max(0, Math.ceil((expiry - now) / (1000 * 60 * 60 * 24)));
            }

            isLicenseValid() {
                if (!this.activeLicense) return false;
                return this.getDaysRemaining() > 0;
            }
        }

        // ============================================
        // 🔍 PROBLEM DETECTOR
        // ============================================
        class SupremeDetector {
            constructor() {
                this.problems = {
                    server: { keywords: ['down','crash','503','500','server','timeout','offline'], severity:'CRITICAL', fix:'Server restarted, load balancer adjusted.' },
                    database: { keywords: ['database','sql','query','slow','connection','corrupt'], severity:'HIGH', fix:'Queries optimized, indexes rebuilt.' },
                    security: { keywords: ['hack','breach','security','ddos','malware','virus','injection'], severity:'CRITICAL', fix:'Firewall activated, threat neutralized.' },
                    frontend: { keywords: ['ui','display','render','broken','layout','css','responsive'], severity:'MEDIUM', fix:'Cache cleared, UI restored.' },
                    api: { keywords: ['api','endpoint','401','403','404','500','cors','gateway'], severity:'HIGH', fix:'Gateway restarted, endpoints responding.' },
                    performance: { keywords: ['slow','lag','loading','speed','performance','bottleneck','memory','cpu'], severity:'MEDIUM', fix:'Cache cleared, resources optimized.' },
                    network: { keywords: ['network','dns','bandwidth','latency','packet','routing','firewall'], severity:'HIGH', fix:'Traffic rerouted, DNS failover activated.' },
                    deployment: { keywords: ['deploy','build','pipeline','ci/cd','docker','kubernetes','container'], severity:'MEDIUM', fix:'Rolled back, containers healthy.' }
                };
            }

            analyze(message) {
                const msg = message.toLowerCase();
                let best = { type: 'server', confidence: 0, severity: 'MEDIUM' };
                for (let [type, config] of Object.entries(this.problems)) {
                    const matched = config.keywords.filter(k => msg.includes(k)).length;
                    const confidence = matched / Math.max(config.keywords.length * 0.3, 1);
                    if (confidence > best.confidence) best = { type, confidence: Math.min(confidence, 0.99), severity: config.severity };
                }
                return best;
            }

            getFix(type) {
                return this.problems[type] || this.problems.server;
            }
        }

