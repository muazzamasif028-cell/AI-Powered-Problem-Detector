            } else if (section === 'chat') {
                document.getElementById('chatSection').classList.add('active');
                document.querySelector('.nav-link:nth-child(3)').classList.add('active');
            }
        }

        function purchaseLicense(tierKey) {
            if (licenseManager.isLicenseValid()) {
                alert('⚠️ You already have an active license: ' + licenseManager.activeLicense.tier + '\n\nLicense expires in ' + licenseManager.getDaysRemaining() + ' days.\n\nPlease renew when expired.');
