<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supreme Technology | Planetary OS</title>
    <style>
        :root {
            --bg-deep: #050510;
            --bg-card: #0a0a1a;
            --bg-input: #0d0d25;
            --accent: #e94560;
            --accent-glow: #ff6b81;
            --gold: #f0c040;
            --gold-dark: #c49a20;
            --tier3: #00c853;
            --tier2: #2979ff;
            --tier1: #ff9800;
            --sovereign: #e94560;
            --text: #e0e0e0;
            --text-dim: #777;
            --border: rgba(255,255,255,0.06);
            --success: #00c853;
            --warning: #ff9800;
            --danger: #ff1744;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg-deep);
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ========== TOP NAV ========== */
        .top-nav {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            padding: 12px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, var(--accent), var(--gold));
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .logo-text {
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .logo-text span {
            font-size: 9px;
            color: var(--text-dim);
            letter-spacing: 3px;
            display: block;
        }

        .nav-links {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .nav-link {
            color: var(--text-dim);
            text-decoration: none;
            font-size: 12px;
            letter-spacing: 0.5px;
            transition: color 0.3s;
            cursor: pointer;
        }

        .nav-link:hover { color: var(--text); }
        .nav-link.active { color: var(--accent); }

        .nav-btn {
            padding: 8px 18px;
            background: linear-gradient(135deg, var(--accent), var(--accent-glow));
            border: none;
            border-radius: 20px;
            color: white;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            letter-spacing: 0.5px;
            transition: all 0.3s;
        }

        .nav-btn:hover {
            transform: scale(1.03);
            box-shadow: 0 6px 20px rgba(233,69,96,0.3);
        }

        /* ========== HERO ========== */
        .hero {
            text-align: center;
            padding: 60px 30px 40px;
            background: radial-gradient(ellipse at center, rgba(233,69,96,0.08) 0%, transparent 70%);
        }

        .hero-badge {
            display: inline-block;
            padding: 6px 16px;
            background: rgba(233,69,96,0.1);
            border: 1px solid rgba(233,69,96,0.2);
            border-radius: 20px;
            font-size: 10px;
            letter-spacing: 3px;
            color: var(--accent);
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: 42px;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 16px;
            background: linear-gradient(135deg, #fff, var(--gold));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero p {
            font-size: 16px;
            color: var(--text-dim);
            max-width: 700px;
            margin: 0 auto 30px;
            line-height: 1.7;
        }

        .hero-stats {
            display: flex;
            justify-content: center;
            gap: 50px;
            flex-wrap: wrap;
        }

        .hero-stat {
            text-align: center;
        }

        .hero-stat-value {
            font-size: 32px;
            font-weight: 800;
            background: linear-gradient(135deg, var(--accent), var(--gold));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-stat-label {
            font-size: 10px;
            letter-spacing: 2px;
            color: var(--text-dim);
            margin-top: 4px;
        }

        /* ========== PRICING SECTION ========== */
        .pricing-section {
            padding: 40px 30px 60px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title h2 {
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .section-title p {
            color: var(--text-dim);
            font-size: 14px;
            letter-spacing: 1px;
        }

        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
            gap: 24px;
        }

        .pricing-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 35px 30px;
            position: relative;
            transition: all 0.4s;
            cursor: pointer;
        }

        .pricing-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        .pricing-card.tier-3 { border-top: 3px solid var(--tier3); }
        .pricing-card.tier-3:hover { border-color: var(--tier3); box-shadow: 0 20px 50px rgba(0,200,83,0.15); }

        .pricing-card.tier-2 { border-top: 3px solid var(--tier2); }
        .pricing-card.tier-2:hover { border-color: var(--tier2); box-shadow: 0 20px 50px rgba(41,121,255,0.15); }

        .pricing-card.tier-1 { border-top: 3px solid var(--tier1); }
        .pricing-card.tier-1:hover { border-color: var(--tier1); box-shadow: 0 20px 50px rgba(255,152,0,0.15); }

        .pricing-card.sovereign {
            border-top: 3px solid var(--sovereign);
            background: linear-gradient(180deg, rgba(233,69,96,0.05) 0%, var(--bg-card) 30%);
        }
        .pricing-card.sovereign:hover { border-color: var(--sovereign); box-shadow: 0 20px 50px rgba(233,69,96,0.2); }

        .card-badge {
            position: absolute;
            top: -12px;
            right: 24px;
            padding: 5px 14px;
            border-radius: 12px;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.5px;
        }

        .badge-growth { background: var(--tier3); color: #000; }
        .badge-major { background: var(--tier2); color: #fff; }
        .badge-strategic { background: var(--tier1); color: #000; }
        .badge-sovereign { background: var(--sovereign); color: #fff; }

        .card-tier-name {
            font-size: 11px;
            letter-spacing: 3px;
            color: var(--text-dim);
            margin-bottom: 8px;
        }

        .card-client-range {
            font-size: 13px;
            color: var(--text-dim);
            margin-bottom: 16px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border);
        }

        .card-price {
            font-size: 48px;
            font-weight: 800;
            margin-bottom: 4px;
            letter-spacing: -2px;
        }

        .tier-3 .card-price { color: var(--tier3); }
        .tier-2 .card-price { color: var(--tier2); }
        .tier-1 .card-price { color: var(--tier1); }
        .sovereign .card-price { color: var(--sovereign); }

        .card-price-sub {
            font-size: 13px;
            color: var(--text-dim);
            margin-bottom: 20px;
        }

        .card-features {
            list-style: none;
            margin-bottom: 24px;
        }

        .card-features li {
            padding: 7px 0;
            font-size: 12px;
            color: var(--text-dim);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .card-features li::before {
            content: '✓';
            color: var(--success);
            font-weight: bold;
        }

        .card-btn {
            width: 100%;
            padding: 14px;
            border: 2px solid var(--border);
            border-radius: 12px;
            background: transparent;
            color: var(--text);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            letter-spacing: 0.5px;
            transition: all 0.3s;
        }

        .tier-3 .card-btn:hover { background: var(--tier3); color: #000; border-color: var(--tier3); }
        .tier-2 .card-btn:hover { background: var(--tier2); color: #fff; border-color: var(--tier2); }
        .tier-1 .card-btn:hover { background: var(--tier1); color: #000; border-color: var(--tier1); }
        .sovereign .card-btn {
            background: linear-gradient(135deg, var(--accent), var(--accent-glow));
            border: none;
            color: #fff;
        }
        .sovereign .card-btn:hover {
            transform: scale(1.02);
            box-shadow: 0 10px 30px rgba(233,69,96,0.3);
        }

        /* ========== DASHBOARD ========== */
        .dashboard-section {
            padding: 40px 30px;
            max-width: 1400px;
            margin: 0 auto;
            display: none;
        }

        .dashboard-section.active { display: block; }

        .dashboard-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .dashboard-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
        }

        .dashboard-card.full-width { grid-column: 1 / -1; }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .card-header h3 { font-size: 14px; font-weight: 600; }
        .card-header .status { font-size: 10px; letter-spacing: 1px; padding: 4px 10px; border-radius: 10px; }
        .status-active { background: rgba(0,200,83,0.1); color: var(--success); }
        .status-licensed { background: rgba(240,192,64,0.1); color: var(--gold); }

        /* ========== MODAL ========== */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.8);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-overlay.active { display: flex; }

        .modal {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 40px;
            max-width: 500px;
            width: 90%;
            text-align: center;
        }

        .modal h2 { font-size: 24px; margin-bottom: 10px; }
        .modal .price-display { font-size: 42px; font-weight: 800; margin: 20px 0; }
        .modal .license-key {
            background: var(--bg-input);
            padding: 14px;
            border-radius: 10px;
            font-family: monospace;
            font-size: 14px;
            letter-spacing: 1px;
            margin: 16px 0;
            word-break: break-all;
        }
        .modal .note {
            font-size: 11px;
            color: var(--text-dim);
            margin-top: 12px;
        }

        .modal-btn {
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            margin: 8px;
            font-size: 13px;
            transition: all 0.3s;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent), var(--accent-glow));
            border: none;
            color: #fff;
        }

        .btn-secondary {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text);
        }

        .btn-primary:hover { transform: scale(1.03); }
        .btn-secondary:hover { background: rgba(255,255,255,0.03); }

        /* ========== RESPONSIVE ========== */
        @media (max-width: 768px) {
            .hero h1 { font-size: 28px; }
            .pricing-grid { grid-template-columns: 1fr; }
            .dashboard-grid { grid-template-columns: 1fr; }
            .hero-stats { gap: 20px; }
        }
    </style>
</head>
<body>

    <!-- ========== TOP NAVIGATION ========== -->
