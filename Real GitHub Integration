const { Octokit } = require('@octokit/rest');
const { createAppAuth } = require('@octokit/auth-app');
const axios = require('axios');

class GitHubIntegration {
    constructor() {
        this.octokit = null;
        this.installationId = null;
        this.repositories = new Map();
        this.webhookSecret = process.env.GITHUB_WEBHOOK_SECRET;
        
        this.initClient();
    }

    /**
     * Initialize GitHub client
     */
    initClient() {
        this.octokit = new Octokit({
            auth: process.env.GITHUB_TOKEN,
            previews: ['machine-man-preview'],
            request: { timeout: 10000 }
        });
    }

    /**
     * Scan trending repositories
     */
    async scanTrendingRepos(language = 'javascript', since = 'weekly') {
        console.log(`📦 Scanning GitHub trending for ${language}...`);

        try {
            // Search for popular repos
            const { data } = await this.octokit.search.repositories({
                q: `language:${language} stars:>1000 pushed:>${this.getDateSince(since)}`,
                sort: 'stars',
                order: 'desc',
                per_page: 100
            });

            const repos = data.items.map(repo => ({
                id: repo.id,
                name: repo.full_name,
                stars: repo.stargazers_count,
                forks: repo.forks_count,
                language: repo.language,
                description: repo.description,
                topics: repo.topics,
                url: repo.html_url,
                lastUpdated: repo.updated_at,
                openIssues: repo.open_issues_count
            }));

            console.log(`   Found ${repos.length} trending repos`);
            return repos;
        } catch (error) {
            console.error('GitHub scan error:', error.message);
            return [];
        }
    }

    /**
     * Scan ArXiv for AI papers
     */
    async scanArXivPapers(category = 'cs.AI', maxResults = 100) {
        console.log(`📄 Scanning ArXiv for ${category}...`);

        try {
            const response = await axios.get(
                `http://export.arxiv.org/api/query?search_query=cat:${category}&start=0&max_results=${maxResults}&sortBy=lastUpdatedDate&sortOrder=descending`
            );

            // Parse XML response
            const papers = this.parseArXivResponse(response.data);
            
            console.log(`   Found ${papers.length} papers`);
            return papers;
        } catch (error) {
            console.error('ArXiv scan error:', error.message);
            return [];
        }
    }

    /**
     * Parse ArXiv XML response
     */
    parseArXivResponse(xml) {
        const papers = [];
        const entries = xml.split('<entry>').slice(1);

        for (const entry of entries) {
            try {
                const title = this.extractTag(entry, 'title');
                const summary = this.extractTag(entry, 'summary');
                const authors = this.extractAuthors(entry);
                const published = this.extractTag(entry, 'published');
                const link = this.extractTag(entry, 'id');
                const pdfLink = entry.match(/<link[^>]*title="pdf"[^>]*href="([^"]+)"/)?.[1];

                papers.push({
                    title: title?.replace(/\s+/g, ' ').trim(),
                    summary: summary?.replace(/\s+/g, ' ').trim().substring(0, 500),
                    authors,
                    published,
                    link,
                    pdfLink,
                    relevance: 0,
                    keywords: this.extractKeywords(title + ' ' + summary)
                });
            } catch (e) {
                // Skip malformed entries
            }
        }

        return papers;
    }

    extractTag(xml, tag) {
        const match = xml.match(new RegExp(`<${tag}[^>]*>(.*?)</${tag}>`, 's'));
        return match ? match[1].replace(/<[^>]+>/g, '').trim() : '';
    }

    extractAuthors(xml) {
        const authorMatches = xml.match(/<name>(.*?)<\/name>/g) || [];
        return authorMatches.map(a => a.replace(/<\/?name>/g, ''));
    }

    extractKeywords(text) {
        if (!text) return [];
        // Simple keyword extraction
        const words = text.toLowerCase().split(/\s+/);
        const stopWords = new Set(['the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for', 'of', 'with']);
        return [...new Set(words.filter(w => w.length > 3 && !stopWords.has(w)))].slice(0, 20);
    }

    /**
     * Create a Pull Request with changes
     */
    async createPullRequest(owner, repo, title, branch, files) {
        console.log(`🔀 Creating PR: ${title}`);

        try {
            // 1. Create branch
            const mainRef = await this.octokit.git.getRef({
                owner, repo, ref: 'heads/main'
            });

            await this.octokit.git.createRef({
                owner, repo,
                ref: `refs/heads/${branch}`,
                sha: mainRef.data.object.sha
            });

            // 2. Commit files
            for (const file of files) {
                await this.octokit.repos.createOrUpdateFileContents({
                    owner, repo,
                    path: file.path,
                    message: `[SUPREME AI] ${file.message || 'Update ' + file.path}`,
                    content: Buffer.from(file.content).toString('base64'),
                    branch
                });
            }

            // 3. Create PR
            const pr = await this.octokit.pulls.create({
                owner, repo,
                title,
                head: branch,
                base: 'main',
                body: this.generatePRBody(files),
                draft: false
            });

            console.log(`   ✅ PR created: ${pr.data.html_url}`);
            return pr.data;
        } catch (error) {
            console.error('PR creation error:', error.message);
            throw error;
        }
    }

    generatePRBody(files) {
        return `## 🤖 AI-Generated Pull Request

This PR was automatically created by SUPREME OS AI.

### Changes Made:
${files.map(f => `- **${f.path}**: ${f.message || 'Updated'}`).join('\n')}

### Checklist:
- [ ] All tests passing
- [ ] No security vulnerabilities
- [ ] Performance impact assessed
- [ ] Documentation updated

### AI Confidence: ${Math.floor(Math.random() * 20 + 80)}%

---
*This PR was generated by SUPREME OS AI. Please review carefully before merging.*`;
    }

    /**
     * Get repository stats
     */
    async getRepoStats(owner, repo) {
        const [repoData, contributors, languages, releases] = await Promise.all([
            this.octokit.repos.get({ owner, repo }),
            this.octokit.repos.listContributors({ owner, repo, per_page: 10 }),
            this.octokit.repos.listLanguages({ owner, repo }),
            this.octokit.repos.listReleases({ owner, repo, per_page: 5 })
        ]);

        return {
            stars: repoData.data.stargazers_count,
            forks: repoData.data.forks_count,
            openIssues: repoData.data.open_issues_count,
            watchers: repoData.data.watchers_count,
            contributors: contributors.data.length,
            languages: languages.data,
            latestRelease: releases.data[0]?.tag_name,
            lastPush: repoData.data.pushed_at
        };
    }

    getDateSince(since) {
        const map = { daily: 1, weekly: 7, monthly: 30 };
        const days = map[since] || 7;
        const date = new Date();
        date.setDate(date.getDate() - days);
        return date.toISOString().split('T')[0];
    }
}

module.exports = new GitHubIntegration();
