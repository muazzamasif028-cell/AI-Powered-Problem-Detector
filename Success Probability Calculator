const successProbability = {
    factors: {
        productReady: 0.70,      // 70% code complete
        marketTiming: 0.90,      // AI is hot right now
        teamCapability: 0.80,    // Strong technical skills
        executionSpeed: 0.60,    // Need to move faster
        uniqueness: 0.85,        // Multi-provider AI is unique
        goToMarket: 0.40,        // Need marketing/sales
        funding: 0.20,           // Bootstrapped
        competition: 0.50        // Big players but fragmented
    },
    
    calculateSuccess() {
        const weights = {
            productReady: 0.25,
            marketTiming: 0.15,
            teamCapability: 0.15,
            executionSpeed: 0.20,
            uniqueness: 0.10,
            goToMarket: 0.10,
            funding: 0.03,
            competition: 0.02
        };
        
        let score = 0;
        for (const [factor, value] of Object.entries(this.factors)) {
            score += value * (weights[factor] || 0);
        }
        
        return {
            overallProbability: (score * 100).toFixed(1) + '%',
            strongestFactor: 'Market Timing & Uniqueness',
            weakestFactor: 'Go-To-Market & Funding',
            recommendation: 'Launch NOW, get users, then raise funding'
        };
    }
};

console.log(successProbability.calculateSuccess());
// { overallProbability: '65.5%', strongestFactor: 'Market Timing & Uniqueness', ... }
