// ============================================================
// 📁 models/problem.model.js — PROBLEM MODEL
// ============================================================
const mongoose = require('mongoose');

const ProblemSchema = new mongoose.Schema({
    problemId: { type: String, required: true, unique: true },
    companyId: { type: String, required: true },
    tenantId: { type: String, required: true },
    
    problem: { type: String, required: true },
    category: { 
        type: String, 
        enum: ['PERFORMANCE', 'AVAILABILITY', 'SECURITY', 'RESOURCE', 'APPLICATION', 'GENERAL'],
        default: 'GENERAL' 
    },
    severity: { 
        type: String, 
        enum: ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW'],
        default: 'MEDIUM' 
    },
    
    status: { 
        type: String, 
        enum: ['OPEN', 'DETECTED', 'ANALYZING', 'SOLVING', 'RESOLVED', 'CLOSED'],
        default: 'OPEN' 
    },
    
    detection: {
        method: String,
        confidence: Number,
        timestamp: Date
    },
    
    rootCause: {
        description: String,
        category: String,
        confidence: Number
    },
    
    solution: {
        id: String,
        action: String,
        description: String,
        applied: Boolean,
        appliedAt: Date,
        success: Boolean
    },
    
    assignedTo: String,
    resolvedBy: String,
    resolution: String,
    resolutionTime: Number,
    
    metadata: {
        source: String,
        ip: String,
        userAgent: String
    },
    
    createdAt: { type: Date, default: Date.now },
    updatedAt: { type: Date, default: Date.now },
    resolvedAt: Date
});

ProblemSchema.index({ companyId: 1, createdAt: -1 });
ProblemSchema.index({ severity: 1, status: 1 });
ProblemSchema.index({ category: 1 });
ProblemSchema.index({ problemId: 1 }, { unique: true });

ProblemSchema.pre('save', function(next) {
    this.updatedAt = new Date();
    next();
});

module.exports = mongoose.model('Problem', ProblemSchema);
