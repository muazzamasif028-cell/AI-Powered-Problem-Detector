const SupremeEngineeringStudio = require('./studio/SupremeEngineeringStudio');

async function demoStudio() {
    console.log('🏭 SUPREME ENGINEERING STUDIO');
    console.log('"Design Any Machine. Engineer Everything."');
    console.log('═══════════════════════════════════════\n');
    
    const studio = new SupremeEngineeringStudio();
    await studio.initialize();
    
    // Show all categories
    console.log('📋 SUPPORTED CATEGORIES:');
    const categories = studio.getCategories();
    for (const cat of categories) {
        console.log(`   ${cat.name}: ${cat.types.join(', ')}`);
    }
    
    // Create a new car design project
    console.log('\n🚗 Creating New Project: SUPREME ELITE 2026\n');
    
    const project = await studio.createProject({
        name: 'SUPREME ELITE 2026',
        category: 'AUTOMOTIVE',
        type: 'CAR',
        description: 'Next-generation luxury electric vehicle',
        requirements: {
            electric: true,
            premium: true,
            performance: 'HIGH',
            range: '700km',
            seating: 4
        }
    });
    
    // Generate complete design
    const design = await studio.generateCompleteDesign(project.projectId);
    
    // Project Summary
    console.log('\n📊 PROJECT SUMMARY:');
    console.log(JSON.stringify(studio.getProjectSummary(project.projectId), null, 2));
    
    console.log('\n✅ SUPREME Engineering Studio Demo Complete!\n');
}

demoStudio();
