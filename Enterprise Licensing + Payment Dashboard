                        sla: '99.999%'
                    },
                    strategic: {
                        name: 'Sovereign Strategic',
                        tier: 1,
                        price: 20000000000,
                        display: '$20,000,000,000',
                        client: '$1 Trillion+',
                        pillars: 30,
                        agents: 22,
                        sla: '99.9999%'
                    }
                };
                this.activeLicense = null;
            }

            loadLicense() {
                const saved = localStorage.getItem('supreme_license');
                if (saved) this.activeLicense = JSON.parse(saved);
                return this.activeLicense;
            }

            purchaseLicense(tierKey) {
                const tier = this.tiers[tierKey];
                if (!tier) return null;
                const license = {
                    id: 'SUP-' + Date.now().toString(36).toUpperCase() + '-' + Math.random().toString(36).substring(2, 6).toUpperCase(),
                    tier: tier.name,
                    tierNumber: tier.tier,
                    price: tier.price,
                    displayPrice: tier.display,
                    clientRange: tier.client,
                    pillars: tier.pillars,
                    agents: tier.agents,
                    sla: tier.sla,
                    purchasedAt: new Date().toISOString(),
                    expiresAt: new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString(),
                    status: 'ACTIVE',
                    renewalRequired: true
                };
                this.activeLicense = license;
                localStorage.setItem('supreme_license', JSON.stringify(license));
                return license;
            }

            getDaysRemaining() {
                if (!this.activeLicense) return 0;
                return Math.max(0, Math.ceil((new Date(this.activeLicense.expiresAt) - new Date()) / (1000 * 60 * 60 * 24)));
            }

            isValid() {
                return this.activeLicense && this.getDaysRemaining() > 0;
            }
        }

        // ============================================
        // CARD VALIDATION ENGINE
        // ============================================

        // Luhn Algorithm
        function luhnCheck(cardNumber) {
            const digits = cardNumber.replace(/\D/g, '');
            if (digits.length < 13 || digits.length > 19) return false;
            let sum = 0, isEven = false;
            for (let i = digits.length - 1; i >= 0; i--) {
                let digit = parseInt(digits[i]);
                if (isEven) { digit *= 2; if (digit > 9) digit -= 9; }
                sum += digit;
                isEven = !isEven;
            }
            return sum % 10 === 0;
        }

        // BIN Database
        const BIN_DATABASE = {
            '4': { brand: 'Visa', type: 'Credit/Debit' },
            '51': { brand: 'Mastercard', type: 'Credit' },
            '52': { brand: 'Mastercard', type: 'Credit' },
            '53': { brand: 'Mastercard', type: 'Credit' },
            '54': { brand: 'Mastercard', type: 'Credit' },
            '55': { brand: 'Mastercard', type: 'Credit/Debit' },
            '2221': { brand: 'Mastercard', type: 'Credit' },
            '2720': { brand: 'Mastercard', type: 'Credit' },
            '34': { brand: 'American Express', type: 'Charge' },
            '37': { brand: 'American Express', type: 'Charge' },
            '6011': { brand: 'Discover', type: 'Credit' },
            '65': { brand: 'Discover', type: 'Credit' },
            '6362': { brand: 'Mada', type: 'Debit' },
            '5043': { brand: 'Mada', type: 'Debit' }
        };

        function detectCard(cardNumber) {
            const digits = cardNumber.replace(/\D/g, '');
            const bin4 = digits.substring(0, 4);
            if (BIN_DATABASE[bin4]) return BIN_DATABASE[bin4];
            const bin2 = digits.substring(0, 2);
            if (BIN_DATABASE[bin2]) return BIN_DATABASE[bin2];
            const bin1 = digits.substring(0, 1);
            if (BIN_DATABASE[bin1]) return BIN_DATABASE[bin1];
            return { brand: 'Unknown', type: 'Unknown' };
        }

        function validateCardNumber() {
            const input = document.getElementById('cardNumber');
            const msgEl = document.getElementById('cardNumberMsg');
            const preview = document.getElementById('cardPreview');
            const cardNumber = input.value.replace(/\s/g, '');

            if (cardNumber.length === 0) {
                input.classList.remove('valid', 'invalid');
                msgEl.textContent = '';
                msgEl.className = 'validation-message';
                preview.classList.remove('valid', 'invalid');
                document.getElementById('cardValidationBadge').style.display = 'none';
                return false;
            }

            if (cardNumber.length < 13) {
                input.classList.add('invalid'); input.classList.remove('valid');
                msgEl.textContent = 'Card number too short (minimum 13 digits)';
                msgEl.className = 'validation-message error';
                preview.classList.add('invalid'); preview.classList.remove('valid');
                document.getElementById('cardValidationBadge').style.display = 'none';
                return false;
            }

            if (!luhnCheck(cardNumber)) {
                input.classList.add('invalid'); input.classList.remove('valid');
                msgEl.textContent = 'Invalid card number (failed Luhn check)';
                msgEl.className = 'validation-message error';
                preview.classList.add('invalid'); preview.classList.remove('valid');
                document.getElementById('cardValidationBadge').style.display = 'none';
                return false;
            }

            const cardInfo = detectCard(cardNumber);
            if (cardInfo.brand === 'Unknown') {
                input.classList.add('invalid'); input.classList.remove('valid');
                msgEl.textContent = 'Unknown card issuer — not supported';
                msgEl.className = 'validation-message error';
                preview.classList.remove('valid', 'invalid');
                document.getElementById('cardValidationBadge').style.display = 'none';
                return false;
            }

            input.classList.add('valid'); input.classList.remove('invalid');
            msgEl.textContent = '✅ Valid ' + cardInfo.brand + ' (' + cardInfo.type + ')';
            msgEl.className = 'validation-message success';
            preview.classList.add('valid'); preview.classList.remove('invalid');

            const badge = document.getElementById('cardValidationBadge');
            badge.style.display = 'block';
            badge.textContent = '✅ VALID ' + cardInfo.brand.toUpperCase();
            badge.className = 'card-validation-badge valid';
            return true;
        }

        function validateExpiry() {
            const input = document.getElementById('cardExpiry');
            const msgEl = document.getElementById('cardExpiryMsg');
            const value = input.value;

            if (value.length === 0) {
                input.classList.remove('valid', 'invalid');
                msgEl.textContent = '';
                msgEl.className = 'validation-message';
                return false;
            }

            if (value.length < 5) {
                input.classList.add('invalid'); input.classList.remove('valid');
                msgEl.textContent = 'Enter full expiry date (MM/YY)';
                msgEl.className = 'validation-message error';
                return false;
            }

            const parts = value.split('/');
            const month = parseInt(parts[0]);
            const year = parseInt('20' + parts[1]);

            if (month < 1 || month > 12) {
                input.classList.add('invalid'); input.classList.remove('valid');
                msgEl.textContent = 'Invalid month (must be 01-12)';
                msgEl.className = 'validation-message error';
                return false;
            }

            const now = new Date();
            const currentMonth = now.getMonth() + 1;
            const currentYear = now.getFullYear();

            if (year < currentYear || (year === currentYear && month < currentMonth)) {
                input.classList.add('invalid'); input.classList.remove('valid');
                msgEl.textContent = 'Card has expired!';
                msgEl.className = 'validation-message error';
                return false;
            }

            if (year > currentYear + 10) {
                input.classList.add('invalid'); input.classList.remove('valid');
                msgEl.textContent = 'Expiry date too far in the future';
                msgEl.className = 'validation-message error';
                return false;
            }

            input.classList.add('valid'); input.classList.remove('invalid');
            msgEl.textContent = '✅ Valid expiry date';
            msgEl.className = 'validation-message success';
            return true;
        }

        function validateCVV() {
            const input = document.getElementById('cardCVV');
            const msgEl = document.getElementById('cardCVVMsg');
            const value = input.value;

            if (value.length === 0) {
                input.classList.remove('valid', 'invalid');
                msgEl.textContent = '';
                msgEl.className = 'validation-message';
                return false;
            }

            if (value.length < 3) {
                input.classList.add('invalid'); input.classList.remove('valid');
                msgEl.textContent = 'CVV must be at least 3 digits';
                msgEl.className = 'validation-message error';
                return false;
            }

            if (value === '000' || value === '0000') {
                input.classList.add('invalid'); input.classList.remove('valid');
                msgEl.textContent = 'Invalid CVV code';
                msgEl.className = 'validation-message error';
                return false;
            }

            input.classList.add('valid'); input.classList.remove('invalid');
            msgEl.textContent = '✅ Valid CVV';
            msgEl.className = 'validation-message success';
            return true;
        }

        function validateHolder() {
            const input = document.getElementById('cardHolder');
            const msgEl = document.getElementById('cardHolderMsg');
            const value = input.value.trim();

            if (value.length === 0) {
                input.classList.remove('valid', 'invalid');
                msgEl.textContent = '';
                msgEl.className = 'validation-message';
                return false;
            }

            if (value.length < 3) {
                input.classList.add('invalid'); input.classList.remove('valid');
                msgEl.textContent = 'Name is too short';
                msgEl.className = 'validation-message error';
                return false;
            }

            if (!/^[a-zA-Z\s\-'.]+$/.test(value)) {
                input.classList.add('invalid'); input.classList.remove('valid');
                msgEl.textContent = 'Invalid characters in name';
                msgEl.className = 'validation-message error';
                return false;
            }

            input.classList.add('valid'); input.classList.remove('invalid');
            msgEl.textContent = '✅ Valid name';
            msgEl.className = 'validation-message success';
            return true;
        }

        function isCardFullyValid() {
            return validateCardNumber() && validateExpiry() && validateCVV() && validateHolder();
        }

        function formatCardNumber(input) {
            let value = input.value.replace(/\D/g, '');
            value = value.substring(0, 16);
            value = value.replace(/(\d{4})(?=\d)/g, '$1 ');
            input.value = value;
        }

        function formatExpiry(input) {
            let value = input.value.replace(/\D/g, '');
            value = value.substring(0, 4);
            if (value.length >= 2) value = value.substring(0, 2) + '/' + value.substring(2);
            input.value = value;
        }

        function updateCardPreview() {
