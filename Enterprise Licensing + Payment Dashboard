            const cardHolder = document.getElementById('cardHolder').value || 'Your Name';
            const cardExpiry = document.getElementById('cardExpiry').value || 'MM/YY';

            document.getElementById('cardNumberDisplay').textContent = cardNumber || '•••• •••• •••• ••••';
            document.getElementById('cardHolderDisplay').textContent = cardHolder.toUpperCase() || 'YOUR NAME';
            document.getElementById('cardExpiryDisplay').textContent = cardExpiry || 'MM/YY';

            const rawNumber = cardNumber.replace(/\s/g, '');
            const cardInfo = detectCard(rawNumber);

            const brandIcons = {
                'Visa': '💙 Visa',
                'Mastercard': '🧡 MC',
                'American Express': '💚 Amex',
                'Discover': '🧡 Discover',
                'Mada': '💜 Mada'
            };

            document.getElementById('cardBrand').textContent = brandIcons[cardInfo.brand] || '💳';
        }

        // ============================================
        // PAYMENT STATE
        // ============================================
        const licenseManager = new LicenseManager();
        let selectedLicenseTier = null;
        let selectedPayMethod = 'CARD';

        let paymentState = {
            licenseFee: 0,
            discountPercent: 0,
            discountAmount: 0,
            taxRate: 0,
            taxAmount: 0,
            total: 0,
            country: 'US',
            couponApplied: null
        };

        // ============================================
        // NAVIGATION
        // ============================================
        function navigateTo(section) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));

            const sectionMap = {
                'licensing': 'licensingSection',
                'dashboard': 'dashboardSection',
                'payment': 'paymentSection'
            };

            document.getElementById(sectionMap[section]).classList.add('active');
            document.querySelector(`[data-section="${section}"]`).classList.add('active');

            if (section === 'dashboard') updateDashboard();
        }

        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', function() {
                navigateTo(this.dataset.section);
            });
        });

        // ============================================
        // LICENSE SELECTION
        // ============================================
        function selectLicense(tierKey) {
            selectedLicenseTier = tierKey;
            const tier = licenseManager.tiers[tierKey];

            document.getElementById('paymentTierName').textContent = tier.name + ' (Tier ' + tier.tier + ')';
            document.getElementById('paymentTierDetail').textContent = 
                tier.display + '/year · ' + tier.client + ' Market Cap · ' + tier.pillars + ' Security Pillars';

            paymentState.licenseFee = tier.price;
            paymentState.taxRate = 0; // US default
            document.getElementById('country').value = 'US';
            recalcPayment();

            navigateTo('payment');

            document.getElementById('payButton').disabled = false;
            document.getElementById('payButton').textContent = '🔒 PAY ' + tier.display + ' NOW';

            showToast('✅ ' + tier.name + ' license selected! Proceed to payment.', 'success');
        }

        // ============================================
        // PAYMENT CALCULATIONS
        // ============================================
        function recalcPayment() {
            const discount = paymentState.discountPercent > 0 ? 
                paymentState.licenseFee * (paymentState.discountPercent / 100) : 
                paymentState.discountAmount;

            const afterDiscount = paymentState.licenseFee - discount;
            const tax = afterDiscount * paymentState.taxRate;
            const total = afterDiscount + tax;

            paymentState.discountAmount = discount;
            paymentState.taxAmount = Math.round(tax * 100) / 100;
            paymentState.total = Math.round(total * 100) / 100;

            document.getElementById('paymentLicenseFee').textContent = '$' + paymentState.licenseFee.toLocaleString();
            document.getElementById('paymentTaxRate').textContent = (paymentState.taxRate * 100).toFixed(0) + '%';
            document.getElementById('paymentTax').textContent = '$' + paymentState.taxAmount.toLocaleString();
            document.getElementById('paymentTotal').textContent = '$' + paymentState.total.toLocaleString();

            if (discount > 0) {
                document.getElementById('paymentDiscountRow').style.display = 'flex';
                document.getElementById('paymentDiscount').textContent = '-$' + discount.toLocaleString();
                document.getElementById('paymentSavings').style.display = 'inline-block';
                document.getElementById('paymentSavings').textContent = '💡 You Save: $' + discount.toLocaleString();
            } else {
                document.getElementById('paymentDiscountRow').style.display = 'none';
                document.getElementById('paymentSavings').style.display = 'none';
            }

            if (paymentState.licenseFee > 0) {
                document.getElementById('payButton').textContent = '🔒 PAY $' + paymentState.total.toLocaleString() + ' NOW';
            }
        }

        function updatePaymentTax() {
            const taxRates = {
                'US': 0, 'SA': 0.15, 'AE': 0, 'UK': 0.20,
                'EU': 0.20, 'PK': 0, 'IN': 0.18, 'SG': 0.09, 'JP': 0.10
            };
            paymentState.country = document.getElementById('country').value;
            paymentState.taxRate = taxRates[paymentState.country] || 0;
            recalcPayment();
        }

        function selectPayMethod(method, element) {
            selectedPayMethod = method;
            document.querySelectorAll('.payment-method').forEach(el => el.classList.remove('active'));
            element.classList.add('active');
        }

        // ============================================
        // COUPON SYSTEM
        // ============================================
        function applyPaymentCoupon() {
            const code = document.getElementById('paymentCouponInput').value.trim().toUpperCase();
            const coupons = {
                'SUPREME20': { discount: 20, type: 'PERCENT' },
                'LAUNCH50': { discount: 50, type: 'PERCENT' },
                'NEOM2025': { discount: 30, type: 'PERCENT' },
                'STARTUP100': { discount: 100, type: 'FIXED' }
            };

            if (!coupons[code]) {
                showToast('❌ Invalid coupon code: ' + code, 'error');
                return;
            }

            const coupon = coupons[code];
            paymentState.couponApplied = code;
            paymentState.discountPercent = coupon.type === 'PERCENT' ? coupon.discount : 0;

            document.getElementById('paymentCouponApplied').style.display = 'flex';
            document.getElementById('paymentCouponCode').textContent = code;
            document.getElementById('paymentCouponValue').textContent = 
                coupon.type === 'PERCENT' ? coupon.discount + '% OFF' : '$' + coupon.discount + ' OFF';

            recalcPayment();
            showToast('✅ Coupon applied! ' + coupon.discount + (coupon.type === 'PERCENT' ? '%' : '$') + ' discount.', 'success');
        }

        function removePaymentCoupon() {
            paymentState.couponApplied = null;
            paymentState.discountPercent = 0;
            paymentState.discountAmount = 0;
            document.getElementById('paymentCouponApplied').style.display = 'none';
            document.getElementById('paymentCouponInput').value = '';
            recalcPayment();
            showToast('Coupon removed.', 'warning');
        }

        // ============================================
        // PAYMENT PROCESSING
        // ============================================
        async function processPayment(event) {
            event.preventDefault();

            if (!selectedLicenseTier || paymentState.licenseFee <= 0) {
                showToast('❌ Please select a license tier first!', 'error');
                navigateTo('licensing');
                return;
            }

            if (selectedPayMethod === 'CARD' && !isCardFullyValid()) {
                showToast('❌ Please fix card validation errors before paying.', 'error');
                validateCardNumber();
                validateExpiry();
                validateCVV();
                validateHolder();
                return;
            }

            if (paymentState.total <= 0) {
                showToast('❌ Invalid payment amount.', 'error');
                return;
            }

            // Show processing
            document.getElementById('processingOverlay').classList.add('show');
            document.getElementById('payButton').disabled = true;
            document.getElementById('payButton').textContent = '⏳ PROCESSING PAYMENT...';

            // Simulate processing
            await new Promise(resolve => setTimeout(resolve, 2500));

            // Purchase license
            const license = licenseManager.purchaseLicense(selectedLicenseTier);
            const transactionId = 'TXN-' + Date.now().toString(36).toUpperCase() + '-' + 
                                  Math.random().toString(36).substring(2, 6).toUpperCase();
            const invoiceNumber = 'INV-SUP-' + Math.floor(Math.random() * 90000 + 10000);

            // Hide processing
            document.getElementById('processingOverlay').classList.remove('show');
            document.getElementById('payButton').disabled = false;
            document.getElementById('payButton').textContent = '🔒 PAY $' + paymentState.total.toLocaleString() + ' NOW';

            // Show success
            document.getElementById('transactionId').textContent = transactionId;
            document.getElementById('paidAmount').textContent = '$' + paymentState.total.toLocaleString();
            document.getElementById('invoiceNumber').textContent = invoiceNumber;
            document.getElementById('successOverlay').classList.add('show');

            // Save transaction
            const transaction = {
                transactionId: transactionId,
                invoiceNumber: invoiceNumber,
                amount: paymentState.total,
                currency: 'USD',
                method: selectedPayMethod,
                license: license.tier,
                tier: license.tierNumber,
                coupon: paymentState.couponApplied,
                discount: paymentState.discountAmount,
                tax: paymentState.taxAmount,
                country: paymentState.country,
                timestamp: new Date().toISOString(),
                status: 'COMPLETED'
            };

            const transactions = JSON.parse(localStorage.getItem('supreme_transactions') || '[]');
            transactions.push(transaction);
            localStorage.setItem('supreme_transactions', JSON.stringify(transactions));

            updateDashboard();
            showToast('✅ License Activated! ' + license.tier + ' — Welcome to Supreme Technology.', 'success');
        }

        // ============================================
