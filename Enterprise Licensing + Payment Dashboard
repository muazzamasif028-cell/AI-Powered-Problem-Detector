<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supreme Technology | Planetary OS — Enterprise Licensing</title>
    <style>
        :root {
            --bg-deep: #050510;
            --bg-card: #0a0a1a;
            --bg-input: #0d0d25;
            --accent: #e94560;
            --accent-glow: #ff6b81;
            --gold: #f0c040;
            --gold-dark: #c49a20;
            --tier3: #00c853;
            --tier2: #2979ff;
            --tier1: #ff9800;
            --sovereign: #e94560;
            --text: #e0e0e0;
            --text-dim: #777;
            --border: rgba(255,255,255,0.06);
            --success: #00c853;
            --warning: #ff9800;
            --danger: #ff1744;
            --quantum: #00ffff;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg-deep);
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ========== TOP NAVIGATION ========== */
        .top-nav {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            padding: 12px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(20px);
        }

        .nav-logo { display: flex; align-items: center; gap: 10px; }
        .logo-icon {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, var(--accent), var(--gold));
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px;
        }
        .logo-text { font-size: 13px; font-weight: 700; letter-spacing: 1px; }
        .logo-text span { font-size: 9px; color: var(--text-dim); letter-spacing: 3px; display: block; }

        .nav-links { display: flex; gap: 20px; align-items: center; }
        .nav-link {
            color: var(--text-dim); text-decoration: none;
            font-size: 12px; letter-spacing: 0.5px;
            cursor: pointer; transition: color 0.3s;
            padding: 6px 0;
            border-bottom: 2px solid transparent;
        }
        .nav-link:hover { color: var(--text); }
        .nav-link.active { color: var(--accent); border-bottom-color: var(--accent); }

        .nav-btn {
            padding: 8px 18px;
            background: linear-gradient(135deg, var(--accent), var(--accent-glow));
            border: none; border-radius: 20px;
            color: white; font-size: 12px; font-weight: 600;
            cursor: pointer; letter-spacing: 0.5px;
            transition: all 0.3s;
        }
        .nav-btn:hover { transform: scale(1.03); box-shadow: 0 6px 20px rgba(233,69,96,0.3); }

        /* ========== SECTION CONTROL ========== */
        .section { display: none; }
        .section.active { display: block; }

        /* ========== HERO ========== */
        .hero {
            text-align: center;
            padding: 60px 30px 40px;
            background: radial-gradient(ellipse at center, rgba(233,69,96,0.08) 0%, transparent 70%);
        }
        .hero-badge {
            display: inline-block;
            padding: 6px 16px;
            background: rgba(233,69,96,0.1);
            border: 1px solid rgba(233,69,96,0.2);
            border-radius: 20px;
            font-size: 10px; letter-spacing: 3px;
            color: var(--accent); margin-bottom: 20px;
            text-transform: uppercase;
        }
        .hero h1 {
            font-size: 42px; font-weight: 800; letter-spacing: -1px;
            margin-bottom: 16px;
            background: linear-gradient(135deg, #fff, var(--gold));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero p { font-size: 16px; color: var(--text-dim); max-width: 700px; margin: 0 auto 30px; line-height: 1.7; }
        .hero-stats { display: flex; justify-content: center; gap: 50px; flex-wrap: wrap; }
        .hero-stat { text-align: center; }
        .hero-stat-value {
            font-size: 32px; font-weight: 800;
            background: linear-gradient(135deg, var(--accent), var(--gold));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-stat-label { font-size: 10px; letter-spacing: 2px; color: var(--text-dim); margin-top: 4px; text-transform: uppercase; }

        /* ========== LICENSING SECTION ========== */
        .licensing-section { padding: 40px 30px 60px; max-width: 1400px; margin: 0 auto; }
        .section-title { text-align: center; margin-bottom: 50px; }
        .section-title h2 { font-size: 30px; font-weight: 700; margin-bottom: 10px; }
        .section-title p { color: var(--text-dim); font-size: 14px; letter-spacing: 1px; }

        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 24px;
        }

        .pricing-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 35px 30px;
            position: relative;
            transition: all 0.4s;
            cursor: pointer;
        }
        .pricing-card:hover { transform: translateY(-8px); }
        .pricing-card.tier-3 { border-top: 3px solid var(--tier3); }
        .pricing-card.tier-3:hover { box-shadow: 0 20px 50px rgba(0,200,83,0.15); }
        .pricing-card.tier-2 { border-top: 3px solid var(--tier2); }
        .pricing-card.tier-2:hover { box-shadow: 0 20px 50px rgba(41,121,255,0.15); }
        .pricing-card.tier-1 { border-top: 3px solid var(--tier1); }
        .pricing-card.tier-1:hover { box-shadow: 0 20px 50px rgba(255,152,0,0.15); }
        .pricing-card.sovereign {
            border-top: 3px solid var(--sovereign);
            background: linear-gradient(180deg, rgba(233,69,96,0.05) 0%, var(--bg-card) 30%);
        }
        .pricing-card.sovereign:hover { box-shadow: 0 20px 50px rgba(233,69,96,0.2); }

        .card-badge {
            position: absolute; top: -12px; right: 24px;
            padding: 5px 14px; border-radius: 12px;
            font-size: 9px; font-weight: 700; letter-spacing: 1.5px;
            text-transform: uppercase;
        }
        .badge-growth { background: var(--tier3); color: #000; }
        .badge-major { background: var(--tier2); color: #fff; }
        .badge-strategic { background: var(--tier1); color: #000; }
        .badge-sovereign { background: var(--sovereign); color: #fff; }

        .card-tier-name { font-size: 11px; letter-spacing: 3px; color: var(--text-dim); margin-bottom: 8px; text-transform: uppercase; }
        .card-client-range { font-size: 13px; color: var(--text-dim); margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--border); }
        .card-price { font-size: 48px; font-weight: 800; margin-bottom: 4px; letter-spacing: -2px; }
        .tier-3 .card-price { color: var(--tier3); }
        .tier-2 .card-price { color: var(--tier2); }
        .tier-1 .card-price { color: var(--tier1); }
        .sovereign .card-price { color: var(--sovereign); }
        .card-price-sub { font-size: 13px; color: var(--text-dim); margin-bottom: 20px; }
        .card-features { list-style: none; margin-bottom: 24px; }
        .card-features li {
            padding: 7px 0; font-size: 12px; color: var(--text-dim);
            display: flex; align-items: center; gap: 8px;
        }
        .card-features li::before { content: '✓'; color: var(--success); font-weight: bold; }

        .card-btn {
            width: 100%; padding: 14px;
            border: 2px solid var(--border);
            border-radius: 12px;
            background: transparent;
            color: var(--text); font-size: 13px; font-weight: 600;
            cursor: pointer; letter-spacing: 0.5px;
            transition: all 0.3s; text-transform: uppercase;
        }
        .tier-3 .card-btn:hover { background: var(--tier3); color: #000; border-color: var(--tier3); }
        .tier-2 .card-btn:hover { background: var(--tier2); color: #fff; border-color: var(--tier2); }
        .tier-1 .card-btn:hover { background: var(--tier1); color: #000; border-color: var(--tier1); }
        .sovereign .card-btn {
            background: linear-gradient(135deg, var(--accent), var(--accent-glow));
            border: none; color: #fff;
        }
        .sovereign .card-btn:hover { transform: scale(1.02); box-shadow: 0 10px 30px rgba(233,69,96,0.3); }

        /* ========== DASHBOARD SECTION ========== */
        .dashboard-section { padding: 40px 30px; max-width: 1400px; margin: 0 auto; }
        .dashboard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .dashboard-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
        }
        .dashboard-card.full-width { grid-column: 1 / -1; }
        .card-header {
            display: flex; justify-content: space-between;
            align-items: center; margin-bottom: 16px;
        }
        .card-header h3 { font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
        .status { font-size: 10px; letter-spacing: 1px; padding: 4px 10px; border-radius: 10px; text-transform: uppercase; font-weight: 600; }
        .status-active { background: rgba(0,200,83,0.1); color: var(--success); }
        .status-licensed { background: rgba(240,192,64,0.1); color: var(--gold); }
        .status-inactive { background: rgba(119,119,119,0.1); color: var(--text-dim); }
        .status-error { background: rgba(255,23,68,0.1); color: var(--danger); }

        /* ========== PAYMENT DASHBOARD ========== */
        .payment-dashboard {
            width: 100%; max-width: 1100px; margin: 0 auto;
            display: grid; grid-template-columns: 1fr 1fr; gap: 24px;
        }

        .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 24px; }
        .problem-summary {
            background: var(--bg-input);
            border: 1px solid rgba(233,69,96,0.2);
            border-radius: 12px;
            padding: 16px; margin-bottom: 16px;
        }
        .problem-badge {
            display: inline-block;
            padding: 4px 12px; border-radius: 20px;
            font-size: 0.7em; font-weight: 700;
            letter-spacing: 0.5px; margin-bottom: 10px;
            text-transform: uppercase;
        }
        .problem-badge.critical {
            background: rgba(218,54,51,0.2);
            color: #da3633;
            border: 1px solid rgba(218,54,51,0.3);
        }
        .problem-badge.license {
            background: rgba(240,192,64,0.2);
            color: var(--gold);
            border: 1px solid rgba(240,192,64,0.3);
        }
        .problem-name { font-size: 1.1em; font-weight: 600; margin-bottom: 6px; }
        .problem-detail { font-size: 0.8em; color: var(--text-dim); line-height: 1.5; }

        .price-row {
            display: flex; justify-content: space-between;
            align-items: center; padding: 10px 0;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            font-size: 0.9em;
        }
        .price-row:last-child { border-bottom: none; }
        .price-label { color: var(--text-dim); }
        .price-value { font-weight: 600; color: var(--text); }
        .price-value.discount { color: var(--success); }
        .price-row.total {
            margin-top: 8px; padding-top: 14px;
            border-top: 2px solid var(--border);
            font-size: 1.1em; font-weight: 700;
        }
        .price-row.total .price-value { color: var(--gold); font-size: 1.3em; }
        .savings-badge {
            display: inline-block;
            background: rgba(63,185,80,0.15);
            color: var(--success);
            padding: 3px 10px; border-radius: 12px;
            font-size: 0.7em; font-weight: 600;
        }

        /* Credit Card Preview */
        .credit-card-preview {
            background: linear-gradient(135deg, #1a1a3e 0%, #0f3460 50%, #e94560 150%);
            border-radius: 16px; padding: 20px 24px;
            margin-bottom: 20px; position: relative; overflow: hidden;
            min-height: 200px; box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            transition: all 0.3s;
        }
        .credit-card-preview.invalid { border: 2px solid var(--danger); box-shadow: 0 10px 40px rgba(218,54,51,0.3); }
        .credit-card-preview.valid { border: 2px solid var(--success); box-shadow: 0 10px 40px rgba(63,185,80,0.3); }
        .card-chip {
            width: 50px; height: 40px;
            background: linear-gradient(135deg, #ffd700, #c0a000);
            border-radius: 8px; margin-bottom: 20px;
        }
        .card-number-display {
            font-family: 'Courier New', monospace;
            font-size: 1.3em; letter-spacing: 4px;
            color: white; margin-bottom: 16px;
        }
        .card-info-row { display: flex; justify-content: space-between; }
        .card-info-label {
            font-size: 0.55em; color: rgba(255,255,255,0.5);
            text-transform: uppercase; letter-spacing: 1px;
            margin-bottom: 4px;
        }
        .card-info-value { font-family: 'Courier New', monospace; font-size: 1em; color: white; letter-spacing: 1px; text-transform: uppercase; }
        .card-brand {
            position: absolute; top: 20px; right: 24px;
            font-size: 2.5em; opacity: 0.9;
        }
        .card-validation-badge {
            position: absolute; bottom: 15px; right: 24px;
            font-size: 0.7em; font-weight: 700;
            padding: 4px 10px; border-radius: 12px;
            text-transform: uppercase;
        }
        .card-validation-badge.valid { background: rgba(63,185,80,0.2); color: var(--success); }
        .card-validation-badge.invalid { background: rgba(218,54,51,0.2); color: var(--danger); }

        /* Form Elements */
        .form-group { margin-bottom: 16px; }
        .form-label {
            display: block; font-size: 0.78em; font-weight: 600;
            color: var(--text-dim); margin-bottom: 6px;
            text-transform: uppercase; letter-spacing: 0.5px;
        }
        .form-input {
            width: 100%; padding: 12px 16px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text); font-size: 0.9em;
            font-family: inherit; transition: all 0.3s; outline: none;
        }
        .form-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(233,69,96,0.1); }
        .form-input.valid { border-color: var(--success); box-shadow: 0 0 0 3px rgba(63,185,80,0.1); }
        .form-input.invalid { border-color: var(--danger); box-shadow: 0 0 0 3px rgba(218,54,51,0.1); animation: shake 0.5s ease; }
        .form-input::placeholder { color: rgba(255,255,255,0.15); }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-8px); }
            75% { transform: translateX(8px); }
        }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .validation-message { font-size: 0.7em; margin-top: 4px; min-height: 16px; }
        .validation-message.error { color: var(--danger); }
        .validation-message.success { color: var(--success); }

        /* Payment Methods */
        .payment-methods { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 20px; }
        .payment-method {
            padding: 12px 8px; background: var(--bg-input);
            border: 2px solid var(--border); border-radius: 10px;
            text-align: center; cursor: pointer; transition: all 0.3s;
            font-size: 0.75em; color: var(--text-dim);
        }
        .payment-method:hover { border-color: rgba(233,69,96,0.3); }
        .payment-method.active { border-color: var(--accent); background: rgba(233,69,96,0.1); color: var(--text); }
        .payment-method .method-icon { font-size: 1.5em; margin-bottom: 4px; }

        /* Buttons */
        .btn {
            width: 100%; padding: 14px 24px;
            border: none; border-radius: 12px;
            font-size: 1em; font-weight: 700;
            cursor: pointer; transition: all 0.3s;
            letter-spacing: 0.5px; font-family: inherit;
            text-transform: uppercase;
        }
        .btn-primary {
            background: linear-gradient(135deg, #e94560, #ff6b81);
            color: white; box-shadow: 0 6px 20px rgba(233,69,96,0.3);
        }
        .btn-primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(233,69,96,0.5); }
        .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
        .btn-secondary { background: transparent; border: 1px solid var(--border); color: var(--text-dim); }
        .btn-coupon {
            background: transparent; border: 1px dashed var(--gold);
            color: var(--gold); padding: 8px 16px; border-radius: 8px;
            cursor: pointer; font-size: 0.78em; font-family: inherit;
            text-transform: uppercase; letter-spacing: 1px;
        }
        .btn-coupon:hover { background: rgba(255,215,0,0.1); }

        /* Coupon */
        .coupon-section { display: flex; gap: 8px; margin-bottom: 16px; }
        .coupon-input {
            flex: 1; padding: 10px 14px;
            background: var(--bg-input);
            border: 1px dashed var(--gold);
            border-radius: 8px; color: var(--gold);
            font-family: 'Courier New', monospace;
            font-size: 0.9em; text-transform: uppercase;
            letter-spacing: 2px; outline: none;
        }
        .coupon-input::placeholder { color: rgba(255,215,0,0.3); }
        .coupon-applied {
            display: flex; align-items: center; gap: 8px;
            padding: 10px 14px;
            background: rgba(63,185,80,0.1);
            border: 1px solid rgba(63,185,80,0.3);
            border-radius: 8px; color: var(--success);
            font-size: 0.85em; margin-bottom: 16px;
        }

        /* Success Overlay */
        .success-overlay {
            display: none; position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.85); z-index: 1000;
            justify-content: center; align-items: center;
        }
        .success-overlay.show { display: flex; }
        .success-modal {
            background: var(--bg-card);
            border: 1px solid var(--success);
            border-radius: 20px; padding: 40px;
            text-align: center; max-width: 550px; width: 90%;
            max-height: 90vh; overflow-y: auto;
            animation: slideUp 0.5s ease;
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .success-icon { font-size: 4em; margin-bottom: 16px; }
        .success-title { font-size: 1.5em; font-weight: 700; color: var(--success); margin-bottom: 8px; text-transform: uppercase; }
        .success-message { color: var(--text-dim); font-size: 0.9em; margin-bottom: 20px; line-height: 1.6; }
        .transaction-id {
            font-family: 'Courier New', monospace;
            background: var(--bg-input); padding: 10px 16px;
            border-radius: 8px; color: var(--quantum);
            font-size: 0.85em; margin-bottom: 16px;
            user-select: all;
        }
        .features-unlocked { text-align: left; margin: 16px 0; }
        .feature-item {
            display: flex; align-items: center; gap: 8px;
            padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.04);
            font-size: 0.82em; color: var(--text);
        }
        .feature-item .check { color: var(--success); font-weight: 700; }

        /* Processing Overlay */
        .processing-overlay {
            display: none; position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7); z-index: 998;
            justify-content: center; align-items: center;
        }
        .processing-overlay.show { display: flex; }
        .processing-spinner {
            width: 60px; height: 60px;
            border: 4px solid rgba(255,255,255,0.1);
            border-top-color: var(--accent);
            border-radius: 50%; animation: spin 1s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* Toast Notification */
        .toast {
            position: fixed; top: 20px; right: 20px;
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 12px; padding: 16px 20px;
            z-index: 999; animation: slideIn 0.3s ease;
            display: none; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            max-width: 400px;
        }
        .toast.show { display: block; }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(100px); }
            to { opacity: 1; transform: translateX(0); }
        }
        .toast.success { border-color: var(--success); }
        .toast.error { border-color: var(--danger); }
        .toast.warning { border-color: var(--warning); }

        /* Responsive */
        @media (max-width: 768px) {
            .payment-dashboard { grid-template-columns: 1fr; }
            .dashboard-grid { grid-template-columns: 1fr; }
            .pricing-grid { grid-template-columns: 1fr; }
            .payment-methods { grid-template-columns: repeat(2, 1fr); }
            .hero h1 { font-size: 28px; }
            .hero-stats { gap: 20px; }
            .card-price { font-size: 36px; }
            .nav-links { gap: 10px; }
            .nav-link { font-size: 10px; }
        }
    </style>
</head>
<body>

    <!-- ========== TOP NAVIGATION ========== -->
    <nav class="top-nav">
        <div class="nav-logo">
            <div class="logo-icon">⚡</div>
            <div class="logo-text">SUPREME<span>TECHNOLOGY</span></div>
        </div>
        <div class="nav-links">
            <span class="nav-link active" data-section="licensing">Licensing</span>
            <span class="nav-link" data-section="dashboard">Dashboard</span>
            <span class="nav-link" data-section="payment">Payment</span>
            <button class="nav-btn" onclick="navigateTo('licensing')">Get License</button>
        </div>
    </nav>

    <!-- ========== LICENSING SECTION ========== -->
    <section class="section active" id="licensingSection">
        <div class="hero">
            <div class="hero-badge">🌍 PLANETARY OPERATING SYSTEM</div>
            <h1>The World's First Sovereign<br>Technology Infrastructure</h1>
            <p>
                Supreme Technology is a Planetary OS that operates Internet, Banking, Cities, Cars, and Space 
                from a single platform. Zero external dependencies. 100% sovereign stack.
                Pay once annually — unlimited usage all year. No hidden costs. Annual renewal required.
            </p>
            <div class="hero-stats">
                <div class="hero-stat"><div class="hero-stat-value">753K+</div><div class="hero-stat-label">Isolated Companies</div></div>
                <div class="hero-stat"><div class="hero-stat-value">$440B+</div><div class="hero-stat-label">Replaceable Market</div></div>
                <div class="hero-stat"><div class="hero-stat-value">99.999%</div><div class="hero-stat-label">Fix Success Rate</div></div>
                <div class="hero-stat"><div class="hero-stat-value">0ms</div><div class="hero-stat-label">Response Time</div></div>
            </div>
        </div>

        <div class="licensing-section">
