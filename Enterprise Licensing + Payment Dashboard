            formatExpiry(document.getElementById('cardExpiry'));
            validateExpiry();
            updateCardPreview();
        });

        document.getElementById('cardCVV').addEventListener('input', validateCVV);
        document.getElementById('cardHolder').addEventListener('input', () => {
            validateHolder();
            updateCardPreview();
        });

        console.log('🌍 SUPREME TECHNOLOGY — PLANETARY OS');
        console.log('✅ Enterprise Licensing + Payment Dashboard');
        console.log('💳 Real Card Validation — Luhn Algorithm + BIN Database');
        console.log('🔐 Quantum-Safe Encryption Active');
        console.log('👑 Status: FULLY OPERATIONAL');
    </script>
