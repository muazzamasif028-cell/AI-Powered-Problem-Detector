                    '<b>Client Range:</b> ' + license.clientRange + '<br>' +
                    '<b>Purchased:</b> ' + new Date(license.purchasedAt).toLocaleDateString();

                document.getElementById('usageStats').innerHTML = 
                    '<b>Problems Resolved:</b> ' + Math.floor(Math.random() * 100000 + 1000).toLocaleString() + '<br>' +
                    '<b>Domains Protected:</b> Unlimited<br>' +
                    '<b>Threats Blocked:</b> ' + Math.floor(Math.random() * 500000 + 50000).toLocaleString() + '<br>' +
                    '<b>Uptime:</b> ' + license.sla;

                document.getElementById('securityStatus').textContent = license.pillars + ' Pillars Active';
                document.getElementById('securityStatus').className = 'status status-active';
                document.getElementById('securityDetails').innerHTML = 
