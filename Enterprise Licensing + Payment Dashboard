                document.getElementById('licenseDetails').innerHTML = 'No license purchased yet. Visit the Licensing section to get started.';
                document.getElementById('usageStats').innerHTML = 'Problems Resolved: --<br>Domains Protected: --<br>Threats Blocked: --<br>Uptime: --%';
                document.getElementById('securityStatus').textContent = 'Inactive';
                document.getElementById('securityStatus').className = 'status status-inactive';
                document.getElementById('securityDetails').innerHTML = 'Active Pillars: --<br>Encryption: --<br>Last Scan: --';
                document.getElementById('renewalStatus').textContent = 'N/A';
                document.getElementById('renewalStatus').className = 'status status-inactive';
                document.getElementById('renewalDetails').innerHTML = 'License Expiry: --<br>Days Remaining: --<br>Auto-Renewal: OFF';
            }
        }

        // ============================================
        // UTILITY FUNCTIONS
        // ============================================
        function contactSales() {
            alert('🤝 SUPREME COUNCIL — PLANETARY PARTNERSHIP\n\n' +
                  'For Global Infrastructure & Government inquiries:\n\n' +
                  '📧 council@supreme.technology\n' +
                  '📞 Direct line available for qualified entities\n\n' +
                  'We will reach out within 24 hours.\n\n' +
                  '🌍 Supreme Technology — Planetary OS');
