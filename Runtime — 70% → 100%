class EventLoop {
    constructor() {
        this.queue = [];
        this.running = false;
    }

    push(event) {
        this.queue.push(event);
    }

    async run() {
        this.running = true;
        while (this.running && this.queue.length > 0) {
            const event = this.queue.shift();
            await event.handler();
        }
    }
}

class AsyncRuntime {
    async spawn(fn) {
        return await fn();
    }

    async parallel(fns) {
        return await Promise.all(fns.map(fn => fn()));
    }
}
