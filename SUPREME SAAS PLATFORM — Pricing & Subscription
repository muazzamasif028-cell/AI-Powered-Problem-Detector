    /**
     * 📈 Get Platform Analytics (SUPREME Internal)
     */
    async getPlatformAnalytics() {
        const tenants = Array.from(this.state.tenants.values());
        
        return {
            totalTenants: tenants.length,
            byPlan: {
                FREE: tenants.filter(t => t.plan === 'FREE').length,
                PROFESSIONAL: tenants.filter(t => t.plan === 'PROFESSIONAL').length,
                BUSINESS: tenants.filter(t => t.plan === 'BUSINESS').length,
                ENTERPRISE: tenants.filter(t => t.plan === 'ENTERPRISE').length,
                ULTIMATE: tenants.filter(t => t.plan === 'ULTIMATE').length
            },
            revenue: this.state.revenue,
            conversionRate: this.calculateConversionRate(),
            averageRevenuePerUser: this.calculateARPU(),
            churnRate: this.calculateChurnRate()
        };
    }

    // ============================================
    // PRIVATE HELPERS
    // ============================================

    updateRevenue(planKey, price, billingCycle) {
        const monthlyPrice = billingCycle === 'ANNUAL' ? price / 12 : price;
        
        this.state.revenue.mrr += monthlyPrice;
        this.state.revenue.arr = this.state.revenue.mrr * 12;
        this.state.revenue.totalCustomers++;
        
        this.state.revenue.byPlan[planKey] = (this.state.revenue.byPlan[planKey] || 0) + 1;
    }

    calculateProration(tenant, newPlan) {
        return newPlan.price || 149; // Simplified
    }

    suggestUpgrade(feature) {
        const recommendations = {
            'BOM_GENERATOR': 'PROFESSIONAL',
            'DOCUMENTATION': 'PROFESSIONAL',
            'DIGITAL_TWIN': 'BUSINESS',
            'COLLABORATION': 'BUSINESS',
            'API_ACCESS': 'BUSINESS',
            'SIMULATION_ADVANCED': 'BUSINESS',
            'CUSTOM_AI': 'ENTERPRISE'
        };
        return recommendations[feature] || 'PROFESSIONAL';
    }

    getRecommendedUpgrade(tenant) {
        if (tenant.plan === 'FREE' && tenant.usage.projectsCreated >= 2) return 'PROFESSIONAL';
        if (tenant.plan === 'PROFESSIONAL' && tenant.usage.aiRequests > 400) return 'BUSINESS';
        return null;
    }

    calculateConversionRate() {
        const total = this.state.tenants.size;
        const paid = Array.from(this.state.tenants.values())
            .filter(t => t.plan !== 'FREE').length;
        return total > 0 ? ((paid / total) * 100).toFixed(1) + '%' : '0%';
    }

    calculateARPU() {
        const paid = Array.from(this.state.tenants.values())
            .filter(t => t.plan !== 'FREE').length;
        return paid > 0 ? '$' + Math.round(this.state.revenue.mrr / paid) : '$0';
    }

