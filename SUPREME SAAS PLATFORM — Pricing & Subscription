                projectsCreated: 0,
                aiRequests: 0,
                simulations: 0,
                storageUsed: 0
            }
        };
        
        this.state.tenants.set(tenantId, tenant);
        
        console.log(`👤 Tenant Created: ${tenant.name} (${tenant.plan} Plan)`);
        
        return tenant;
    }

    /**
     * 💰 Subscribe to Plan
     */
    async subscribe(tenantId, planKey, billingCycle = 'MONTHLY') {
        const tenant = this.state.tenants.get(tenantId);
        const plan = this.plans[planKey];
        
        if (!tenant) throw new Error('Tenant not found');
        if (!plan) throw new Error('Invalid plan');
        
        // Calculate price
        const price = billingCycle === 'ANNUAL' ? 
            (plan.annualPrice || plan.price * 10) : 
            plan.price;
        
        const subscription = {
            subscriptionId: `SUB-${Date.now().toString(36).toUpperCase()}`,
            tenantId,
            plan: planKey,
            billingCycle,
            price,
            status: 'ACTIVE',
            startedAt: new Date().toISOString(),
            renewsAt: new Date(Date.now() + (billingCycle === 'ANNUAL' ? 365 : 30) * 24 * 60 * 60 * 1000).toISOString(),
            paymentMethod: null,
            invoices: []
        };
        
        // Update tenant
        tenant.plan = planKey;
        tenant.subscriptionStatus = 'ACTIVE';
        
        this.state.subscriptions.set(subscription.subscriptionId, subscription);
        
        // Update revenue
        this.updateRevenue(planKey, price, billingCycle);
        
        console.log(`💰 Subscribed: ${tenant.name} → ${plan.emoji} ${plan.name} ($${price}/${billingCycle})`);
        
        this.emit('subscription:created', { tenantId, plan: planKey, price });
        
        return subscription;
    }

    /**
     * ⬆️ Upgrade Plan
     */
    async upgradePlan(tenantId, newPlanKey) {
        const tenant = this.state.tenants.get(tenantId);
        const currentPlan = this.plans[tenant.plan];
        const newPlan = this.plans[newPlanKey];
        
        if (!tenant) throw new Error('Tenant not found');
        if (!newPlan) throw new Error('Invalid plan');
        
        // Calculate proration
        const proration = this.calculateProration(tenant, newPlan);
        
        console.log(`⬆️ Upgrading: ${tenant.name}`);
        console.log(`   ${currentPlan.emoji} ${currentPlan.name} → ${newPlan.emoji} ${newPlan.name}`);
        console.log(`   Prorated Charge: $${proration}`);
        
        tenant.plan = newPlanKey;
        
        this.emit('plan:upgraded', { tenantId, from: tenant.plan, to: newPlanKey });
        
        return { success: true, newPlan: newPlanKey, proration };
    }

    /**
     * ❌ Cancel Subscription
     */
    async cancelSubscription(tenantId, reason = '') {
        const tenant = this.state.tenants.get(tenantId);
        
        if (!tenant) throw new Error('Tenant not found');
        
        tenant.subscriptionStatus = 'CANCELLED';
        tenant.cancelledAt = new Date().toISOString();
        tenant.cancellationReason = reason;
        
        console.log(`❌ Cancelled: ${tenant.name} — Reason: ${reason || 'Not specified'}`);
        
        // Downgrade to FREE after current period
        setTimeout(() => {
            tenant.plan = 'FREE';
            console.log(`🔄 ${tenant.name} downgraded to FREE plan`);
        }, 30 * 24 * 60 * 60 * 1000); // After 30 days
        
        return { success: true, message: 'Subscription cancelled' };
    }

    /**
     * ✅ Check Feature Access
     */
    async checkFeatureAccess(tenantId, feature) {
        const tenant = this.state.tenants.get(tenantId);
        
        if (!tenant) return { allowed: false, reason: 'TENANT_NOT_FOUND' };
        
        const plan = this.plans[tenant.plan];
        
        // Check usage limits
        const usage = tenant.usage;
        const limits = plan.limitations;
        
        // Check project limit
        if (feature === 'CREATE_PROJECT' && plan.projects !== 'UNLIMITED') {
            if (usage.projectsCreated >= plan.projects) {
                return { 
                    allowed: false, 
                    reason: 'PROJECT_LIMIT_REACHED',
                    message: `Free plan allows ${plan.projects} projects. Upgrade to create more.`,
                    upgradeTo: 'PROFESSIONAL'
                };
            }
        }
        
        // Check AI requests
        if (feature === 'AI_REQUEST' && limits.aiRequests !== 'UNLIMITED') {
            if (usage.aiRequests >= parseInt(limits.aiRequests)) {
                return {
                    allowed: false,
                    reason: 'AI_LIMIT_REACHED',
                    message: `Monthly AI limit reached (${limits.aiRequests}). Upgrade for more.`,
                    upgradeTo: 'PROFESSIONAL'
                };
            }
        }
        
        // Check simulation limit
        if (feature === 'SIMULATION' && limits.simulations !== 'UNLIMITED') {
            if (usage.simulations >= parseInt(limits.simulations)) {
                return {
                    allowed: false,
                    reason: 'SIMULATION_LIMIT_REACHED',
                    message: `Monthly simulation limit reached. Upgrade for unlimited.`,
                    upgradeTo: 'BUSINESS'
                };
            }
        }
        
        // Check feature availability in plan
        const featureMap = {
            'BOM_GENERATOR': plan.features.bom,
            'DOCUMENTATION': plan.features.documentation,
            'DIGITAL_TWIN': plan.features.digitalTwin,
            'COLLABORATION': plan.features.collaboration,
            'API_ACCESS': plan.features.api,
            'SIMULATION_ADVANCED': plan.features.simulation === 'ADVANCED' || plan.features.simulation === 'UNLIMITED',
            'CUSTOM_AI': plan.features.ai === 'CUSTOM_MODELS' || plan.features.ai === 'FULLY_CUSTOM_TRAINED'
        };
        
        if (featureMap[feature] === false || featureMap[feature] === undefined) {
            return {
                allowed: false,
                reason: 'FEATURE_NOT_IN_PLAN',
                message: 'This feature requires a higher plan.',
                upgradeTo: this.suggestUpgrade(feature)
            };
        }
        
        return { allowed: true };
    }

