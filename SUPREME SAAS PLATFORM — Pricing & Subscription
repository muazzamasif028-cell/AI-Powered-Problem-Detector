    async createTenant(tenantData) {
        const tenantId = `TENANT-${Date.now().toString(36).toUpperCase()}`;
        
        const tenant = {
            tenantId,
            name: tenantData.name,
            email: tenantData.email,
            plan: 'FREE', // Start with free
            subscriptionStatus: 'TRIAL',
