    async def get_admin_analytics(self) -> Dict:
        """Get admin analytics dashboard"""
        total_revenue = self.db.query(
            func.sum(Payment.amount)
        ).filter(Payment.status == PaymentStatus.SUCCESS).scalar() or 0
        
        active_subscriptions = self.db.query(Subscription).filter(
            Subscription.status == SubscriptionStatus.ACTIVE
        ).count()
        
        mrr = self.db.query(
            func.sum(Subscription.unit_price * Subscription.quantity)
        ).filter(Subscription.status == SubscriptionStatus.ACTIVE).scalar() or 0
        
        # Trial conversion rate
        total_trials = self.db.query(Subscription).filter(
            Subscription.status.in_([SubscriptionStatus.TRIAL, SubscriptionStatus.ACTIVE, SubscriptionStatus.EXPIRED])
        ).count()
        
        converted_trials = self.db.query(Subscription).filter(
            Subscription.status == SubscriptionStatus.ACTIVE
        ).count()
        
        conversion_rate = (converted_trials / total_trials * 100) if total_trials > 0 else 0
        
        # Revenue by country
        revenue_by_country = self.db.query(
            Organization.country,
            func.sum(Payment.amount)
        ).join(Payment, Payment.invoice_id == Invoice.id)\
         .join(Invoice, Invoice.organization_id == Organization.id)\
         .filter(Payment.status == PaymentStatus.SUCCESS)\
         .group_by(Organization.country).all()
        
        return {
            "total_revenue": total_revenue,
            "active_subscriptions": active_subscriptions,
            "mrr": mrr,
            "arr": mrr * 12,
            "trial_conversion_rate": conversion_rate,
            "revenue_by_country": dict(revenue_by_country),
            "churn_rate": self._calculate_churn_rate()
        }
    
    def _calculate_churn_rate(self) -> float:
        """Calculate monthly churn rate"""
        current_month_start = datetime.utcnow().replace(day=1)
        previous_month_start = (current_month_start - timedelta(days=1)).replace(day=1)
        
        canceled = self.db.query(Subscription).filter(
            Subscription.canceled_at >= previous_month_start,
            Subscription.canceled_at < current_month_start
        ).count()
        
        active_at_start = self.db.query(Subscription).filter(
            Subscription.created_at < previous_month_start,
            Subscription.status.in_([SubscriptionStatus.ACTIVE, SubscriptionStatus.TRIAL])
        ).count()
        
        return (canceled / active_at_start * 100) if active_at_start > 0 else 0

