class PricingEngine:
    def __init__(self, db: Session):
        self.db = db
    
    async def get_plan_pricing(self, plan_id: str, currency: str = "USD", 
                               coupon_code: Optional[str] = None) -> Dict:
        """Calculate final pricing with discounts and taxes"""
        plan = self.db.query(Plan).filter(Plan.id == plan_id).first()
        if not plan:
            raise HTTPException(status_code=404, detail="Plan not found")
        
        base_price = plan.price
        discount_amount = Decimal('0')
        
        # Apply coupon if provided
        if coupon_code:
            coupon = self.db.query(Coupon).filter(
                Coupon.code == coupon_code,
                Coupon.status == "active",
                Coupon.expiry_date > datetime.utcnow()
            ).first()
            
            if coupon and self._validate_coupon(coupon, plan.id):
                discount_amount = self._calculate_discount(base_price, coupon)
        
        discounted_price = base_price - discount_amount
        
        # Convert currency if needed
        if currency != plan.currency:
            discounted_price = await self._convert_currency(
                discounted_price, plan.currency, currency
            )
        
        # Calculate tax
        tax_amount = await self._calculate_tax(discounted_price, "US")  # Country from context
        final_price = discounted_price + tax_amount
        
        return {
            "plan_name": plan.name,
            "base_price": base_price,
            "discount": discount_amount,
            "subtotal": discounted_price,
            "tax": tax_amount,
            "total": final_price,
            "currency": currency,
            "billing_cycle": plan.billing_cycle,
            "trial_days": plan.trial_days
        }
    
    def _validate_coupon(self, coupon: Coupon, plan_id: str) -> bool:
        """Validate coupon applicability"""
        if coupon.max_uses and coupon.current_uses >= coupon.max_uses:
            return False
        
        if coupon.plans and plan_id not in coupon.plans:
            return False
        
        return True
    
    def _calculate_discount(self, amount: Decimal, coupon: Coupon) -> Decimal:
        """Calculate discount amount"""
        if coupon.discount_type == "percentage":
            return amount * (coupon.discount_value / 100)
        else:  # fixed
            return min(coupon.discount_value, amount)
    
    async def _calculate_tax(self, amount: Decimal, country: str) -> Decimal:
        """Calculate applicable tax"""
        tax_rate = self.db.query(TaxRate).filter(
            TaxRate.country == country,
            TaxRate.status == "active"
        ).first()
        
        if tax_rate:
            return amount * (tax_rate.rate / 100)
        return Decimal('0')
    
    async def _convert_currency(self, amount: Decimal, from_currency: str, 
                                to_currency: str) -> Decimal:
        """Currency conversion using external API"""
        # Simulated conversion rates
        rates = {
            ("USD", "PKR"): Decimal('280'),
            ("USD", "EUR"): Decimal('0.92'),
            ("USD", "GBP"): Decimal('0.79')
        }
        
        if from_currency == to_currency:
            return amount
        
        rate = rates.get((from_currency, to_currency), Decimal('1'))
        return amount * rate

