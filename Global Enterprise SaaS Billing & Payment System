class SubscriptionManager:
    def __init__(self, db: Session, gateway_factory: GatewayFactory):
        self.db = db
        self.gateway_factory = gateway_factory
    
    async def create_subscription(self, organization_id: str, plan_id: str,
                                 payment_method_id: str, coupon_code: Optional[str] = None,
                                 quantity: int = 1) -> Dict:
        """Create new subscription"""
        # Get organization and plan
        org = self.db.query(Organization).filter(Organization.id == organization_id).first()
        plan = self.db.query(Plan).filter(Plan.id == plan_id).first()
        
        if not org or not plan:
            raise HTTPException(status_code=404, detail="Organization or Plan not found")
        
        # Calculate pricing
        pricing_engine = PricingEngine(self.db)
        pricing = await pricing_engine.get_plan_pricing(plan_id, plan.currency, coupon_code)
        
        # Create subscription record
        subscription = Subscription(
            organization_id=organization_id,
            plan_id=plan_id,
            status=SubscriptionStatus.TRIAL,
            current_period_start=datetime.utcnow(),
            current_period_end=datetime.utcnow() + timedelta(days=plan.trial_days),
            trial_end=datetime.utcnow() + timedelta(days=plan.trial_days),
            quantity=quantity,
            unit_price=pricing["total"],
            metadata={"coupon": coupon_code} if coupon_code else {}
        )
        
        self.db.add(subscription)
        self.db.commit()
        
        # Schedule subscription activation after trial
        self._schedule_trial_end(subscription.id, plan.trial_days)
        
        return {
            "subscription_id": subscription.id,
            "status": subscription.status,
            "trial_end": subscription.trial_end,
            "pricing": pricing
        }
    
    def _schedule_trial_end(self, subscription_id: str, trial_days: int):
        """Schedule trial end processing"""
        # In production, use Celery or similar task queue
        from datetime import timedelta
        trial_end = datetime.utcnow() + timedelta(days=trial_days)
        # celery_app.send_task("process_trial_end", args=[subscription_id], eta=trial_end)
    
    async def process_trial_end(self, subscription_id: str):
        """Handle trial end - convert to paid or cancel"""
        subscription = self.db.query(Subscription).filter(
            Subscription.id == subscription_id
        ).first()
        
        if not subscription or subscription.status != SubscriptionStatus.TRIAL:
            return
        
        organization = self.db.query(Organization).filter(
            Organization.id == subscription.organization_id
        ).first()
        
        # Attempt to charge
        try:
            payment_method = self.db.query(PaymentMethod).filter(
                PaymentMethod.organization_id == organization.id,
                PaymentMethod.is_default == True
            ).first()
            
            if payment_method:
                invoice = await self._create_invoice(subscription)
                payment_success = await self._process_payment(invoice, payment_method)
                
                if payment_success:
                    subscription.status = SubscriptionStatus.ACTIVE
                    subscription.current_period_end = datetime.utcnow() + timedelta(days=30)
                else:
                    subscription.status = SubscriptionStatus.PAST_DUE
            else:
                subscription.status = SubscriptionStatus.EXPIRED
        
        except Exception as e:
            subscription.status = SubscriptionStatus.PAST_DUE
            logging.error(f"Trial end processing failed: {e}")
        
        self.db.commit()
    
    async def _create_invoice(self, subscription: Subscription) -> Invoice:
        """Generate invoice for subscription"""
        plan = self.db.query(Plan).filter(Plan.id == subscription.plan_id).first()
        
        invoice = Invoice(
            invoice_number=self._generate_invoice_number(),
            organization_id=subscription.organization_id,
            subscription_id=subscription.id,
            type=InvoiceType.SUBSCRIPTION,
            amount=subscription.unit_price * subscription.quantity,
            tax_amount=0,  # Calculate based on country
            total_amount=subscription.unit_price * subscription.quantity,
            currency=plan.currency,
            status=PaymentStatus.PENDING,
            due_date=datetime.utcnow() + timedelta(days=30)
        )
        
        self.db.add(invoice)
        self.db.commit()
        return invoice
    
    async def _process_payment(self, invoice: Invoice, payment_method: PaymentMethod) -> bool:
        """Process payment through gateway"""
        gateway = self.gateway_factory.get_gateway(payment_method.gateway)
        
        try:
            result = await gateway.create_payment(
                amount=invoice.total_amount,
                currency=invoice.currency,
                metadata={
                    "invoice_id": invoice.id,
                    "customer_id": payment_method.gateway_token
                }
            )
            
            # Record payment
            payment = Payment(
                invoice_id=invoice.id,
                gateway=payment_method.gateway,
                gateway_payment_id=result["gateway_payment_id"],
                amount=invoice.total_amount,
                currency=invoice.currency,
                status=PaymentStatus.SUCCESS,
                payment_method_id=payment_method.id
            )
            
            invoice.status = PaymentStatus.SUCCESS
            invoice.paid_at = datetime.utcnow()
            
            self.db.add(payment)
            self.db.commit()
            
            return True
            
        except Exception as e:
            logging.error(f"Payment processing failed: {e}")
            invoice.status = PaymentStatus.FAILED
            self.db.commit()
            return False
    
    def _generate_invoice_number(self) -> str:
        """Generate unique invoice number"""
        year = datetime.utcnow().year
        count = self.db.query(Invoice).filter(
            Invoice.created_at >= f"{year}-01-01"
        ).count()
        return f"INV-{year}-{count + 1:05d}"

