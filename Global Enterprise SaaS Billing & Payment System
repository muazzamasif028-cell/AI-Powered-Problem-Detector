class StripeGateway(PaymentGatewayInterface):
    def __init__(self, api_key: str, webhook_secret: str):
        stripe.api_key = api_key
        self.webhook_secret = webhook_secret
    
    async def create_payment(self, amount: Decimal, currency: str, metadata: Dict) -> Dict:
        try:
            intent = stripe.PaymentIntent.create(
                amount=int(amount * 100),  # Convert to cents
                currency=currency.lower(),
                metadata=metadata,
                automatic_payment_methods={"enabled": True}
            )
            return {
                "gateway_payment_id": intent.id,
                "client_secret": intent.client_secret,
                "status": intent.status
            }
        except stripe.error.StripeError as e:
            raise HTTPException(status_code=400, detail=str(e))
    
    async def capture_payment(self, payment_id: str) -> Dict:
        intent = stripe.PaymentIntent.retrieve(payment_id)
        return {"status": intent.status, "amount": intent.amount / 100}
    
    async def refund_payment(self, payment_id: str, amount: Optional[Decimal] = None) -> Dict:
        refund_data = {"payment_intent": payment_id}
        if amount:
            refund_data["amount"] = int(amount * 100)
        refund = stripe.Refund.create(**refund_data)
        return {"refund_id": refund.id, "status": refund.status}
    
    async def create_subscription(self, customer_id: str, price_id: str) -> Dict:
        subscription = stripe.Subscription.create(
            customer=customer_id,
            items=[{"price": price_id}],
            payment_behavior="default_incomplete",
            expand=["latest_invoice.payment_intent"]
        )
        return {
            "subscription_id": subscription.id,
            "status": subscription.status,
            "client_secret": subscription.latest_invoice.payment_intent.client_secret
        }
    
    async def cancel_subscription(self, subscription_id: str) -> Dict:
        subscription = stripe.Subscription.delete(subscription_id)
        return {"subscription_id": subscription.id, "status": subscription.status}
    
    async def get_payment_status(self, payment_id: str) -> Dict:
        intent = stripe.PaymentIntent.retrieve(payment_id)
        return {"status": intent.status}
    
    async def validate_webhook(self, payload: bytes, signature: str) -> bool:
        try:
            stripe.Webhook.construct_event(payload, signature, self.webhook_secret)
            return True
        except Exception:
            return False

class PayFastPKGateway(PaymentGatewayInterface):
    def __init__(self, merchant_id: str, secret_key: str, base_url: str):
        self.merchant_id = merchant_id
        self.secret_key = secret_key
        self.base_url = base_url
    
    async def create_payment(self, amount: Decimal, currency: str, metadata: Dict) -> Dict:
        # PayFast Pakistan API Integration
        payload = {
            "merchant_id": self.merchant_id,
            "amount": str(amount),
            "currency": currency,
            "order_id": metadata.get("order_id"),
            "return_url": metadata.get("return_url"),
            "cancel_url": metadata.get("cancel_url")
        }
        
        # Generate signature
        signature = self._generate_signature(payload)
        payload["signature"] = signature
        
        response = requests.post(f"{self.base_url}/api/payment/create", json=payload)
        return response.json()
    
    def _generate_signature(self, payload: Dict) -> str:
        # Pakistan payment gateway signature generation
        data_string = "&".join([f"{k}={v}" for k, v in sorted(payload.items())])
        return hashlib.sha256(f"{data_string}{self.secret_key}".encode()).hexdigest()
    
    async def capture_payment(self, payment_id: str) -> Dict:
        response = requests.get(f"{self.base_url}/api/payment/{payment_id}", 
                               headers={"Authorization": f"Bearer {self.secret_key}"})
        return response.json()
    
    async def refund_payment(self, payment_id: str, amount: Optional[Decimal] = None) -> Dict:
        payload = {"payment_id": payment_id}
        if amount:
            payload["amount"] = str(amount)
        
        response = requests.post(f"{self.base_url}/api/refund", 
                                json=payload,
                                headers={"Authorization": f"Bearer {self.secret_key}"})
        return response.json()
    
    async def create_subscription(self, customer_id: str, plan_id: str) -> Dict:
        # PayFast subscription setup
        pass
    
    async def cancel_subscription(self, subscription_id: str) -> Dict:
        pass
    
    async def get_payment_status(self, payment_id: str) -> Dict:
        response = requests.get(f"{self.base_url}/api/payment/status/{payment_id}")
        return response.json()
    
    async def validate_webhook(self, payload: Dict, signature: str) -> bool:
        computed = self._generate_signature(payload)
        return hmac.compare_digest(computed, signature)

class HBLGateway(PaymentGatewayInterface):
    def __init__(self, client_id: str, client_secret: str, base_url: str):
        self.client_id = client_id
        self.client_secret = client_secret
        self.base_url = base_url
        self.access_token = None
    
    async def _get_token(self) -> str:
        # OAuth2 token for HBL Payment Gateway
        auth_response = requests.post(
            f"{self.base_url}/oauth/token",
            json={
                "client_id": self.client_id,
                "client_secret": self.client_secret,
                "grant_type": "client_credentials"
            }
        )
        return auth_response.json()["access_token"]
    
    async def create_payment(self, amount: Decimal, currency: str, metadata: Dict) -> Dict:
        token = await self._get_token()
        
        payload = {
            "amount": str(amount),
            "currency": currency,
            "merchant_id": self.client_id,
            "order_id": metadata.get("order_id"),
            "callback_url": metadata.get("callback_url")
        }
        
        response = requests.post(
            f"{self.base_url}/api/v1/payments",
            json=payload,
            headers={"Authorization": f"Bearer {token}"}
        )
        return response.json()
    
    async def capture_payment(self, payment_id: str) -> Dict:
        token = await self._get_token()
        response = requests.get(
            f"{self.base_url}/api/v1/payments/{payment_id}",
            headers={"Authorization": f"Bearer {token}"}
        )
        return response.json()
    
    async def refund_payment(self, payment_id: str, amount: Optional[Decimal] = None) -> Dict:
        token = await self._get_token()
        payload = {"amount": str(amount)} if amount else {}
        
        response = requests.post(
            f"{self.base_url}/api/v1/payments/{payment_id}/refund",
            json=payload,
            headers={"Authorization": f"Bearer {token}"}
        )
        return response.json()
    
    async def create_subscription(self, customer_id: str, plan_id: str) -> Dict:
        token = await self._get_token()
        # HBL subscription logic
        pass
    
    async def cancel_subscription(self, subscription_id: str) -> Dict:
        pass
    
    async def get_payment_status(self, payment_id: str) -> Dict:
        token = await self._get_token()
        response = requests.get(
            f"{self.base_url}/api/v1/payments/{payment_id}/status",
            headers={"Authorization": f"Bearer {token}"}
        )
        return response.json()
    
    async def validate_webhook(self, payload: Dict, signature: str) -> bool:
        # HBL webhook validation
