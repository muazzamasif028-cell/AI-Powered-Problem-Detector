class GatewayFactory:
    def __init__(self, config: Dict):
        self.config = config
        self._gateways = {}
        self._initialize_gateways()
    
    def _initialize_gateways(self):
        """Initialize all payment gateways"""
        gateway_configs = {
            GatewayType.STRIPE: {
                "class": StripeGateway,
                "params": {
                    "api_key": self.config.get("STRIPE_SECRET_KEY"),
                    "webhook_secret": self.config.get("STRIPE_WEBHOOK_SECRET")
                }
            },
            GatewayType.PAYFAST_PK: {
                "class": PayFastPKGateway,
                "params": {
                    "merchant_id": self.config.get("PAYFAST_MERCHANT_ID"),
                    "secret_key": self.config.get("PAYFAST_SECRET_KEY"),
                    "base_url": self.config.get("PAYFAST_BASE_URL")
                }
            },
            GatewayType.HBL: {
                "class": HBLGateway,
                "params": {
                    "client_id": self.config.get("HBL_CLIENT_ID"),
                    "client_secret": self.config.get("HBL_CLIENT_SECRET"),
                    "base_url": self.config.get("HBL_BASE_URL")
                }
            },
            GatewayType.JAZZCASH: {
                "class": JazzCashGateway,
                "params": {
                    "merchant_id": self.config.get("JAZZCASH_MERCHANT_ID"),
                    "password": self.config.get("JAZZCASH_PASSWORD"),
                    "base_url": self.config.get("JAZZCASH_BASE_URL")
                }
            }
        }
        
        for gateway_type, config in gateway_configs.items():
            if all(config["params"].values()):  # Only initialize if config exists
                self._gateways[gateway_type] = config["class"](**config["params"])
    
    def get_gateway(self, gateway_type: GatewayType) -> PaymentGatewayInterface:
        gateway = self._gateways.get(gateway_type)
        if not gateway:
            raise ValueError(f"Gateway {gateway_type} not configured")
        return gateway
    
    def get_available_gateways(self) -> List[GatewayType]:
        return list(self._gateways.keys())
    
    def get_gateway_by_country(self, country: str) -> List[GatewayType]:
        """Smart gateway selection based on country"""
        country_gateway_map = {
            "PK": [GatewayType.PAYFAST_PK, GatewayType.HBL, GatewayType.JAZZCASH],
            "US": [GatewayType.STRIPE],
            "GB": [GatewayType.STRIPE],
            "AE": [GatewayType.STRIPE]
        }
        return country_gateway_map.get(country, [GatewayType.STRIPE])

