        # Validate webhook
        if not await gateway.validate_webhook(payload, signature):
            raise HTTPException(status_code=400, detail="Invalid webhook signature")
        
        # Process based on event type
        event_type = payload.get("type")
        
        if event_type == "payment.succeeded":
            return await self._handle_payment_success(payload)
        elif event_type == "payment.failed":
            return await self._handle_payment_failure(payload)
        elif event_type == "subscription.created":
            return await self._handle_subscription_created(payload)
        elif event_type == "subscription.canceled":
            return await self._handle_subscription_canceled(payload)
        else:
            return {"status": "ignored", "event": event_type}
    
