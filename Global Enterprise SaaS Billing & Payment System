    async def create_checkout_session(self, organization_id: str, plan_id: str,
                                     country: str, coupon_code: Optional[str] = None,
                                     gateway_preference: Optional[GatewayType] = None) -> Dict:
        """Create checkout session"""
        # Get pricing
        pricing = await self.pricing_engine.get_plan_pricing(plan_id, "USD", coupon_code)
        
        # Select gateway based on country
        if gateway_preference:
            gateway_type = gateway_preference
        else:
            available_gateways = self.gateway_factory.get_gateway_by_country(country)
            if not available_gateways:
                raise HTTPException(status_code=400, detail="No gateway available for your country")
            gateway_type = available_gateways[0]
        
        gateway = self.gateway_factory.get_gateway(gateway_type)
        
        # Create payment intent
        payment_result = await gateway.create_payment(
            amount=pricing["total"],
            currency=pricing["currency"],
            metadata={
                "organization_id": organization_id,
                "plan_id": plan_id,
                "type": "checkout"
            }
        )
        
        return {
            "checkout_id": payment_result["gateway_payment_id"],
