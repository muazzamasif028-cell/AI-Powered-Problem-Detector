    /**
     * Register a provider
     */
    registerProvider(name, vendor, provider) {
        this.providers.set(name, {
            name,
            vendor,
            provider,
            status: 'registered',
            connectedAt: null,
            usageCount: 0
        });

        // Track by category
        const category = this.getCategoryForProvider(name);
        if (!this.categories.has(category)) {
            this.categories.set(category, []);
        }
        this.categories.get(category).push(name);
    }

    /**
     * Connect to a provider
     */
    async connect(name, credentials) {
        const provider = this.providers.get(name);
        if (!provider) throw new Error(`Provider not found: ${name}`);

        try {
            await provider.provider.connect(credentials);
            provider.status = 'connected';
            provider.connectedAt = new Date();
            this.activeConnections.set(name, provider);
            
            console.log(`✅ Connected: ${name}`);
            return { success: true, provider: name };
        } catch (error) {
            provider.status = 'error';
            throw error;
        }
    }

    /**
     * Execute AI operation
     */
    async execute(providerName, action, params) {
        const provider = this.providers.get(providerName);
        if (!provider) throw new Error(`Provider not found: ${providerName}`);
        if (provider.status !== 'connected') throw new Error(`Provider not connected: ${providerName}`);

        const startTime = Date.now();
        
        try {
            const result = await provider.provider[action](params);
            provider.usageCount++;
            
            // Log usage
            this.logUsage(providerName, action, Date.now() - startTime);
            
            return result;
        } catch (error) {
            console.error(`Provider ${providerName} error:`, error.message);
            throw error;
        }
    }

    /**
     * Get category for provider
     */
    getCategoryForProvider(name) {
        const categoryMap = {
            'chatgpt': 'chatbot', 'claude': 'chatbot', 'gemini': 'chatbot',
            'github-copilot': 'code', 'codeium': 'code', 'replit': 'code',
            'canva': 'design', 'midjourney': 'design', 'dalle': 'design',
            'sora': 'video', 'heygen': 'video', 'synthesia': 'video',
            'jasper': 'writing', 'grammarly': 'writing',
            'elevenlabs': 'speech', 'murf': 'speech',
            'suno': 'music', 'udio': 'music',
            'consensus': 'research', 'elicit': 'research',
            'zapier': 'automation', 'make': 'automation',
            'hubspot': 'business', 'salesforce': 'business',
            'tableau': 'data', 'powerbi': 'data',
            'darktrace': 'security', 'crowdstrike': 'security'
        };
        return categoryMap[name] || 'other';
    }

    /**
     * Get all providers by category
     */
    getByCategory(category) {
        const providers = this.categories.get(category) || [];
        return providers.map(name => this.providers.get(name));
    }

    /**
     * Get all categories
     */
    getCategories() {
        return Array.from(this.categories.keys());
    }

    /**
     * Get category count
     */
    getCategoryCount() {
        return this.categories.size;
    }

    /**
     * Get all connected providers
     */
    getConnected() {
        return Array.from(this.activeConnections.values());
    }

    /**
     * Get provider stats
     */
    getStats() {
        const total = this.providers.size;
        const connected = this.activeConnections.size;
        const categories = this.categories.size;

        const byCategory = {};
        for (const [category, providers] of this.categories) {
            byCategory[category] = {
                total: providers.length,
                connected: providers.filter(p => this.providers.get(p).status === 'connected').length
            };
        }

        return { total, connected, categories, byCategory };
    }

    /**
     * Log usage
     */
    logUsage(provider, action, duration) {
        // In production: save to analytics database
        if (process.env.NODE_ENV === 'development') {
            console.log(`📊 ${provider}.${action} — ${duration}ms`);
        }
    }

    /**
     * Disconnect all
     */
    async disconnectAll() {
        for (const [name, provider] of this.activeConnections) {
            try {
                await provider.provider.disconnect();
                provider.status = 'disconnected';
            } catch (error) {
                console.error(`Disconnect ${name} failed:`, error.message);
            }
        }
        this.activeConnections.clear();
    }
}

