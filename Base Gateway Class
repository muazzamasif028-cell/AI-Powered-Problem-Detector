// gateways/BaseGateway.js
const crypto = require('crypto');
const axios = require('axios');
const EventEmitter = require('events');

class BaseGateway extends EventEmitter {
    constructor(config) {
        super();
        this.config = config;
        this.name = config.name;
        this.type = config.type;
        this.environment = config.environment;
        
        // Get current environment config
        this.envConfig = config[this.environment];
        
        // Initialize HTTP client
        this.client = axios.create({
            baseURL: this.envConfig.apiUrl,
            timeout: 30000,
            headers: {
                'Content-Type': 'application/json',
                'User-Agent': 'SUPREME-Payment/14.0'
            }
        });
        
        // Request interceptor for logging
        this.client.interceptors.request.use(request => {
            this.emit('request', { gateway: this.name, request });
            return request;
        });
        
        // Response interceptor for error handling
        this.client.interceptors.response.use(
            response => {
                this.emit('response', { gateway: this.name, response });
                return response;
            },
            error => {
                this.emit('error', { gateway: this.name, error });
                return Promise.reject(error);
            }
        );
    }

    /**
     * Generate unique transaction ID
     */
    generateTransactionId() {
        const timestamp = Date.now().toString(36);
        const random = crypto.randomBytes(8).toString('hex');
        return `TXN_${this.name}_${timestamp}_${random}`.toUpperCase();
    }

    /**
     * Generate signature for request verification
     */
    generateSignature(payload, secret) {
        const data = typeof payload === 'string' ? payload : JSON.stringify(payload);
        return crypto
            .createHmac('sha256', secret)
            .update(data)
            .digest('hex');
    }

    /**
     * Verify webhook signature
     */
    verifyWebhookSignature(payload, signature, secret) {
        const expectedSignature = this.generateSignature(payload, secret);
        return crypto.timingSafeEqual(
            Buffer.from(signature),
            Buffer.from(expectedSignature)
        );
    }

    /**
     * Mask sensitive data for logging
     */
    maskSensitiveData(data) {
        const masked = { ...data };
        
        if (masked.cardNumber) {
            masked.cardNumber = `****-****-****-${masked.cardNumber.slice(-4)}`;
        }
        if (masked.cvv) {
            masked.cvv = '***';
        }
        if (masked.password) {
            masked.password = '********';
        }
        
        return masked;
    }

    /**
     * Standard error handler
     */
    handleError(error) {
        const gatewayError = {
            gateway: this.name,
            timestamp: new Date().toISOString(),
            error: {
                code: error.response?.status || 500,
                message: error.response?.data?.message || error.message,
                details: error.response?.data || null
            }
        };
        
        this.emit('gateway:error', gatewayError);
        return gatewayError;
    }

    /**
     * Process payment - To be implemented by each gateway
     */
    async processPayment(paymentData) {
        throw new Error('processPayment must be implemented by gateway');
    }

    /**
     * Verify payment - To be implemented by each gateway
     */
    async verifyPayment(transactionId) {
        throw new Error('verifyPayment must be implemented by gateway');
    }

    /**
     * Process refund - To be implemented by each gateway
     */
    async processRefund(transactionId, amount) {
        throw new Error('processRefund must be implemented by gateway');
    }

    /**
     * Get supported payment methods
     */
    getSupportedMethods() {
        return this.config.supportedCards || [];
    }

    /**
     * Check if gateway supports feature
     */
    supportsFeature(feature) {
        return this.config.features?.[feature] || false;
    }
}

module.exports = BaseGateway;
