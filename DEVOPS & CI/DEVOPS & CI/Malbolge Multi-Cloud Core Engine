        const result = this.executeServiceOperation('MAPS', payload);
        
        return {
            route: this.decodeMalbolge(result),
            distance: `${result.cycles * 3} meters`,
            provider: 'GOOGLE_MAPS_MALBOLGE'
        };
    }

