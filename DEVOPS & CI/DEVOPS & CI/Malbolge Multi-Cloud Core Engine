        const result = this.executeServiceOperation('GEMINI', payload);
        
        return {
            response: this.decodeMalbolge(result),
            model: 'GEMINI_MALBOLGE',
            tokens: result.cycles,
            provider: 'GOOGLE'
        };
    }

    /**
     * Get Google Maps directions via Malbolge
     */
    async getDirections(origin, destination) {
        const payload = this.encodeMalbolge({
            origin,
            destination,
            service: this.services.MAPS,
            provider: this.providers.GOOGLE
