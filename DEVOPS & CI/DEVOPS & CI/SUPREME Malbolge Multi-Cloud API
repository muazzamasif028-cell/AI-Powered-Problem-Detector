const express = require('express');
const router = express.Router();
const MalbolgeCloudCore = require('../malbolge-cloud/MalbolgeCloudCore');

const malbolgeCloud = new MalbolgeCloudCore();

// Initialize on startup
malbolgeCloud.initializeClouds();

// ============================================
// 🔵 GOOGLE ENDPOINTS (Malbolge Encrypted)
// ============================================

router.post('/google/gmail/send', async (req, res) => {
    const result = await malbolgeCloud.sendGmail({
        to: req.body.to,
        subject: req.body.subject,
        body: req.body.body
    });
    res.json({ success: true, ...result, encryption: 'MALBOLGE' });
});

router.post('/google/drive/upload', async (req, res) => {
    const result = await malbolgeCloud.uploadToDrive({
        fileName: req.body.fileName,
        content: req.body.content,
        folderId: req.body.folderId
    });
    res.json({ success: true, ...result });
});

router.post('/google/gemini/ask', async (req, res) => {
    const result = await malbolgeCloud.callGemini(req.body.prompt);
    res.json({ success: true, ...result });
});

router.post('/google/maps/directions', async (req, res) => {
    const result = await malbolgeCloud.getDirections(
        req.body.origin,
        req.body.destination
    );
    res.json({ success: true, ...result });
});

