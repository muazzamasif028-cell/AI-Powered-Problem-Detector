class MalbolgeInterpreter {
    constructor() {
        // Malbolge's crazy operation table
        this.operationTable = this.buildCrazyOperationTable();
        
        // Memory (59049 cells - Malbolge standard)
        this.memory = new Uint8Array(59049);
        
        // Registers
        this.a = 0; // Accumulator
        this.c = 0; // Code pointer
        this.d = 0; // Data pointer
        
        // State
        this.running = false;
    }

    /**
     * Build Malbolge's insane operation table
     * Based on: op = (x + c) % 94
     */
    buildCrazyOperationTable() {
        const table = [];
        const crazyOps = 'j<p oB"a/2\'vV$yJxI?wXuU%tTsSrRqQ3PpO5nNmM4lLkK8jJ7iIhH6gGfF9eEdDcCbB0aA@zZ!';
        
        for (let i = 0; i < 94; i++) {
            table[i] = crazyOps.charCodeAt(i);
        }
        
        return table;
    }

    /**
     * The infamous "crazy operation" — Malbolge's core
     */
    crazyOperation(x, y) {
        const op = (x + this.c) % 94;
        const instruction = this.operationTable[op];
        
        switch (instruction) {
            case 106: // 'j' - NOP (do nothing)
                return { action: 'NOP', result: x };
                
            case 112: // 'p' - Crazy op
                const result = this.ternaryCrazyOp(x, y);
                // ENCRYPT the result in memory (Malbolge quirk)
                this.memory[this.d] = this.encryptValue(result);
                return { action: 'CRAZY', result };
                
            case 60: // '<'
                return { action: 'ROTATE', result: this.rotateRight(x) };
                
            case 111: // 'o' - Halt if no output ready
                if (this.a < 33 || this.a > 126) {
                    return { action: 'HALT', result: 0 };
                }
                return { action: 'OUTPUT', result: this.a };
                
            default:
                return { action: 'NOP', result: x };
        }
    }

    /**
     * Malbolge's ternary operation (trinary base-3)
     */
    ternaryCrazyOp(x, y) {
        // Convert to base-3 (ternary)
        const x3 = this.toTernary(x);
        const y3 = this.toTernary(y);
        
        // Perform Malbolge's crazy trinary operation
        let result = 0;
        for (let i = 0; i < 10; i++) {
            const xi = x3[i] || 0;
            const yi = y3[i] || 0;
            const ri = this.ternaryTable(xi, yi);
            result += ri * Math.pow(3, i);
        }
        
        return result % 59049; // Modulo Malbolge memory size
    }

    /**
     * The mysterious ternary table
     */
    ternaryTable(x, y) {
        const table = [
            [1, 0, 0],
            [1, 0, 2],
            [2, 2, 1]
        ];
        return table[x][y];
    }

    /**
     * Convert number to ternary (base-3)
     */
    toTernary(num) {
        const digits = [];
        let n = num;
        
        while (n > 0) {
            digits.push(n % 3);
            n = Math.floor(n / 3);
        }
        
        return digits;
    }

    /**
     * Encrypt value after operation (Malbolge standard)
     */
    encryptValue(value) {
        // Malbolge encryption: (value * 2 + position) % 256
        return (value * 2 + this.d) % 256;
    }

    /**
     * Rotate right (ternary rotation)
     */
    rotateRight(value) {
        const ternary = this.toTernary(value);
        const rotated = [ternary[ternary.length - 1], ...ternary.slice(0, -1)];
        
        let result = 0;
        for (let i = 0; i < rotated.length; i++) {
            result += rotated[i] * Math.pow(3, i);
        }
        
        return result % 59049;
    }

    /**
     * Execute Malbolge program
     */
    execute(program) {
        this.running = true;
        this.c = 0;
        this.d = 0;
        this.a = 0;
        
        const output = [];
        let iterations = 0;
        const maxIterations = 1000000; // Safety limit
        
        while (this.running && iterations < maxIterations) {
            // Fetch instruction
            const instruction = this.memory[this.c] || program.charCodeAt(this.c % program.length);
            
            // Normalize to Malbolge range
            const normalized = ((instruction - 33) % 94 + 94) % 94;
            
            // Get operands
            const x = this.memory[this.d];
            const y = this.a;
            
            // Execute crazy operation
            const { action, result } = this.crazyOperation(x, y);
            
            // Update registers
            if (action === 'OUTPUT') {
                output.push(this.a);
            }
            
            if (action === 'HALT') {
                this.running = false;
                break;
            }
            
            this.a = result;
            
            // Move to next instruction (self-modifying!)
            this.c = (this.c + 1) % 59049;
            this.d = (this.d + 1) % 59049;
            
            // ENCRYPT the instruction we just executed (Malbolge magic)
            this.memory[this.c - 1] = this.encryptValue(this.memory[this.c - 1]);
            
            iterations++;
        }
        
        return {
            output: String.fromCharCode(...output),
            iterations,
            finalState: {
                a: this.a,
                c: this.c,
                d: this.d
            }
        };
    }
}

module.exports = MalbolgeInterpreter;
