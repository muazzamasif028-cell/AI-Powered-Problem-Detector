// ============================================================
// 🎯 evolution-orchestrator.js
// SUPREME Evolution Orchestrator — "No Broken Update" Engine
// ============================================================
const SystemScanner = require('./system-scanner');
const BugDetector = require('./bug-detector');
const AutoFixer = require('./auto-fixer');
const QualityGate = require('./quality-gate');
const FeatureDNA = require('./feature-dna');
const ReleaseManager = require('./release-manager');
const ImprovementPipeline = require('./improvement-pipeline');
const SandboxTester = require('../sandbox/sandbox-tester');
const Activity = require('../../models/Activity');

class EvolutionOrchestrator {
    constructor() {
        this.cycleStatus = 'IDLE';
        this.currentCycle = null;
        this.cycleHistory = [];
        this.policy = {
            blockReleaseIfAnyBroken: true,
            minimumHealthScore: 95,
            maxBrokenFeaturesAllowed: 0,
            requireFullRegressionTest: true,
            sandboxTestRequired: true
        };
    }

    /**
     * Start monthly evolution cycle
     */
    async startMonthlyCycle() {
        console.log('🧬 ========================================');
        console.log('🧬 STARTING MONTHLY EVOLUTION CYCLE');
        console.log('🧬 ========================================');

        this.cycleStatus = 'RUNNING';
        this.currentCycle = {
            id: `EVO-${Date.now()}`,
            startedAt: new Date(),
            status: 'RUNNING',
            phases: [],
            stats: {
                featuresChecked: 0,
                featuresWorking: 0,
                featuresBroken: 0,
                featuresFixed: 0,
                improvementsGenerated: 0,
                improvementsApproved: 0,
                featuresReleased: 0,
                releaseBlocked: false,
                blockReason: null
            }
        };

        try {
            // ==========================================
            // PHASE 1: System Scan
            // ==========================================
            await this.runPhase('PHASE_1_SCAN', async () => {
                console.log('\n🔍 PHASE 1: Scanning all features...');
                
                const scanResult = await SystemScanner.scanAllFeatures();
                
                this.currentCycle.stats.featuresChecked = scanResult.total;
                this.currentCycle.stats.featuresWorking = scanResult.working;
                this.currentCycle.stats.featuresBroken = scanResult.broken;
                
                console.log(`   Total Features: ${scanResult.total}`);
                console.log(`   ✅ Working: ${scanResult.working}`);
                console.log(`   ❌ Broken: ${scanResult.broken}`);
                
                return scanResult;
            });

            // ==========================================
            // PHASE 2: Fix Broken Features
            // ==========================================
            if (this.currentCycle.stats.featuresBroken > 0) {
                await this.runPhase('PHASE_2_FIX', async () => {
                    console.log('\n🔧 PHASE 2: Fixing broken features...');
                    
                    const fixResult = await AutoFixer.fixAllBroken();
                    
                    this.currentCycle.stats.featuresFixed = fixResult.fixed;
                    
                    console.log(`   Fixed: ${fixResult.fixed}/${fixResult.total}`);
                    console.log(`   Still Broken: ${fixResult.remaining}`);
                    
                    return fixResult;
                });

                // Re-scan after fixes
                if (this.currentCycle.stats.featuresFixed > 0) {
                    const reScan = await SystemScanner.scanAllFeatures();
                    this.currentCycle.stats.featuresBroken = reScan.broken;
                    this.currentCycle.stats.featuresWorking = reScan.working;
                }
            }

            // ==========================================
            // PHASE 3: Quality Gate
            // ==========================================
            await this.runPhase('PHASE_3_QUALITY', async () => {
                console.log('\n✅ PHASE 3: Quality Gate verification...');
                
                const qualityResult = await QualityGate.verifyAll();
                
                if (!qualityResult.passed) {
                    this.currentCycle.stats.releaseBlocked = true;
                    this.currentCycle.stats.blockReason = qualityResult.reason;
                    
                    console.log(`   🚫 RELEASE BLOCKED: ${qualityResult.reason}`);
                    console.log(`   Failed Checks: ${qualityResult.failedChecks.join(', ')}`);
                    
                    throw new ReleaseBlockedError(qualityResult.reason);
                }
                
                console.log(`   ✅ All quality checks passed!`);
                return qualityResult;
            });

            // ==========================================
            // PHASE 4: Improvement Pipeline
            // ==========================================
            await this.runPhase('PHASE_4_IMPROVEMENTS', async () => {
                console.log('\n⚡ PHASE 4: Processing improvement pipeline...');
                console.log('   Scanning 100,000+ ideas...');
                
                const improvements = await ImprovementPipeline.process();
                
                this.currentCycle.stats.improvementsGenerated = improvements.total;
                this.currentCycle.stats.improvementsApproved = improvements.approved;
                
                console.log(`   Ideas Scanned: ${improvements.total}`);
                console.log(`   Shortlisted: ${improvements.shortlisted}`);
                console.log(`   Approved: ${improvements.approved}`);
                console.log(`   Rejected: ${improvements.rejected}`);
                
                return improvements;
            });

            // ==========================================
            // PHASE 5: Sandbox Testing
            // ==========================================
            if (this.currentCycle.stats.improvementsApproved > 0) {
                await this.runPhase('PHASE_5_SANDBOX', async () => {
                    console.log('\n🧪 PHASE 5: Sandbox testing new features...');
                    
                    const sandboxResult = await SandboxTester.testAll(
                        this.currentCycle.stats.improvementsApproved
                    );
                    
                    this.currentCycle.stats.featuresReleased = sandboxResult.passed;
                    
                    console.log(`   Tested: ${sandboxResult.total}`);
                    console.log(`   Passed: ${sandboxResult.passed}`);
                    console.log(`   Failed: ${sandboxResult.failed}`);
                    
                    return sandboxResult;
                });
            }

            // ==========================================
            // PHASE 6: Release
            // ==========================================
            await this.runPhase('PHASE_6_RELEASE', async () => {
                console.log('\n📦 PHASE 6: Preparing monthly release...');
                
                const release = await ReleaseManager.createRelease(this.currentCycle);
                
                console.log(`   Release Version: ${release.version}`);
                console.log(`   Features: ${release.features.length}`);
                console.log(`   Fixes: ${release.fixes.length}`);
                
                return release;
            });

            // ==========================================
            // CYCLE COMPLETE
            // ==========================================
            this.currentCycle.status = 'COMPLETED';
            this.currentCycle.completedAt = new Date();
            this.cycleHistory.push(this.currentCycle);
            this.cycleStatus = 'IDLE';

            await this.generateCycleReport();

            console.log('\n✅ ========================================');
            console.log('✅ EVOLUTION CYCLE COMPLETE');
            console.log('✅ ========================================');

            return this.currentCycle;

        } catch (error) {
            this.currentCycle.status = error instanceof ReleaseBlockedError ? 'BLOCKED' : 'FAILED';
            this.currentCycle.error = error.message;
            this.cycleHistory.push(this.currentCycle);
            this.cycleStatus = 'IDLE';

            console.error(`\n❌ Evolution cycle failed: ${error.message}`);
            
            await Activity.create({
                type: 'evolution.cycle',
                action: 'cycle_failed',
                description: `❌ Evolution cycle ${error instanceof ReleaseBlockedError ? 'blocked' : 'failed'}: ${error.message}`,
                metadata: this.currentCycle.stats
            });

            throw error;
        }
    }

    /**
     * Run a phase with timing
     */
    async runPhase(phaseName, fn) {
        const startTime = Date.now();
        
        try {
            const result = await fn();
            const duration = Date.now() - startTime;
            
            this.currentCycle.phases.push({
                name: phaseName,
                status: 'COMPLETED',
                duration: `${duration}ms`,
                result
            });

            return result;
        } catch (error) {
            this.currentCycle.phases.push({
                name: phaseName,
                status: 'FAILED',
                error: error.message
            });
            throw error;
        }
    }

    /**
     * Generate cycle report
     */
    async generateCycleReport() {
        const report = {
            cycleId: this.currentCycle.id,
            completedAt: this.currentCycle.completedAt,
            duration: this.currentCycle.completedAt - this.currentCycle.startedAt,
            stats: this.currentCycle.stats,
            summary: `
📊 Monthly Evolution Report
━━━━━━━━━━━━━━━━━━━━━━━━━━
✅ Features Checked: ${this.currentCycle.stats.featuresChecked}
✅ Working: ${this.currentCycle.stats.featuresWorking}
🔧 Broken: ${this.currentCycle.stats.featuresBroken}
🔧 Fixed: ${this.currentCycle.stats.featuresFixed}
⚡ Improvements: ${this.currentCycle.stats.improvementsApproved}
📦 Released: ${this.currentCycle.stats.featuresReleased}
${this.currentCycle.stats.releaseBlocked ? '🚫 RELEASE BLOCKED' : '✅ RELEASE SUCCESSFUL'}
            `
        };

        await Activity.create({
            type: 'evolution.cycle',
            action: 'cycle_completed',
            description: report.summary,
            metadata: report
        });

        console.log(report.summary);
        return report;
    }

    /**
     * Get evolution status
     */
    getStatus() {
        return {
            status: this.cycleStatus,
            currentCycle: this.currentCycle,
            history: this.cycleHistory.slice(-12), // Last 12 cycles
            policy: this.policy,
            nextScheduledCycle: this.getNextCycleDate()
        };
    }

    getNextCycleDate() {
        const now = new Date();
        return new Date(now.getFullYear(), now.getMonth() + 1, 1);
    }
}

class ReleaseBlockedError extends Error {
    constructor(reason) {
        super(`Release blocked: ${reason}`);
        this.name = 'ReleaseBlockedError';
    }
}

module.exports = new EvolutionOrchestrator();
