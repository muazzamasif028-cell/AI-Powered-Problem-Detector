        <!-- MODULE TOGGLE PANEL — 4 Pillars ON/OFF -->
        <div class="module-toggle-panel">
            <div class="module-toggle p1 active" id="toggle-p1" onclick="toggleModule('p1')" title="Click to toggle ON/OFF">
                <div class="module-icon">🧠</div>
                <div class="module-name">
                    <span class="module-status-indicator status-on" id="dot-p1"></span>COGNITION
                </div>
                <div style="font-size:6px;color:rgba(255,255,255,0.3);">o3/GPT-5 + Claude 5</div>
