<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechSolve Enterprise | Supreme + Azure</title>
    <style>
        :root {
            --company-primary: #1a1a2e;
            --company-secondary: #16213e;
            --company-accent: #0f3460;
            --company-gold: #e94560;
            --text-light: #eee;
            --chat-bg: #0d1117;
            --user-bubble: #238636;
            --bot-bubble: #21262d;
            --azure: #0078d4;
            --azure-glow: #00bcf2;
            --success: #00c853;
            --danger: #ff1744;
            --warning: #ff9800;
            --p1-color: #10a37f;
            --p2-color: #ff9800;
            --p3-color: #f0c040;
            --p4-color: #4285f4;
        }
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Segoe UI', sans-serif;
            background: var(--company-primary);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .main-container {
            width: 100%;
            max-width: 950px;
            height: 94vh;
            background: var(--company-secondary);
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 25px 60px rgba(0,0,0,0.5);
            overflow: hidden;
        }
        
        .company-header {
            background: linear-gradient(135deg, var(--company-accent), var(--company-gold));
            padding: 16px 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 2px solid rgba(255,255,255,0.1);
        }
        
        .company-logo {
            width: 40px; height: 40px;
            background: white;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px; font-weight: bold;
            color: var(--company-accent);
        }
        
        .company-info h2 { color: white; font-size: 1.1em; font-weight: 600; letter-spacing: 0.5px; }
        .company-info p { color: rgba(255,255,255,0.8); font-size: 0.7em; margin-top: 1px; }

        /* Azure Status */
        .azure-status {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 20px;
            background: linear-gradient(135deg, #001a33, #003366);
            border-bottom: 1px solid rgba(0,188,242,0.2);
            font-size: 9px;
            letter-spacing: 0.5px;
            flex-wrap: wrap;
        }
        .azure-dot { width: 5px; height: 5px; background: var(--success); border-radius: 50%; animation: pulse 2s infinite; }
        @keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }
        .azure-text { color: var(--azure-glow); font-weight: 600; }
        .azure-info { color: rgba(255,255,255,0.5); font-size: 8px; margin-left: auto; }

        /* ========== MODULE TOGGLE PANEL ========== */
        .module-toggle-panel {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1px;
            background: rgba(0,0,0,0.5);
            padding: 1px;
        }
        .module-toggle {
            padding: 10px 8px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            border-bottom: 3px solid transparent;
            position: relative;
            user-select: none;
        }
        .module-toggle.p1 { background: rgba(16,163,127,0.06); color: var(--p1-color); }
        .module-toggle.p2 { background: rgba(255,152,0,0.06); color: var(--p2-color); }
        .module-toggle.p3 { background: rgba(240,192,64,0.06); color: var(--p3-color); }
        .module-toggle.p4 { background: rgba(66,133,244,0.06); color: var(--p4-color); }
        .module-toggle.active { border-bottom-color: currentColor; filter: brightness(1.4); }
        .module-toggle.inactive { opacity: 0.3; filter: grayscale(0.8); border-bottom-color: transparent; }
        
        .module-icon { font-size: 16px; margin-bottom: 2px; }
        .module-name { font-size: 8px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
        .module-status-indicator {
            display: inline-block;
            width: 6px; height: 6px;
            border-radius: 50%;
            margin-right: 3px;
        }
        .status-on { background: var(--success); }
        .status-off { background: var(--danger); }

        /* Quick toggle all */
        .quick-toggle-bar {
            display: flex;
            gap: 6px;
            padding: 4px 16px;
            background: rgba(0,0,0,0.3);
            border-bottom: 1px solid rgba(255,255,255,0.04);
            align-items: center;
            flex-wrap: wrap;
        }
        .quick-btn {
            padding: 3px 10px;
            border-radius: 10px;
            font-size: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            border: 1px solid rgba(255,255,255,0.15);
            background: transparent;
            color: rgba(255,255,255,0.6);
            letter-spacing: 0.5px;
            white-space: nowrap;
        }
        .quick-btn:hover { border-color: rgba(255,255,255,0.4); color: white; }
        .quick-btn.all-on { border-color: var(--success); color: var(--success); }
        .quick-btn.all-on:hover { background: rgba(0,200,83,0.1); }
        .quick-btn.all-off { border-color: var(--danger); color: var(--danger); }
        .quick-btn.all-off:hover { background: rgba(255,23,68,0.1); }

        /* AI Model Selector */
        .provider-bar {
            display: flex;
            gap: 4px;
            padding: 6px 16px;
            background: rgba(0,0,0,0.3);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            flex-wrap: wrap;
            align-items: center;
        }
        .bar-label { font-size: 8px; color: rgba(255,255,255,0.4); letter-spacing: 1px; margin-right: 2px; }
        .chip {
            padding: 3px 9px;
            border-radius: 12px;
            font-size: 8px; font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            border: 1px solid rgba(255,255,255,0.1);
            background: transparent;
            color: rgba(255,255,255,0.5);
            white-space: nowrap;
        }
        .chip:hover { border-color: rgba(255,255,255,0.3); color: rgba(255,255,255,0.8); }
        .chip.active { background: var(--company-gold); color: white; border-color: var(--company-gold); }
        .divider { width: 1px; height: 14px; background: rgba(255,255,255,0.08); margin: 0 2px; }
        
        /* Chat */
        .chat-area {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            background: var(--chat-bg);
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .message { display: flex; animation: slideIn 0.3s ease; }
        @keyframes slideIn { from{opacity:0;transform:translateY(10px);} to{opacity:1;transform:translateY(0);} }
        .user-msg { justify-content: flex-end; }
        .bot-msg { justify-content: flex-start; }
        .bubble {
            max-width: 75%;
            padding: 12px 16px;
            border-radius: 16px;
            line-height: 1.5;
            font-size: 0.9em;
        }
        .user-bubble { background: var(--user-bubble); color: white; border-bottom-right-radius: 4px; margin-left: 40px; }
        .bot-bubble { background: var(--bot-bubble); color: var(--text-light); border-bottom-left-radius: 4px; margin-right: 40px; border: 1px solid rgba(255,255,255,0.08); }
        .tag-line { font-size: 8px; margin-bottom: 5px; display: flex; gap: 4px; flex-wrap: wrap; }
        .tag { padding: 2px 6px; border-radius: 6px; font-weight: 600; font-size: 7px; letter-spacing: 0.5px; }
        .tag-azure { background: rgba(0,120,212,0.3); color: var(--azure-glow); }
        .tag-p1 { background: rgba(16,163,127,0.2); color: var(--p1-color); }
        .tag-p2 { background: rgba(255,152,0,0.2); color: var(--p2-color); }
        .tag-p3 { background: rgba(240,192,64,0.2); color: var(--p3-color); }
        .tag-p4 { background: rgba(66,133,244,0.2); color: var(--p4-color); }
        .tag-model { background: rgba(233,69,96,0.2); color: var(--company-gold); }
        .tag-off { background: rgba(255,23,68,0.2); color: var(--danger); }

        .typing-indicator {
            display: flex; gap: 4px;
            padding: 12px 16px;
            background: var(--bot-bubble);
            border-radius: 16px;
            border-bottom-left-radius: 4px;
            width: fit-content;
        }
        .typing-dot { width: 7px; height: 7px; background: var(--company-gold); border-radius: 50%; animation: typing 1.4s infinite; }
        .typing-dot:nth-child(2) { animation-delay: 0.2s; }
        .typing-dot:nth-child(3) { animation-delay: 0.4s; }
        @keyframes typing { 0%,60%,100%{opacity:0.3;transform:scale(0.8);} 30%{opacity:1;transform:scale(1);} }
        
        .input-area {
            padding: 16px 20px;
            background: var(--company-secondary);
            border-top: 1px solid rgba(255,255,255,0.08);
            display: flex;
            gap: 10px;
        }
        .message-input {
            flex: 1;
            padding: 12px 18px;
            background: var(--chat-bg);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 22px;
            color: white;
            font-size: 0.9em;
            outline: none;
            transition: all 0.3s;
        }
        .message-input:focus { border-color: var(--company-gold); box-shadow: 0 0 0 3px rgba(233,69,96,0.1); }
        .send-btn {
            width: 44px; height: 44px;
            background: var(--company-gold);
            border: none;
            border-radius: 50%;
            cursor: pointer;
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            color: white;
        }
        .send-btn:hover { background: #ff6b81; transform: scale(1.05); box-shadow: 0 5px 20px rgba(233,69,96,0.4); }
        .chat-area::-webkit-scrollbar { width: 4px; }
        .chat-area::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 10px; }

        /* Active modules summary */
        .active-modules-summary {
            font-size: 8px;
            color: rgba(255,255,255,0.4);
            padding: 0 20px 4px;
            text-align: right;
            letter-spacing: 0.5px;
        }

        @media (max-width: 768px) {
            .module-toggle-panel { grid-template-columns: repeat(2, 1fr); }
            .provider-bar { gap: 2px; padding: 4px 10px; }
            .chip { font-size: 7px; padding: 2px 6px; }
            .bubble { max-width: 88%; }
        }
    </style>
</head>
<body>

    <div class="main-container">
        <!-- Header -->
        <div class="company-header">
            <div class="company-logo">⚡</div>
            <div class="company-info">
                <h2>TechSolve Enterprise</h2>
                <p>AI-Powered Problem Resolution · Azure Backend</p>
            </div>
        </div>

        <!-- Azure Status -->
        <div class="azure-status">
            <span class="azure-dot"></span>
            <span class="azure-text">☁️ AZURE CONNECTED</span>
            <span style="color:rgba(255,255,255,0.3);">|</span>
            <span style="color:rgba(255,255,255,0.6);font-size:8px;">60 Regions · HW TPM · Orbital · IoT Edge · Synapse</span>
            <span class="azure-info">Confidential Computing</span>
