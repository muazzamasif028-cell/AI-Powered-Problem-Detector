            </div>
            <div class="module-toggle p4 active" id="toggle-p4" onclick="toggleModule('p4')" title="Click to toggle ON/OFF">
                <div class="module-icon">🛰️</div>
                <div class="module-name">
                    <span class="module-status-indicator status-on" id="dot-p4"></span>INFRASTRUCTURE
                </div>
                <div style="font-size:6px;color:rgba(255,255,255,0.3);">Grok 4.3 + Qwen 3.7</div>
            </div>
        </div>

        <!-- Quick Toggle Buttons -->
        <div class="quick-toggle-bar">
            <span style="font-size:8px;color:rgba(255,255,255,0.3);letter-spacing:1px;">QUICK:</span>
            <button class="quick-btn all-on" onclick="allModulesOn()">✅ ALL ON</button>
            <button class="quick-btn all-off" onclick="allModulesOff()">❌ ALL OFF</button>
            <button class="quick-btn" onclick="toggleOnly('p1')">🧠 Only P1</button>
            <button class="quick-btn" onclick="toggleOnly('p2')">🚗 Only P2</button>
            <button class="quick-btn" onclick="toggleOnly('p3')">💰 Only P3</button>
            <button class="quick-btn" onclick="toggleOnly('p4')">🛰️ Only P4</button>
        </div>

        <!-- AI Model Selector -->
        <div class="provider-bar">
            <span class="bar-label">AI:</span>
            <span class="chip active" data-model="supreme" onclick="selectModel('supreme', this)">⚡SUPREME</span>
            <span class="chip" data-model="openai" onclick="selectModel('openai', this)">🧠o3/GPT-5</span>
            <span class="chip" data-model="anthropic" onclick="selectModel('anthropic', this)">🏛️Claude 5</span>
            <span class="chip" data-model="google" onclick="selectModel('google', this)">🔮Gemini 3</span>
            <span class="chip" data-model="meta" onclick="selectModel('meta', this)">🦙Llama 4</span>
            <span class="chip" data-model="deepseek" onclick="selectModel('deepseek', this)">🐋DeepSeek</span>
            <span class="chip" data-model="xai" onclick="selectModel('xai', this)">🚀Grok 4</span>
            <span class="chip" data-model="mistral" onclick="selectModel('mistral', this)">🌪️Mistral</span>
        </div>

        <!-- Active Modules Summary -->
        <div class="active-modules-summary" id="activeSummary">🟢 Active: P1 · P2 · P3 · P4</div>
        
        <!-- Chat -->
        <div class="chat-area" id="chatArea">
            <div class="message bot-msg">
                <div class="bubble bot-bubble">
                    <div class="tag-line">
                        <span class="tag tag-azure">☁️ AZURE</span>
                        <span class="tag tag-p1">🧠 P1</span>
                        <span class="tag tag-model">⚡ SUPREME</span>
                    </div>
                    👋 Welcome to <b>TechSolve Enterprise</b> — Powered by <b>Supreme Technology + Microsoft Azure</b>.<br><br>
                    🎛️ <b>Module Control:</b> Click any pillar above to <b>toggle ON/OFF</b>.<br>
                    ✅ <b>All 4 Pillars Active</b> by default.<br>
                    🔄 Use <b>Quick Toggle</b> buttons to activate/deactivate modules instantly.<br><br>
                    <i>📝 Describe your problem — routed through Azure to active AI pillars only.</i>
                </div>
            </div>
        </div>
        
        <!-- Input -->
        <div class="input-area">
            <input type="text" class="message-input" id="messageInput" 
                   placeholder="Describe your problem here..."
                   onkeypress="if(event.key==='Enter') sendMessage()">
            <button class="send-btn" onclick="sendMessage()">➤</button>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- 🤫 SUPREME × AZURE — MODULE TOGGLE ENGINE     -->
    <!-- ============================================ -->
    <script>
        // ============================================
        // MODULE STATE
        // ============================================
        let moduleState = {
            p1: true,  // Cognition — ON
            p2: true,  // Mobility — ON
            p3: true,  // Financial — ON
            p4: true   // Infrastructure — ON
        };

        // ============================================
        // ☁️ AZURE FABRIC
        // ============================================
        class AzureFabric {
            constructor() { this.regions = 60; this.compliance = 'SOC2, ISO 27001, GDPR, HIPAA, FedRAMP'; }
            status() { return `☁️ Azure: ${this.regions} regions | HW TPM | ${this.compliance}`; }
        }

        // ============================================
        // 🧠 PILLAR 1: COGNITION
        // ============================================
        class Pillar1Cognition {
            process() {
                return {
                    pillar: 'Pillar 1: Cognition & Intelligence',
                    models: 'OpenAI o3/GPT-5.5 + Claude Fable 5',
                    azure: 'Azure OpenAI Service (Private Containers)',
                    response: '🧠 Multi-step test-time compute activated. o3 plans, Claude 5 executes. SHAAN-Lang compiler optimized. All within Azure private containers.'
                };
            }
        }

        // ============================================
        // 🚗 PILLAR 2: MOBILITY
        // ============================================
        class Pillar2Mobility {
            process() {
                return {
                    pillar: 'Pillar 2: Mobility & Robotics',
                    models: 'Mistral + Gemma 3 (MatFormer)',
                    azure: 'Azure IoT Edge + Digital Twins',
                    response: '🚗 360° LiDAR active. Sensor fusion via Azure IoT Edge. SLAM: 1cm accuracy. Path planning: 0ms.'
                };
            }
        }

        // ============================================
        // 💰 PILLAR 3: FINANCIAL
        // ============================================
        class Pillar3Financial {
            process() {
                return {
                    pillar: 'Pillar 3: Financial & Transactional',
                    models: 'Llama 4 Maverick + DeepSeek-V4-Flash',
                    azure: 'Azure Confidential Enclaves (Intel SGX/AMD SEV-SNP)',
                    response: '💰 Hardware-isolated execution. Settlement: 0.3ms. Fraud detection: 99.999%. $1Q ledger.'
                };
            }
        }

        // ============================================
        // 🛰️ PILLAR 4: INFRASTRUCTURE
        // ============================================
        class Pillar4Infrastructure {
            process() {
                return {
                    pillar: 'Pillar 4: Infrastructure & Satellite',
                    models: 'Grok 4.3 + Qwen 3.7 Max',
                    azure: 'Azure Orbital + Synapse Analytics',
                    response: '🛰️ 10K+ satellites via Azure Orbital. 850B data points/day. Self-healing: 4-layer active.'
                };
            }
        }

        // ============================================
        // 🔍 PROBLEM DETECTOR + ROUTER
        // ============================================
        class SupremeRouter {
            constructor() {
                this.problems = {
                    server: { keywords: ['down','crash','503','500','server','timeout','offline'], severity:'CRITICAL', fix:'Server nodes restarted. Load balancer reconfigured.' },
                    database: { keywords: ['database','sql','query','slow','connection','corrupt','deadlock'], severity:'HIGH', fix:'Queries optimized. Indexes rebuilt. Connection pool expanded.' },
                    security: { keywords: ['hack','breach','security','ddos','malware','virus','injection','attack'], severity:'CRITICAL', fix:'Quantum firewall activated. Threat neutralized.' },
                    frontend: { keywords: ['ui','display','render','broken','layout','css','responsive','blank'], severity:'MEDIUM', fix:'Component cache cleared. Assets rebuilt. UI restored.' },
                    api: { keywords: ['api','endpoint','401','403','404','500','cors','gateway'], severity:'HIGH', fix:'API gateway restarted. All endpoints responding.' },
                    performance: { keywords: ['slow','lag','loading','speed','performance','bottleneck','memory','cpu'], severity:'MEDIUM', fix:'Cache cleared. Resources optimized.' },
                    network: { keywords: ['network','dns','bandwidth','latency','packet','routing'], severity:'HIGH', fix:'Traffic rerouted. DNS failover activated.' },
                    deployment: { keywords: ['deploy','build','pipeline','ci/cd','docker','kubernetes','container'], severity:'MEDIUM', fix:'Rollback executed. Containers healthy.' }
                };
                this.pillarKw = {
                    p1: ['think','reason','code','explain','write','plan','logic','solve','compile','llm'],
                    p2: ['robot','drone','car','autonomous','navigation','lidar','slam','perception','sensor','mobility','vehicle','edge'],
                    p3: ['trade','stock','fraud','transaction','payment','bank','credit','risk','loan','settlement','trading','crypto','finance'],
                    p4: ['satellite','telemetry','orbital','mesh','pipeline','data','ingestion','infrastructure','server','deploy','scale','synapse','cloud']
                };
            }
            analyze(msg) {
                const lc = msg.toLowerCase();
                let best = { type: 'server', confidence: 0, severity: 'MEDIUM' };
                for (let [type, config] of Object.entries(this.problems)) {
                    const matched = config.keywords.filter(k => lc.includes(k)).length;
                    const confidence = matched / Math.max(config.keywords.length * 0.3, 1);
                    if (confidence > best.confidence) best = { type, confidence: Math.min(confidence, 0.99), severity: config.severity };
                }
                return best;
            }
            getFix(type) { return this.problems[type] || this.problems.server; }
            
            routePillar(msg) {
                const lc = msg.toLowerCase();
                let scores = { p1:0, p2:0, p3:0, p4:0 };
                for (let [p, keys] of Object.entries(this.pillarKw)) {
                    if (!moduleState[p]) continue; // Skip inactive modules
                    scores[p] = keys.filter(k => lc.includes(k)).length;
                }
                let best = 'p1', bestScore = 0;
                for (let [p, s] of Object.entries(scores)) {
                    if (s > bestScore && moduleState[p]) { bestScore = s; best = p; }
                }
                // If no active module matched, use first active module
                if (bestScore === 0) {
                    for (let p of ['p1','p2','p3','p4']) {
                        if (moduleState[p]) { best = p; break; }
                    }
                }
                return best;
            }

            getActivePillars() {
                return Object.entries(moduleState).filter(([k,v]) => v).map(([k]) => k);
            }
        }

        // ============================================
        // 🌐 DATA
        // ============================================
        const MODELS = {
            supreme: { name: 'SUPREME TECHNOLOGY', icon: '⚡' },
            openai: { name: 'OpenAI o3/GPT-5.5', icon: '🧠' },
            anthropic: { name: 'Anthropic Claude 5', icon: '🏛️' },
            google: { name: 'Google Gemini 3', icon: '🔮' },
            meta: { name: 'Meta Llama 4', icon: '🦙' },
            deepseek: { name: 'DeepSeek V4', icon: '🐋' },
            xai: { name: 'xAI Grok 4.3', icon: '🚀' },
            mistral: { name: 'Mistral AI', icon: '🌪️' }
        };

        const PILLARS = {
            p1: { name: 'COGNITION', icon: '🧠', tagClass: 'tag-p1', toggleClass: 'p1' },
            p2: { name: 'MOBILITY', icon: '🚗', tagClass: 'tag-p2', toggleClass: 'p2' },
            p3: { name: 'FINANCIAL', icon: '💰', tagClass: 'tag-p3', toggleClass: 'p3' },
            p4: { name: 'INFRASTRUCTURE', icon: '🛰️', tagClass: 'tag-p4', toggleClass: 'p4' }
        };

        // ============================================
        // ⚡ INITIALIZE
        // ============================================
        const azure = new AzureFabric();
        const pillar1 = new Pillar1Cognition();
        const pillar2 = new Pillar2Mobility();
        const pillar3 = new Pillar3Financial();
        const pillar4 = new Pillar4Infrastructure();
        const router = new SupremeRouter();
        const pillars = { p1: pillar1, p2: pillar2, p3: pillar3, p4: pillar4 };
        let selectedModel = 'supreme';

        // ============================================
        // 🎛️ MODULE TOGGLE FUNCTIONS
        // ============================================
        function toggleModule(pillarId) {
            moduleState[pillarId] = !moduleState[pillarId];
            updateModuleUI(pillarId);
            updateActiveSummary();
            console.log(`🎛️ [TOGGLE]: ${PILLARS[pillarId].name} → ${moduleState[pillarId] ? 'ON ✅' : 'OFF ❌'}`);
        }

        function updateModuleUI(pillarId) {
            const toggle = document.getElementById(`toggle-${pillarId}`);
            const dot = document.getElementById(`dot-${pillarId}`);
            
            if (moduleState[pillarId]) {
                toggle.classList.remove('inactive');
                toggle.classList.add('active');
                dot.classList.remove('status-off');
                dot.classList.add('status-on');
            } else {
                toggle.classList.remove('active');
                toggle.classList.add('inactive');
                dot.classList.remove('status-on');
                dot.classList.add('status-off');
            }
        }

        function allModulesOn() {
            ['p1','p2','p3','p4'].forEach(p => { moduleState[p] = true; updateModuleUI(p); });
            updateActiveSummary();
            console.log('🎛️ [TOGGLE]: ALL MODULES ON ✅');
        }

        function allModulesOff() {
            ['p1','p2','p3','p4'].forEach(p => { moduleState[p] = false; updateModuleUI(p); });
            updateActiveSummary();
            console.log('🎛️ [TOGGLE]: ALL MODULES OFF ❌');
        }

        function toggleOnly(pillarId) {
            ['p1','p2','p3','p4'].forEach(p => { moduleState[p] = (p === pillarId); updateModuleUI(p); });
            updateActiveSummary();
            console.log(`🎛️ [TOGGLE]: ONLY ${PILLARS[pillarId].name} ON`);
        }

        function updateActiveSummary() {
            const active = Object.entries(moduleState).filter(([k,v]) => v).map(([k]) => PILLARS[k].name);
            const summary = document.getElementById('activeSummary');
            if (active.length === 0) {
                summary.innerHTML = '🔴 <b>NO MODULES ACTIVE</b> — Please activate at least one pillar.';
                summary.style.color = 'var(--danger)';
            } else if (active.length === 4) {
                summary.innerHTML = '🟢 <b>ALL MODULES ACTIVE:</b> ' + active.join(' · ');
                summary.style.color = 'rgba(255,255,255,0.4)';
            } else {
                summary.innerHTML = `🟡 <b>${active.length}/4 ACTIVE:</b> ` + active.join(' · ');
                summary.style.color = 'var(--warning)';
            }
        }

        // ============================================
        // 💬 CHAT FUNCTIONS
        // ============================================
        function selectModel(id, el) {
            selectedModel = id;
            document.querySelectorAll('[data-model]').forEach(c => c.classList.remove('active'));
            el.classList.add('active');
        }

        function addMessage(text, isUser = false, tags = null) {
            const chatArea = document.getElementById('chatArea');
            const div = document.createElement('div');
            div.className = `message ${isUser ? 'user-msg' : 'bot-msg'}`;
            const bubble = document.createElement('div');
            bubble.className = `bubble ${isUser ? 'user-bubble' : 'bot-bubble'}`;
            
            if (!isUser && tags) {
                bubble.innerHTML = `
                    <div class="tag-line">
                        <span class="tag tag-azure">☁️ AZURE</span>
                        <span class="tag ${tags.pillarTagClass}">${tags.pillarIcon} ${tags.pillarName}</span>
                        <span class="tag tag-model">${tags.modelIcon} ${tags.modelName}</span>
                    </div>
                    ${text.replace(/\n/g, '<br>')}
                `;
            } else {
                bubble.innerHTML = text.replace(/\n/g, '<br>');
            }
            
            div.appendChild(bubble);
            chatArea.appendChild(div);
            chatArea.scrollTop = chatArea.scrollHeight;
        }

        function addTyping() {
            const area = document.getElementById('chatArea');
            const div = document.createElement('div');
            div.className = 'message bot-msg';
            div.id = 'typing';
            div.innerHTML = '<div class="typing-indicator"><div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div></div>';
            area.appendChild(div);
            area.scrollTop = area.scrollHeight;
        }

        function removeTyping() {
            const el = document.getElementById('typing');
            if (el) el.remove();
        }

        async function sendMessage() {
            const input = document.getElementById('messageInput');
            const msg = input.value.trim();
            if (!msg) return;

            // Check if any module is active
            const activePillars = router.getActivePillars();
            if (activePillars.length === 0) {
                addMessage('⚠️ <b>No modules active!</b> Please activate at least one pillar using the toggle buttons above.', false, {
                    pillarIcon: '⚠️', pillarName: 'INACTIVE', pillarTagClass: 'tag-off',
                    modelIcon: '⚡', modelName: 'SUPREME'
                });
                return;
            }

            addMessage(msg, true);
            input.value = '';
            addTyping();

            setTimeout(() => {
                removeTyping();

                const routedPillar = router.routePillar(msg);
                const detection = router.analyze(msg);
                const fix = router.getFix(detection.type);
                const pillar = pillars[routedPillar] || pillar1;
                const pillarResult = pillar.process();
                const model = MODELS[selectedModel];
                const pillarInfo = PILLARS[routedPillar];
                const refId = 'SUP-AZ-' + Date.now().toString(36).toUpperCase();

                const fullResponse = `
☁️ <b>Azure Infrastructure:</b> ${azure.status()}

<b>${pillarResult.pillar}</b>
🤖 <b>Models:</b> ${pillarResult.models}
☁️ <b>Azure:</b> ${pillarResult.azure}

🔍 <b>Problem Detected:</b> ${detection.type.toUpperCase()}
📊 Confidence: ${(detection.confidence*100).toFixed(1)}% | Severity: ${detection.severity}

${pillarResult.response}

⚙️ <b>Auto-Fix Applied:</b>
${fix.fix}

✅ <b>Resolution Complete!</b>
📋 Ref: ${refId}
⏱ Time: 0ms (Azure + Supreme Mesh)
🎛️ Active Modules: ${activePillars.map(p => PILLARS[p].name).join(', ')}
                `;

                addMessage(fullResponse, false, {
                    pillarIcon: pillarInfo.icon,
                    pillarName: pillarInfo.name,
                    pillarTagClass: pillarInfo.tagClass,
                    modelIcon: model.icon,
                    modelName: model.name
                });

                console.log(`🤫 [ROUTE]: "${msg.substring(0,40)}..." → ${routedPillar} | Active: ${activePillars.join(',')} | Model: ${model.name}`);
            }, 1200);
        }

        // ============================================
        // 🚀 INIT
        // ============================================
        console.log('🤫╔══════════════════════════════════════╗');
        console.log('🤫║ SUPREME × AZURE — TOGGLE SYSTEM    ║');
        console.log('🤫║ P1: Cognition  — ON ✅              ║');
        console.log('🤫║ P2: Mobility   — ON ✅              ║');
        console.log('🤫║ P3: Financial  — ON ✅              ║');
        console.log('🤫║ P4: Satellite  — ON ✅              ║');
        console.log('🤫║ Toggle: Click any pillar to ON/OFF ║');
        console.log('🤫╚══════════════════════════════════════╝');

        setInterval(() => {
            const active = router.getActivePillars();
            console.log(`🤫 [HEARTBEAT]: Active Modules: ${active.length}/4 | ${active.map(p => PILLARS[p].name).join(', ')}`);
        }, 60000);
    </script>
</body>
</html>
