            <div class="module-toggle p2 active" id="toggle-p2" onclick="toggleModule('p2')" title="Click to toggle ON/OFF">
                <div class="module-icon">🚗</div>
                <div class="module-name">
                    <span class="module-status-indicator status-on" id="dot-p2"></span>MOBILITY
                </div>
                <div style="font-size:6px;color:rgba(255,255,255,0.3);">Mistral + Gemma 3</div>
            </div>
            <div class="module-toggle p3 active" id="toggle-p3" onclick="toggleModule('p3')" title="Click to toggle ON/OFF">
                <div class="module-icon">💰</div>
                <div class="module-name">
                    <span class="module-status-indicator status-on" id="dot-p3"></span>FINANCIAL
                </div>
