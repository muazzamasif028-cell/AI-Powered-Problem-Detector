// 🧬 agents/AgentRegistry.js
// SUPREME Agent Registry — Manages 2M+ Agents
// Distributed, Sharded, Horizontally Scalable
// ============================================================
const crypto = require('crypto');
const EventEmitter = require('events');

class AgentRegistry extends EventEmitter {
    constructor() {
        super();
        
        // Distributed registry shards (256 shards)
        this.shards = new Map();
        this.shardCount = 256;
        
        // Agent categories
        this.categories = new Map();
        
        // Metadata indexes
        this.indexes = {
            byCategory: new Map(),
            byCapability: new Map(),
            byStatus: new Map(),
            byVersion: new Map(),
            byAuthor: new Map(),
            byPopularity: new Map(),
            byPerformance: new Map()
        };
        
        // Stats
        this.stats = {
            totalAgents: 0,
            activeAgents: 0,
            totalExecutions: 0,
            averageLatency: 0
        };
        
        // Initialize shards
        this.initializeShards();
    }

    /**
     * Initialize distributed shards
     */
    initializeShards() {
        for (let i = 0; i < this.shardCount; i++) {
            this.shards.set(i, {
                id: i,
                agents: new Map(), // Local agent storage
                load: 0,
                maxAgents: 8000, // ~8000 agents per shard = 2M total
                status: 'ACTIVE',
                lastHeartbeat: Date.now()
            });
        }
    }

    /**
     * Register a new agent
     */
    async registerAgent(agentConfig) {
        const agentId = this.generateAgentId(agentConfig);
        const shardId = this.getShardId(agentId);
        
        const agent = {
            agentId,
            shardId,
            name: agentConfig.name,
            category: agentConfig.category,
            version: agentConfig.version || '1.0.0',
            status: 'REGISTERED',
            capabilities: agentConfig.capabilities || [],
            dependencies: agentConfig.dependencies || [],
            requirements: {
                cpu: agentConfig.cpu || '100m',
                memory: agentConfig.memory || '128Mi',
                gpu: agentConfig.gpu || false,
                timeout: agentConfig.timeout || 30000
            },
            metadata: {
                author: agentConfig.author,
                description: agentConfig.description,
                tags: agentConfig.tags || [],
                price: agentConfig.price || 0,
                rating: 0,
                executions: 0,
                successRate: 100
            },
            runtime: {
                container: agentConfig.container,
                entrypoint: agentConfig.entrypoint,
                environment: agentConfig.environment || {},
                resources: agentConfig.resources || {}
            },
            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString()
        };
        
        // Store in shard
        const shard = this.shards.get(shardId);
        shard.agents.set(agentId, agent);
        shard.load++;
        
        // Update indexes
        this.updateIndexes(agent, 'ADD');
        
        this.stats.totalAgents++;
        
        this.emit('agent:registered', { agentId, category: agent.category });
        
        return agent;
    }

    /**
     * Get shard ID for agent
     */
    getShardId(agentId) {
        const hash = crypto.createHash('sha256').update(agentId).digest('hex');
        return parseInt(hash.slice(0, 8), 16) % this.shardCount;
    }

    /**
     * Generate unique agent ID
     */
    generateAgentId(config) {
        const prefix = config.category?.slice(0, 4).toUpperCase() || 'AGNT';
        const timestamp = Date.now().toString(36);
        const random = crypto.randomBytes(4).toString('hex');
        return `${prefix}_${timestamp}_${random}`;
    }

    /**
     * Update distributed indexes
     */
    updateIndexes(agent, operation) {
        const { agentId, category, capabilities, status, version, metadata } = agent;
        
        if (operation === 'ADD') {
            this.addToIndex('byCategory', category, agentId);
            capabilities.forEach(cap => this.addToIndex('byCapability', cap, agentId));
            this.addToIndex('byStatus', status, agentId);
            this.addToIndex('byVersion', version, agentId);
            this.addToIndex('byAuthor', metadata.author, agentId);
        } else {
            this.removeFromIndex('byCategory', category, agentId);
            capabilities.forEach(cap => this.removeFromIndex('byCapability', cap, agentId));
            this.removeFromIndex('byStatus', status, agentId);
        }
    }

    /**
     * Add to index
     */
    addToIndex(indexName, key, agentId) {
        if (!this.indexes[indexName].has(key)) {
            this.indexes[indexName].set(key, new Set());
        }
        this.indexes[indexName].get(key).add(agentId);
    }

    /**
     * Remove from index
     */
    removeFromIndex(indexName, key, agentId) {
        const index = this.indexes[indexName].get(key);
        if (index) {
            index.delete(agentId);
            if (index.size === 0) {
                this.indexes[indexName].delete(key);
            }
        }
    }

    /**
     * Query agents by criteria
     */
    queryAgents(criteria) {
        const {
            category,
            capability,
            status,
            version,
            author,
            limit = 100,
            offset = 0
        } = criteria;

        let resultSet = null;

        // Get initial set from most specific index
        if (category) {
            resultSet = this.indexes.byCategory.get(category);
        } else if (capability) {
            resultSet = this.indexes.byCapability.get(capability);
        } else if (status) {
            resultSet = this.indexes.byStatus.get(status);
        } else {
            // Full scan (expensive, use with pagination)
            return this.getAllAgentsPaginated(limit, offset);
        }

        if (!resultSet) return [];

        // Convert to array and paginate
        const agentIds = Array.from(resultSet).slice(offset, offset + limit);
        
        // Fetch agents from shards
        return agentIds
            .map(id => this.getAgent(id))
            .filter(Boolean);
    }

    /**
     * Get agent by ID
     */
    getAgent(agentId) {
        const shardId = this.getShardId(agentId);
        const shard = this.shards.get(shardId);
        return shard?.agents.get(agentId) || null;
    }

    /**
     * Get all agents with pagination
     */
    getAllAgentsPaginated(limit, offset) {
        const agents = [];
        
        for (const [shardId, shard] of this.shards) {
            for (const [agentId, agent] of shard.agents) {
                if (agents.length >= offset + limit) break;
                if (agents.length >= offset) {
                    agents.push(agent);
                } else {
                    // Still in offset range
                    agents.push(null); // Placeholder for counting
                }
            }
        }
        
        return agents.filter(Boolean);
    }

    /**
     * Get registry stats
     */
    getStats() {
        const shardStats = [];
        let totalLoad = 0;
        
        for (const [id, shard] of this.shards) {
            shardStats.push({
                shardId: id,
                agentCount: shard.agents.size,
                load: shard.load,
                maxCapacity: shard.maxAgents,
                utilizationPercent: (shard.agents.size / shard.maxAgents * 100).toFixed(2),
                status: shard.status
            });
            totalLoad += shard.agents.size;
        }

        return {
            ...this.stats,
            totalAgents: totalLoad,
            shardCount: this.shardCount,
            averageShardLoad: totalLoad / this.shardCount,
            indexCounts: Object.fromEntries(
                Object.entries(this.indexes).map(([name, index]) => [name, index.size])
            )
        };
    }
}

module.exports = AgentRegistry;
