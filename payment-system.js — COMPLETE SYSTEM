    // =============================================
    async handleSubscription(transaction, paymentData) {
        const subscriptionId = 'SUB-' + Date.now().toString(36) + '-' + 
                              Math.random().toString(36).substr(2, 6).toUpperCase();

        const plan = this.pricingPlans[paymentData.plan] || this.pricingPlans.STARTER;
        
        const subscription = {
            id: subscriptionId,
            companyId: paymentData.companyId,
            companyName: paymentData.companyName,
            plan: paymentData.plan,
            planName: plan.name,
            tier: plan.tier,
            
            billing: {
                cycle: paymentData.billingCycle || 'MONTHLY',
                amount: plan.pricing.monthly,
                annualAmount: plan.pricing.annual,
                currency: paymentData.currency || 'USD',
                nextBillingDate: this.calculateNextBillingDate(paymentData.billingCycle),
                autoRenew: true
            },

            features: plan.features,
            
            status: 'ACTIVE',
            trialEnds: plan.trialDays > 0 ? 
                new Date(Date.now() + plan.trialDays * 24 * 60 * 60 * 1000).toISOString() : null,
            
            paymentMethod: {
                id: transaction.payment.providerId,
                type: transaction.payment.method,
                last4: transaction.payment.last4
            },

            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString(),
            
            history: [{
                event: 'CREATED',
                transactionId: transaction.id,
                timestamp: new Date().toISOString()
            }]
        };

        this.subscriptions.set(subscriptionId, subscription);
        this.state.activeSubscriptions++;

        this.subscriptionEvents.push({
            type: 'SUBSCRIPTION_CREATED',
            subscriptionId,
            companyId: paymentData.companyId,
            plan: paymentData.plan,
            timestamp: new Date().toISOString()
        });

        return subscription;
    }

    // =============================================
    // PROCESS REFUND
    // =============================================
    async processRefund(transactionId, reason = '', amount = null) {
        const transaction = this.transactions.find(t => t.id === transactionId);
        if (!transaction) {
            return { success: false, error: 'Transaction not found' };
        }

        const refundId = 'REF-' + Date.now().toString(36) + '-' + 
                        Math.random().toString(36).substr(2, 6).toUpperCase();

        const refundAmount = amount || transaction.amount.total;

        const refund = {
            id: refundId,
            transactionId,
            originalAmount: transaction.amount.total,
            refundAmount,
            reason,
            status: 'COMPLETED',
            provider: transaction.payment.provider,
            createdAt: new Date().toISOString()
        };

        transaction.status = 'REFUNDED';
        transaction.refund = refund;
        transaction.updatedAt = new Date().toISOString();

        this.state.refundedAmount += refundAmount;

        return {
            success: true,
            refund,
            transaction
        };
    }

    // =============================================
    // CANCEL SUBSCRIPTION
    // =============================================
    cancelSubscription(subscriptionId, reason = '') {
        const subscription = this.subscriptions.get(subscriptionId);
        if (!subscription) {
            return { success: false, error: 'Subscription not found' };
        }

        subscription.status = 'CANCELLED';
        subscription.cancelledAt = new Date().toISOString();
        subscription.cancelReason = reason;
        subscription.billing.autoRenew = false;

        this.state.activeSubscriptions--;

        this.subscriptionEvents.push({
            type: 'SUBSCRIPTION_CANCELLED',
            subscriptionId,
            reason,
            timestamp: new Date().toISOString()
        });

        return {
            success: true,
            subscription,
            effectiveUntil: subscription.billing.nextBillingDate
        };
    }

