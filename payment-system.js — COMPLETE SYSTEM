    // =============================================
    // SYSTEM STATUS
    // =============================================
    getStatus() {
        return {
            initialized: this.state.initialized,
            providers: Object.keys(this.providers).length,
            plans: Object.keys(this.pricingPlans).length,
            activeSubscriptions: this.state.activeSubscriptions,
            totalRevenue: '$' + this.state.totalRevenue.toLocaleString(),
            transactions: this.state.totalTransactions
        };
    }

    reset() {
        this.transactions = [];
        this.subscriptions.clear();
        this.subscriptionEvents = [];
        this.state.totalTransactions = 0;
        this.state.totalRevenue = 0;
        this.state.activeSubscriptions = 0;
        this.state.failedPayments = 0;
        this.state.refundedAmount = 0;
        this.initializeCoupons();
        return { status: 'RESET' };
    }
}

