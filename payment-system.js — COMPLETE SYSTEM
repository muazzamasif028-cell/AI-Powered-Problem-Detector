        const subscription = this.subscriptions.get(subscriptionId);
        if (!subscription) {
            return { success: false, error: 'Subscription not found' };
        }

        const plan = this.pricingPlans[newPlan];
        if (!plan) {
            return { success: false, error: 'Invalid plan' };
        }

        const oldPlan = subscription.plan;
        
        // Calculate prorated amount
        const daysRemaining = Math.ceil(
            (new Date(subscription.billing.nextBillingDate) - new Date()) / (1000 * 60 * 60 * 24)
        );
        const oldDailyRate = subscription.billing.amount / 30;
        const newDailyRate = plan.pricing.monthly / 30;
        const proratedCharge = (newDailyRate - oldDailyRate) * daysRemaining;

        // Process prorated payment if needed
        if (proratedCharge > 0) {
            await this.processPayment({
                amount: proratedCharge,
                currency: subscription.billing.currency,
                method: subscription.paymentMethod.type,
                companyId: subscription.companyId,
                plan: newPlan,
                metadata: { type: 'UPGRADE_PRORATION', oldPlan, newPlan }
            });
        }

        // Update subscription
        subscription.plan = newPlan;
        subscription.planName = plan.name;
        subscription.tier = plan.tier;
        subscription.billing.amount = plan.pricing.monthly;
        subscription.billing.annualAmount = plan.pricing.annual;
        subscription.features = plan.features;
        subscription.updatedAt = new Date().toISOString();

        subscription.history.push({
            event: 'UPGRADED',
            oldPlan,
            newPlan,
            proratedCharge,
            timestamp: new Date().toISOString()
        });

        return {
            success: true,
            subscription,
            upgrade: {
                from: oldPlan,
                to: newPlan,
                proratedCharge
            }
        };
    }

    // =============================================
    // UTILITY FUNCTIONS
    // =============================================
    calculateNextBillingDate(cycle) {
        const next = new Date();
        switch (cycle) {
            case 'MONTHLY': next.setMonth(next.getMonth() + 1); break;
            case 'QUARTERLY': next.setMonth(next.getMonth() + 3); break;
            case 'ANNUAL': next.setFullYear(next.getFullYear() + 1); break;
            default: next.setMonth(next.getMonth() + 1);
        }
        return next.toISOString();
    }

    // =============================================
    // GET PAYMENT DASHBOARD
    // =============================================
    getPaymentDashboard() {
        const now = Date.now();
        const thisMonth = this.transactions.filter(t => {
            const date = new Date(t.createdAt);
            return date.getMonth() === new Date().getMonth() && 
                   date.getFullYear() === new Date().getFullYear();
        });

        return {
            summary: {
                totalTransactions: this.state.totalTransactions,
                totalRevenue: '$' + this.state.totalRevenue.toLocaleString(),
                activeSubscriptions: this.state.activeSubscriptions,
                failedPayments: this.state.failedPayments,
                refundedAmount: '$' + this.state.refundedAmount.toLocaleString(),
                averageTransaction: '$' + this.state.averageTransactionValue.toLocaleString()
            },
            thisMonth: {
                transactions: thisMonth.length,
                revenue: '$' + thisMonth.reduce((sum, t) => sum + t.amount.total, 0).toLocaleString(),
                newSubscriptions: this.subscriptionEvents.filter(e => 
                    e.type === 'SUBSCRIPTION_CREATED' && 
                    new Date(e.timestamp).getMonth() === new Date().getMonth()
                ).length
            },
            byProvider: {
                STRIPE: this.transactions.filter(t => t.payment.provider === 'Stripe').length,
                PAYPAL: this.transactions.filter(t => t.payment.provider === 'PayPal').length,
                CRYPTO: this.transactions.filter(t => t.payment.provider === 'Cryptocurrency').length,
                BANK: this.transactions.filter(t => t.payment.provider === 'Bank Transfer / Wire').length
            },
            byPlan: {
                STARTER: Array.from(this.subscriptions.values()).filter(s => s.plan === 'STARTER').length,
                GROWING: Array.from(this.subscriptions.values()).filter(s => s.plan === 'GROWING').length,
                BUSINESS: Array.from(this.subscriptions.values()).filter(s => s.plan === 'BUSINESS').length,
                ENTERPRISE: Array.from(this.subscriptions.values()).filter(s => s.plan === 'ENTERPRISE').length,
                GLOBAL: Array.from(this.subscriptions.values()).filter(s => s.plan === 'GLOBAL').length
            },
            recentTransactions: this.transactions.slice(-10).reverse()
        };
    }

