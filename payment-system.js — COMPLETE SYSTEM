    // =============================================
    // 💳 PROCESS PAYMENT — MAIN ENTRY POINT
    // =============================================
    async processPayment(paymentData, context = {}) {
        const paymentId = 'PAY-' + Date.now().toString(36) + '-' + 
                         Math.random().toString(36).substr(2, 8).toUpperCase();
        
        const startTime = performance.now();

        console.log(`💳 [PAYMENT]: ${paymentId} — Processing ${paymentData.amount} ${paymentData.currency}`);

        try {
            // Step 1: Validate payment data
            const validation = this.validatePayment(paymentData);
            if (!validation.valid) {
                return { paymentId, status: 'FAILED', error: validation.error };
            }

            // Step 2: Apply coupon if present
            let discount = 0;
            if (paymentData.couponCode) {
                const couponResult = this.applyCoupon(paymentData.couponCode, paymentData.plan);
                if (couponResult.valid) {
                    discount = couponResult.discount;
                    paymentData.amount -= discount;
                }
            }

            // Step 3: Calculate tax
            const taxResult = this.calculateTax(paymentData.amount, paymentData.country, paymentData.currency);
            const totalAmount = paymentData.amount + taxResult.taxAmount;

            // Step 4: Select provider
            const provider = this.selectProvider(paymentData.method);

            // Step 5: Process with provider
            const providerResult = await this.processWithProvider(provider, paymentData, totalAmount);

            // Step 6: Create transaction record
            const transaction = this.createTransaction(paymentId, paymentData, totalAmount, taxResult, discount, providerResult);

            // Step 7: Generate invoice
            const invoice = this.generateInvoice(transaction);

            // Step 8: Handle subscription if applicable
            if (paymentData.subscription) {
                await this.handleSubscription(transaction, paymentData);
            }

            // Update state
            this.state.totalTransactions++;
            this.state.totalRevenue += totalAmount;
            this.state.averageTransactionValue = this.state.totalRevenue / this.state.totalTransactions;

            const processingTime = (performance.now() - startTime).toFixed(2);

            console.log(`💳 [PAYMENT]: ${paymentId} — ${providerResult.success ? 'SUCCESS' : 'FAILED'} (${processingTime}ms)`);

            return {
                paymentId,
                status: providerResult.success ? 'COMPLETED' : 'FAILED',
                transaction,
                invoice,
                provider: provider.name,
                amount: totalAmount,
                currency: paymentData.currency,
                discount,
                tax: taxResult.taxAmount,
                processingTime_ms: processingTime,
                timestamp: new Date().toISOString()
            };

        } catch (error) {
            console.error(`💳 [PAYMENT]: ${paymentId} — Error: ${error.message}`);
            return { paymentId, status: 'ERROR', error: error.message };
        }
    }

    // =============================================
    // VALIDATE PAYMENT
    // =============================================
    validatePayment(paymentData) {
        if (!paymentData.amount || paymentData.amount <= 0) {
            return { valid: false, error: 'Invalid amount' };
        }

        if (!paymentData.currency) {
            return { valid: false, error: 'Currency required' };
        }

        if (!paymentData.method) {
            return { valid: false, error: 'Payment method required' };
        }

        if (paymentData.method === 'CARD') {
            if (!paymentData.cardNumber || !paymentData.expiry || !paymentData.cvv) {
                return { valid: false, error: 'Card details incomplete' };
            }
        }

        if (paymentData.amount > 1000000) {
            return { valid: false, error: 'Amount exceeds maximum limit. Please contact enterprise sales.' };
        }

        return { valid: true };
    }

    // =============================================
    // APPLY COUPON
    // =============================================
    applyCoupon(code, plan) {
        const coupon = this.coupons.get(code?.toUpperCase());
        
        if (!coupon) {
            return { valid: false, error: 'Invalid coupon code' };
        }

        if (coupon.usedCount >= coupon.maxUses) {
            return { valid: false, error: 'Coupon usage limit reached' };
        }

        if (new Date(coupon.validUntil) < new Date()) {
            return { valid: false, error: 'Coupon expired' };
        }

        if (coupon.planRestriction && coupon.planRestriction !== plan) {
            return { valid: false, error: `Coupon only valid for ${coupon.planRestriction} plan` };
        }

        coupon.usedCount++;

        let discountAmount = 0;
        if (coupon.type === 'PERCENT') {
            discountAmount = 0; // Will be calculated from plan price
        } else {
            discountAmount = coupon.discount;
        }

        return {
            valid: true,
            coupon: code,
            type: coupon.type,
            discount: discountAmount,
            remaining: coupon.maxUses - coupon.usedCount
        };
    }

    // =============================================
    // CALCULATE TAX
    // =============================================
    calculateTax(amount, country, currency) {
        const taxRate = this.billing.taxRates[country] || { rate: 0, name: 'No Tax' };
        
        let taxAmount = 0;
        
        // Tax exemption for certain countries
        const taxExempt = ['AE']; // UAE is tax-free for certain services
        
        if (!taxExempt.includes(country)) {
            taxAmount = amount * (taxRate.rate / 100);
        }

        return {
            country,
            taxRate: taxRate.rate,
            taxName: taxRate.name,
            taxAmount: Math.round(taxAmount * 100) / 100,
            taxExempt: taxExempt.includes(country)
        };
    }

    // =============================================
    // SELECT PROVIDER
    // =============================================
    selectProvider(method) {
        switch (method?.toUpperCase()) {
            case 'CARD':
            case 'CREDIT_CARD':
            case 'DEBIT_CARD':
                return this.providers.STRIPE;
            case 'PAYPAL':
                return this.providers.PAYPAL;
            case 'CRYPTO':
            case 'BITCOIN':
            case 'ETHEREUM':
            case 'USDT':
                return this.providers.CRYPTO;
            case 'BANK_TRANSFER':
            case 'WIRE':
                return this.providers.BANK_TRANSFER;
            case 'APPLE_PAY':
                return this.providers.APPLE_PAY;
            case 'GOOGLE_PAY':
                return this.providers.GOOGLE_PAY;
            default:
                return this.providers.STRIPE; // Default to Stripe
        }
    }

