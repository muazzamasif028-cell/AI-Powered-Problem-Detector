            id: paymentId,
            providerTransactionId: providerResult.transactionId,
            status: providerResult.success ? 'COMPLETED' : 'FAILED',
            
            amount: {
                subtotal: paymentData.amount + discount,
                discount: discount,
                tax: taxResult.taxAmount,
                taxRate: taxResult.taxRate,
                taxName: taxResult.taxName,
                processingFee: providerResult.processingFee,
                total: totalAmount,
                netAmount: providerResult.netAmount,
                currency: paymentData.currency
            },

            payment: {
                method: paymentData.method,
                provider: providerResult.providerName,
                providerId: providerResult.providerId,
                authorizationCode: providerResult.authorizationCode,
                last4: paymentData.cardNumber ? paymentData.cardNumber.slice(-4) : null
            },

            customer: {
                companyId: paymentData.companyId || 'UNKNOWN',
                companyName: paymentData.companyName || 'Unknown Company',
                email: paymentData.email || 'unknown@email.com',
                name: paymentData.customerName || 'Unknown Customer',
                country: paymentData.country || 'US'
            },

            plan: paymentData.plan || null,
            coupon: paymentData.couponCode || null,
            subscription: paymentData.subscription || false,
            
            metadata: paymentData.metadata || {},
            
            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString()
        };

        // Store transaction
        this.transactions.push(transaction);
        if (this.transactions.length > this.maxTransactions) {
            this.transactions.shift();
        }

        return transaction;
    }

