<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supreme LLM Hub — All AI Providers Merged</title>
    <style>
        :root {
            --bg-deep: #050510;
            --bg-card: #0a0a1a;
            --bg-input: #0d0d25;
            --accent: #e94560;
            --accent-glow: #ff6b81;
            --gold: #f0c040;
            --text: #e0e0e0;
            --text-dim: #777;
            --border: rgba(255,255,255,0.06);
            --success: #00c853;
            --openai: #10a37f;
            --anthropic: #d97757;
            --google: #4285f4;
            --meta: #0668e1;
            --deepseek: #4d6bfe;
            --xai: #ffffff;
            --mistral: #facc15;
            --azure: #0078d4;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: var(--bg-deep);
            color: var(--text);
            min-height: 100vh;
        }

        /* ========== TOP NAV ========== */
        .top-nav {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            padding: 10px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-logo { display: flex; align-items: center; gap: 10px; }
        .logo-icon {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, var(--accent), var(--gold));
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px;
        }
        .logo-text { font-size: 13px; font-weight: 700; letter-spacing: 1px; }
        .logo-text span { font-size: 9px; color: var(--text-dim); letter-spacing: 3px; display: block; }

        .nav-links { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
        .nav-link {
            color: var(--text-dim); font-size: 11px; cursor: pointer;
            padding: 4px 0; border-bottom: 2px solid transparent;
            transition: all 0.3s;
            letter-spacing: 0.5px;
        }
        .nav-link:hover { color: var(--text); }
        .nav-link.active { color: var(--accent); border-bottom-color: var(--accent); }

        .nav-btn {
            padding: 8px 18px;
            background: linear-gradient(135deg, var(--accent), var(--accent-glow));
            border: none; border-radius: 20px;
            color: white; font-size: 12px; font-weight: 600;
            cursor: pointer; transition: all 0.3s;
        }
        .nav-btn:hover { transform: scale(1.03); box-shadow: 0 6px 20px rgba(233,69,96,0.3); }

        /* ========== SECTIONS ========== */
        .section { display: none; padding: 20px; max-width: 1400px; margin: 0 auto; }
        .section.active { display: block; }

        /* ========== HERO ========== */
        .hero {
            text-align: center; padding: 30px 20px 20px;
            background: radial-gradient(ellipse at center, rgba(233,69,96,0.06) 0%, transparent 70%);
        }
        .hero h1 {
            font-size: 2.2em; font-weight: 800; letter-spacing: -1px;
            margin-bottom: 10px;
            background: linear-gradient(135deg, #fff, var(--gold));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero p { color: var(--text-dim); font-size: 14px; max-width: 700px; margin: 0 auto 20px; }

        /* ========== PROVIDER GRID ========== */
        .provider-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 16px;
        }

        .provider-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 18px;
            transition: all 0.3s;
            cursor: pointer;
        }
        .provider-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.3); }

        .provider-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 10px;
        }
        .provider-name { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 14px; }
        .provider-icon { font-size: 20px; }
        .provider-status {
            font-size: 9px; padding: 4px 12px; border-radius: 12px;
            font-weight: 600; letter-spacing: 0.5px;
        }
        .status-connected { background: rgba(0,200,83,0.12); color: var(--success); }
        .status-available { background: rgba(240,192,64,0.12); color: var(--gold); }

        .provider-models {
            display: flex; flex-wrap: wrap; gap: 4px; margin: 6px 0 8px;
        }
        .model-chip {
            padding: 3px 8px; border-radius: 12px; font-size: 9px;
            background: var(--bg-input); border: 1px solid var(--border);
            color: var(--text-dim);
        }
        .model-chip.flagship { border-color: var(--accent); color: var(--accent); }
        .model-chip.reasoning { border-color: var(--gold); color: var(--gold); }
        .model-chip.budget { border-color: #888; color: #888; }

        .provider-footer {
            display: flex; gap: 8px; margin-top: 12px;
        }
        .btn {
            flex: 1; padding: 8px 12px; border-radius: 8px;
            font-size: 11px; font-weight: 600; cursor: pointer;
            transition: all 0.3s; text-align: center; border: none;
        }
        .btn-connect {
            background: var(--accent); color: white;
        }
        .btn-connect:hover { background: var(--accent-glow); }
        .btn-configure {
            background: transparent; color: var(--text);
            border: 1px solid var(--border);
        }
        .btn-configure:hover { background: rgba(255,255,255,0.03); }

        /* ========== CHAT INTERFACE ========== */
        .chat-container {
            max-width: 900px; margin: 0 auto;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px; overflow: hidden;
        }
        .chat-header {
            padding: 14px 20px; border-bottom: 1px solid var(--border);
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: wrap; gap: 8px;
        }
        .chat-provider-select {
            display: flex; gap: 6px; flex-wrap: wrap;
        }
        .chat-chip {
            padding: 4px 10px; border-radius: 14px; font-size: 9px; font-weight: 600;
            cursor: pointer; transition: all 0.3s;
            border: 1px solid var(--border); background: transparent; color: var(--text-dim);
            white-space: nowrap;
        }
        .chat-chip:hover { border-color: rgba(255,255,255,0.2); }
        .chat-chip.active { background: var(--accent); color: white; border-color: var(--accent); }

        .chat-messages {
            height: 350px; overflow-y: auto; padding: 16px;
            display: flex; flex-direction: column; gap: 10px;
        }
        .msg { display: flex; animation: slideIn 0.3s ease; }
        @keyframes slideIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
        .user-msg { justify-content: flex-end; }
        .bot-msg { justify-content: flex-start; }
        .bubble {
            max-width: 75%; padding: 10px 14px; border-radius: 14px;
            font-size: 13px; line-height: 1.5;
        }
        .user-bubble { background: var(--accent); color: white; border-bottom-right-radius: 3px; }
        .bot-bubble { background: var(--bg-input); border: 1px solid var(--border); border-bottom-left-radius: 3px; }
        .bot-bubble .provider-tag {
            font-size: 9px; opacity: 0.6; letter-spacing: 0.5px;
            margin-bottom: 4px; display: block;
        }
        .chat-input-area {
            padding: 12px 16px; border-top: 1px solid var(--border);
            display: flex; gap: 8px;
        }
        .chat-input {
            flex: 1; padding: 10px 14px;
            background: var(--bg-input); border: 1px solid var(--border);
            border-radius: 20px; color: white; font-size: 13px; outline: none;
        }
        .chat-input:focus { border-color: var(--accent); }
        .chat-send {
            padding: 10px 18px; background: var(--accent);
            border: none; border-radius: 12px; color: white;
            font-weight: 600; cursor: pointer; transition: all 0.3s;
        }
        .chat-send:hover { background: var(--accent-glow); }

        ::-webkit-scrollbar { width: 3px; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.06); border-radius: 10px; }

        @media (max-width: 768px) {
            .provider-grid { grid-template-columns: 1fr; }
            .nav-links { gap: 8px; }
            .nav-link { font-size: 10px; }
        }
    </style>
</head>
<body>

    <!-- ========== TOP NAV ========== -->
    <nav class="top-nav">
        <div class="nav-logo">
            <div class="logo-icon">⚡</div>
            <div class="logo-text">SUPREME<span>LLM HUB</span></div>
        </div>
        <div class="nav-links">
            <span class="nav-link active" data-section="providers">🌐 Providers</span>
            <span class="nav-link" data-section="chat">💬 Chat</span>
            <span class="nav-link" data-section="dashboard">📊 Dashboard</span>
            <button class="nav-btn" onclick="switchSection('chat')">🚀 Launch Chat</button>
        </div>
    </nav>

    <!-- ========== PROVIDERS SECTION ========== -->
    <section class="section active" id="providersSection">
        <div class="hero">
            <h1>All AI Providers — Unified Under Supreme</h1>
            <p>OpenAI, Anthropic, Google, Meta, DeepSeek, xAI, Mistral, Azure — all merged into one sovereign platform.</p>
        </div>
        <div class="provider-grid" id="providerGrid">
            <!-- Dynamically filled -->
        </div>
    </section>

    <!-- ========== CHAT SECTION ========== -->
    <section class="section" id="chatSection">
        <div class="chat-container">
            <div class="chat-header">
                <div>
                    <div style="font-weight:600;font-size:14px;">Unified AI Chat</div>
                    <div style="font-size:10px;color:var(--text-dim);">Switch providers instantly</div>
                </div>
                <div class="chat-provider-select" id="chatProviderSelect">
                    <!-- Dynamically filled -->
                </div>
            </div>
            <div class="chat-messages" id="chatMessages">
                <div class="msg bot-msg">
                    <div class="bubble bot-bubble">
                        <div class="provider-tag">⚡ SUPREME</div>
                        👋 Welcome to the <b>Unified LLM Hub</b>.<br>
                        All major AI providers integrated. Select a provider and start chatting.
                    </div>
                </div>
            </div>
            <div class="chat-input-area">
                <input type="text" class="chat-input" id="chatInput" 
                       placeholder="Ask anything to any AI model..."
                       onkeypress="if(event.key==='Enter') sendChatMessage()">
                <button class="chat-send" onclick="sendChatMessage()">Send</button>
            </div>
        </div>
    </section>

    <!-- ========== DASHBOARD SECTION ========== -->
    <section class="section" id="dashboardSection">
        <div class="hero">
            <h1>📊 LLM Dashboard</h1>
            <p>Real-time usage, cost, and performance across all providers.</p>
        </div>
        <div id="dashboardContent" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;">
            <!-- Dynamically filled -->
        </div>
    </section>

    <script>
        // ============================================
        // 🧠 LLM PROVIDERS DATABASE
        // ============================================
        const providers = [{
            id: 'openai',
            name: 'OpenAI',
            icon: '🧠',
            color: '#10a37f',
            status: 'connected',
            models: [
                { name: 'GPT-5.5', tier: 'flagship' },
                { name: 'o3', tier: 'reasoning' },
                { name: 'GPT-4o', tier: 'budget' }
            ],
            strength: 'Agentic orchestration, multi-step reasoning'
        }, {
            id: 'anthropic',
            name: 'Anthropic',
            icon: '🏛️',
            color: '#d97757',
            status: 'connected',
            models: [
                { name: 'Claude Fable 5', tier: 'flagship' },
                { name: 'Claude Opus 4.8', tier: 'reasoning' },
                { name: 'Claude Haiku 4.5', tier: 'budget' }
            ],
            strength: 'Enterprise compliance, long-horizon coding'
        }, {
            id: 'google',
            name: 'Google DeepMind',
            icon: '🔮',
            color: '#4285f4',
            status: 'available',
            models: [
                { name: 'Gemini 3.1 Pro', tier: 'flagship' },
                { name: 'Gemini 3.5 Flash', tier: 'budget' }
            ],
            strength: 'Multi-million token context, video-to-code'
        }, {
            id: 'meta',
            name: 'Meta Llama',
            icon: '🦙',
            color: '#0668e1',
            status: 'available',
            models: [
                { name: 'Llama 4 Maverick', tier: 'flagship' },
                { name: 'Llama 4 Scout', tier: 'budget' }
            ],
            strength: 'Open-weight, 10M context, local deployment'
        }, {
            id: 'deepseek',
            name: 'DeepSeek',
            icon: '🐋',
            color: '#4d6bfe',
            status: 'available',
            models: [
                { name: 'DeepSeek-V4-Flash', tier: 'flagship' },
                { name: 'DeepSeek-R1', tier: 'reasoning' }
            ],
            strength: 'Test-time reasoning, cost-efficient architecture'
        }, {
            id: 'xai',
            name: 'xAI (Grok)',
            icon: '🚀',
            color: '#ffffff',
            status: 'available',
            models: [
                { name: 'Grok 4.3', tier: 'flagship' },
                { name: 'Grok 3', tier: 'budget' }
            ],
            strength: 'Real-time X data, frontier reasoning'
        }, {
            id: 'mistral',
            name: 'Mistral AI',
            icon: '🌪️',
            color: '#facc15',
            status: 'available',
            models: [
                { name: 'Mistral Large 3', tier: 'flagship' },
                { name: 'Codestral', tier: 'budget' }
            ],
            strength: 'European sovereign, coding specialized'
        }, {
            id: 'azure',
            name: 'Microsoft Azure',
            icon: '☁️',
            color: '#0078d4',
            status: 'connected',
            models: [
                { name: 'Azure OpenAI (GPT-5)', tier: 'flagship' },
                { name: 'Azure ML (Custom)', tier: 'budget' }
            ],
            strength: 'Enterprise infrastructure, hardware-level security'
        }];

        // ============================================
        // STATE
        // ============================================
        let selectedProvider = 'openai';
        let connectedProviders = JSON.parse(localStorage.getItem('supreme_llm_connected') || '{}');

        // ============================================
        // RENDER PROVIDERS
        // ============================================
        function renderProviders() {
            const grid = document.getElementById('providerGrid');
            grid.innerHTML = '';

            providers.forEach(p => {
                const isConnected = connectedProviders[p.id] || p.status === 'connected';
                const card = document.createElement('div');
                card.className = 'provider-card';
                card.innerHTML = `
                    <div class="provider-header">
                        <div class="provider-name">
                            <span class="provider-icon">${p.icon}</span>
                            ${p.name}
                        </div>
                        <span class="provider-status ${isConnected ? 'status-connected' : 'status-available'}">
                            ${isConnected ? '✅ CONNECTED' : '⚡ AVAILABLE'}
                        </span>
                    </div>
                    <div class="provider-models">
                        ${p.models.map(m => `
                            <span class="model-chip ${m.tier}">${m.name}</span>
                        `).join('')}
                    </div>
                    <div style="font-size:11px;color:var(--text-dim);margin:6px 0;">
                        💪 ${p.strength}
                    </div>
                    <div class="provider-footer">
                        <button class="btn btn-connect" onclick="toggleConnection('${p.id}')">
                            ${isConnected ? '🔄 Disconnect' : '🔗 Connect'}
                        </button>
                        <button class="btn btn-configure" onclick="configureProvider('${p.id}')">
                            ⚙️ Configure
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });

            renderChatProviders();
            renderDashboard();
        }

        // ============================================
        // TOGGLE CONNECTION
        // ============================================
        function toggleConnection(id) {
            if (connectedProviders[id]) {
                delete connectedProviders[id];
                localStorage.setItem('supreme_llm_connected', JSON.stringify(connectedProviders));
                showToast(`❌ ${id} disconnected`);
            } else {
                // Check for API key (simulated)
                const keys = JSON.parse(localStorage.getItem('supreme_llm_keys') || '{}');
                if (!keys[id]) {
                    configureProvider(id);
                    return;
                }
                connectedProviders[id] = true;
                localStorage.setItem('supreme_llm_connected', JSON.stringify(connectedProviders));
                showToast(`✅ ${id} connected`);
            }
            renderProviders();
        }

        // ============================================
        // CONFIGURE PROVIDER
        // ============================================
        function configureProvider(id) {
            const p = providers.find(pr => pr.id === id);
            const key = prompt(`Enter your ${p.name} API key:`);
            if (key) {
                const keys = JSON.parse(localStorage.getItem('supreme_llm_keys') || '{}');
                keys[id] = key;
                localStorage.setItem('supreme_llm_keys', JSON.stringify(keys));
                connectedProviders[id] = true;
                localStorage.setItem('supreme_llm_connected', JSON.stringify(connectedProviders));
                renderProviders();
                showToast(`✅ ${p.name} configured and connected`);
            }
        }

        // ============================================
        // CHAT PROVIDER SELECTOR
        // ============================================
        function renderChatProviders() {
            const container = document.getElementById('chatProviderSelect');
            container.innerHTML = '';

            // Supreme always available
            const supremeChip = document.createElement('span');
            supremeChip.className = 'chat-chip ' + (selectedProvider === 'supreme' ? 'active' : '');
            supremeChip.textContent = '⚡ SUPREME';
            supremeChip.onclick = () => selectProvider('supreme');
            container.appendChild(supremeChip);

            // Connected providers
            Object.keys(connectedProviders).forEach(id => {
                const p = providers.find(pr => pr.id === id);
                if (!p) return;
                const chip = document.createElement('span');
                chip.className = 'chat-chip ' + (selectedProvider === id ? 'active' : '');
                chip.textContent = p.icon + ' ' + p.name;
                chip.onclick = () => selectProvider(id);
                container.appendChild(chip);
            });
        }

        function selectProvider(id) {
            selectedProvider = id;
            renderChatProviders();
            const p = id === 'supreme' ? { name: 'SUPREME', icon: '⚡' } : providers.find(pr => pr.id === id);
            showToast(`💬 Switched to ${p.icon} ${p.name}`);
        }

        // ============================================
        // SEND CHAT MESSAGE
        // ============================================
        function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const msg = input.value.trim();
            if (!msg) return;

            const container = document.getElementById('chatMessages');

            // User message
            const userDiv = document.createElement('div');
            userDiv.className = 'msg user-msg';
            userDiv.innerHTML = `<div class="bubble user-bubble">${msg}</div>`;
            container.appendChild(userDiv);
            input.value = '';

            // Bot response with selected provider
            setTimeout(() => {
                const provider = selectedProvider === 'supreme' ?
                    { name: 'SUPREME TECHNOLOGY', icon: '⚡' } :
                    providers.find(p => p.id === selectedProvider);

                const responses = {
                    supreme: `🔮 <b>Supreme AI Engine</b> (280+ layers, 22 agents) — processing your request through the sovereign stack.\n\n✅ Quantum-safe. Zero external dependency. Response time: 0ms.`,
                    openai: `🧠 <b>OpenAI GPT-5.5</b> via Supreme Mesh — agentic orchestration complete. Multi-step reasoning applied.`,
                    anthropic: `🏛️ <b>Anthropic Claude Fable 5</b> — enterprise-grade analysis. Repository-scale reasoning complete.`,
                    google: `🔮 <b>Google Gemini 3.1 Pro</b> — 2M context processed. Multimodal understanding applied.`,
                    meta: `🦙 <b>Meta Llama 4 Maverick</b> — open-weight model. 10M context utilized. Local deployment ready.`,
                    deepseek: `🐋 <b>DeepSeek-V4-Flash</b> — test-time reasoning complete. Cost-efficient inference applied.`,
                    xai: `🚀 <b>xAI Grok 4.3</b> — real-time X data integrated. Frontier reasoning active.`,
                    mistral: `🌪️ <b>Mistral Large 3</b> — European sovereign AI. Efficient architecture processing.`,
                    azure: `☁️ <b>Azure OpenAI (GPT-5)</b> — enterprise infrastructure. Hardware-level security. Confidential computing.`
                };

                const response = responses[selectedProvider] || responses.supreme;

                const botDiv = document.createElement('div');
                botDiv.className = 'msg bot-msg';
                botDiv.innerHTML = `
                    <div class="bubble bot-bubble">
                        <div class="provider-tag">${provider.icon} ${provider.name}</div>
                        ${response.replace(/\n/g, '<br>')}
                        <div style="margin-top:6px;font-size:10px;color:var(--text-dim);">⚡ Delivered via Supreme LLM Hub</div>
                    </div>
                `;
                container.appendChild(botDiv);
                container.scrollTop = container.scrollHeight;
            }, 800);
            container.scrollTop = container.scrollHeight;
        }

        // ============================================
        // RENDER DASHBOARD
        // ============================================
        function renderDashboard() {
            const container = document.getElementById('dashboardContent');
            container.innerHTML = '';

            const connected = Object.keys(connectedProviders);
            const total = providers.length;

            const stats = [
                { label: 'Providers', value: `${connected.length}/${total}`, desc: 'Connected' },
                { label: 'Models', value: providers.reduce((sum, p) => sum + p.models.length, 0), desc: 'Total available' },
                { label: 'Status', value: connected.length > 3 ? '🟢 HEALTHY' : '🟡 WARNING', desc: 'All systems' },
                { label: 'Latency', value: '0-200ms', desc: 'Avg response' }
            ];

            stats.forEach(s => {
                const card = document.createElement('div');
                card.style.cssText = 'background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:16px;text-align:center;';
                card.innerHTML = `
                    <div style="font-size:24px;font-weight:700;color:var(--gold);">${s.value}</div>
                    <div style="font-size:11px;color:var(--text-dim);">${s.label}</div>
                    <div style="font-size:9px;color:var(--text-dim);margin-top:4px;">${s.desc}</div>
                `;
                container.appendChild(card);
            });
        }

        // ============================================
        // TOAST
        // ============================================
        function showToast(msg, type = 'success') {
            const t = document.createElement('div');
            t.style.cssText = `
                position:fixed; top:20px; right:20px;
                background:var(--bg-card); border:1px solid ${type === 'success' ? 'var(--success)' : 'var(--accent)'};
                border-radius:10px; padding:12px 18px; z-index:999;
                animation: slideIn 0.3s ease; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
                font-size:13px; color:var(--text); max-width:350px;
            `;
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(() => t.remove(), 3000);
        }

        // ============================================
        // NAVIGATION
        // ============================================
        function switchSection(section) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
            document.getElementById(section + 'Section').classList.add('active');
            document.querySelector(`[data-section="${section}"]`).classList.add('active');
        }

        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', function() {
                switchSection(this.dataset.section);
            });
        });

        // ============================================
        // INIT
        // ============================================
        renderProviders();
        console.log('🌍 SUPREME LLM HUB — ALL PROVIDERS MERGED');
        console.log('✅ OpenAI | Anthropic | Google | Meta | DeepSeek | xAI | Mistral | Azure');
        console.log('👑 Status: OPERATIONAL — One Hub, All Models');
    </script>
</body>
</html>
