// spl-v/compiler/SupremeVehicleParser.js
import { 
    ProgramNode, VehicleNode, ModuleNode, SettingNode, 
    TaskNode, SafetyPillarNode, ConditionNode, BinaryExprNode,
    ValueNode, EventNode, ActionNode, MainPhaseNode 
} from './ast/ASTNodes.js';

export class SupremeVehicleParser {
    constructor(tokens) {
        this.tokens = tokens;
        this.pos = 0;
    }

    parse() {
        const program = new ProgramNode([]);
        
        while (!this.isAtEnd()) {
            if (this.check('KEYWORD')) {
                const kw = this.peek().value;
                switch (kw) {
                    case 'vehicle': program.modules.push(this.parseVehicle()); break;
                    case 'copilot': program.modules.push(this.parseCopilot()); break;
                    case 'autonomous': program.modules.push(this.parseAutonomous()); break;
                    case 'hardware': program.modules.push(this.parseHardware()); break;
                    case 'safety': program.modules.push(this.parseSafety()); break;
                    case 'main': program.modules.push(this.parseMain()); break;
                    case 'fleet':
                    case 'ota':
                    case 'kernel':
                    case 'scheduler':
                    case 'hal':
                        program.modules.push(this.parseGenericModule(kw)); break;
                    default: this.advance();
                }
            } else { this.advance(); }
        }
        
        return program;
    }

    parseVehicle() {
        this.consume('KEYWORD', 'vehicle');
        // Handle BOTH String and Identifier for vehicle name
        let name;
        if (this.check('STRING')) {
            name = this.consume('STRING').value;
        } else if (this.check('IDENTIFIER')) {
            name = this.consume('IDENTIFIER').value;
        } else {
            throw new Error(`Expected vehicle name at line ${this.peek()?.line}`);
        }
        
        this.consume('LBRACE');
        const props = this.parseProperties();
        this.consume('RBRACE');
        
        return new VehicleNode(name, props);
    }

    parseCopilot() {
        this.consume('KEYWORD', 'copilot');
        this.consume('LBRACE');
        
        const settings = {};
        const events = [];
        
        while (!this.check('RBRACE') && !this.isAtEnd()) {
            if (this.check('KEYWORD') && this.peek().value === 'on') {
                events.push(this.parseCopilotEvent());
            } else if (this.check('IDENTIFIER')) {
                const key = this.consume('IDENTIFIER').value;
                this.consume('COLON');
                settings[key] = this.parseValue();
            } else {
                this.advance();
            }
        }
        
        this.consume('RBRACE');
        return { type: 'CopilotConfig', settings, events };
    }

    parseCopilotEvent() {
        this.consume('KEYWORD', 'on');
        const trigger = this.parseExpression();
        this.consume('LBRACE');
        
        const actions = [];
        while (!this.check('RBRACE') && !this.isAtEnd()) {
            if (this.check('KEYWORD') && this.peek().value === 'say') {
                this.advance();
                actions.push(new ActionNode('say', { message: this.consume('STRING').value }));
            } else if (this.check('KEYWORD') && this.peek().value === 'suggest') {
                this.advance();
                actions.push(new ActionNode('suggest', { action: this.consume('IDENTIFIER').value }));
            } else {
                this.advance();
            }
        }
        
        this.consume('RBRACE');
        return new EventNode(trigger, actions);
    }

    parseAutonomous() {
        this.consume('KEYWORD', 'autonomous');
        this.consume('LBRACE');
        const subsystems = {};
        
        while (!this.check('RBRACE') && !this.isAtEnd()) {
            if (this.check('KEYWORD') && !['true', 'false'].includes(this.peek().value)) {
                const name = this.consume('KEYWORD').value;
                this.consume('LBRACE');
                subsystems[name] = this.parseProperties();
                this.consume('RBRACE');
            } else { this.advance(); }
        }
        
        this.consume('RBRACE');
        return { type: 'AutonomousConfig', subsystems };
    }

    parseHardware() {
        this.consume('KEYWORD', 'hardware');
        this.consume('LBRACE');
        const subsystems = {};
        
        while (!this.check('RBRACE') && !this.isAtEnd()) {
            if (this.check('KEYWORD') && !['true', 'false'].includes(this.peek().value)) {
                const name = this.consume('KEYWORD').value;
                this.consume('LBRACE');
                subsystems[name] = this.parseProperties();
                this.consume('RBRACE');
            } else { this.advance(); }
        }
        
        this.consume('RBRACE');
        return { type: 'HardwareConfig', subsystems };
    }

    parseSafety() {
        this.consume('KEYWORD', 'safety');
        this.consume('LBRACE');
        
        const pillars = [];
        let count = 30;
        
        while (!this.check('RBRACE') && !this.isAtEnd()) {
            if (this.check('KEYWORD') && this.peek().value === 'pillar') {
                pillars.push(this.parsePillar());
            } else if (this.check('KEYWORD') && this.peek().value === 'pillars') {
                this.advance();
                this.consume('COLON');
                count = this.consume('NUMBER').value;
            } else { this.advance(); }
        }
        
        this.consume('RBRACE');
        return { type: 'SafetyConfig', pillars, count };
    }

    parsePillar() {
        this.consume('KEYWORD', 'pillar');
        const name = this.consume('IDENTIFIER').value;
        this.consume('LBRACE');
        
        const props = {};
        while (!this.check('RBRACE') && !this.isAtEnd()) {
            if (this.check('IDENTIFIER')) {
                const key = this.consume('IDENTIFIER').value;
                this.consume('COLON');
                props[key] = this.parseValue();
            } else { this.advance(); }
        }
        
        this.consume('RBRACE');
        return new SafetyPillarNode(name, props);
    }

    parseGenericModule(name) {
        this.consume('KEYWORD', name);
        this.consume('LBRACE');
        const props = this.parseProperties();
        this.consume('RBRACE');
        return { type: `${name}Config`, ...props };
    }

    parseMain() {
        this.consume('KEYWORD', 'main');
        this.consume('LBRACE');
        
        const phases = [];
        while (!this.check('RBRACE') && !this.isAtEnd()) {
            if (this.check('KEYWORD')) {
                const phaseName = this.consume('KEYWORD').value;
                this.consume('LBRACE');
                const statements = this.parseStatements();
                this.consume('RBRACE');
                phases.push(new MainPhaseNode(phaseName, statements));
            } else { this.advance(); }
        }
        
        this.consume('RBRACE');
        return { type: 'MainConfig', phases };
    }

    parseProperties() {
        const props = {};
        while (!this.check('RBRACE') && !this.isAtEnd()) {
            if (this.check('IDENTIFIER') || this.check('KEYWORD')) {
                const key = this.advance().value;
                this.consume('COLON');
                props[key] = this.parseValue();
            } else { this.advance(); }
        }
        return props;
    }

    parseStatements() {
        const stmts = [];
        while (!this.check('RBRACE') && !this.isAtEnd()) {
            if (this.check('KEYWORD') && this.peek().value === 'task') {
                stmts.push(this.parseTask());
            } else if (this.check('IDENTIFIER') || this.check('KEYWORD')) {
                const name = this.advance().value;
                this.consume('COLON');
                stmts.push(new SettingNode(name, this.parseValue()));
            } else { this.advance(); }
        }
        return stmts;
    }

    parseTask() {
        this.consume('KEYWORD', 'task');
        const name = this.consume('IDENTIFIER').value;
        this.consume('LBRACE');
        const props = this.parseProperties();
        this.consume('RBRACE');
        return new TaskNode(name, props);
    }

    // ============================================
    // FULL EXPRESSION PARSER (Pratt Parser)
    // ============================================
    parseExpression(minPrecedence = 0) {
        let left = this.parsePrimary();
        
        while (true) {
            const token = this.peek();
            if (!token || token.type === 'EOF' || token.type === 'SEMICOLON' || 
                token.type === 'RBRACE' || token.type === 'RPAREN' || token.type === 'RBRACKET' ||
                token.type === 'COMMA' || token.type === 'COLON') {
                break;
            }
            
            const precedence = this.getPrecedence(token);
            if (precedence < minPrecedence) break;
            
            if (token.type === 'AND' || token.type === 'OR') {
                const op = this.advance().value;
                const right = this.parseExpression(precedence + 1);
                left = new BinaryExprNode(left, op, right);
            } else if (token.type === 'EQ' || token.type === 'NEQ' || 
                       token.type === 'LT' || token.type === 'GT' || 
                       token.type === 'LTE' || token.type === 'GTE') {
                const op = this.advance().value;
                const right = this.parseExpression(precedence + 1);
                left = new ConditionNode(left, op, right);
            } else if (token.type === 'PLUS' || token.type === 'MINUS') {
                const op = this.advance().value;
                const right = this.parseExpression(precedence + 1);
                left = new BinaryExprNode(left, op, right);
            } else if (token.type === 'STAR' || token.type === 'SLASH' || token.type === 'PERCENT') {
                const op = this.advance().value;
                const right = this.parseExpression(precedence + 1);
                left = new BinaryExprNode(left, op, right);
            } else {
                break;
            }
        }
        
        return left;
    }

    getPrecedence(token) {
        const precedence = {
            'AND': 1, 'OR': 1,
            'EQ': 2, 'NEQ': 2, 'LT': 2, 'GT': 2, 'LTE': 2, 'GTE': 2,
            'PLUS': 3, 'MINUS': 3,
            'STAR': 4, 'SLASH': 4, 'PERCENT': 4
        };
        return precedence[token.type] || 0;
    }

    parsePrimary() {
        const token = this.peek();
        
        if (token.type === 'NUMBER') {
            const t = this.advance();
            return new ValueNode(t.value, t.unit);
        }
        if (token.type === 'STRING') {
            return new ValueNode(this.consume('STRING').value);
        }
        if (token.type === 'IDENTIFIER') {
            const val = this.consume('IDENTIFIER').value;
            if (val === 'true') return new ValueNode(true);
            if (val === 'false') return new ValueNode(false);
            return { type: 'Identifier', value: val };
        }
        if (token.type === 'KEYWORD' && ['true', 'false'].includes(token.value)) {
            this.advance();
            return new ValueNode(token.value === 'true');
        }
        if (token.type === 'LPAREN') {
            this.advance();
            const expr = this.parseExpression();
            this.consume('RPAREN');
            return expr;
        }
        if (token.type === 'NOT' || token.type === 'MINUS') {
            const op = this.advance().value;
            const expr = this.parsePrimary();
            return { type: 'UnaryExpr', op, expr };
        }
        
        return null;
    }

    parseValue() {
        if (this.check('STRING')) return new ValueNode(this.consume('STRING').value);
        if (this.check('NUMBER')) {
            const t = this.consume('NUMBER');
            return new ValueNode(t.value, t.unit);
        }
        if (this.check('LBRACKET')) {
            this.advance();
            const arr = [];
            while (!this.check('RBRACKET') && !this.isAtEnd()) {
                arr.push(this.parseValue());
                if (this.check('COMMA')) this.advance();
            }
            this.consume('RBRACKET');
            return { type: 'Array', value: arr };
        }
        if (this.check('LBRACE')) {
            this.advance();
            const obj = this.parseProperties();
            this.consume('RBRACE');
            return { type: 'Object', value: obj };
        }
        if (this.check('IDENTIFIER')) {
            const val = this.consume('IDENTIFIER').value;
            if (val === 'true' || val === 'false') return new ValueNode(val === 'true');
            return { type: 'Identifier', value: val };
        }
        return this.parseExpression();
    }

    // Helpers
    peek() { return this.tokens[this.pos]; }
    isAtEnd() { return !this.peek() || this.peek().type === 'EOF'; }
    check(type) { return this.peek()?.type === type; }
    advance() { return this.tokens[this.pos++] || { type: 'EOF' }; }
    
    consume(type, value) {
        const t = this.advance();
        if (t.type !== type || (value && t.value !== value)) {
            throw new Error(`Expected ${type}${value ? ':' + value : ''}, got ${t.type}:${t.value} at line ${t.line || '?'}`);
        }
        return t;
    }
}
