<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SUPREME OS — Domain Registration & AI Platform</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #0a0a1a 0%, #1a1a3a 50%, #0a0a2a 100%);
            color: #fff;
            min-height: 100vh;
        }
        .container { max-width: 1200px; margin: 0 auto; padding: 40px 20px; }
        .hero { text-align: center; padding: 80px 0; }
        .hero h1 { font-size: 3.5em; background: linear-gradient(135deg, #00ffff, #0088ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 20px; }
        .hero p { font-size: 1.3em; color: #aaa; max-width: 600px; margin: 0 auto 40px; }
        .search-box { max-width: 500px; margin: 0 auto; display: flex; gap: 10px; }
        .search-box input { flex: 1; padding: 16px 20px; border-radius: 12px; border: 2px solid #333; background: #1a1a2e; color: #fff; font-size: 1.1em; }
        .search-box button { padding: 16px 30px; border-radius: 12px; border: none; background: linear-gradient(135deg, #00ffff, #0088ff); color: #000; font-weight: bold; font-size: 1.1em; cursor: pointer; }
        .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; margin-top: 80px; }
        .feature-card { background: #1a1a2e; border: 1px solid #333; border-radius: 16px; padding: 30px; text-align: center; transition: transform 0.3s; }
        .feature-card:hover { transform: translateY(-5px); border-color: #00ffff; }
        .feature-card .icon { font-size: 3em; margin-bottom: 15px; }
        .feature-card h3 { font-size: 1.3em; margin-bottom: 10px; color: #00ffff; }
        .feature-card p { color: #888; }
        .cta { text-align: center; margin-top: 80px; padding: 60px 0; }
        .cta h2 { font-size: 2em; margin-bottom: 20px; }
        .cta button { padding: 18px 40px; border-radius: 12px; border: none; background: linear-gradient(135deg, #00ffff, #0088ff); color: #000; font-weight: bold; font-size: 1.2em; cursor: pointer; }
    </style>
</head>
<body>
    <div class="container">
        <div class="hero">
            <h1>⚡ SUPREME OS</h1>
            <p>Register domains, deploy websites, and build AI agents — all in one platform. The operating system for the internet.</p>
            <div class="search-box">
                <input type="text" id="domainSearch" placeholder="Search your domain..." onkeydown="if(event.key==='Enter')searchDomain()">
                <button onclick="searchDomain()">Search →</button>
            </div>
            <p style="margin-top:20px;color:#666;">
                <span id="searchResult"></span>
            </p>
        </div>

        <div class="features">
            <div class="feature-card">
                <div class="icon">🌐</div>
                <h3>Domain Registration</h3>
                <p>Register .com, .net, .org, .io, .ai and 500+ TLDs at competitive prices.</p>
            </div>
            <div class="feature-card">
                <div class="icon">🤖</div>
                <h3>AI Platform</h3>
                <p>Build, deploy, and scale AI agents with GPT-4, Claude, and Gemini.</p>
            </div>
            <div class="feature-card">
                <div class="icon">🚀</div>
                <h3>Instant Deploy</h3>
                <p>One-click website deployment with free SSL and global CDN.</p>
            </div>
            <div class="feature-card">
                <div class="icon">🔒</div>
                <h3>Enterprise Security</h3>
                <p>DDoS protection, WAF, and quantum-ready encryption included.</p>
            </div>
        </div>

        <div class="cta">
            <h2>Ready to launch your online presence?</h2>
            <p style="color:#888;margin-bottom:30px;">Join thousands of developers and businesses on SUPREME OS.</p>
            <button onclick="window.location.href='/signup'">Get Started Free →</button>
        </div>
    </div>

    <script>
        async function searchDomain() {
            const domain = document.getElementById('domainSearch').value.trim();
            if (!domain) return;
            
            const result = document.getElementById('searchResult');
            result.innerHTML = 'Searching...';
            
            try {
                const res = await fetch('/api/domain/search', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ domain })
                });
                const data = await res.json();
                
                const available = data.results.filter(r => r.available);
                result.innerHTML = available.length > 0 
                    ? `✅ ${available[0].domain} is available — <a href="/signup" style="color:#00ffff">Register now</a>`
                    : '❌ Not available — try different TLDs';
            } catch (err) {
                result.innerHTML = 'Error searching. Try again.';
            }
        }
    </script>
</body>
</html>
