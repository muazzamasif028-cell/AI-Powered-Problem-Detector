                preActions.push(preAction);
                
                this.state.predictionsMade++;
                
                if (prediction.confidence >= 98) {
                    this.state.accuratePredictions++;
                }
            }
        }

        // Execute preemptive actions
        const executedActions = await this.executePreemptiveActions(preActions);

        // Update stats
        this.state.incidentsPrevented += executedActions.length;
        this.state.revenueSaved += executedActions.reduce((sum, a) => sum + (a.estimatedSavings || 0), 0);

        const processingTime = (performance.now() - startTime).toFixed(2);

        const result = {
            scanId,
            tenantId,
            timestamp: new Date().toISOString(),
            predictions,
            preActions: executedActions,
            stats: {
                predictionsMade: predictions.length,
                actionsExecuted: executedActions.length,
                estimatedSavings: '$' + executedActions.reduce((sum, a) => sum + (a.estimatedSavings || 0), 0).toLocaleString(),
                processingTime_ms: processingTime
            }
        };

        this.predictionHistory.push(result);
        if (this.predictionHistory.length > this.maxHistorySize) {
            this.predictionHistory.shift();
        }

        console.log(`🔮 [PRE-COG]: ${scanId} — ${executedActions.length} preemptive actions taken`);

        return result;
    }

    // =============================================
    // PREDICT FAILURE
    // =============================================
    predictFailure(pattern, currentMetrics) {
        const now = new Date();
        const trigger = pattern.trigger;
        
        // Check if pattern is active right now or soon
        let isRelevant = false;
        let timeUntilFailure = 0;
        
        // Day check
        if (trigger.day) {
            const currentDay = now.toLocaleString('en-US', { weekday: 'long' });
            if (currentDay === trigger.day) {
                isRelevant = true;
            }
        }
        
        // Date range check (month-end)
        if (trigger.day === '28-31') {
            const currentDate = now.getDate();
            if (currentDate >= 28 && currentDate <= 31) {
                isRelevant = true;
            }
        }
        
        // Specific date (25th)
        if (trigger.day === '25') {
            const currentDate = now.getDate();
            if (currentDate === 25) {
                isRelevant = true;
            }
        }

        // Time check
        if (isRelevant && trigger.time) {
            const [hours, minutes] = trigger.time.split(':').map(Number);
            const currentHours = now.getHours();
            const currentMinutes = now.getMinutes();
            
            const triggerMinutes = hours * 60 + minutes;
            const currentTotalMinutes = currentHours * 60 + currentMinutes;
            
            timeUntilFailure = triggerMinutes - currentTotalMinutes;
            
            // If within 30 minutes of failure
            if (timeUntilFailure > 0 && timeUntilFailure <= 30) {
                isRelevant = true;
            } else if (timeUntilFailure <= 0) {
                isRelevant = false; // Already passed
            }
        }

        if (!isRelevant) {
            return { willFail: false, patternId: pattern.id };
        }

        // Get predicted metric
        const metricKey = Object.keys(pattern.metrics)[0];
        const metricData = pattern.metrics[metricKey];
        
        // Calculate confidence based on how close to predicted value
        const confidence = pattern.successRate;
        
        // Check if current metrics align with prediction
        const currentValue = currentMetrics[metricKey] || metricData.current;
        const predictionAccuracy = 1 - Math.abs(currentValue - metricData.predicted) / metricData.predicted;
        const adjustedConfidence = confidence * Math.max(0, predictionAccuracy);

        return {
            willFail: adjustedConfidence >= 95,
            patternId: pattern.id,
            patternName: pattern.name,
            metric: metricKey,
            currentValue: currentValue,
            predictedValue: metricData.predicted,
            threshold: metricData.threshold,
            timeUntilFailure: timeUntilFailure + ' minutes',
            predictedFailureTime: new Date(now.getTime() + timeUntilFailure * 60000).toISOString(),
            confidence: adjustedConfidence.toFixed(1),
            recommendedAction: pattern.action,
            cause: pattern.cause,
            estimatedSavings: this.calculateSavings(pattern)
        };
    }

