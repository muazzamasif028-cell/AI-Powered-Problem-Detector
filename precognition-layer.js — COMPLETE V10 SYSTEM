placeholderFiles.forEach(file => {
    const fullPath = path.join(PROJECT_NAME, file);
    if (!fs.existsSync(fullPath)) {
        const ext = path.extname(file);
        let content = '';
        if (ext === '.json') content = '[]';
        else if (ext === '.sh') content = '#!/bin/bash\n';
        else if (ext === '.html') content = '<!DOCTYPE html>\n<html>\n</html>';
        else if (ext === '.css') content = '/* Styles */\n';
        else if (ext === '.js') content = '// ' + path.basename(file) + '\n';
        
        fs.writeFileSync(fullPath, content);
        count++;
        console.log(`   ✅ ${file}`);
    }
});

console.log(`\n🎉 DONE! ${count} files created in "${PROJECT_NAME}/"`);
console.log(`\n⚡ Next steps:`);
console.log(`   cd ${PROJECT_NAME}`);
console.log(`   npm install`);
console.log(`   npm start`);
