// SUPREME Webhook Handler — Paddle | Lemon Squeezy
// ============================================================
const express = require('express');
const router = express.Router();
const paymentOrchestrator = require('../services/payment');

// Paddle webhook
router.post('/paddle', express.raw({ type: 'application/json' }), async (req, res) => {
    await paymentOrchestrator.handleWebhook('paddle', req, res);
});

// Lemon Squeezy webhook
router.post('/lemonsqueezy', express.json(), async (req, res) => {
    await paymentOrchestrator.handleWebhook('lemonsqueezy', req, res);
});

module.exports = router;
