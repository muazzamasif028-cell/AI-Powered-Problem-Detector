    // =============================================
    // INITIALIZE
    // =============================================
    initialize() {
        this.state.initialized = true;
        console.log('🤫 [PRICING MODEL]: Ready —', Object.keys(this.tiers).length, 'tiers');
        return { status: 'READY', tiers: Object.keys(this.tiers).length };
    }

    // =============================================
    // GET TIER BY PROBLEM
    // =============================================
    detectTier(problem, context = {}) {
        const lowerProblem = (typeof problem === 'string' ? problem : JSON.stringify(problem)).toLowerCase();
        
        // GLOBAL indicators
        if (lowerProblem.includes('city') || lowerProblem.includes('infrastructure') || 
            lowerProblem.includes('neom') || lowerProblem.includes('national') ||
            lowerProblem.includes('government') || lowerProblem.includes('smart city')) {
            return 'GLOBAL';
        }

        // ENTERPRISE indicators
        if (lowerProblem.includes('breach') || lowerProblem.includes('outage') ||
            lowerProblem.includes('revenue') || lowerProblem.includes('critical') ||
            lowerProblem.includes('datacenter') || lowerProblem.includes('security incident')) {
            return 'ENTERPRISE';
        }

        // BUSINESS indicators
        if (lowerProblem.includes('production') || lowerProblem.includes('slowdown') ||
            lowerProblem.includes('outage') || lowerProblem.includes('scaling') ||
            context.userCount > 1000) {
            return 'BUSINESS';
        }

        // MEDIUM indicators
        if (lowerProblem.includes('database') || lowerProblem.includes('latency') ||
            lowerProblem.includes('api') || lowerProblem.includes('multiple') ||
            (context.services && context.services > 1)) {
            return 'MEDIUM';
        }

        // SMALL (default)
        return 'SMALL';
    }

    // =============================================
    // GENERATE QUOTE
    // =============================================
    generateQuote(problem, options = {}) {
        const quoteId = 'QUOTE-' + Date.now().toString(36) + '-' + 
                       Math.random().toString(36).substr(2, 6).toUpperCase();
        
        const tier = options.tier || this.detectTier(problem, options);
        const tierConfig = this.tiers[tier];
        
        // Calculate pricing
        const diagnosis = this.calculatePrice(tierConfig.pricing.DIAGNOSIS, options);
        const fixRepair = this.calculatePrice(tierConfig.pricing.FIX_REPAIR, options);
        const fullSolution = this.calculatePrice(tierConfig.pricing.FULL_SOLUTION, options);
        
        // Apply discounts
        const discount = this.calculateDiscount(options);
        const discountedDiagnosis = Math.round(diagnosis * (1 - discount));
        const discountedFix = Math.round(fixRepair * (1 - discount));
        const discountedSolution = Math.round(fullSolution * (1 - discount));

        const quote = {
            quoteId,
            timestamp: new Date().toISOString(),
            tier: {
                level: tier,
                name: tierConfig.name,
                emoji: tierConfig.emoji,
                description: tierConfig.description
            },
            problem: {
                summary: typeof problem === 'string' ? problem.substring(0, 100) : 'Custom problem',
                detectedTier: tier,
                useCases: tierConfig.useCases
            },
            pricing: {
                diagnosis: {
                    original: diagnosis,
                    discounted: discountedDiagnosis,
                    range: `$${tierConfig.pricing.DIAGNOSIS.min.toLocaleString()} - $${tierConfig.pricing.DIAGNOSIS.max.toLocaleString()}`
                },
                fixRepair: {
                    original: fixRepair,
                    discounted: discountedFix,
                    range: `$${tierConfig.pricing.FIX_REPAIR.min.toLocaleString()} - $${tierConfig.pricing.FIX_REPAIR.max.toLocaleString()}`
                },
                fullSolution: {
                    original: fullSolution,
                    discounted: discountedSolution,
                    range: `$${tierConfig.pricing.FULL_SOLUTION.min.toLocaleString()} - $${tierConfig.pricing.FULL_SOLUTION.max.toLocaleString()}`
                }
            },
            discount: {
                applied: discount > 0,
                percentage: (discount * 100).toFixed(0) + '%',
                reason: this.getDiscountReason(options),
                savings: `$${(fullSolution - discountedSolution).toLocaleString()}`
            },
            features: tierConfig.features,
            targetCustomers: tierConfig.targetCustomers,
            profitMargin: tierConfig.profitMargin,
            conversionRate: tierConfig.conversionRate,
            popularChoice: tierConfig.popularChoice || false,
            requiresContract: tierConfig.requiresContract || false,
            totalEstimate: {
                minimum: `$${tierConfig.pricing.DIAGNOSIS.min.toLocaleString()}`,
                average: `$${tierConfig.pricing.FULL_SOLUTION.average.toLocaleString()}`,
                maximum: `$${tierConfig.pricing.FULL_SOLUTION.max.toLocaleString()}`
            }
        };

        // Update state
        this.state.totalQuotes++;
        this.state.totalRevenue += discountedSolution;
        this.state.averageTicket = this.state.totalRevenue / this.state.totalQuotes;

        this.quoteHistory.push(quote);
        if (this.quoteHistory.length > this.maxHistorySize) this.quoteHistory.shift();

        console.log(`🤫 [PRICING]: ${quoteId} — ${tier} tier — $${discountedSolution.toLocaleString()}`);

        return quote;
    }

    // =============================================
    // CALCULATE PRICE
    // =============================================
    calculatePrice(range, options) {
        const base = range.average;
        
        // Adjust based on urgency
        if (options.urgent) return Math.round(base * 1.5);
        
        // Adjust based on complexity
        if (options.complexity === 'HIGH') return Math.round(base * 1.3);
        if (options.complexity === 'LOW') return Math.round(base * 0.8);
        
        return base;
    }

    // =============================================
    // CALCULATE DISCOUNT
    // =============================================
    calculateDiscount(options) {
        let totalDiscount = 0;
        
        if (options.annualPlan) totalDiscount += this.discounts.ANNUAL_PLAN;
        if (options.volume) totalDiscount += this.discounts.VOLUME;
        if (options.startup) totalDiscount += this.discounts.STARTUP;
        if (options.nonprofit) totalDiscount += this.discounts.NONPROFIT;
        if (options.referral) totalDiscount += this.discounts.REFERRAL;
        
        return Math.min(0.40, totalDiscount); // Cap at 40%
    }

    getDiscountReason(options) {
        const reasons = [];
        if (options.annualPlan) reasons.push('Annual Plan (15%)');
        if (options.volume) reasons.push('Volume (10%)');
        if (options.startup) reasons.push('Startup (20%)');
        if (options.nonprofit) reasons.push('Nonprofit (25%)');
        if (options.referral) reasons.push('Referral (5%)');
        return reasons.length > 0 ? reasons.join(' + ') : 'None';
    }

    // =============================================
    // GET ALL TIERS SUMMARY
    // =============================================
    getAllTiers() {
        return Object.entries(this.tiers).map(([level, config]) => ({
            level,
            name: config.name,
            emoji: config.emoji,
            description: config.description,
            diagnosisRange: `$${config.pricing.DIAGNOSIS.min.toLocaleString()} - $${config.pricing.DIAGNOSIS.max.toLocaleString()}`,
            fixRange: `$${config.pricing.FIX_REPAIR.min.toLocaleString()} - $${config.pricing.FIX_REPAIR.max.toLocaleString()}`,
            solutionRange: `$${config.pricing.FULL_SOLUTION.min.toLocaleString()} - $${config.pricing.FULL_SOLUTION.max.toLocaleString()}`,
            features: config.features.length,
            profitMargin: config.profitMargin,
            popularChoice: config.popularChoice || false
        }));
    }

    // =============================================
    // COMPARE TIERS
    // =============================================
    compareTiers(tier1, tier2) {
        const t1 = this.tiers[tier1];
        const t2 = this.tiers[tier2];
        
        if (!t1 || !t2) return { error: 'Invalid tier(s)' };

        return {
            tier1: { level: tier1, name: t1.name, averageSolution: t1.pricing.FULL_SOLUTION.average },
            tier2: { level: tier2, name: t2.name, averageSolution: t2.pricing.FULL_SOLUTION.average },
            priceDifference: `$${(t2.pricing.FULL_SOLUTION.average - t1.pricing.FULL_SOLUTION.average).toLocaleString()}`,
            featureDifference: t2.features.length - t1.features.length,
            upgradeRecommended: t2.pricing.FULL_SOLUTION.average > t1.pricing.FULL_SOLUTION.average
        };
    }

    // =============================================
    // SYSTEM STATUS
    // =============================================
    getStatus() {
        return {
            initialized: this.state.initialized,
            totalQuotes: this.state.totalQuotes,
            totalRevenue: '$' + this.state.totalRevenue.toLocaleString(),
            averageTicket: '$' + this.state.averageTicket.toLocaleString(),
            tiers: Object.keys(this.tiers).length,
            discounts: Object.keys(this.discounts).length,
            historySize: this.quoteHistory.length
        };
    }

    reset() {
        this.quoteHistory = [];
        this.state.totalQuotes = 0;
        this.state.totalRevenue = 0;
        this.state.averageTicket = 0;
        return { status: 'RESET' };
    }
}

