<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supreme Technology | TechSolve Enterprise</title>
    
    <!-- StackBlitz-ready: No dependencies, single file -->
    <style>
        :root {
            --bg-deep: #0a0a0f;
            --bg-card: #12121a;
            --bg-input: #1a1a2e;
            --accent: #e94560;
            --accent-glow: #ff6b81;
            --gold: #f0c040;
            --text: #e0e0e0;
            --text-dim: #888;
            --border: rgba(255,255,255,0.06);
            --success: #00c853;
            --warning: #ff9800;
            --danger: #ff1744;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg-deep);
            color: var(--text);
            height: 100vh;
            overflow: hidden;
        }

        /* ========== PLATFORM LAYOUT ========== */
        .platform {
            display: grid;
            grid-template-columns: 260px 1fr 300px;
            height: 100vh;
        }

        /* ========== LEFT SIDEBAR ========== */
        .sidebar-left {
            background: var(--bg-card);
            border-right: 1px solid var(--border);
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            overflow-y: auto;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 12px 20px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 8px;
        }

        .logo-icon {
            width: 38px; height: 38px;
            background: linear-gradient(135deg, var(--accent), var(--gold));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: bold;
        }

        .logo-text h3 { font-size: 13px; font-weight: 700; letter-spacing: 0.5px; }
        .logo-text span { font-size: 9px; color: var(--text-dim); letter-spacing: 2px; }

        .nav-section {
            font-size: 9px; text-transform: uppercase;
            letter-spacing: 2px; color: var(--text-dim);
            padding: 12px 10px 4px;
        }

        .nav-item {
            display: flex; align-items: center; gap: 8px;
            padding: 10px 12px; border-radius: 8px;
            cursor: pointer; transition: all 0.2s;
            font-size: 12px; color: var(--text-dim);
            border: 1px solid transparent;
            user-select: none;
        }

        .nav-item:hover { background: rgba(255,255,255,0.03); color: var(--text); }
        .nav-item.active {
            background: rgba(233,69,96,0.1);
            color: var(--accent);
            border-color: rgba(233,69,96,0.2);
            font-weight: 600;
        }

        .nav-badge {
            margin-left: auto; font-size: 9px;
            padding: 2px 8px; border-radius: 10px;
            font-weight: 600;
        }
        .badge-live { background: var(--accent); color: white; }
        .badge-soon { background: #333; color: #888; }

        /* ========== MAIN CHAT AREA ========== */
        .main-area {
            display: flex; flex-direction: column;
            background: var(--bg-deep);
        }

        .main-header {
            padding: 16px 24px;
            border-bottom: 1px solid var(--border);
            background: var(--bg-card);
            display: flex; align-items: center;
            justify-content: space-between;
        }

        .main-header h2 { font-size: 14px; font-weight: 600; }
        .main-header .module-name { color: var(--accent); }

        .status-indicator {
            display: flex; align-items: center; gap: 6px;
            font-size: 11px; color: var(--success);
        }

        .status-dot {
            width: 6px; height: 6px;
            background: var(--success); border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }

        .chat-container {
            flex: 1; overflow-y: auto;
            padding: 20px 24px;
            display: flex; flex-direction: column;
            gap: 14px;
        }

        .message {
            display: flex;
            animation: fadeUp 0.3s ease;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .user-msg { justify-content: flex-end; }
        .bot-msg { justify-content: flex-start; }

        .bubble {
            max-width: 72%;
            padding: 12px 16px;
            border-radius: 16px;
            line-height: 1.5;
            font-size: 13px;
        }

        .user-bubble {
            background: var(--accent);
            color: white;
            border-bottom-right-radius: 4px;
        }

        .bot-bubble {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-bottom-left-radius: 4px;
        }

        .bot-bubble b { color: var(--accent); }
        .bot-bubble .highlight { color: var(--gold); }

        .input-area {
            padding: 16px 24px;
            border-top: 1px solid var(--border);
            background: var(--bg-card);
            display: flex; gap: 10px;
        }

        .msg-input {
            flex: 1;
            padding: 12px 18px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 24px;
            color: white; font-size: 13px;
            outline: none;
            transition: all 0.3s;
        }

        .msg-input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(233,69,96,0.08);
        }

        .send-btn {
            width: 42px; height: 42px;
            background: linear-gradient(135deg, var(--accent), var(--accent-glow));
            border: none; border-radius: 50%;
            cursor: pointer; font-size: 18px; color: white;
            transition: all 0.3s;
            display: flex; align-items: center; justify-content: center;
        }

        .send-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 20px rgba(233,69,96,0.3);
        }

        .send-btn:active { transform: scale(0.95); }

        .quick-actions {
            display: flex; gap: 6px;
            padding: 8px 24px; flex-wrap: wrap;
        }

        .quick-btn {
            padding: 6px 12px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 14px;
            color: var(--text-dim);
            font-size: 11px;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }

        .quick-btn:hover {
            background: rgba(233,69,96,0.1);
            border-color: var(--accent);
            color: var(--accent);
        }

        /* ========== RIGHT SIDEBAR ========== */
        .sidebar-right {
            background: var(--bg-card);
            border-left: 1px solid var(--border);
            padding: 16px;
            overflow-y: auto;
            display: flex; flex-direction: column;
            gap: 10px;
        }

        .metric-card {
            background: var(--bg-input);
            border-radius: 10px;
            padding: 14px;
            border: 1px solid var(--border);
        }

        .metric-label {
            font-size: 9px; text-transform: uppercase;
            letter-spacing: 1.5px; color: var(--text-dim);
            margin-bottom: 6px;
        }

        .metric-value {
            font-size: 24px; font-weight: 700;
            background: linear-gradient(135deg, var(--accent), var(--gold));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .metric-sub { font-size: 10px; color: var(--text-dim); margin-top: 2px; }

        .license-box {
            background: var(--bg-input);
            border: 1px solid rgba(240,192,64,0.3);
            border-radius: 10px;
            padding: 14px;
        }

        .license-box h4 {
            font-size: 12px; color: var(--gold);
            margin-bottom: 8px;
        }

        .tier-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 10px; font-weight: 600;
            margin: 2px;
        }

        .tier-starter { background: rgba(41,121,255,0.15); color: #2979ff; }
        .tier-business { background: rgba(255,152,0,0.15); color: #ff9800; }
        .tier-enterprise { background: rgba(0,200,83,0.15); color: #00c853; }

        .license-btn {
            width: 100%; padding: 10px;
            background: linear-gradient(135deg, var(--gold), #d4a020);
            border: none; border-radius: 8px;
            color: #000; font-weight: 700;
            cursor: pointer; font-size: 12px;
            margin-top: 8px;
            transition: all 0.3s;
        }

        .license-btn:hover {
            transform: scale(1.02);
            box-shadow: 0 6px 20px rgba(240,192,64,0.25);
        }

        .hidden-console {
            position: fixed; bottom: 6px; right: 10px;
            font-size: 7px; color: rgba(255,255,255,0.04);
            letter-spacing: 2px; pointer-events: none;
            z-index: -1;
        }

        ::-webkit-scrollbar { width: 3px; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.06); border-radius: 10px; }

        @media (max-width: 768px) {
            .platform { grid-template-columns: 1fr; }
            .sidebar-left, .sidebar-right { display: none; }
        }
    </style>
</head>
<body>

    <div class="platform">
        <!-- ========== LEFT SIDEBAR ========== -->
        <div class="sidebar-left">
            <div class="logo">
                <div class="logo-icon">⚡</div>
                <div class="logo-text">
                    <h3>SUPREME</h3>
