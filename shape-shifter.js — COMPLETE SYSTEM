        const user = demoUsers[userEmail] || demoUsers['sarah@engineering.com'];
        const personaResult = this.detectPersona(user);
        const transformation = this.applyTransformation(personaResult);

        return {
            user,
            detectedPersona: personaResult.persona,
            transformation,
            message: `🎨 Canvas transformed for ${personaResult.persona.name} — ${personaResult.persona.colorScheme} theme applied`
        };
    }

    // =============================================
    // GET ALL PERSONAS SUMMARY
    // =============================================
    getAllPersonasSummary() {
        const personas = [];
        
        for (let [key, persona] of Object.entries(this.personaDetector.personas)) {
            personas.push({
                key,
                name: persona.name,
                icon: persona.icon,
                layout: persona.layout,
                colorScheme: persona.colorScheme,
                components: persona.components.length,
                hiddenComponents: persona.hiddenComponents.length,
                theme: Object.keys(this.canvasEngine.themes).find(t => t === persona.colorScheme) ? '✅' : '⚠️'
            });
        }

        return personas;
    }

    // =============================================
    // SYSTEM STATUS
    // =============================================
    getStatus() {
        return {
            initialized: this.state.initialized,
            totalTransformations: this.state.totalTransformations,
            availablePersonas: Object.keys(this.personaDetector.personas).length,
            availableThemes: Object.keys(this.canvasEngine.themes).length,
            availableLayouts: this.canvasEngine.adapts.LAYOUT.options.length,
            averageSwitchTime: this.state.averageSwitchTime + 'ms',
            userSatisfaction: this.state.userSatisfaction + '%',
            personas: this.getAllPersonasSummary()
        };
    }

    reset() {
        this.transformationLog = [];
        this.state.totalTransformations = 0;
        return { status: 'RESET' };
    }
}

