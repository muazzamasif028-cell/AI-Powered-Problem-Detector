    // =============================================
    // 🎨 DETECT PERSONA FROM USER DATA
    // =============================================
    detectPersona(userData) {
        const detectionId = 'DETECT-' + Date.now().toString(36);
        const startTime = performance.now();

        const { email, jobTitle, department, usagePattern, deviceType } = userData;

        // Multi-factor persona scoring
        const scores = {};

        for (let [personaKey, persona] of Object.entries(this.personaDetector.personas)) {
            let score = 0;

            // Factor 1: Email domain (weight: 30%)
            if (email) {
                const emailLower = email.toLowerCase();
                persona.detectionKeywords.forEach(keyword => {
                    if (emailLower.includes(keyword.toLowerCase())) {
                        score += 30;
                    }
                });
            }

            // Factor 2: Job title (weight: 35%)
            if (jobTitle) {
                const titleLower = jobTitle.toLowerCase();
                persona.detectionKeywords.forEach(keyword => {
                    if (titleLower.includes(keyword.toLowerCase())) {
                        score += 35;
                    }
                });
            }

            // Factor 3: Department (weight: 20%)
            if (department) {
                const deptLower = department.toLowerCase();
                persona.detectionKeywords.forEach(keyword => {
                    if (deptLower.includes(keyword.toLowerCase())) {
                        score += 20;
                    }
                });
            }

            // Factor 4: Usage pattern (weight: 15%)
            if (usagePattern) {
                const patternLower = usagePattern.toLowerCase();
                persona.detectionKeywords.forEach(keyword => {
                    if (patternLower.includes(keyword.toLowerCase())) {
                        score += 15;
                    }
                });
            }

            scores[personaKey] = {
                personaKey,
                personaName: persona.name,
                score: Math.min(100, score),
                confidence: 0
            };
        }

        // Find best match
        let bestPersona = null;
        let highestScore = 0;

        for (let [key, data] of Object.entries(scores)) {
            if (data.score > highestScore) {
                highestScore = data.score;
                bestPersona = key;
            }
        }

        // Calculate confidence
        if (bestPersona && scores[bestPersona]) {
            scores[bestPersona].confidence = (highestScore / 100 * 100).toFixed(1) + '%';
        }

        const persona = bestPersona ? this.personaDetector.personas[bestPersona] : this.personaDetector.personas.DEVELOPER;
        const processingTime = (performance.now() - startTime).toFixed(2);

        // Log transformation
        this.transformationLog.push({
            detectionId,
            user: userData.email || 'Unknown',
            detectedPersona: persona.name,
            confidence: scores[bestPersona]?.confidence || 'N/A',
            processingTime_ms: processingTime,
            timestamp: new Date().toISOString()
        });

        this.state.totalTransformations++;

        return {
            detectionId,
            persona: {
                key: bestPersona,
                name: persona.name,
                icon: persona.icon,
                layout: persona.layout,
                components: persona.components,
                hiddenComponents: persona.hiddenComponents,
                colorScheme: persona.colorScheme,
                fontFamily: persona.fontFamily,
                dataDensity: persona.dataDensity,
                chartTypes: persona.chartTypes,
                shortcutPreset: persona.shortcutPreset,
                onboardingTour: persona.onboardingTour
            },
            theme: this.canvasEngine.themes[persona.colorScheme],
            scores: scores,
            processingTime_ms: processingTime
        };
    }

