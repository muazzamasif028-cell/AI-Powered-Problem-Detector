#!/bin/bash
# ============================================================
# 🤫 SUPREME PLATFORM — PRODUCTION DEPLOYMENT SCRIPT
# ============================================================

set -e

echo "🚀 SUPREME PLATFORM — PRODUCTION DEPLOYMENT"
echo "============================================"
echo ""

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Configuration
APP_NAME="supreme-platform"
DEPLOY_DIR="/var/www/supreme-platform"
GIT_BRANCH="main"
DOCKER_REGISTRY="ghcr.io/supreme-technologies"
TIMESTAMP=$(date +"%Y%m%d-%H%M%S")

# Step 1: Pre-deployment checks
echo -e "${CYAN}📋 Step 1: Pre-deployment checks...${NC}"

if [ ! -f ".env.production" ]; then
    echo -e "${RED}❌ .env.production file not found!${NC}"
    exit 1
fi

if [ ! -f "docker-compose.prod.yml" ]; then
    echo -e "${RED}❌ docker-compose.prod.yml not found!${NC}"
    exit 1
fi

echo -e "${GREEN}✅ Pre-deployment checks passed${NC}"

# Step 2: Pull latest code
echo -e "${CYAN}📦 Step 2: Pulling latest code...${NC}"
git pull origin $GIT_BRANCH
echo -e "${GREEN}✅ Code updated${NC}"

# Step 3: Install dependencies
echo -e "${CYAN}📦 Step 3: Installing dependencies...${NC}"
npm ci --only=production
echo -e "${GREEN}✅ Dependencies installed${NC}"

# Step 4: Run tests
echo -e "${CYAN}🧪 Step 4: Running tests...${NC}"
if npm test 2>/dev/null; then
    echo -e "${GREEN}✅ Tests passed${NC}"
else
    echo -e "${YELLOW}⚠️ Some tests failed — proceeding with caution${NC}"
fi

# Step 5: Build Docker image
echo -e "${CYAN}🐳 Step 5: Building Docker image...${NC}"
docker build -f Dockerfile.prod -t ${APP_NAME}:${TIMESTAMP} -t ${APP_NAME}:latest .
echo -e "${GREEN}✅ Docker image built${NC}"

# Step 6: Backup database
echo -e "${CYAN}💾 Step 6: Backing up database...${NC}"
if docker exec supreme-mongo-prod mongodump --out /backup/${TIMESTAMP} 2>/dev/null; then
    echo -e "${GREEN}✅ Database backed up${NC}"
else
    echo -e "${YELLOW}⚠️ Database backup skipped (container not running?)${NC}"
fi

# Step 7: Deploy with rolling update
echo -e "${CYAN}🚀 Step 7: Deploying with rolling update...${NC}"
docker-compose -f docker-compose.prod.yml up -d --no-deps --build app
echo -e "${GREEN}✅ App deployed${NC}"

# Step 8: Wait for healthy
echo -e "${CYAN}⏳ Step 8: Waiting for health check...${NC}"
for i in {1..30}; do
    if curl -sf http://localhost:5000/api/health > /dev/null 2>&1; then
        echo -e "${GREEN}✅ Health check passed${NC}"
        break
    fi
    if [ $i -eq 30 ]; then
        echo -e "${RED}❌ Health check failed! Rolling back...${NC}"
        docker-compose -f docker-compose.prod.yml up -d --no-deps --build app --rollback
        exit 1
    fi
    sleep 2
done

# Step 9: Reload NGINX
echo -e "${CYAN}🔄 Step 9: Reloading NGINX...${NC}"
docker exec supreme-nginx-prod nginx -s reload
echo -e "${GREEN}✅ NGINX reloaded${NC}"

# Step 10: Cleanup old images
echo -e "${CYAN}🧹 Step 10: Cleaning up...${NC}"
docker image prune -f --filter "until=24h"
echo -e "${GREEN}✅ Cleanup complete${NC}"

# Final Status
echo ""
echo -e "${GREEN}════════════════════════════════════════${NC}"
echo -e "${GREEN}   ✅ DEPLOYMENT SUCCESSFUL!            ${NC}"
echo -e "${GREEN}════════════════════════════════════════${NC}"
echo ""
echo -e "📦 Version: ${TIMESTAMP}"
echo -e "🌐 URL: https://supreme-platform.com"
echo -e "💚 Health: https://supreme-platform.com/api/health"
echo -e "📊 Grafana: https://supreme-platform.com:3000"
echo ""
echo -e "${CYAN}To check logs:${NC}"
echo -e "  docker-compose -f docker-compose.prod.yml logs -f app"
echo ""
echo -e "${CYAN}To rollback:${NC}"
echo -e "  docker-compose -f docker-compose.prod.yml up -d --no-deps app --rollback"
