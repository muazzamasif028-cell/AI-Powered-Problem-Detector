const SupremeConnect = require('./network/SupremeConnect');
const SupremeSatelliteNetwork = require('./network/SupremeSatellite');
const SupremeAINetwork = require('./network/SupremeAINetwork');
const SupremeCloud = require('./network/SupremeCloud');
const SupremeSecurityNetwork = require('./network/SupremeSecurityNetwork');
const SupremeFleetDashboard = require('./network/SupremeFleetDashboard');

async function demoNetwork() {
    console.log('🌐 SUPREME CONNECT — Planetary Network Platform');
    console.log('═══════════════════════════════════════════════\n');
    
    // Initialize Connect for a vehicle
    const vehicle = { vin: 'SUPREME-ELITE-001' };
    const connect = new SupremeConnect(vehicle);
    
    console.log('\n📡 NETWORK STATUS:');
    console.log(`   Primary: ${connect.primaryNetwork.toUpperCase()}`);
    console.log(`   Active Networks: ${connect.getActiveNetworkCount()}`);
    
    // Satellite
    const satellite = new SupremeSatelliteNetwork();
    const satStatus = satellite.getStatus();
    console.log(`\n🛰️ SATELLITE: ${satStatus.constellation}`);
    console.log(`   Coverage: ${satStatus.coverage}`);
    console.log(`   Latency: ${satStatus.latency}`);
    
    // AI Network
    const aiNetwork = new SupremeAINetwork();
    const traffic = await aiNetwork.analyzeTraffic('Dubai');
    console.log(`\n🧠 AI NETWORK:`);
    console.log(`   Congestion: ${traffic.congestionLevel}`);
    console.log(`   Recommendation: ${traffic.recommendations[0]}`);
    
    // Fleet Dashboard
    const dashboard = new SupremeFleetDashboard();
    console.log(`\n📊 FLEET DASHBOARD:`);
    console.log(`   Total Vehicles: All SUPREME products`);
    console.log(`   Monitor: Cars • Trucks • Buses • Jets • Yachts • Bikes`);
    
    console.log('\n✅ SUPREME CONNECT Demo Complete!\n');
}

demoNetwork();
