const express = require('express');
const router = express.Router();
const auth = require('../../middleware/auth');
const isolationEngine = require('../../services/isolation/engine/sovereign-isolation-engine');
const crossTenantGuard = require('../../services/isolation/engine/cross-tenant-guard');
const TenantRegistry = require('../../services/isolation/engine/tenant-registry');

// Admin-only routes
router.use(auth);
router.use(async (req, res, next) => {
    if (req.user.role !== 'admin' && req.user.role !== 'superadmin') {
        return res.status(403).json({ error: 'Admin access required' });
    }
    next();
});

// Create sovereign tenant
router.post('/tenants', async (req, res) => {
    try {
        const tenant = await isolationEngine.createTenant(req.body);
        res.status(201).json({ success: true, tenant });
    } catch (error) {
        res.status(400).json({ success: false, error: error.message });
    }
});

// Get tenant isolation report
router.get('/tenants/:tenantId/report', async (req, res) => {
    const report = await isolationEngine.getIsolationReport(req.params.tenantId);
    res.json({ success: true, report });
});

// Get violation report
router.get('/tenants/:tenantId/violations', async (req, res) => {
    const report = await crossTenantGuard.getViolationReport(req.params.tenantId);
    res.json({ success: true, report });
});

// Verify isolation between two tenants
router.post('/verify-isolation', async (req, res) => {
    const { tenantId1, tenantId2 } = req.body;
    const result = await isolationEngine.verifyIsolation(tenantId1, tenantId2, 'manual_audit');
    res.json({ success: true, result });
});

// List all tenants
router.get('/tenants', async (req, res) => {
    const tenants = await TenantRegistry.listAll();
    res.json({ success: true, tenants: tenants.length, data: tenants });
});

module.exports = router;
