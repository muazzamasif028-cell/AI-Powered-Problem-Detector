    detectDatabases(company) {
        const dbMap = {
            JPMorgan: ['Oracle DB (500 instances)', 'MongoDB (200 clusters)', 'DB2 (300 mainframes)'],
            Boeing: ['SQL Server (400 instances)', 'PostgreSQL (150 clusters)', 'Proprietary DB (50 systems)'],
            NASA: ['Cassandra (100 clusters)', 'MySQL (300 instances)', 'Custom Scientific DB (200)'],
            default: ['Multiple database types detected — Auto-mapping']
        };
        return dbMap[company] || dbMap.default;
    }

    detectLegacyCode(company) {
        const legacyMap = {
            JPMorgan: { COBOL: '220B lines', Java: '150B lines', Cpp: '80B lines' },
            Boeing: { FORTRAN: '50B lines', Ada: '30B lines', Cpp: '100B lines' },
            NASA: { FORTRAN: '80B lines', C: '120B lines', Assembly: '20B lines' },
            default: { COBOL: '100B lines', FORTRAN: '50B lines', Cpp: '150B lines' }
        };
        return legacyMap[company] || legacyMap.default;
    }

    detectAPIs(company) { return { total: '5,000+ APIs', rest: '60%', graphql: '15%', soap: '25%' }; }
    detectDependencies(company) { return { internal: '2,000+', external: '500+', thirdParty: '300+' }; }

