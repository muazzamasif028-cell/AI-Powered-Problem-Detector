// gateway/PaymentGateway.java
package com.supreme.billing.gateway;

import com.supreme.billing.dto.PaymentRequest;
import com.supreme.billing.dto.PaymentResponse;
import com.supreme.billing.model.PaymentMethod;

public interface PaymentGateway {
    PaymentResponse processPayment(PaymentRequest request);
    PaymentResponse refund(String transactionId, BigDecimal amount);
    PaymentResponse verifyPayment(String transactionId);
    PaymentGatewayType getType();
    List<PaymentMethod> getSupportedMethods();
    
    enum PaymentGatewayType {
        STRIPE, PAYPAL, SAFEPAY, PAYFAST, HBL, 
        BANK_ALFALAH, MEEZAN, JAZZCASH, EASYPAISA,
        UBL, KEENU, NIFT
    }
}
// gateway/SafePayGateway.java
package com.supreme.billing.gateway;

import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.web.client.RestTemplate;
import org.springframework.http.*;
import com.supreme.billing.dto.*;
import java.util.*;

@Component
@Slf4j
public class SafePayGateway implements PaymentGateway {
    
    @Value("${safepay.api.key}")
    private String apiKey;
    
    @Value("${safepay.api.secret}")
    private String apiSecret;
    
    @Value("${safepay.api.url}")
    private String apiUrl;
    
    private final RestTemplate restTemplate;
    
    public SafePayGateway() {
        this.restTemplate = new RestTemplate();
    }
    
    @Override
    public PaymentResponse processPayment(PaymentRequest request) {
        try {
            HttpHeaders headers = createHeaders();
            
            Map<String, Object> body = new HashMap<>();
            body.put("amount", request.getAmount());
            body.put("currency", request.getCurrency());
            body.put("order_id", request.getOrderId());
            body.put("customer", Map.of(
                "name", request.getCustomerName(),
                "email", request.getCustomerEmail(),
                "phone", request.getCustomerPhone()
            ));
            body.put("return_url", request.getReturnUrl());
            body.put("cancel_url", request.getCancelUrl());
            
            HttpEntity<Map<String, Object>> entity = new HttpEntity<>(body, headers);
            
            ResponseEntity<Map> response = restTemplate.exchange(
                apiUrl + "/transaction/v1/create",
                HttpMethod.POST,
                entity,
                Map.class
            );
            
            Map<String, Object> responseBody = response.getBody();
            
            return PaymentResponse.builder()
                .success(true)
                .transactionId((String) responseBody.get("token"))
                .redirectUrl((String) responseBody.get("redirect_url"))
                .gateway(PaymentGatewayType.SAFEPAY)
                .build();
                
        } catch (Exception e) {
            log.error("SafePay payment failed", e);
            return PaymentResponse.builder()
                .success(false)
                .error(e.getMessage())
                .gateway(PaymentGatewayType.SAFEPAY)
                .build();
        }
    }
    
    @Override
    public PaymentResponse refund(String transactionId, BigDecimal amount) {
        // Implementation for SafePay refund
        return null;
    }
    
    @Override
    public PaymentResponse verifyPayment(String transactionId) {
        // Implementation for verification
        return null;
    }
    
    @Override
    public PaymentGatewayType getType() {
        return PaymentGatewayType.SAFEPAY;
    }
    
    @Override
    public List<PaymentMethod> getSupportedMethods() {
        return List.of(
            PaymentMethod.CREDIT_CARD,
            PaymentMethod.DEBIT_CARD,
            PaymentMethod.BANK_TRANSFER
        );
    }
    
    private HttpHeaders createHeaders() {
        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.APPLICATION_JSON);
        headers.set("X-API-Key", apiKey);
        headers.setBearerAuth(apiSecret);
        return headers;
    }
}

