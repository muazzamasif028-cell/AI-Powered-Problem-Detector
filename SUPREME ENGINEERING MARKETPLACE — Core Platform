            { id: 'MACHINE_DESIGNS', name: 'Machine Designs', emoji: '🏭', types: ['CNC', 'Robotic Arm', 'Conveyor', 'Press'] },
            { id: 'CAD_COMPONENTS', name: 'CAD Components', emoji: '🧩', types: ['Fasteners', 'Brackets', 'Housings', 'Mounts'] },
            { id: 'TEMPLATES', name: 'Engineering Templates', emoji: '📄', types: ['BOM', 'FEA', 'CFD', 'Documentation'] }
