            { id: 'CHASSIS_DESIGNS', name: 'Chassis Designs', emoji: '🛡️', types: ['Monocoque', 'Space Frame', 'Skateboard'] },
            { id: 'ROBOT_DESIGNS', name: 'Robot Designs', emoji: '🤖', types: ['Humanoid', 'Industrial', 'Medical', 'Drone'] },
            { id: 'AIRCRAFT_CONCEPTS', name: 'Aircraft Concepts', emoji: '✈️', types: ['Jets', 'eVTOL', 'Drones', 'Helicopters'] },
