                priceMultiplier: 3.0,
                description: 'For commercial products and services',
                restrictions: ['No reselling the design itself'],
                allowsManufacturing: true,
                maxUnits: 1000
            },
            MANUFACTURING: {
                name: 'Manufacturing License',
                emoji: '🏭',
                priceMultiplier: 10.0,
                description: 'Full manufacturing rights',
