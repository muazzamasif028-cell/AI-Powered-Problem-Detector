# ============================================================
# 🧱 kubernetes/tenant-isolation.yaml
# SUPREME Per-Tenant Kubernetes Isolation
# ============================================================

# Example: Tenant TNT-A1B2C3
---
apiVersion: v1
kind: Namespace
metadata:
  name: tenant-tnt-a1b2c3
  labels:
    tenant-id: tnt-a1b2c3
    tenant-type: enterprise
    isolation-level: sovereign
  annotations:
    supreme-os.com/tenant-name: "Google"
    supreme-os.com/isolation: "strict"

---
# Resource Quota — Limits per tenant
apiVersion: v1
kind: ResourceQuota
metadata:
  name: tenant-quota
  namespace: tenant-tnt-a1b2c3
spec:
  hard:
    requests.cpu: "100"
    requests.memory: "256Gi"
    limits.cpu: "200"
    limits.memory: "512Gi"
    requests.storage: "1Ti"
    persistentvolumeclaims: "50"
    pods: "1000"
    services: "100"
    secrets: "500"
    configmaps: "200"

---
# Network Policy — DENY ALL cross-namespace traffic
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: deny-cross-namespace
  namespace: tenant-tnt-a1b2c3
spec:
  podSelector: {}
  policyTypes:
  - Ingress
  - Egress
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          tenant-id: tnt-a1b2c3  # ONLY same tenant
  egress:
  - to:
    - namespaceSelector:
        matchLabels:
          tenant-id: tnt-a1b2c3  # ONLY same tenant

---
# LimitRange
apiVersion: v1
kind: LimitRange
metadata:
  name: tenant-limits
  namespace: tenant-tnt-a1b2c3
spec:
  limits:
  - default:
      cpu: "500m"
      memory: "512Mi"
    defaultRequest:
      cpu: "200m"
      memory: "256Mi"
    type: Container

---
# Pod Security Policy
apiVersion: policy/v1
kind: PodSecurityPolicy
metadata:
  name: tenant-psp
  namespace: tenant-tnt-a1b2c3
spec:
  privileged: false
  allowPrivilegeEscalation: false
  requiredDropCapabilities:
  - ALL
  volumes:
  - 'configMap'
  - 'emptyDir'
  - 'persistentVolumeClaim'
  - 'secret'
  hostNetwork: false
  hostPID: false
  hostIPC: false
  runAsUser:
    rule: 'MustRunAsNonRoot'
  seLinux:
    rule: 'RunAsAny'
  fsGroup:
    rule: 'MustRunAs'
    ranges:
    - min: 1
      max: 65535
