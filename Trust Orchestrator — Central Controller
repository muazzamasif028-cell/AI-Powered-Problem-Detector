// SUPREME Trust Orchestrator — Coordinates all trust layers
// ============================================================

const evidenceEngine = require('./evidence-engine.service');
const contradictionDetector = require('./contradiction-detector.service');
const selfAuditEngine = require('./self-audit-engine.service');
const hallucinationDetector = require('./hallucination-detector.service');
const sourceRanking = require('./source-ranking.service');
const knowledgeFreshness = require('./knowledge-freshness.service');
const aiJudge = require('./ai-judge.service');
const reproducibility = require('./reproducibility.service');
const safetyEngine = require('./safety-engine.service');
const explainability = require('./explainability.service');

class TrustOrchestrator {
    constructor() {
        this.layers = [
            { name: 'Evidence', priority: 1, engine: evidenceEngine, critical: true },
            { name: 'Hallucination', priority: 2, engine: hallucinationDetector, critical: true },
            { name: 'Contradiction', priority: 3, engine: contradictionDetector, critical: true },
            { name: 'Self Audit', priority: 4, engine: selfAuditEngine, critical: false },
            { name: 'Source Ranking', priority: 5, engine: sourceRanking, critical: false },
            { name: 'Knowledge Freshness', priority: 6, engine: knowledgeFreshness, critical: false },
            { name: 'Reproducibility', priority: 7, engine: reproducibility, critical: false },
            { name: 'Safety', priority: 8, engine: safetyEngine, critical: true },
            { name: 'AI Judge', priority: 9, engine: aiJudge, critical: true },
            { name: 'Explainability', priority: 10, engine: explainability, critical: true }
        ];

        this.passThreshold = 7; // Minimum layers to pass
        this.criticalPassRequired = true; // All critical layers must pass
    }

    /**
     * Full trust verification pipeline
     */
    async verify(userId, query, response, provider, context = {}) {
        const startTime = Date.now();
        const results = [];
        let overallScore = 0;
        let criticalPassed = true;

        console.log(`🛡️ Starting Trust Verification for query: "${query.substring(0, 50)}..."`);

        // Run all trust layers
        for (const layer of this.layers) {
            try {
                const result = await layer.engine.evaluate(query, response, {
                    userId,
                    provider,
                    ...context
                });

                results.push({
                    layer: layer.name,
                    priority: layer.priority,
                    critical: layer.critical,
                    passed: result.passed,
                    score: result.score,
                    details: result.details,
                    warnings: result.warnings || [],
                    recommendations: result.recommendations || []
                });

                overallScore += result.score;

                if (layer.critical && !result.passed) {
                    criticalPassed = false;
                }

            } catch (error) {
                results.push({
                    layer: layer.name,
                    priority: layer.priority,
                    critical: layer.critical,
                    passed: false,
                    score: 0,
                    error: error.message
                });
            }
        }

        // Calculate final verdict
        const passedLayers = results.filter(r => r.passed).length;
        const averageScore = results.length > 0 ? overallScore / results.length : 0;
        
        const finalVerdict = this.determineVerdict(
            passedLayers,
            averageScore,
            criticalPassed
        );

        return {
            query: query.substring(0, 100),
            provider,
            timestamp: new Date().toISOString(),
            timeTaken: Date.now() - startTime,
            verdict: finalVerdict,
            overallScore: averageScore,
            passedLayers,
            totalLayers: results.length,
            criticalPassed,
            layers: results,
            summary: this.generateSummary(finalVerdict, results),
            recommendations: this.collectRecommendations(results)
        };
    }

    /**
     * Quick verification (critical layers only)
     */
    async quickVerify(query, response, provider) {
        const criticalLayers = this.layers.filter(l => l.critical);
        const results = [];

        for (const layer of criticalLayers) {
            try {
                const result = await layer.engine.evaluate(query, response, { provider });
                results.push({
                    layer: layer.name,
                    passed: result.passed,
                    score: result.score
                });
            } catch (error) {
                results.push({
                    layer: layer.name,
                    passed: false,
                    score: 0
                });
            }
        }

        const allPassed = results.every(r => r.passed);
        
        return {
            passed: allPassed,
            quickVerdict: allPassed ? 'APPROVED' : 'REJECTED',
            checks: results
        };
    }

    /**
     * Determine final verdict
     */
    determineVerdict(passedLayers, averageScore, criticalPassed) {
        if (!criticalPassed) {
            return {
                level: 'REJECTED',
                color: '#ff0000',
                icon: '🚫',
                label: 'Rejected — Critical checks failed',
                actionable: false
            };
        }

        if (averageScore >= 0.95 && passedLayers >= 9) {
            return {
                level: 'VERIFIED',
                color: '#3fb950',
                icon: '✅',
                label: 'Fully Verified — Safe to use',
                actionable: true
            };
        }

        if (averageScore >= 0.85 && passedLayers >= 7) {
            return {
                level: 'TRUSTED',
                color: '#38bdf8',
                icon: '👍',
                label: 'Trusted — Minor issues found',
                actionable: true
            };
        }

        if (averageScore >= 0.70 && passedLayers >= 5) {
            return {
                level: 'CAUTION',
                color: '#d29922',
                icon: '⚠️',
                label: 'Use with Caution — Several issues detected',
                actionable: true
            };
        }

        if (averageScore >= 0.50) {
            return {
                level: 'UNRELIABLE',
                color: '#f85149',
                icon: '❌',
                label: 'Unreliable — Needs human review',
                actionable: false
            };
        }

        return {
            level: 'DANGEROUS',
            color: '#ff0000',
            icon: '☠️',
            label: 'Dangerous — Do not use',
            actionable: false
        };
    }

    /**
     * Generate summary
     */
    generateSummary(verdict, results) {
        const warnings = results.flatMap(r => r.warnings || []);
        const passed = results.filter(r => r.passed).length;
        
        return {
            verdict: verdict.label,
            totalChecks: results.length,
            passed,
            failed: results.length - passed,
            warnings: warnings.length,
            topIssues: results
                .filter(r => !r.passed)
                .sort((a, b) => a.priority - b.priority)
                .slice(0, 3)
                .map(r => ({
                    layer: r.layer,
                    issue: r.details?.issue || 'Check failed'
                }))
        };
    }

    /**
     * Collect recommendations from all layers
     */
    collectRecommendations(results) {
        return results
            .flatMap(r => r.recommendations || [])
            .filter((rec, index, self) => 
                self.findIndex(r => r.message === rec.message) === index
            );
    }

    /**
     * Get trust score for a provider
     */
    async getProviderTrustScore(provider) {
        // Aggregate historical trust scores
        return {
            provider,
            overallTrust: 0.92,
            evidenceScore: 0.95,
            hallucinationRate: 0.02,
            consistencyScore: 0.88,
            safetyScore: 0.98
        };
    }
}

module.exports = new TrustOrchestrator();
