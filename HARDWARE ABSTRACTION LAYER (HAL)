// ============================================================
// 🏗️ HARDWARE ABSTRACTION LAYER (HAL)
// ============================================================

hal SupremeVehicleHAL {
    
    // ============================================
    // SENSORS
    // ============================================
    sensors {
        camera front_main {
            type: "Sony IMX490"
            resolution: 8MP
            fps: 60
            hdr: true
            interface: MIPI_CSI2
            buffer: 4
        }
        
        camera front_wide {
            type: "Sony IMX390"
            resolution: 5MP
            fps: 30
            fov: 120°
        }
        
        lidar main {
            type: "Velodyne Alpha Prime"
            range: 300m
            points_per_second: 2_000_000
            fov: [360° horizontal, 40° vertical]
            interface: AutomotiveEthernet
        }
        
        radar front {
            type: "Continental ARS540"
            range: 300m
            fov: [±60° horizontal, ±20° vertical]
            interface: CAN_FD
        }
        
        radar corner {
            count: 4
            type: "Bosch MRR"
            range: 160m
            purpose: blind_spot_detection
        }
        
        ultrasonic {
            count: 12
            range: 5m
            purpose: parking
        }
        
        gps {
            type: "u-blox F9"
            precision: 1cm
            update_rate: 100hz
            constellations: [GPS, Galileo, BeiDou, GLONASS]
        }
        
        imu {
            type: "Bosch BMI088"
            axes: 6
            update_rate: 1000hz
        }
    }
    
    // ============================================
    // COMPUTE
    // ============================================
    compute {
        cpu {
            type: "ARM Cortex-A78AE"
            cores: 12
            frequency: 2.5ghz
            safety: ASIL_D
        }
        
        gpu {
            type: "NVIDIA Orin"
            tflops: 254
            cores: 2048
            memory: 32gb HBM3
        }
        
        npu {
            type: "Custom SUPREME NPU"
            tops: 500
            purpose: [ai_inference, vision, llm]
            precision: [INT8, FP16, BF16]
        }
        
        fpga {
            type: "Xilinx Zynq UltraScale+"
            purpose: [sensor_fusion, signal_processing]
            reprogrammable: true
        }
        
        safety_mcu {
            type: "ARM Cortex-R52"
            cores: 2
            purpose: [watchdog, emergency, monitoring]
            certified: [ISO_26262, ASIL_D]
        }
    }
    
    // ============================================
    // COMMUNICATION
    // ============================================
    communication {
        can {
            channels: 4
            speed: [500kbps, 1mbps]
        }
        
        can_fd {
            channels: 2
            speed: 5mbps
        }
        
        flexray {
            channels: 2
            speed: 10mbps
        }
        
        automotive_ethernet {
            ports: 4
            speed: [1gbps, 10gbps]
            tsn: true
        }
        
        lte_5g {
            modem: "Qualcomm X65"
            speed: 10gbps
            purpose: [telemetry, ota, fleet]
        }
        
        wifi_6e {
            purpose: [garage_updates, diagnostics]
        }
        
        bluetooth_5_3 {
            purpose: [phone_key, media, diagnostics]
        }
        
        uwb {
            purpose: [precise_location, digital_key]
        }
    }
}
