// 📊 src/monitoring/metrics.js
// Prometheus Metrics Collection
// ============================================================
const prometheus = require('prom-client');

class MetricsService {
    constructor() {
        this.register = new prometheus.Registry();
        
        // Enable default metrics (CPU, memory, etc.)
        prometheus.collectDefaultMetrics({ register: this.register });
        
        // Define custom metrics
        this.defineCustomMetrics();
    }

    /**
     * Define custom metrics
     */
    defineCustomMetrics() {
        // HTTP metrics
        this.httpRequestDuration = new prometheus.Histogram({
            name: 'supreme_http_request_duration_seconds',
            help: 'HTTP request duration in seconds',
            labelNames: ['method', 'path', 'status'],
            buckets: [0.01, 0.05, 0.1, 0.5, 1, 2, 5, 10],
            registers: [this.register]
        });

        this.httpRequestTotal = new prometheus.Counter({
            name: 'supreme_http_requests_total',
            help: 'Total HTTP requests',
            labelNames: ['method', 'path', 'status'],
            registers: [this.register]
        });

        // Business metrics
        this.domainsRegistered = new prometheus.Counter({
            name: 'supreme_domains_registered_total',
            help: 'Total domains registered',
            labelNames: ['tld'],
            registers: [this.register]
        });

        this.revenueTotal = new prometheus.Counter({
            name: 'supreme_revenue_total',
            help: 'Total revenue',
            labelNames: ['currency', 'type'],
            registers: [this.register]
        });

        this.aiTokensUsed = new prometheus.Counter({
            name: 'supreme_ai_tokens_total',
            help: 'Total AI tokens used',
            labelNames: ['model'],
            registers: [this.register]
        });

        this.activeUsers = new prometheus.Gauge({
            name: 'supreme_active_users',
            help: 'Number of active users',
            registers: [this.register]
        });

        this.invoiceAmount = new prometheus.Histogram({
            name: 'supreme_invoice_amount',
            help: 'Invoice amounts',
            labelNames: ['currency', 'type'],
            buckets: [10, 50, 100, 500, 1000, 5000, 10000],
            registers: [this.register]
        });

        // System metrics
        this.queueSize = new prometheus.Gauge({
            name: 'supreme_queue_size',
            help: 'Queue size',
            labelNames: ['queue_name'],
            registers: [this.register]
        });

        this.dbQueryDuration = new prometheus.Histogram({
            name: 'supreme_db_query_duration_seconds',
            help: 'Database query duration',
            labelNames: ['operation', 'collection'],
            buckets: [0.001, 0.005, 0.01, 0.05, 0.1, 0.5, 1],
            registers: [this.register]
        });

        this.cacheHitRate = new prometheus.Gauge({
            name: 'supreme_cache_hit_rate',
            help: 'Cache hit rate percentage',
            registers: [this.register]
        });

        this.errorTotal = new prometheus.Counter({
            name: 'supreme_errors_total',
            help: 'Total errors',
            labelNames: ['type', 'service'],
            registers: [this.register]
        });
    }

    /**
     * Record HTTP request
     */
    recordHTTPRequest(method, path, status, duration) {
        this.httpRequestTotal.inc({ method, path, status });
        this.httpRequestDuration.observe({ method, path, status }, duration);
    }

    /**
     * Record domain registration
     */
    recordDomainRegistration(tld) {
        this.domainsRegistered.inc({ tld });
    }

    /**
     * Record revenue
     */
    recordRevenue(amount, currency, type) {
        this.revenueTotal.inc({ currency, type }, amount);
        this.invoiceAmount.observe({ currency, type }, amount);
    }

    /**
     * Record AI tokens
     */
    recordAITokens(count, model) {
        this.aiTokensUsed.inc({ model }, count);
    }

    /**
     * Update active users
     */
    updateActiveUsers(count) {
        this.activeUsers.set(count);
    }

    /**
     * Update queue size
     */
    updateQueueSize(queueName, size) {
        this.queueSize.set({ queue_name: queueName }, size);
    }

    /**
     * Record database query
     */
    recordDBQuery(operation, collection, duration) {
        this.dbQueryDuration.observe({ operation, collection }, duration);
    }

    /**
     * Update cache hit rate
     */
    updateCacheHitRate(rate) {
        this.cacheHitRate.set(rate);
    }

    /**
     * Record error
     */
    recordError(type, service) {
        this.errorTotal.inc({ type, service });
    }

    /**
     * Get metrics for Prometheus scraping
     */
    async getMetrics() {
        return this.register.metrics();
    }

    /**
     * Get metrics summary (for admin dashboard)
     */
    async getSummary() {
        const metrics = await this.register.getMetricsAsJSON();
        
        return {
            timestamp: new Date().toISOString(),
            metrics: metrics.map(m => ({
                name: m.name,
                help: m.help,
                type: m.type,
                values: m.values
            }))
        };
    }
}

module.exports = new MetricsService();
