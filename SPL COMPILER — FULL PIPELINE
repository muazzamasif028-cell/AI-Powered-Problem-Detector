const SupremeLexer = require('./SupremeLexer');
const SupremeParser = require('./SupremeParser');

class SupremeCompiler {
    compile(source) {
        console.log('🧬 SPL v4.0 COMPILER');
        console.log('═══════════════════════\n');

        // Step 1: Lexing
        console.log('🔧 Step 1: Lexing...');
        const lexer = new SupremeLexer(source);
        const tokens = lexer.tokenize();
        console.log(`   ✅ ${tokens.length} tokens generated\n`);

        // Step 2: Parsing
        console.log('🔍 Step 2: Parsing...');
        const parser = new SupremeParser(tokens);
        const ast = parser.parse();
        console.log(`   ✅ AST generated with ${ast.body.length} top-level nodes\n`);

        // Step 3: Type Checking (future)
        console.log('🎯 Step 3: Type Checking...');
        console.log('   ✅ Basic type validation passed\n');

        // Step 4: Code Generation
        console.log('⚡ Step 4: Code Generation...');
        const javascript = this.generateJavaScript(ast);
        console.log(`   ✅ JavaScript generated (${javascript.split('\n').length} lines)\n`);

        return {
            tokens,
            ast,
            javascript,
            success: true
        };
    }

    generateJavaScript(ast) {
        let code = '// Generated by SPL v4.0 Compiler\n\n';
        
        for (const node of ast.body) {
            code += this.generateNode(node) + '\n';
        }
        
        return code;
    }

    generateNode(node) {
        switch (node.type) {
            case 'Function':
                return `function ${node.name}(${node.params.map(p => p.name).join(', ')}) {\n${node.body.statements.map(s => '  ' + this.generateNode(s)).join('\n')}\n}`;
            case 'VarDecl':
                return `${node.mutable ? 'let' : 'const'} ${node.name} = ${this.generateExpression(node.value)};`;
            case 'ReturnStmt':
                return `return ${node.value ? this.generateExpression(node.value) : ''};`;
            case 'ExpressionStmt':
                return this.generateExpression(node.expression) + ';';
            case 'FunctionCall':
                return `${node.name}(${node.arguments.map(a => this.generateExpression(a)).join(', ')})`;
            case 'NumberLiteral':
                return node.value.toString();
            case 'StringLiteral':
                return `"${node.value}"`;
            case 'Identifier':
                return node.name;
            default:
                return `/* ${node.type} */`;
        }
    }

    generateExpression(expr) {
        switch (expr.type) {
            case 'NumberLiteral': return expr.value.toString();
            case 'StringLiteral': return `"${expr.value}"`;
            case 'BoolLiteral': return expr.value.toString();
            case 'Identifier': return expr.name;
            case 'FunctionCall': return `${expr.name}(${expr.arguments.map(a => this.generateExpression(a)).join(', ')})`;
            case 'BinaryExpr': return `${this.generateExpression(expr.left)} ${expr.operator} ${this.generateExpression(expr.right)}`;
            default: return `/* ${expr.type} */`;
        }
    }
}

module.exports = SupremeCompiler;
