// ============================================================
// AUTH MIDDLEWARE
// ============================================================
const authenticate = (req, res, next) => {
    const token = req.headers.authorization?.replace('Bearer ', '');
    if (!token) return res.status(401).json({ error: 'Authentication required', code: 'AUTH_REQUIRED' });
    const sessionCheck = authSystem.verifySession(token);
    if (!sessionCheck.valid) return res.status(401).json({ error: sessionCheck.error, code: 'INVALID_SESSION' });
    req.userSession = sessionCheck.session;
    req.companyId = sessionCheck.session.companyId;
    req.userRole = sessionCheck.session.role;
    next();
};

const requirePermission = (permission) => (req, res, next) => {
    if (!authSystem.hasPermission(req.userSession, permission)) return res.status(403).json({ error: 'Insufficient permissions', code: 'PERMISSION_DENIED', required: permission });
    next();
};

const companyIsolation = (req, res, next) => {
    if (req.params.companyId && req.params.companyId !== req.companyId && req.userRole !== 'SUPER_ADMIN') return res.status(403).json({ error: 'Cross-company access denied', code: 'COMPANY_ISOLATION' });
    next();
};

