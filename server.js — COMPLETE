// MIDDLEWARE: AUTHENTICATION CHECK
// ============================================================
const authenticate = (req, res, next) => {
    const token = req.headers.authorization?.replace('Bearer ', '');
    
    if (!token) {
        return res.status(401).json({ error: 'Authentication required', code: 'AUTH_REQUIRED' });
    }

    const sessionCheck = authSystem.verifySession(token);
    
    if (!sessionCheck.valid) {
        return res.status(401).json({ error: sessionCheck.error, code: 'INVALID_SESSION' });
    }

    req.userSession = sessionCheck.session;
    req.companyId = sessionCheck.session.companyId;
    req.userRole = sessionCheck.session.role;
    
    next();
};

// ============================================================
// MIDDLEWARE: PERMISSION CHECK
// ============================================================
const requirePermission = (permission) => {
    return (req, res, next) => {
        if (!authSystem.hasPermission(req.userSession, permission)) {
            return res.status(403).json({ 
                error: 'Insufficient permissions', 
                code: 'PERMISSION_DENIED',
                required: permission 
            });
        }
        next();
    };
};

// ============================================================
// MIDDLEWARE: COMPANY ISOLATION
// ============================================================
const companyIsolation = (req, res, next) => {
    // Ensure users can only access their company's data
    if (req.params.companyId && req.params.companyId !== req.companyId) {
        if (req.userRole !== 'SUPER_ADMIN') {
            return res.status(403).json({ 
                error: 'Cross-company access denied', 
                code: 'COMPANY_ISOLATION' 
            });
        }
    }
    next();
};

