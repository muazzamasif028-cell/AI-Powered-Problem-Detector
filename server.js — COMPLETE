const diagRouter = express.Router();
diagRouter.use(authenticate);
diagRouter.use(companyIsolation);

// Run Full Diagnostic
diagRouter.post('/full', async (req, res) => {
    try {
        const { input } = req.body;
        
        // Execute full pipeline
        const executionResult = await executionEngine.execute(input, {
            companyId: req.companyId,
            userId: req.userSession.userId
        });
        
        // Root cause analysis
        const rootCause = await rootCauseEngine.analyze(input);
        
        // Generate solution
        const solution = await solutionEngine.generateSolution(rootCause.rootCause, {
            autoApply: req.userRole === 'SUPER_ADMIN'
        });
        
        // Calculate confidence
        const confidence = await confidenceScoring.calculateScore({
            issues: rootCause.rootCause.allPossibleCauses.map(c => ({ module: c })),
            summary: { overallStatus: rootCause.rootCause.consensus === 'STRONG' ? 'CRITICAL' : 'WARNING' },
            patternsDetected: rootCause.rootCause.allPossibleCauses.length,
            severity: rootCause.rootCause.category === 'SECURITY_INCIDENT' ? 'CRITICAL' : 'HIGH'
        });
        
        res.json({
            execution: executionResult,
            rootCause: rootCause,
            solution: solution,
            confidence: confidence,
            timestamp: new Date().toISOString()
        });
        
    } catch (error) {
        res.status(500).json({ error: 'Diagnostics failed', code: 'DIAG_ERROR' });
    }
});

