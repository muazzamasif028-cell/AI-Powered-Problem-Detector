const authRouter = express.Router();

authRouter.post('/signin', async (req, res) => {
    try {
        const { email, password, companyCode } = req.body;
        const result = companyCode ? await authSystem.signInWithCompanyCode(email, password, companyCode) : await authSystem.signIn(email, password);
        result.success ? res.json(result) : res.status(401).json(result);
    } catch (error) { res.status(500).json({ error: 'Sign in failed', code: 'AUTH_ERROR' }); }
});

authRouter.post('/signup', async (req, res) => {
    try {
        const { company, admin } = req.body;
        const result = await authSystem.signUpCompany(company, admin);
        result.success ? res.status(201).json(result) : res.status(400).json(result);
    } catch (error) { res.status(500).json({ error: 'Registration failed', code: 'REG_ERROR' }); }
});

authRouter.post('/signout', authenticate, (req, res) => {
    const token = req.headers.authorization?.replace('Bearer ', '');
    res.json(authSystem.signOut(token));
});

authRouter.get('/verify', authenticate, (req, res) => res.json({ valid: true, session: req.userSession, timestamp: new Date().toISOString() }));

authRouter.get('/me', authenticate, (req, res) => {
    const company = authSystem.companies.get(req.companyId);
    const user = authSystem.users.get(req.userSession.userId);
    res.json({ user: { id: user?.id, name: user?.name, email: user?.email, role: user?.role, permissions: user?.permissions }, company: company ? { id: company.id, name: company.name, tier: company.tier, features: company.features } : null });
});

