    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><defs><linearGradient id='g' x1='0%' y1='0%' x2='100%' y2='100%'><stop offset='0%' style='stop-color:#38bdf8'/><stop offset='100%' style='stop-color:#c084fc'/></linearGradient></defs><rect width='100' height='100' rx='20' fill='url(#g)'/><text y='78' x='50' text-anchor='middle' font-size='65'>⚡</text></svg>">
    
