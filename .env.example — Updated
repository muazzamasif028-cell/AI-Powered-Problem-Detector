# Payment Providers (Choose one or all)
PAYMENT_PROVIDER=paddle  # paddle | lemonsqueezy | paypal

# Paddle (Merchant of Record - Handles global taxes)
PADDLE_API_KEY=your_paddle_api_key
PADDLE_CLIENT_TOKEN=your_paddle_client_token
PADDLE_WEBHOOK_SECRET=your_webhook_secret

# Lemon Squeezy (MoR - Simple & Modern)
LEMONSQUEEZY_API_KEY=your_ls_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret

# PayPal (Traditional - Country dependent)
PAYPAL_CLIENT_ID=your_paypal_client_id
