AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=supreme-platform-storage

# ============================================
# GOOGLE CLOUD
# ============================================
GOOGLE_CLOUD_PROJECT_ID=your-project-id
