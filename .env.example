# ============================================================
# SUPREME PLATFORM v14.0.0 — Environment Configuration
# Copy this file to .env and fill in real values: cp .env.example .env
# ============================================================

# Port the HTTP server binds to.
PORT=5000

# Runtime mode: development | production
# In production, session cookies are marked Secure and 5xx bodies are redacted.
NODE_ENV=development

# Signing key for JWT sessions AND the express-session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset, an ephemeral key is generated at boot and every restart invalidates
# all existing tokens.
SESSION_SECRET=

# Comma-separated list of origins allowed by CORS.
# Leave empty to reflect the request origin (development only).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
