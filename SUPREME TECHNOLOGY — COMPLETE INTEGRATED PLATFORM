                return {
                    safe: threats.length === 0,
                    threatsFound: threats,
                    pillarsActive: this.pillars,
                    action: threats.length > 0 ? 'BLOCKED & QUARANTINED' : 'PASSED',
                    threatLevel: threats.length > 0 ? 'HIGH' : 'NONE'
                };
            }
        }
        
