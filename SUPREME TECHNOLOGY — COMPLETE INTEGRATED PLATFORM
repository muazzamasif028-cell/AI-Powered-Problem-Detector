<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supreme Technology | Enterprise Platform</title>
    <style>
        :root {
            --bg-deep: #0a0a0f;
            --bg-card: #12121a;
            --bg-input: #1a1a2e;
            --accent: #e94560;
            --accent-glow: #ff6b81;
            --gold: #f0c040;
            --text: #e0e0e0;
            --text-dim: #888;
            --border: rgba(255,255,255,0.06);
            --success: #00c853;
            --warning: #ff9800;
            --danger: #ff1744;
            --info: #2979ff;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: var(--bg-deep);
            color: var(--text);
            min-height: 100vh;
        }

        /* ========== MAIN LAYOUT ========== */
        .platform-container {
            display: grid;
            grid-template-columns: 280px 1fr 320px;
            height: 100vh;
            overflow: hidden;
        }

        /* ========== SIDEBAR LEFT - MODULES ========== */
        .sidebar-left {
            background: var(--bg-card);
            border-right: 1px solid var(--border);
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            overflow-y: auto;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 10px;
        }

        .logo-icon {
            width: 42px; height: 42px;
            background: linear-gradient(135deg, var(--accent), var(--gold));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .logo-text h3 {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .logo-text span {
            font-size: 10px;
            color: var(--text-dim);
            letter-spacing: 2px;
        }

        .nav-section {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--text-dim);
            padding: 15px 10px 5px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 15px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 13px;
            color: var(--text-dim);
            border: 1px solid transparent;
        }

        .nav-item:hover {
            background: rgba(255,255,255,0.03);
            color: var(--text);
        }

        .nav-item.active {
            background: rgba(233,69,96,0.1);
            color: var(--accent);
            border-color: rgba(233,69,96,0.2);
            font-weight: 600;
        }

        .nav-badge {
            margin-left: auto;
            font-size: 10px;
            background: var(--accent);
            color: white;
            padding: 3px 8px;
            border-radius: 12px;
        }

        /* ========== MAIN CHAT AREA ========== */
        .main-area {
            display: flex;
            flex-direction: column;
            background: var(--bg-deep);
        }

        .main-header {
            padding: 20px 30px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-card);
        }

        .main-header h2 {
            font-size: 16px;
            font-weight: 600;
        }

        .header-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: var(--success);
        }

        .status-dot {
            width: 8px; height: 8px;
            background: var(--success);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        .chat-container {
            flex: 1;
            overflow-y: auto;
            padding: 30px;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .message {
            display: flex;
            animation: fadeUp 0.4s ease;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .user-msg { justify-content: flex-end; }
        .bot-msg { justify-content: flex-start; }

        .bubble {
            max-width: 70%;
            padding: 16px 20px;
            border-radius: 18px;
            line-height: 1.6;
            font-size: 14px;
        }

        .user-bubble {
            background: var(--accent);
            color: white;
            border-bottom-right-radius: 4px;
        }

        .bot-bubble {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-bottom-left-radius: 4px;
        }

        .bot-bubble b { color: var(--accent); }

        .input-area {
            padding: 20px 30px;
            border-top: 1px solid var(--border);
            background: var(--bg-card);
            display: flex;
            gap: 12px;
        }

        .msg-input {
            flex: 1;
            padding: 14px 20px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 30px;
            color: white;
            font-size: 14px;
            outline: none;
            transition: all 0.3s;
        }

        .msg-input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(233,69,96,0.1);
        }

        .send-btn {
            width: 50px; height: 50px;
            background: linear-gradient(135deg, var(--accent), var(--accent-glow));
            border: none;
            border-radius: 50%;
            cursor: pointer;
            font-size: 20px;
            color: white;
            transition: all 0.3s;
        }

        .send-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 25px rgba(233,69,96,0.3);
        }

        /* ========== SIDEBAR RIGHT - ANALYTICS ========== */
        .sidebar-right {
            background: var(--bg-card);
            border-left: 1px solid var(--border);
            padding: 20px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .metric-card {
            background: var(--bg-input);
            border-radius: 14px;
            padding: 18px;
            border: 1px solid var(--border);
        }

        .metric-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--text-dim);
            margin-bottom: 8px;
        }

        .metric-value {
            font-size: 28px;
            font-weight: 700;
            background: linear-gradient(135deg, var(--accent), var(--gold));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .metric-sub {
            font-size: 11px;
            color: var(--text-dim);
            margin-top: 4px;
        }

        .tier-badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            margin-top: 8px;
        }

        .tier-starter { background: rgba(41,121,255,0.15); color: #2979ff; }
        .tier-business { background: rgba(255,152,0,0.15); color: #ff9800; }
        .tier-enterprise { background: rgba(0,200,83,0.15); color: #00c853; }

        .license-box {
            background: var(--bg-input);
            border: 1px solid var(--gold);
            border-radius: 14px;
            padding: 18px;
        }

        .license-box h4 {
            font-size: 13px;
            margin-bottom: 10px;
            color: var(--gold);
        }

        .license-btn {
            width: 100%;
            padding: 12px;
            background: linear-gradient(135deg, var(--gold), #d4a020);
            border: none;
            border-radius: 10px;
            color: #000;
            font-weight: 700;
            cursor: pointer;
            font-size: 13px;
            transition: all 0.3s;
        }

        .license-btn:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 25px rgba(240,192,64,0.3);
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 10px; }

        /* Hidden watermark */
        .hidden-watermark {
            position: fixed;
            bottom: 10px;
            right: 20px;
            font-size: 8px;
            color: rgba(255,255,255,0.05);
            letter-spacing: 3px;
            pointer-events: none;
        }
    </style>
</head>
