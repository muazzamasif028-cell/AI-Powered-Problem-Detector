            scan(input) {
                const threats = [];
                const patterns = [
                    'drop table', '<script>', 'union select', '1=1', '../etc/passwd',
                    'eval(', 'exec(', 'wget ', 'curl ', '| sh', 'rm -rf', 'chmod 777'
