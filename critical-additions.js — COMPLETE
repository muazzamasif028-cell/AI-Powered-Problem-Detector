        if (type === 'BEFORE') {
            this.beforeAfterTracking.snapshotSystem.beforeSnapshot.values = snapshot.metrics;
            this.beforeAfterTracking.snapshotSystem.beforeSnapshot.timestamp = snapshot.timestamp;
        } else {
            this.beforeAfterTracking.snapshotSystem.afterSnapshot.values = snapshot.metrics;
            this.beforeAfterTracking.snapshotSystem.afterSnapshot.timestamp = snapshot.timestamp;
        }

        return snapshot;
    }

    calculateImprovements(before, after) {
        const improvements = {};
        
        for (let [metric, beforeValue] of Object.entries(before.metrics)) {
            const afterValue = after.metrics[metric];
            
            if (typeof beforeValue === 'string' && beforeValue.includes('%')) {
                const bNum = parseFloat(beforeValue);
                const aNum = parseFloat(afterValue);
                improvements[metric] = {
                    before: beforeValue,
                    after: afterValue,
                    improvement: (bNum - aNum).toFixed(1) + '%',
                    status: bNum > aNum ? 'IMPROVED' : 'SAME'
                };
            } else if (typeof beforeValue === 'string' && beforeValue.startsWith('$')) {
                const bNum = parseFloat(beforeValue.replace('$', ''));
                const aNum = parseFloat(afterValue.replace('$', ''));
                improvements[metric] = {
                    before: beforeValue,
                    after: afterValue,
                    savings: '$' + (bNum - aNum).toFixed(2),
                    status: bNum > aNum ? 'COST_REDUCED' : 'SAME'
                };
            } else {
                const bNum = parseFloat(beforeValue);
                const aNum = parseFloat(afterValue);
                const improvement = ((aNum - bNum) / bNum * 100);
                improvements[metric] = {
                    before: beforeValue,
                    after: afterValue,
                    change: improvement.toFixed(1) + '%',
                    status: improvement > 0 ? 'IMPROVED' : improvement < 0 ? 'DEGRADED' : 'SAME'
                };
            }
        }

        return improvements;
    }

    calculateROI(before, after) {
        const beforeCost = parseFloat(before.metrics.cost_per_hour.replace('$', ''));
        const afterCost = parseFloat(after.metrics.cost_per_hour.replace('$', ''));
        const dailySavings = (beforeCost - afterCost) * 24;
        const annualSavings = dailySavings * 365;

        return {
            dailySavings: '$' + dailySavings.toFixed(2),
            monthlySavings: '$' + (dailySavings * 30).toFixed(2),
            annualSavings: '$' + annualSavings.toFixed(2),
            savingsPercent: ((beforeCost - afterCost) / beforeCost * 100).toFixed(1) + '%',
            timeToValue: 'Immediate',
            paybackPeriod: '< 1 month'
        };
    }

    // =============================================
    // ADDITION 5: EXECUTE PLAYBOOK
    // =============================================
    async executePlaybook(playbookId, context = {}) {
        console.log(`🧩 [PLAYBOOK]: Executing ${playbookId}`);

        // Find playbook
        let playbook = null;
        for (let [category, data] of Object.entries(this.prebuiltPlaybooks.categories)) {
            const found = data.playbooks.find(p => p.id === playbookId);
            if (found) {
                playbook = found;
                break;
            }
        }

        if (!playbook) {
            return { success: false, error: 'Playbook not found' };
        }

        const executionId = 'PB-EXEC-' + Date.now().toString(36);
        const stepResults = [];
        let allStepsPassed = true;

        // Execute each step
        for (let step of playbook.steps) {
            const stepStart = performance.now();
            
            try {
                const result = {
                    step: step.step,
                    action: step.action,
                    description: step.description,
                    automated: step.automated,
                    status: step.automated ? 'AUTO_EXECUTED' : 'MANUAL_REQUIRED',
                    duration: (performance.now() - stepStart).toFixed(0) + 'ms',
                    timestamp: new Date().toISOString()
                };
                
                stepResults.push(result);
                
                if (!step.automated) {
                    allStepsPassed = false;
                }
            } catch (error) {
                stepResults.push({
                    step: step.step,
                    action: step.action,
                    status: 'FAILED',
                    error: error.message
                });
                allStepsPassed = false;
                break;
            }
        }

        this.state.totalPlaybooks++;

        return {
            executionId,
            playbookId,
            playbookName: playbook.name,
            timestamp: new Date().toISOString(),
            success: allStepsPassed,
            totalSteps: playbook.steps.length,
            completedSteps: stepResults.filter(r => r.status !== 'FAILED').length,
            stepResults,
            estimatedDuration: playbook.estimatedDuration,
            actualDuration: stepResults.reduce((sum, r) => sum + parseInt(r.duration || 0), 0) + 'ms'
        };
    }

    // =============================================
    // GET PLAYBOOK CATALOG
    // =============================================
    getPlaybookCatalog() {
        const catalog = {};
        
        for (let [category, data] of Object.entries(this.prebuiltPlaybooks.categories)) {
            catalog[category] = {
                count: data.count,
                playbooks: data.playbooks.map(p => ({
                    id: p.id,
                    name: p.name,
                    trigger: p.trigger,
                    severity: p.severity,
                    estimatedDuration: p.estimatedDuration,
                    steps: p.steps.length,
                    successRate: p.successRate
                }))
            };
        }

        return {
            totalPlaybooks: this.prebuiltPlaybooks.metrics.totalPlaybooks,
            categories: Object.keys(catalog).length,
            catalog,
            timestamp: new Date().toISOString()
        };
    }

