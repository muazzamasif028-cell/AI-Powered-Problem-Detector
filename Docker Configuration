# Dockerfile
FROM openjdk:17-slim

WORKDIR /app

COPY target/supreme-billing-1.0.0.jar app.jar
COPY src/main/resources/application.yml application.yml

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "-Dspring.profiles.active=prod", "app.jar"]

# docker-compose.yml
version: '3.8'

services:
  supreme-billing:
    build: .
    ports:
      - "8080:8080"
    environment:
      - DB_USERNAME=supreme
      - DB_PASSWORD=supreme123
      - SAFEPAY_API_KEY=${SAFEPAY_API_KEY}
      - PAYFAST_MERCHANT_ID=${PAYFAST_MERCHANT_ID}
      - STRIPE_API_KEY=${STRIPE_API_KEY}
    depends_on:
      - postgres
      - redis
  
  postgres:
    image: postgres:15
    environment:
      POSTGRES_DB: supreme_billing
      POSTGRES_USER: supreme
      POSTGRES_PASSWORD: supreme123
    volumes:
      - postgres_data:/var/lib/postgresql/data
  
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"

volumes:
  postgres_data:
