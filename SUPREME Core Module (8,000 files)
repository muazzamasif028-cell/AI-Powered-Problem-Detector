// 🧠 packages/core/src/kernel/kernel.js
// SUPREME Platform Kernel — Central bootstrap
// ============================================================
const EventEmitter = require('events');
const { createLogger } = require('../config/logger');

class SupremeKernel extends EventEmitter {
    constructor() {
        super();
        this.name = 'SUPREME-KERNEL';
        this.version = '1.0.0';
        this.services = new Map();
        this.status = 'INITIALIZING';
        this.startTime = null;
        this.logger = createLogger('kernel');
    }

    /**
     * Initialize the kernel and all registered services
     */
    async initialize() {
        this.startTime = Date.now();
        this.logger.info(`⚡ SUPREME Kernel v${this.version} initializing...`);

        try {
            // 1. Load configuration
            await this.loadConfiguration();
            this.logger.info('✅ Configuration loaded');

            // 2. Initialize database connections
            await this.initializeDatabases();
            this.logger.info('✅ Databases connected');

            // 3. Initialize cache
            await this.initializeCache();
            this.logger.info('✅ Cache initialized');

            // 4. Initialize event bus
            await this.initializeEventBus();
            this.logger.info('✅ Event bus initialized');

            // 5. Initialize queue system
            await this.initializeQueue();
            this.logger.info('✅ Queue system initialized');

            // 6. Load all services
            await this.loadServices();
            this.logger.info(`✅ ${this.services.size} services loaded`);

            // 7. Start health checks
            this.startHealthChecks();

            this.status = 'RUNNING';
            const bootTime = Date.now() - this.startTime;
            this.logger.info(`🚀 SUPREME Kernel ready (${bootTime}ms)`);

            this.emit('kernel:ready', { bootTime, services: this.services.size });

        } catch (error) {
            this.status = 'ERROR';
            this.logger.error('❌ Kernel initialization failed:', error);
            throw error;
        }
    }

    /**
     * Register a service with the kernel
     */
    registerService(name, service) {
        if (this.services.has(name)) {
            throw new Error(`Service "${name}" is already registered`);
        }

        this.services.set(name, {
            name,
            instance: service,
            status: 'REGISTERED',
            registeredAt: new Date(),
            dependencies: service.dependencies || []
        });

        this.logger.info(`📦 Service registered: ${name}`);
        this.emit('service:registered', { name });
    }

    /**
     * Get a registered service
     */
    getService(name) {
        const service = this.services.get(name);
        if (!service) {
            throw new Error(`Service "${name}" not found`);
        }
        return service.instance;
    }

    /**
     * Graceful shutdown
     */
    async shutdown() {
        this.logger.info('🔄 Shutting down SUPREME Kernel...');
        this.status = 'SHUTTING_DOWN';

        // Shutdown in reverse order
        const services = Array.from(this.services.values()).reverse();
        for (const service of services) {
            if (service.instance.shutdown) {
                await service.instance.shutdown();
            }
        }

        this.status = 'STOPPED';
        this.logger.info('✅ SUPREME Kernel stopped');
        this.emit('kernel:stopped');
    }

    // Private methods
    async loadConfiguration() {
        const config = require('../config');
        this.config = config;
    }

    async initializeDatabases() {
        const mongoose = require('mongoose');
        await mongoose.connect(process.env.MONGODB_URI);
    }

    async initializeCache() {
        const Redis = require('ioredis');
        this.redis = new Redis({
            host: process.env.REDIS_HOST || 'localhost',
            port: process.env.REDIS_PORT || 6379
        });
    }

    async initializeEventBus() {
        const EventBus = require('../events/eventBus');
        this.eventBus = new EventBus();
        await this.eventBus.initialize();
    }

    async initializeQueue() {
        const Queue = require('bull');
        this.queue = new Queue('supreme-jobs', {
            redis: { host: process.env.REDIS_HOST || 'localhost' }
        });
    }

    async loadServices() {
        // Core services
        this.registerService('auth', require('../../auth/src/services/auth.service'));
        this.registerService('token', require('../../auth/src/services/token.service'));
        this.registerService('billing', require('../../billing/src/services/billing.service'));
        
        // AI services
        this.registerService('ai-gateway', require('../../ai-brain/src/llm/providers/openai.provider'));
        this.registerService('memory', require('../../ai-brain/src/memory/memory-engine'));
        this.registerService('agent-runtime', require('../../agent-os/src/runtime/agent-runtime'));
    }

    startHealthChecks() {
        setInterval(() => {
            const health = {
                status: this.status,
                uptime: Date.now() - this.startTime,
                services: this.services.size,
                memory: process.memoryUsage(),
                timestamp: new Date().toISOString()
            };
            this.emit('kernel:health', health);
        }, 15000);
    }
}

// Singleton
const kernel = new SupremeKernel();

module.exports = kernel;
