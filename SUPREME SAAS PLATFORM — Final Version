    /**
     * 📈 Get Platform Analytics (SUPREME Internal)
     */
    getPlatformAnalytics() {
        const tenants = Array.from(this.state.tenants.values());
        const paid = tenants.filter(t => t.plan !== 'BASIC');
        
        return {
            customers: {
                total: tenants.length,
                paid: paid.length,
                free: tenants.filter(t => t.plan === 'BASIC').length,
                byPlan: this.state.revenue.byPlan
            },
            revenue: {
                mrr: `$${this.state.revenue.mrr.toLocaleString()}`,
                arr: `$${this.state.revenue.arr.toLocaleString()}`,
                averagePerUser: paid.length > 0 ? 
                    `$${Math.round(this.state.revenue.mrr / paid.length)}` : '$0',
                projectedAnnual: `$${(this.state.revenue.mrr * 12).toLocaleString()}`
            },
            subscriptions: {
                active: this.state.revenue.activeSubscriptions,
                conversionRate: tenants.length > 0 ?
                    `${((paid.length / tenants.length) * 100).toFixed(1)}%` : '0%'
            },
            popularPlan: this.getMostPopularPlan()
        };
    }

    // ============================================
    // PRIVATE HELPERS
