    async generateInvoice(tenant, subscription) {
        const invoiceId = `INV-${Date.now().toString(36).toUpperCase()}`;
        
        const invoice = {
            invoiceId,
            tenantId: tenant.tenantId,
            tenantName: tenant.name,
            subscriptionId: subscription.subscriptionId,
            plan: subscription.plan,
            amount: subscription.price,
            billingCycle: subscription.billingCycle,
            status: 'PAID',
            createdAt: new Date().toISOString(),
            downloadUrl: `/invoices/${invoiceId}.pdf`
        };
        
        this.state.invoices.set(invoiceId, invoice);
        tenant.billing.invoices.push(invoiceId);
        
        return invoice;
    }

    calculateProration(tenant, newPlan, isUpgrade) {
        if (!isUpgrade) return 0;
        
        const daysInMonth = 30;
        const daysRemaining = Math.ceil(
            (new Date(tenant.billing.nextBillingDate || Date.now()) - new Date()) / 
            (1000 * 60 * 60 * 24)
        );
        
        const oldDaily = this.plans[tenant.plan].monthlyPrice / daysInMonth;
        const newDaily = newPlan.monthlyPrice / daysInMonth;
        
        return Math.round((newDaily - oldDaily) * Math.max(daysRemaining, 1));
    }

    getMostPopularPlan() {
        const counts = this.state.revenue.byPlan;
        const max = Math.max(...Object.values(counts));
        const popular = Object.entries(counts).find(([, v]) => v === max);
        return popular ? `${this.plans[popular[0]].emoji} ${this.plans[popular[0]].name}` : 'N/A';
    }
