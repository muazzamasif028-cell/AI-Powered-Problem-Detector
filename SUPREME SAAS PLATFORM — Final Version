    /**
     * 💰 Subscribe to Plan
     */
    async subscribe(tenantId, planKey, billingCycle = 'MONTHLY') {
        const tenant = this.state.tenants.get(tenantId);
        const plan = this.plans[planKey];
        
        if (!tenant) throw new Error('Tenant not found');
        if (!plan) throw new Error('Invalid plan');
        
        // Calculate price
        const isAnnual = billingCycle === 'ANNUAL';
        const monthlyPrice = plan.monthlyPrice;
        const price = isAnnual ? plan.annualPrice : monthlyPrice;
        const savings = isAnnual ? `Save $${(monthlyPrice * 12) - plan.annualPrice}/year` : null;
        
        // Create subscription
        const subscription = {
            subscriptionId: `SUB-${Date.now().toString(36).toUpperCase()}`,
            tenantId,
            plan: planKey,
            billingCycle,
            price,
            monthlyEquivalent: isAnnual ? Math.round(plan.annualPrice / 12) : price,
            status: 'ACTIVE',
            startedAt: new Date().toISOString(),
            renewsAt: new Date(Date.now() + (isAnnual ? 365 : 30) * 24 * 60 * 60 * 1000).toISOString()
        };
        
        // Update tenant
        const oldPlan = tenant.plan;
        tenant.plan = planKey;
        tenant.status = 'ACTIVE';
        tenant.billing.nextBillingDate = subscription.renewsAt;
        
        this.state.subscriptions.set(subscription.subscriptionId, subscription);
        
        // Update revenue stats
        this.state.revenue.byPlan[oldPlan]--;
        this.state.revenue.byPlan[planKey]++;
        this.state.revenue.mrr += isAnnual ? (plan.annualPrice / 12) : monthlyPrice;
        this.state.revenue.arr = this.state.revenue.mrr * 12;
        this.state.revenue.activeSubscriptions++;
        
        // Generate invoice
        const invoice = await this.generateInvoice(tenant, subscription);
        
        console.log(`💰 Subscribed: ${tenant.name} → ${plan.emoji} ${plan.name}`);
        console.log(`   ${billingCycle}: $${price} ${savings ? `(${savings})` : ''}`);
        
        this.emit('subscription:created', { tenantId, plan: planKey, price, savings });
        
        return { 
            success: true, 
            plan: planKey, 
            price, 
            savings,
            invoice 
        };
    }

    /**
     * ⬆️ Upgrade/Downgrade Plan
     */
    async changePlan(tenantId, newPlanKey) {
        const tenant = this.state.tenants.get(tenantId);
        const oldPlan = this.plans[tenant.plan];
        const newPlan = this.plans[newPlanKey];
        
        if (!tenant) throw new Error('Tenant not found');
        if (!newPlan) throw new Error('Invalid plan');
        if (tenant.plan === newPlanKey) throw new Error('Already on this plan');
        
        const isUpgrade = newPlan.monthlyPrice > oldPlan.monthlyPrice;
        const proration = this.calculateProration(tenant, newPlan, isUpgrade);
        
        console.log(`${isUpgrade ? '⬆️ UPGRADE' : '⬇️ DOWNGRADE'}: ${tenant.name}`);
        console.log(`   ${oldPlan.emoji} ${oldPlan.name} → ${newPlan.emoji} ${newPlan.name}`);
        
        if (isUpgrade) {
            console.log(`   Prorated charge: $${proration}`);
        }
        
        // Update tenant
        this.state.revenue.byPlan[tenant.plan]--;
        this.state.revenue.byPlan[newPlanKey]++;
        tenant.plan = newPlanKey;
        
        this.emit('plan:changed', { 
            tenantId, 
            from: tenant.plan, 
            to: newPlanKey, 
            isUpgrade 
        });
        
        return { 
            success: true, 
            newPlan: newPlanKey, 
            isUpgrade,
            proration: isUpgrade ? proration : 0
        };
    }

