        console.log(`📦 Add-on: ${tenant.name} → ${addon.emoji} ${addon.name} (+$${addon.price}/mo)`);
        
        return { success: true, addon: addon.name, price: addon.price };
    }

    /**
     * ❌ Cancel Subscription
     */
    async cancelSubscription(tenantId, reason = '') {
        const tenant = this.state.tenants.get(tenantId);
        
        if (!tenant) throw new Error('Tenant not found');
        
        tenant.status = 'CANCELLED';
        tenant.cancelledAt = new Date().toISOString();
        tenant.cancellationReason = reason;
        
        this.state.revenue.activeSubscriptions--;
        this.state.revenue.byPlan[tenant.plan]--;
        this.state.revenue.mrr -= this.plans[tenant.plan].monthlyPrice;
        this.state.revenue.arr = this.state.revenue.mrr * 12;
        
        console.log(`❌ Cancelled: ${tenant.name} — "${reason || 'No reason given'}"`);
        
        // Schedule downgrade to free after billing period
        setTimeout(() => {
            if (tenant.plan !== 'BASIC') {
                this.state.revenue.byPlan.BASIC++;
                tenant.plan = 'BASIC';
                console.log(`🔄 ${tenant.name} → Basic Plan`);
            }
        }, 30 * 24 * 60 * 60 * 1000);
        
        return { success: true, message: 'Subscription cancelled' };
    }

    /**
     * ✅ Check Feature Access
     */
    checkAccess(tenantId, feature) {
        const tenant = this.state.tenants.get(tenantId);
        if (!tenant) return { allowed: false, reason: 'TENANT_NOT_FOUND' };
        
        const plan = this.plans[tenant.plan];
        
        // Check project limit
        if (feature === 'CREATE_PROJECT' && plan.projects !== 'UNLIMITED') {
            if (tenant.usage.projectsCreated >= plan.projects) {
                return {
                    allowed: false,
                    reason: 'LIMIT_REACHED',
                    message: `Basic plan allows ${plan.projects} projects.`,
                    upgradeTo: 'PRO',
                    upgradePrice: '$70/month'
                };
            }
        }
        
        // Check feature availability
        const featureChecks = {
            'BOM_GENERATOR': plan.features.some(f => f.includes('BOM')),
            'MANUFACTURING_PLANNER': plan.features.some(f => f.includes('Manufacturing')),
            'COST_ESTIMATOR': plan.features.some(f => f.includes('Cost Estimator')),
            'TEAM_COLLABORATION': plan.features.some(f => f.includes('Collaboration')),
            'API_ACCESS': plan.api || false,
            'RBAC': plan.rbac || false,
            'SSO': plan.sso || false,
            'DIGITAL_TWIN': plan.features.some(f => f.includes('Digital Twin')),
            'CUSTOM_AI': plan.aiModel === 'CUSTOM'
        };
        
        if (featureChecks[feature] === false) {
            return {
                allowed: false,
                reason: 'FEATURE_NOT_AVAILABLE',
                message: 'This feature requires a higher plan.',
                upgradeTo: 'PRO',
                upgradePrice: '$70/month'
            };
        }
        
        return { allowed: true };
    }

