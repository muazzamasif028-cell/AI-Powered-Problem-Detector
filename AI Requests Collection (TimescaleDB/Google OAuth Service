const { OAuth2Client } = require('google-auth-library');
const User = require('../models/User');
const tokenService = require('./token.service');
const onboardingService = require('./onboarding.service');
const welcomeEmailService = require('./welcome-email.service');

class GoogleOAuthService {
    constructor() {
        this.client = new OAuth2Client({
            clientId: process.env.GOOGLE_CLIENT_ID,
            clientSecret: process.env.GOOGLE_CLIENT_SECRET,
            redirectUri: process.env.GOOGLE_CALLBACK_URL || 'http://localhost:3000/api/auth/google/callback'
        });

        // Scopes we request from Google
        this.scopes = [
            'https://www.googleapis.com/auth/userinfo.email',
            'https://www.googleapis.com/auth/userinfo.profile',
            'openid'
        ];
    }

    /**
     * Get Google OAuth URL
     */
    getAuthUrl(state = '') {
        return this.client.generateAuthUrl({
            access_type: 'offline',
            scope: this.scopes,
            prompt: 'consent',
            state: state || this.generateState(),
            include_granted_scopes: true
        });
    }

    /**
     * Handle Google OAuth callback
     */
    async handleCallback(code) {
        // 1. Exchange code for tokens
        const { tokens } = await this.client.getToken(code);
        this.client.setCredentials(tokens);

        // 2. Get user info from Google
        const userInfo = await this.getUserInfo(tokens.access_token);

        // 3. Find or create user
        const user = await this.findOrCreateUser(userInfo, tokens);

        // 4. Generate SUPREME OS tokens
        const accessToken = tokenService.generateAccessToken(user);
        const refreshToken = await tokenService.generateRefreshToken(user._id, {
            userAgent: 'Google OAuth',
            ip: '0.0.0.0'
        });

        // 5. Auto onboarding (welcome email, setup workspace, etc.)
        await onboardingService.onboardNewUser(user, 'google');

        return {
            user: user.toSafeObject(),
            accessToken,
            refreshToken: refreshToken.token,
            isNewUser: user._isNewUser || false
        };
    }

    /**
     * Verify Google ID token (for client-side auth)
     */
    async verifyIdToken(idToken) {
        const ticket = await this.client.verifyIdToken({
            idToken,
            audience: process.env.GOOGLE_CLIENT_ID
        });

        const payload = ticket.getPayload();
        
        // Find or create user
        const user = await this.findOrCreateUser({
            email: payload.email,
            name: payload.name,
            picture: payload.picture,
            email_verified: payload.email_verified,
            sub: payload.sub
        }, { access_token: idToken });

        // Generate tokens
        const accessToken = tokenService.generateAccessToken(user);
        const refreshToken = await tokenService.generateRefreshToken(user._id, {
            userAgent: 'Google OAuth (ID Token)',
            ip: '0.0.0.0'
        });

        // Auto onboarding
        if (user._isNewUser) {
            await onboardingService.onboardNewUser(user, 'google');
        }

        return {
            user: user.toSafeObject(),
            accessToken,
            refreshToken: refreshToken.token,
            isNewUser: user._isNewUser || false
        };
    }

    /**
     * Get user info from Google
     */
    async getUserInfo(accessToken) {
        const response = await fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
            headers: { Authorization: `Bearer ${accessToken}` }
        });

        if (!response.ok) {
            throw new Error('Failed to get user info from Google');
        }

        return response.json();
    }

    /**
     * Find existing user or create new one
     */
    async findOrCreateUser(googleUser, tokens) {
        const { email, name, picture, sub } = googleUser;

        // Check if user already exists by email
        let user = await User.findOne({ email: email.toLowerCase() });

        if (user) {
            // Existing user — update Google OAuth info
            const existingProvider = user.oauthProviders.find(p => p.provider === 'google');
            
            if (existingProvider) {
                existingProvider.accessToken = this.encryptToken(tokens.access_token);
                existingProvider.refreshToken = tokens.refresh_token ? this.encryptToken(tokens.refresh_token) : null;
                existingProvider.lastLoginAt = new Date();
            } else {
                user.oauthProviders.push({
                    provider: 'google',
                    providerId: sub,
                    email,
                    name,
                    avatar: picture,
                    accessToken: this.encryptToken(tokens.access_token),
                    refreshToken: tokens.refresh_token ? this.encryptToken(tokens.refresh_token) : null,
                    connectedAt: new Date(),
                    lastLoginAt: new Date()
                });
            }

            user.lastLoginAt = new Date();
            user.loginCount += 1;
            user._isNewUser = false;
            
            await user.save();
            return user;
        }

        // New user — create account
        const crypto = require('crypto');
        
        user = await User.create({
            name: name || email.split('@')[0],
            email: email.toLowerCase(),
            password: crypto.randomBytes(32).toString('hex'), // Random password
            avatar: picture,
            isEmailVerified: true, // Google already verified
            oauthProviders: [{
                provider: 'google',
                providerId: sub,
                email,
                name,
                avatar: picture,
                accessToken: this.encryptToken(tokens.access_token),
                refreshToken: tokens.refresh_token ? this.encryptToken(tokens.refresh_token) : null,
                connectedAt: new Date(),
                lastLoginAt: new Date(),
                isPrimary: true
            }],
            plan: 'free',
            status: 'active',
            lastLoginAt: new Date(),
            loginCount: 1,
            role: 'user',
            permissions: ['domain:read', 'ai:read', 'ai:write']
        });

        user._isNewUser = true;
        return user;
    }

    /**
     * Encrypt sensitive tokens
     */
    encryptToken(token) {
        if (!token) return null;
        const crypto = require('crypto');
        const algorithm = 'aes-256-gcm';
        const key = Buffer.from(process.env.ENCRYPTION_KEY || 'supreme-32-char-encryption-key!!', 'utf8');
        const iv = crypto.randomBytes(16);
        const cipher = crypto.createCipheriv(algorithm, key, iv);
        
        let encrypted = cipher.update(token, 'utf8', 'hex');
        encrypted += cipher.final('hex');
        const authTag = cipher.getAuthTag();
        
        return `${iv.toString('hex')}:${authTag.toString('hex')}:${encrypted}`;
    }

    /**
     * Decrypt token
     */
    decryptToken(encryptedToken) {
        if (!encryptedToken) return null;
        const crypto = require('crypto');
        const algorithm = 'aes-256-gcm';
        const key = Buffer.from(process.env.ENCRYPTION_KEY || 'supreme-32-char-encryption-key!!', 'utf8');
        
        const [ivHex, authTagHex, encrypted] = encryptedToken.split(':');
        const iv = Buffer.from(ivHex, 'hex');
        const authTag = Buffer.from(authTagHex, 'hex');
        const decipher = crypto.createDecipheriv(algorithm, key, iv);
        decipher.setAuthTag(authTag);
        
        let decrypted = decipher.update(encrypted, 'hex', 'utf8');
        decrypted += decipher.final('utf8');
        
        return decrypted;
    }

    /**
     * Refresh Google access token
     */
    async refreshGoogleToken(userId) {
        const user = await User.findById(userId);
        const googleProvider = user.oauthProviders.find(p => p.provider === 'google');
        
        if (!googleProvider || !googleProvider.refreshToken) {
            throw new Error('No Google refresh token available');
        }

        const refreshToken = this.decryptToken(googleProvider.refreshToken);
        this.client.setCredentials({ refresh_token: refreshToken });
        
        const { credentials } = await this.client.refreshAccessToken();
        
        googleProvider.accessToken = this.encryptToken(credentials.access_token);
        if (credentials.refresh_token) {
            googleProvider.refreshToken = this.encryptToken(credentials.refresh_token);
        }
        
        await user.save();
        return credentials.access_token;
    }

    generateState() {
        const crypto = require('crypto');
        return crypto.randomBytes(16).toString('hex');
    }
}

module.exports = new GoogleOAuthService();
