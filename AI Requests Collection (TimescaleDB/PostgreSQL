CREATE TABLE ai_requests (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id VARCHAR(50) NOT NULL,
    provider VARCHAR(20) NOT NULL, -- openai, anthropic, google
    model VARCHAR(50) NOT NULL,
    action VARCHAR(20) NOT NULL, -- chat, embed, image
    tokens_input INTEGER DEFAULT 0,
    tokens_output INTEGER DEFAULT 0,
    cost DECIMAL(10,6) DEFAULT 0,
    latency_ms INTEGER DEFAULT 0,
    status VARCHAR(10) DEFAULT 'success', -- success, error
    error_message TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Hypertable for time-series
SELECT create_hypertable('ai_requests', 'created_at');

-- Indexes
CREATE INDEX idx_ai_requests_user ON ai_requests(user_id, created_at DESC);
CREATE INDEX idx_ai_requests_provider ON ai_requests(provider, created_at DESC);
