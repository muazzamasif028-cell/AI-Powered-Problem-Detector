<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supreme Problem Detector v7.0</title>
    <style>
        :root {
            --bg-deep: #08080f;
            --bg-panel: #0e0e1a;
            --bg-card: #12122a;
            --accent: #e94560;
            --quantum: #00ffff;
            --gold: #ffd700;
            --success: #3fb950;
            --warning: #f0883e;
            --danger: #da3633;
            --text: #e0e0e0;
            --text-dim: #8888aa;
            --border: rgba(255,255,255,0.06);
        }
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: var(--bg-deep);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }
        
        /* ========== MAIN CANVAS ========== */
        .main-container {
            width: 100%;
            max-width: 1100px;
            height: 95vh;
            background: var(--bg-panel);
            border-radius: 24px;
            display: flex;
            box-shadow: 0 30px 80px rgba(0,0,0,0.8), 0 0 0 1px var(--border);
            overflow: hidden;
            position: relative;
        }
        
        /* ========== V6 DASHBOARD SIDEBAR ========== */
        .dashboard-sidebar {
            width: 280px;
            background: var(--bg-card);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            padding: 20px 15px;
            gap: 8px;
            overflow-y: auto;
        }
        
        .sidebar-header {
            padding: 10px;
            text-align: center;
            border-bottom: 1px solid var(--border);
            margin-bottom: 10px;
        }
        
        .sidebar-header h3 {
            color: var(--quantum);
            font-size: 0.85em;
            letter-spacing: 1px;
        }
        
        .sidebar-header .version {
            color: var(--text-dim);
            font-size: 0.65em;
            margin-top: 3px;
        }
        
        .dashboard-card {
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .dashboard-card:hover {
            border-color: var(--quantum);
            background: rgba(0,255,255,0.03);
        }
        
        .dashboard-card.active {
            border-color: var(--accent);
            background: rgba(233,69,96,0.08);
        }
        
        .card-title {
            color: var(--text);
            font-size: 0.75em;
            font-weight: 600;
            margin-bottom: 6px;
        }
        
        .card-metric {
            display: flex;
            justify-content: space-between;
            font-size: 0.7em;
            color: var(--text-dim);
            padding: 2px 0;
        }
        
        .card-metric .val { color: var(--text); font-weight: 500; }
        .val.ok { color: var(--success); }
        .val.warn { color: var(--warning); }
        .val.crit { color: var(--danger); }
        
        .trust-meter {
            background: rgba(0,255,255,0.05);
            border: 1px solid var(--quantum);
            border-radius: 12px;
            padding: 15px;
            text-align: center;
            margin-top: auto;
        }
        
        .trust-score-big {
            font-size: 2.5em;
            font-weight: 800;
            color: var(--quantum);
            text-shadow: 0 0 30px rgba(0,255,255,0.4);
        }
        
        .trust-label {
            color: var(--text-dim);
            font-size: 0.65em;
            letter-spacing: 2px;
            margin-top: 4px;
        }
        
        /* ========== MAIN CHAT AREA ========== */
        .chat-main {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        
        .company-header {
            background: linear-gradient(135deg, #0f0f23 0%, #1a1a3e 50%, #e94560 150%);
            padding: 18px 25px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--border);
        }
        
        .company-logo {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #e94560, #ff6b81);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            animation: logoGlow 3s ease-in-out infinite;
        }
        
        @keyframes logoGlow {
            0%, 100% { box-shadow: 0 0 20px rgba(233,69,96,0.3); }
            50% { box-shadow: 0 0 35px rgba(0,255,255,0.5); }
        }
        
        .company-info h2 { color: white; font-size: 1.2em; font-weight: 700; }
        .company-info p { color: rgba(255,255,255,0.6); font-size: 0.7em; }
        
        .quantum-badge {
            margin-left: auto;
            background: rgba(0,255,255,0.08);
            border: 1px solid rgba(0,255,255,0.25);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.6em;
            color: var(--quantum);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        
        .quantum-dot {
            width: 6px; height: 6px;
            background: var(--quantum);
            border-radius: 50%;
            animation: quantumPulse 2s infinite;
        }
        
        @keyframes quantumPulse {
            0%, 100% { opacity: 0.3; }
            50% { opacity: 1; box-shadow: 0 0 12px var(--quantum); }
        }
        
        .chat-area {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            background: var(--bg-deep);
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        
        .message {
            display: flex;
            animation: slideIn 0.3s ease;
        }
        
        @keyframes slideIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .user-msg { justify-content: flex-end; }
        .bot-msg { justify-content: flex-start; }
        
        .bubble {
            max-width: 75%;
            padding: 14px 18px;
            border-radius: 18px;
            line-height: 1.55;
            font-size: 0.9em;
        }
        
        .user-bubble {
            background: linear-gradient(135deg, #238636, #2ea043);
            color: white;
            border-bottom-right-radius: 4px;
            margin-left: 40px;
        }
        
        .bot-bubble {
            background: #1a1a2e;
            color: var(--text);
            border-bottom-left-radius: 4px;
            margin-right: 40px;
            border: 1px solid var(--border);
        }
        
        .diagnostic-card {
            background: rgba(18,18,42,0.6);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px 16px;
            margin: 4px 0;
            font-size: 0.8em;
            font-family: 'Courier New', monospace;
        }
        
        .diagnostic-card .metric {
            display: flex;
            justify-content: space-between;
            padding: 3px 0;
            border-bottom: 1px solid rgba(255,255,255,0.03);
        }
        
        .diagnostic-card .metric:last-child { border-bottom: none; }
        .metric-label { color: var(--text-dim); }
        .metric-value { font-weight: 600; }
        .metric-ok { color: var(--success); }
        .metric-warn { color: var(--warning); }
        .metric-crit { color: var(--danger); }
        
        .trust-output-card {
            background: rgba(0,255,255,0.04);
            border: 1px solid rgba(0,255,255,0.2);
            border-radius: 12px;
            padding: 14px 16px;
            margin: 6px 0;
            font-size: 0.8em;
            font-family: 'Courier New', monospace;
        }
        
        .quantum-seal {
            text-align: center;
            color: var(--quantum);
            font-size: 0.7em;
            padding: 8px;
            border: 1px dashed rgba(0,255,255,0.3);
            border-radius: 8px;
            margin-top: 8px;
        }
        
        .input-area {
            padding: 16px 20px;
            background: var(--bg-panel);
            border-top: 1px solid var(--border);
            display: flex;
            gap: 10px;
        }
        
        .message-input {
            flex: 1;
            padding: 12px 20px;
            background: var(--bg-deep);
            border: 1px solid var(--border);
            border-radius: 25px;
            color: white;
            font-size: 0.9em;
            outline: none;
            font-family: inherit;
            transition: all 0.3s;
        }
        
        .message-input:focus {
            border-color: rgba(0,255,255,0.4);
            box-shadow: 0 0 0 3px rgba(0,255,255,0.05);
        }
        
        .send-btn {
            width: 44px; height: 44px;
            background: linear-gradient(135deg, #e94560, #ff6b81);
            border: none; border-radius: 50%;
            cursor: pointer; font-size: 16px;
            color: white;
            transition: all 0.3s;
        }
        
        .send-btn:hover { transform: scale(1.06); }
        .send-btn:active { transform: scale(0.94); }
        
        .chat-area::-webkit-scrollbar,
        .dashboard-sidebar::-webkit-scrollbar { width: 3px; }
        .chat-area::-webkit-scrollbar-thumb,
        .dashboard-sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.06); border-radius: 10px; }
    </style>
</head>
<body>

    <div class="main-container">
        
        <!-- ============================================ -->
        <!-- V6 DASHBOARD SIDEBAR FLOW                     -->
        <!-- ============================================ -->
        <div class="dashboard-sidebar" id="dashboardSidebar">
            <div class="sidebar-header">
                <h3>🔬 SUPREME DASHBOARD</h3>
