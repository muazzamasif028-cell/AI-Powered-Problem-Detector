                    2.5T Nodes • 5.9B Layers • 500B Comp
                </div>
            </div>
        </div>
        
        <!-- ============================================ -->
        <!-- MAIN CHAT CANVAS                             -->
        <!-- ============================================ -->
        <div class="chat-main">
            <div class="company-header">
                <div class="company-logo">⚡</div>
                <div class="company-info">
                    <h2>Supreme Problem Detector</h2>
                    <p>v7.0 • V4 Trust Core • V5 FREE Output • V6 Dashboard • V7 Quantum-Safe</p>
                </div>
