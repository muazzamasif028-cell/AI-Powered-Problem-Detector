// ============================================================
// 📁 routes/execute.routes.js — EXECUTION ROUTES
// ============================================================
const express = require('express');
const router = express.Router();
const detectionService = require('../services/detection.service');
const executionService = require('../services/execution.service');
const solutionService = require('../services/solution.service');
const jobQueue = require('../queue/job.queue');

// =============================================
// 🔍 DETECTION
// =============================================
router.post('/detect', async (req, res) => {
    try {
        const { input, context } = req.body;
        const result = await detectionService.detect(input, context);
        res.json({ success: true, ...result });
    } catch (err) {
        res.status(500).json({ success: false, error: err.message });
    }
});

router.post('/detect/batch', async (req, res) => {
    try {
        const { problems } = req.body;
        const results = await detectionService.detectBatch(problems);
        res.json({ success: true, results });
    } catch (err) {
        res.status(500).json({ success: false, error: err.message });
    }
});

// =============================================
// ⚡ EXECUTION
// =============================================
router.post('/run', async (req, res) => {
    try {
        const { problem, autoFix, companyId } = req.body;
        
        // Add to job queue
        const job = await jobQueue.add('execute-problem', {
            problem, autoFix, companyId,
            userId: req.user?.userId,
            tenantId: req.tenantId
        });

        res.json({
            success: true,
            jobId: job.id,
            status: 'QUEUED',
            message: 'Problem queued for execution',
            estimatedTime: '2-5 minutes'
        });
    } catch (err) {
        res.status(500).json({ success: false, error: err.message });
    }
});

router.get('/status/:jobId', async (req, res) => {
    try {
        const job = await jobQueue.getJob(req.params.jobId);
        if (!job) return res.status(404).json({ error: 'Job not found' });
        
        res.json({
            jobId: job.id,
            status: await job.getState(),
            progress: job.progress,
            result: job.returnvalue
        });
    } catch (err) {
        res.status(500).json({ success: false, error: err.message });
    }
});

// =============================================
// 🔧 SOLUTION
// =============================================
router.post('/solve', async (req, res) => {
    try {
        const { problemId, solutionId } = req.body;
        const result = await solutionService.applySolution(problemId, solutionId);
        res.json({ success: true, ...result });
    } catch (err) {
        res.status(500).json({ success: false, error: err.message });
    }
});

router.get('/solutions/:problemId', async (req, res) => {
    try {
        const solutions = await solutionService.getSolutions(req.params.problemId);
        res.json({ success: true, solutions });
    } catch (err) {
        res.status(500).json({ success: false, error: err.message });
    }
});

module.exports = router;
