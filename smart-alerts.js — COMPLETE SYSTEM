    // =============================================
    // 📡 CREATE ALERT — MAIN ENTRY POINT
    // =============================================
    async createAlert(problem, context = {}) {
        const alertId = 'ALT-' + Date.now().toString(36) + '-' + 
                       Math.random().toString(36).substr(2, 8).toUpperCase();
        
        const startTime = performance.now();

        console.log(`📡 [ALERT]: ${alertId} — Creating alert: ${problem.problemName || 'Unknown'}`);

        try {
            // Step 1: Build alert object
            const alert = this.buildAlert(alertId, problem, context);
            
            // Step 2: Apply deduplication
            const dedupResult = this.applyDeduplication(alert);
            if (dedupResult.isDuplicate) {
                console.log(`📡 [ALERT]: ${alertId} — Deduplicated (similar to ${dedupResult.similarTo})`);
                return {
                    alertId,
                    status: 'DEDUPLICATED',
                    groupId: dedupResult.groupId,
                    similarTo: dedupResult.similarTo,
                    timestamp: new Date().toISOString()
                };
            }

            // Step 3: Check suppression rules
            const suppressionResult = this.checkSuppression(alert);
            if (suppressionResult.suppressed) {
                console.log(`📡 [ALERT]: ${alertId} — Suppressed: ${suppressionResult.reason}`);
                return {
                    alertId,
                    status: 'SUPPRESSED',
                    reason: suppressionResult.reason,
                    timestamp: new Date().toISOString()
                };
            }

            // Step 4: Apply routing rules
            const routingResult = this.applyRouting(alert);
            
            // Step 5: Determine channels
            const channels = this.determineChannels(alert);
            
            // Step 6: Send to all channels
            const deliveryResults = await this.sendToChannels(alert, channels);
            
            // Step 7: Start escalation timer if needed
            if (alert.priority === 'CRITICAL' || alert.priority === 'HIGH') {
                this.startEscalationTimer(alert);
            }

            // Step 8: Store in history
            this.storeAlert(alert);
            
            // Step 9: Check for alert storm
            this.checkAlertStorm();

            // Update state
            this.state.totalAlerts++;
            this.state.activeAlerts++;

            const processingTime = (performance.now() - startTime).toFixed(2);

            console.log(`📡 [ALERT]: ${alertId} — Delivered to ${deliveryResults.successCount}/${deliveryResults.totalChannels} channels (${processingTime}ms)`);

            return {
                alertId,
                status: 'DELIVERED',
                priority: alert.priority,
                channels: deliveryResults,
                routing: routingResult,
                processingTime_ms: processingTime,
                timestamp: new Date().toISOString()
            };

        } catch (error) {
            console.error(`📡 [ALERT]: ${alertId} — Error: ${error.message}`);
            return { alertId, status: 'ERROR', error: error.message };
        }
    }

    // =============================================
    // BUILD ALERT OBJECT
    // =============================================
    buildAlert(alertId, problem, context) {
        const priority = problem.severity || context.priority || 'MEDIUM';
        const priorityConfig = this.priorityMatrix[priority];

        return {
            id: alertId,
            timestamp: new Date().toISOString(),
            priority,
            priorityConfig,
            
            // Problem details
            problem: {
                id: problem.problemId || 'UNKNOWN',
                name: problem.problemName || problem.name || 'Unknown Problem',
                category: problem.category || 'GENERAL',
                severity: priority,
                location: problem.location || context.location || 'Unknown',
                currentValue: problem.currentValue || 'N/A',
                unit: problem.unit || '',
                description: problem.description || problem.impact || '',
                impact: problem.impact || 'Unknown impact'
            },

            // Context
            context: {
                companyId: context.companyId || 'UNKNOWN',
                companyName: context.companyName || 'Unknown Company',
                userId: context.userId || 'SYSTEM',
                source: context.source || 'AUTO_DETECTION',
                environment: context.environment || 'PRODUCTION',
                region: context.region || 'GLOBAL'
            },

            // Solution hints
            solution: {
                autoFixAvailable: problem.solutions?.length > 0 || false,
                recommendedActions: problem.solutions || [],
                estimatedResolution: problem.estimatedTime || 'Unknown',
                playbookId: problem.playbookId || null
            },

            // Tracking
            status: 'ACTIVE',
            acknowledged: false,
            acknowledgedBy: null,
            acknowledgedAt: null,
            resolvedAt: null,
            escalationLevel: 0,
            deliveryStatus: {},
            correlationGroup: null
        };
    }

    // =============================================
    // DEDUPLICATION
    // =============================================
    applyDeduplication(alert) {
        if (!this.rulesEngine.deduplication.enabled) {
            return { isDuplicate: false };
        }

        const windowMs = this.parseTimeWindow(this.rulesEngine.deduplication.window);
        const cutoff = Date.now() - windowMs;

        // Check recent alerts for similarity
        const recentAlerts = this.alertHistory.filter(h => 
            new Date(h.timestamp).getTime() > cutoff &&
            h.problem.category === alert.problem.category &&
            h.priority === alert.priority
        );

        for (let existing of recentAlerts) {
            const similarity = this.calculateSimilarity(alert, existing);
            
            if (similarity > 0.85) {
                // Add to existing group
                const groupId = existing.correlationGroup || existing.id;
                alert.correlationGroup = groupId;
                
                return {
                    isDuplicate: true,
                    groupId,
                    similarTo: existing.id,
                    similarity: (similarity * 100).toFixed(1) + '%'
                };
            }
        }

        return { isDuplicate: false };
    }

    calculateSimilarity(alert1, alert2) {
        let score = 0;
        let totalFactors = 0;

        // Same problem category
        if (alert1.problem.category === alert2.problem.category) {
            score += 0.4;
        }
        totalFactors++;

        // Same location
        if (alert1.problem.location === alert2.problem.location) {
            score += 0.3;
        }
        totalFactors++;

        // Same priority
        if (alert1.priority === alert2.priority) {
            score += 0.2;
        }
        totalFactors++;

        // Similar problem name
        const nameSimilarity = this.stringSimilarity(
            alert1.problem.name,
            alert2.problem.name
        );
        score += nameSimilarity * 0.3;
        totalFactors++;

        return score / Math.max(1, totalFactors);
    }

    stringSimilarity(str1, str2) {
        const longer = str1.length > str2.length ? str1 : str2;
        const shorter = str1.length > str2.length ? str2 : str1;
        
        if (longer.length === 0) return 1.0;
        
        const editDistance = this.levenshteinDistance(longer, shorter);
        return (longer.length - editDistance) / longer.length;
    }

    levenshteinDistance(str1, str2) {
        const matrix = [];
        for (let i = 0; i <= str1.length; i++) {
            matrix[i] = [i];
            for (let j = 1; j <= str2.length; j++) {
                if (i === 0) {
                    matrix[i][j] = j;
                } else {
                    matrix[i][j] = Math.min(
                        matrix[i - 1][j] + 1,
                        matrix[i][j - 1] + 1,
                        matrix[i - 1][j - 1] + (str1[i - 1] === str2[j - 1] ? 0 : 1)
                    );
                }
            }
        }
        return matrix[str1.length][str2.length];
    }

    // =============================================
    // SUPPRESSION CHECK
    // =============================================
    checkSuppression(alert) {
        for (let rule of this.rulesEngine.suppression.rules) {
            // Maintenance mode check
            if (rule.name === 'Maintenance Window' && this.scheduling.maintenanceWindows.suppressAlerts) {
                const inMaintenance = this.scheduling.maintenanceWindows.scheduledWindows.some(w => 
                    new Date(w.start) <= new Date() && new Date() <= new Date(w.end)
                );
                if (inMaintenance && alert.priority !== 'CRITICAL') {
                    return { suppressed: true, reason: 'Maintenance window active' };
                }
            }

            // Off-hours check
            if (rule.name === 'Low Priority During Off-Hours') {
                const hour = new Date().getUTCHours();
                const isOffHours = hour >= 22 || hour < 7;
                if (isOffHours && (alert.priority === 'LOW' || alert.priority === 'INFO')) {
                    return { 
                        suppressed: false, 
                        delayed: true, 
                        delayUntil: new Date(new Date().setHours(7, 0, 0, 0)).toISOString(),
                        reason: 'Off-hours delay'
                    };
                }
            }
        }

        return { suppressed: false };
    }

    // =============================================
    // ROUTING
    // =============================================
    applyRouting(alert) {
        for (let rule of this.rulesEngine.routing.rules) {
            if (alert.problem.category === rule.condition.category || 
                rule.condition.category === 'ALL') {
                return {
                    rule: rule.name,
                    assignedTeam: rule.assignTo,
                    immediateEscalation: rule.immediateEscalation || false,
                    preferredChannels: rule.channels
                };
            }
        }

        return {
            rule: 'DEFAULT',
            assignedTeam: 'general-support',
            immediateEscalation: false,
            preferredChannels: ['DASHBOARD', 'EMAIL']
        };
    }

    // =============================================
    // DETERMINE CHANNELS
    // =============================================
    determineChannels(alert) {
        const priorityConfig = this.priorityMatrix[alert.priority];
        let channels = [...priorityConfig.channels];

        // Apply quiet hours filtering
        if (this.scheduling.quietHours.enabled) {
            const hour = new Date().getUTCHours();
            const isQuietHours = hour >= parseInt(this.scheduling.quietHours.start) || 
                                hour < parseInt(this.scheduling.quietHours.end);
            
            if (isQuietHours && !this.scheduling.quietHours.exceptions.includes(alert.priority)) {
                channels = channels.filter(c => ['DASHBOARD', 'EMAIL', 'KAFKA'].includes(c));
            }
        }

        return channels;
    }

    // =============================================
    // SEND TO CHANNELS
    // =============================================
    async sendToChannels(alert, channels) {
        const results = {
            totalChannels: channels.length,
            successCount: 0,
            failedCount: 0,
            details: {}
        };

        for (let channelName of channels) {
            try {
                const result = await this.sendToChannel(channelName, alert);
                results.details[channelName] = result;
                if (result.success) results.successCount++;
                else results.failedCount++;
            } catch (error) {
                results.details[channelName] = {
                    success: false,
                    error: error.message
                };
                results.failedCount++;
            }
        }

        alert.deliveryStatus = results;
        return results;
    }

