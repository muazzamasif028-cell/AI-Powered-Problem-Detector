                            "fields": [
                                {"type": "mrkdwn", "text": "*Location:* ${p.location}"},
                                {"type": "mrkdwn", "text": "*Value:* ${p.currentValue} ${p.unit}"}
                            ]
                        },
                        {
                            "type": "section",
                            "text": {"type": "mrkdwn", "text": "*Impact:* ${p.impact}"}
                        }
                    ]
                }`;

            case 'EMAIL':
                return `<html>
                    <body style="font-family:Arial;">
                        <h2 style="color:${this.priorityMatrix[alert.priority].color};">
                            ${priorityIcon} [${alert.priority}] ${p.name}
                        </h2>
                        <p><strong>Location:</strong> ${p.location}</p>
                        <p><strong>Value:</strong> ${p.currentValue} ${p.unit}</p>
                        <p><strong>Impact:</strong> ${p.impact}</p>
                        <p><strong>Recommended Action:</strong> ${alert.solution.recommendedActions[0]?.description || 'Investigate'}</p>
                        <hr>
                        <small>Alert ID: ${alert.id} | ${alert.timestamp}</small>
                    </body>
                </html>`;

            case 'SMS':
                return `${priorityIcon} [${alert.priority}] ${p.name} at ${p.location}. ${p.impact}. Action: ${alert.solution.recommendedActions[0]?.description || 'Check dashboard'}. Ref:${alert.id}`;

            case 'PAGERDUTY':
                return JSON.stringify({
                    routing_key: '${PAGERDUTY_ROUTING_KEY}',
                    event_action: 'trigger',
                    payload: {
                        summary: `[${alert.priority}] ${p.name}`,
                        source: p.location,
                        severity: this.priorityMatrix[alert.priority].level === 1 ? 'critical' : 'error',
                        component: p.category,
                        group: p.location,
                        class: alert.priority
                    }
                });

            case 'KAFKA':
                return JSON.stringify({
                    alertId: alert.id,
                    timestamp: alert.timestamp,
                    priority: alert.priority,
                    problem: p,
                    context: alert.context,
                    solution: alert.solution
                });

            default:
                return JSON.stringify(alert);
        }
    }

    // =============================================
    // ESCALATION TIMER
    // =============================================
    startEscalationTimer(alert) {
        const escalationLevels = this.rulesEngine.escalation.levels;
        
        escalationLevels.forEach((level, index) => {
            const timeout = this.parseTimeWindow(level.timeout);
            
            setTimeout(() => {
                if (alert.status === 'ACTIVE' && !alert.acknowledged) {
                    this.escalateAlert(alert, level);
                }
            }, timeout * (index + 1));
        });
    }

    escalateAlert(alert, level) {
        console.log(`📡 [ESCALATION]: ${alert.id} → Level ${level.level} (${level.name})`);
        
        alert.escalationLevel = level.level;
        this.state.escalatedAlerts++;

        // Send to escalation channels
        this.sendToChannels(alert, level.channels);
    }

    // =============================================
    // ACKNOWLEDGE ALERT
    // =============================================
    acknowledgeAlert(alertId, userId) {
        const alert = this.findAlert(alertId);
        if (!alert) return { success: false, error: 'Alert not found' };

        alert.acknowledged = true;
        alert.acknowledgedBy = userId;
        alert.acknowledgedAt = new Date().toISOString();
        alert.status = 'ACKNOWLEDGED';

        this.state.acknowledgedAlerts++;
        this.state.activeAlerts--;

        console.log(`📡 [ACK]: ${alertId} acknowledged by ${userId}`);

        return { success: true, alertId, acknowledgedBy: userId, timestamp: new Date().toISOString() };
    }

    // =============================================
    // RESOLVE ALERT
    // =============================================
    resolveAlert(alertId, resolution = {}) {
        const alert = this.findAlert(alertId);
        if (!alert) return { success: false, error: 'Alert not found' };

        alert.status = 'RESOLVED';
        alert.resolvedAt = new Date().toISOString();
        alert.resolution = resolution;

        this.state.resolvedAlerts++;
        if (alert.status === 'ACTIVE') this.state.activeAlerts--;

        // Auto-resolve in PagerDuty
        this.sendToChannel('PAGERDUTY', {
            ...alert,
            pagerDutyAction: 'resolve'
        });

        console.log(`📡 [RESOLVED]: ${alertId} resolved`);

        return { success: true, alertId, resolvedAt: new Date().toISOString() };
    }

    // =============================================
    // ALERT STORM DETECTION
    // =============================================
    startStormMonitor() {
        setInterval(() => {
            this.checkAlertStorm();
        }, 60000); // Check every minute
    }

    checkAlertStorm() {
        const recentWindow = Date.now() - 60000; // Last 1 minute
        const recentAlerts = this.alertHistory.filter(h => 
            new Date(h.timestamp).getTime() > recentWindow
        );

        if (recentAlerts.length >= this.stormDetection.thresholds.ratePerMinute) {
            this.state.alertStormCount++;
            
            console.log(`📡 [STORM]: Alert storm detected! ${recentAlerts.length} alerts/min`);

            // Create master incident
            const masterIncident = {
                id: 'STORM-' + Date.now().toString(36).toUpperCase(),
                type: 'ALERT_STORM',
                alertCount: recentAlerts.length,
                timestamp: new Date().toISOString(),
                affectedSystems: [...new Set(recentAlerts.map(a => a.problem.category))],
                status: 'ACTIVE'
            };

            this.activeIncidents.set(masterIncident.id, masterIncident);

            // Suppress non-critical alerts
            if (this.stormDetection.actions.suppressNonCritical) {
                this.rulesEngine.suppression.rules.push({
                    name: 'ALERT_STORM',
                    condition: { stormActive: true },
                    action: 'SUPPRESS',
                    duration: '10 min'
                });
            }

            return {
                stormDetected: true,
                masterIncident,
                alertRate: recentAlerts.length + '/min'
            };
        }

        return { stormDetected: false, alertRate: recentAlerts.length + '/min' };
    }

    // =============================================
    // UTILITY FUNCTIONS
    // =============================================
    parseTimeWindow(window) {
        const match = window.match(/(\d+)\s*(min|hour|hr|h|day|d|sec|s)/i);
        if (!match) return 300000; // Default 5 min
        
        const value = parseInt(match[1]);
        const unit = match[2].toLowerCase();

        switch (unit) {
            case 'sec': case 's': return value * 1000;
            case 'min': return value * 60000;
            case 'hour': case 'hr': case 'h': return value * 3600000;
            case 'day': case 'd': return value * 86400000;
            default: return 300000;
        }
    }

    findAlert(alertId) {
        return this.alertHistory.find(h => h.id === alertId) || null;
    }

    storeAlert(alert) {
        this.alertHistory.push(alert);
        if (this.alertHistory.length > this.maxHistorySize) {
            this.alertHistory.shift();
        }
    }

    // =============================================
    // GET ALERT DASHBOARD
    // =============================================
    getAlertDashboard() {
        const now = Date.now();
        const last24h = this.alertHistory.filter(h => now - new Date(h.timestamp).getTime() < 86400000);
        const last1h = last24h.filter(h => now - new Date(h.timestamp).getTime() < 3600000);
        const last5min = last1h.filter(h => now - new Date(h.timestamp).getTime() < 300000);

        return {
            summary: {
                total: this.state.totalAlerts,
                active: this.state.activeAlerts,
                acknowledged: this.state.acknowledgedAlerts,
                resolved: this.state.resolvedAlerts,
                escalated: this.state.escalatedAlerts,
                stormCount: this.state.alertStormCount
            },
            rates: {
                last5min: last5min.length + '/5min',
                lastHour: last1h.length + '/hour',
                last24h: last24h.length + '/24h',
                stormStatus: this.state.alertStormCount > 0 ? 'ACTIVE' : 'NONE'
            },
            byPriority: {
                CRITICAL: last24h.filter(h => h.priority === 'CRITICAL').length,
                HIGH: last24h.filter(h => h.priority === 'HIGH').length,
                MEDIUM: last24h.filter(h => h.priority === 'MEDIUM').length,
                LOW: last24h.filter(h => h.priority === 'LOW').length
            },
            byChannel: {
                DASHBOARD: this.channels.DASHBOARD.status,
                EMAIL: this.channels.EMAIL.status,
                SMS: this.channels.SMS.status,
                SLACK: this.channels.SLACK.status,
                PAGERDUTY: this.channels.PAGERDUTY.status,
                KAFKA: this.channels.KAFKA.status
            },
            activeIncidents: Array.from(this.activeIncidents.values()),
            recentAlerts: last5min.slice(0, 10)
        };
    }

    // =============================================
    // SYSTEM STATUS
    // =============================================
    getStatus() {
        return {
            initialized: this.state.initialized,
            channels: Object.keys(this.channels).length,
            priorities: Object.keys(this.priorityMatrix).length,
            escalationLevels: this.rulesEngine.escalation.levels.length,
            rules: {
                deduplication: this.rulesEngine.deduplication.enabled,
                correlation: this.rulesEngine.correlation.enabled,
                suppression: this.rulesEngine.suppression.enabled,
                escalation: this.rulesEngine.escalation.enabled,
                routing: this.rulesEngine.routing.enabled
            },
            stormDetection: this.stormDetection.enabled,
            totalAlerts: this.state.totalAlerts,
            activeAlerts: this.state.activeAlerts
        };
    }

    reset() {
        this.alertHistory = [];
        this.alertGroups.clear();
        this.activeIncidents.clear();
        this.state.totalAlerts = 0;
        this.state.activeAlerts = 0;
        this.state.acknowledgedAlerts = 0;
        this.state.resolvedAlerts = 0;
        this.state.escalatedAlerts = 0;
        this.state.alertStormCount = 0;
        return { status: 'RESET' };
    }
}

