{
  "name": "supreme-platform",
  "version": "14.0.0",
  "private": true,
  "description": "SUPREME PLANETARY OS v14.0 — World's Most Powerful AI + Cloud + Agent + Engineering + Mobility + Marketplace Ecosystem with Real-Time Autonomous Systems, Quantum Security, 30 Safety Pillars, Global Payment Infrastructure, Fleet Command Center, and Enterprise Platform",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "modules/*"
  ],
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "turbo dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:auth\" \"npm run dev:payment\" \"npm run dev:marketplace\"",
    "dev:auth": "nodemon src/auth/server.js",
    "dev:payment": "nodemon src/payment/server.js",
    "dev:marketplace": "nodemon src/marketplace/server.js",
    "dev:studio": "nodemon src/engineering/server.js",
    "dev:fleet": "nodemon src/fleet/server.js",
    "dev:realtime": "nodemon src/realtime/server.js",
    "dev:domain": "nodemon src/domain/server.js",
    "build": "turbo build",
    "build:prod": "NODE_ENV=production turbo build",
    "cluster": "node cluster.js",
    "test": "turbo test",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:security": "jest --testPathPattern=security",
    "test:performance": "k6 run tests/performance/",
    "test:load": "artillery run tests/load/",
    "lint": "turbo lint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:build": "docker build -t supreme-os:v14 .",
    "docker:build:all": "docker-compose -f docker/docker-compose.yml build",
    "docker:run": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "docker:prune": "docker system prune -af",
    "k8s:deploy": "kubectl apply -f kubernetes/",
    "k8s:deploy:all": "kubectl apply -f kubernetes/ --recursive",
    "k8s:status": "kubectl get pods -n supreme-platform",
    "k8s:logs": "kubectl logs -n supreme-platform -l app=supreme-core --tail=100 -f",
    "k8s:scale": "kubectl scale deployment supreme-core --replicas=5 -n supreme-platform",
    "k8s:rollback": "kubectl rollout undo deployment/supreme-core -n supreme-platform",
    "db:migrate": "turbo db:migrate",
    "db:seed": "turbo db:seed",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "node scripts/restore-db.js",
    "backup:full": "bash scripts/full-backup.sh",
    "restore:full": "node scripts/full-restore.js",
    "generate:docs": "swagger-jsdoc -d swagger.yaml -o docs/swagger.json",
    "generate:sdk": "node scripts/generate-sdk.js",
    "security:audit": "npm audit --audit-level=high",
    "security:fix": "npm audit fix",
    "security:scan": "snyk test --all-projects",
    "security:docker": "trivy image supreme-os:v14",
    "dep:check": "dependency-cruiser --config .dependency-cruiser.js src/",
    "dep:graph": "madge --image docs/dependency-graph.png src/",
    "dep:update": "npx npm-check-updates -u",
    "load:test": "artillery run tests/load/load-test.yml",
    "perf:test": "k6 run tests/performance/perf-test.js",
    "benchmark": "node tests/benchmark/run-all.js",
    "clean": "turbo clean && rm -rf node_modules/.cache",
    "clean:all": "npm run clean && rm -rf node_modules dist",
    "prepare": "husky install",
    "postinstall": "node scripts/postinstall.js",
    "release:patch": "npm version patch && npm run build:prod",
    "release:minor": "npm version minor && npm run build:prod",
    "release:major": "npm version major && npm run build:prod",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "deploy:production": "bash scripts/deploy-production.sh",
    "deploy:canary": "bash scripts/deploy-canary.sh",
    "rollback:production": "bash scripts/rollback-production.sh"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.1.0",
    "ioredis": "^5.3.2",
    "bull": "^4.12.0",
    "bull-board": "^2.1.3",
