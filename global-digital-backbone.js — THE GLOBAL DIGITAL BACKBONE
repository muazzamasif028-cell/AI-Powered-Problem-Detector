                status: region.status,
                nodes: region.nodes,
                load: (Math.random() * 60 + 20).toFixed(1) + '%',
                health: '✅ ONLINE'
            };
        }

        // Check all sectors
        for (let [key, sector] of Object.entries(this.sectors)) {
            health.sectors[key] = {
                name: sector.name,
                status: sector.status,
                bandwidth: sector.bandwidth,
                health: '✅ CONNECTED'
            };
        }

        // Check all routes
        for (let [key, route] of Object.entries(this.routes)) {
            health.routes[key] = {
                name: route.name,
                status: route.status,
                bandwidth: route.bandwidth,
                latency: route.latency,
                health: route.status === 'ACTIVE' ? '✅ ACTIVE' : '⚠️ DEGRADED'
