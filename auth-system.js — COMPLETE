            // Store
            company.users.push(userId);
            this.companies.set(companyId, company);
            this.users.set(userId, user);
            this.users.set(user.email, user);
            
            this.state.totalUsers++;
            this.state.totalCompanies++;

            // Generate features
            const userFeatures = this.generateUserFeatures(user, company);

            // Log audit
            this.logAudit('COMPANY_REGISTER', userId, companyId, this.getClientIP());

            console.log(`🤫 [AUTH]: ${registerId} — Company created: ${company.name}`);

            return {
