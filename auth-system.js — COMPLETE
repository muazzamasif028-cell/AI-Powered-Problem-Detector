    // =============================================
    // ADD USER TO COMPANY
    // =============================================
    async addCompanyUser(adminSession, newUserData) {
        // Verify admin permissions
        if (!this.hasPermission(adminSession, 'MANAGE_COMPANY_USERS')) {
            return { success: false, error: 'Insufficient permissions' };
        }

        const company = this.companies.get(adminSession.companyId);
        if (!company) {
            return { success: false, error: 'Company not found' };
        }

        // Check user limit
        if (company.users.length >= company.features.maxUsers) {
            return { success: false, error: `Maximum users (${company.features.maxUsers}) reached. Upgrade your plan.` };
        }

        // Create user
        const userId = 'USER-' + Date.now().toString(36).toUpperCase();
        const user = {
            id: userId,
            email: newUserData.email.toLowerCase(),
            password: this.hashPassword(newUserData.password || 'TempPass@123'),
            name: newUserData.name,
            role: newUserData.role || 'COMPANY_VIEWER',
            companyId: company.id,
            companyName: company.name,
            tier: company.tier,
            createdAt: new Date().toISOString(),
            lastLogin: null,
            isActive: true,
            twoFactorEnabled: false,
            permissions: this.roles[newUserData.role || 'COMPANY_VIEWER'].permissions
        };

        company.users.push(userId);
        this.users.set(userId, user);
        this.users.set(user.email, user);
        this.state.totalUsers++;

        this.logAudit('USER_ADDED', userId, company.id, this.getClientIP());

        return {
            success: true,
            user: {
                id: user.id,
                name: user.name,
                email: user.email,
                role: user.role,
                permissions: user.permissions
            },
            companyUsers: company.users.length,
            remainingSlots: company.features.maxUsers - company.users.length
        };
    }

    // =============================================
    // GENERATE USER FEATURES
    // =============================================
    generateUserFeatures(user, company) {
        const role = this.roles[user.role];
        const tier = this.tierFeatures[company.tier];
        
        // Build accessible features based on role + tier
        const accessibleFeatures = {};
        const restrictions = [];

        // Diagnostics
        if (this.featureAccess.DIAGNOSTICS.BASIC.includes(user.role)) {
            accessibleFeatures.diagnostics = { level: 'BASIC', detectors: tier.maxDetectors };
        }
        if (this.featureAccess.DIAGNOSTICS.ADVANCED.includes(user.role)) {
            accessibleFeatures.diagnostics = { level: 'ADVANCED', detectors: tier.maxDetectors };
        }
        if (this.featureAccess.DIAGNOSTICS.FULL_SYSTEM.includes(user.role)) {
            accessibleFeatures.diagnostics = { level: 'FULL', detectors: 'UNLIMITED' };
        }

        // Problem Detection
        if (this.featureAccess.PROBLEM_DETECTION.VIEW_OWN.includes(user.role)) {
            accessibleFeatures.problemView = 'OWN';
        }
        if (this.featureAccess.PROBLEM_DETECTION.VIEW_COMPANY.includes(user.role)) {
            accessibleFeatures.problemView = 'COMPANY';
        }
        if (this.featureAccess.PROBLEM_DETECTION.VIEW_ALL.includes(user.role)) {
            accessibleFeatures.problemView = 'ALL';
        }

        // Fixes
        if (this.featureAccess.FIXES.APPLY_BASIC.includes(user.role)) {
            accessibleFeatures.fixes = 'BASIC';
        }
        if (this.featureAccess.FIXES.APPLY_ADVANCED.includes(user.role)) {
            accessibleFeatures.fixes = 'ADVANCED';
        }
        if (this.featureAccess.FIXES.AUTO_APPLY.includes(user.role)) {
            accessibleFeatures.fixes = 'AUTO';
        }

        // Satellite
        if (this.featureAccess.SATELLITE.VIEW.includes(user.role)) {
            accessibleFeatures.satellite = 'VIEW';
        }
        if (this.featureAccess.SATELLITE.CONTROL.includes(user.role)) {
            accessibleFeatures.satellite = 'CONTROL';
        }

        // Pricing
        if (this.featureAccess.PRICING.VIEW_OWN.includes(user.role)) {
            accessibleFeatures.pricing = 'VIEW';
        }
        if (this.featureAccess.PRICING.MODIFY.includes(user.role)) {
            accessibleFeatures.pricing = 'MODIFY';
        }

        // Restrictions based on role
        if (user.role === 'EXTERNAL_USER') {
            restrictions.push('Cannot view other users problems');
            restrictions.push('Cannot access company settings');
            restrictions.push('Limited to 1 active session');
        }
        if (user.role === 'COMPANY_VIEWER') {
            restrictions.push('Read-only access');
            restrictions.push('Cannot apply fixes');
            restrictions.push('Cannot manage users');
        }

        return {
            accessibleFeatures,
            companyFeatures: tier.features,
            maxUsers: tier.maxUsers,
            storage: tier.storage,
            support: tier.support,
            responseTime: tier.responseTime,
            restrictions,
            dashboardConfig: this.generateDashboardConfig(user, company)
        };
    }

    // =============================================
    // GENERATE DASHBOARD CONFIG
    // =============================================
    generateDashboardConfig(user, company) {
        const config = {
            widgets: [],
            sidebar: [],
            alerts: []
        };

        switch (user.role) {
            case 'SUPER_ADMIN':
                config.widgets = ['ALL_COMPANIES', 'SYSTEM_HEALTH', 'SATELLITE_FLEET', 'REVENUE', 'AUDIT_LOG'];
                config.sidebar = ['DASHBOARD', 'COMPANIES', 'USERS', 'SATELLITES', 'PRICING', 'AUDIT', 'SYSTEM'];
                config.alerts = ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW'];
                break;
            
            case 'COMPANY_ADMIN':
                config.widgets = ['COMPANY_HEALTH', 'USERS', 'BILLING', 'PROBLEMS', 'ANALYTICS'];
                config.sidebar = ['DASHBOARD', 'PROBLEMS', 'USERS', 'BILLING', 'SETTINGS'];
                config.alerts = ['CRITICAL', 'HIGH', 'MEDIUM'];
                break;
            
            case 'COMPANY_ENGINEER':
                config.widgets = ['DIAGNOSTICS', 'PROBLEMS', 'FIXES', 'LOGS'];
                config.sidebar = ['DASHBOARD', 'DIAGNOSTICS', 'PROBLEMS', 'LOGS'];
                config.alerts = ['CRITICAL', 'HIGH'];
                break;
            
            case 'COMPANY_VIEWER':
                config.widgets = ['PROBLEMS', 'STATUS'];
                config.sidebar = ['DASHBOARD', 'PROBLEMS'];
                config.alerts = ['CRITICAL'];
                break;
            
            default:
                config.widgets = ['MY_PROBLEMS'];
                config.sidebar = ['MY_PROBLEMS', 'SUPPORT'];
                config.alerts = [];
        }

        return config;
    }

    // =============================================
    // PERMISSION CHECK
    // =============================================
    hasPermission(session, permission) {
        if (!session || !session.userId) return false;
        
        const user = this.users.get(session.userId);
        if (!user) return false;
        
        return user.permissions.includes(permission) || user.permissions.includes('ALL_ACCESS');
    }

    // =============================================
    // VERIFY SESSION
    // =============================================
    verifySession(sessionToken) {
        const session = this.sessions.get(sessionToken);
        
        if (!session) {
            return { valid: false, error: 'Session not found' };
        }

        if (Date.now() > session.expiresAt) {
            this.sessions.delete(sessionToken);
            this.state.activeSessions--;
            return { valid: false, error: 'Session expired' };
        }

        // Extend session
        session.lastActivity = Date.now();
        
        return {
            valid: true,
            session: {
                userId: session.userId,
                companyId: session.companyId,
                role: session.role,
                expiresAt: session.expiresAt
            }
        };
    }

    // =============================================
    // SIGN OUT
    // =============================================
    signOut(sessionToken) {
        const session = this.sessions.get(sessionToken);
        
        if (session) {
            this.sessions.delete(sessionToken);
            this.state.activeSessions--;
            
            this.logAudit('SIGN_OUT', session.userId, session.companyId, this.getClientIP());
            
            return { success: true, message: 'Signed out successfully' };
        }
        
        return { success: false, error: 'Session not found' };
    }

    // =============================================
    // CREATE SESSION
    // =============================================
    createSession(user, company, ipAddress) {
        const sessionId = 'SESS-' + Date.now().toString(36) + '-' + 
                         Math.random().toString(36).substr(2, 16);
        
        const token = this.generateToken(user);
        const role = this.roles[user.role];
        
        const session = {
            id: sessionId,
            token,
            userId: user.id,
            companyId: company.id,
            role: user.role,
            tier: company.tier,
            createdAt: Date.now(),
            expiresAt: Date.now() + (role.sessionTimeout * 1000),
            lastActivity: Date.now(),
            ipAddress
        };

        this.sessions.set(token, session);
        this.state.activeSessions++;

        return session;
    }

    canCreateSession(user) {
        const role = this.roles[user.role];
        const userSessions = Array.from(this.sessions.values())
            .filter(s => s.userId === user.id && s.expiresAt > Date.now());
        
        return userSessions.length < role.maxSessions;
    }

    // =============================================
    // UTILITY FUNCTIONS
    // =============================================
    generateToken(user) {
        const payload = `${user.id}:${user.companyId}:${Date.now()}:${Math.random()}`;
        return this.hashPassword(payload);
    }

    generateCompanyCode(name) {
        const prefix = name.replace(/[^A-Z]/g, '').substring(0, 3).toUpperCase();
        const number = Math.floor(Math.random() * 9000) + 1000;
        return `${prefix}-${number}`;
    }

    hashPassword(password) {
        let hash = 0;
        const salt = 'SUPREME_SALT_2024';
        const combined = password + salt;
        
        for (let i = 0; i < combined.length; i++) {
            const char = combined.charCodeAt(i);
            hash = ((hash << 5) - hash) + char;
            hash = hash & hash;
        }
        
        return Math.abs(hash).toString(16).padStart(64, '0');
    }

    verifyPassword(password, hash) {
        return this.hashPassword(password) === hash;
    }

    getClientIP() {
        return '192.168.1.' + Math.floor(Math.random() * 255);
    }

    isRateLimited(ipAddress) {
        // Simple rate limiting
        const recentAttempts = this.auditLogs.filter(
            log => log.ip === ipAddress && 
                   log.action === 'SIGN_IN' && 
                   Date.now() - new Date(log.timestamp).getTime() < 900000
        );
        
        return recentAttempts.length > 10;
    }

    authFailed(loginId, reason) {
        console.log(`🤫 [AUTH]: ${loginId} — Failed: ${reason}`);
        return {
            success: false,
            loginId,
            error: reason,
            timestamp: new Date().toISOString()
        };
    }

    logAudit(action, userId, companyId, ipAddress) {
        this.auditLogs.push({
            action,
            userId,
            companyId,
            ip: ipAddress,
            timestamp: new Date().toISOString()
        });
        
        if (this.auditLogs.length > 10000) {
            this.auditLogs.shift();
        }
    }

    // =============================================
    // SYSTEM STATUS
    // =============================================
    getStatus() {
        return {
            initialized: this.state.initialized,
            totalUsers: this.state.totalUsers,
            totalCompanies: this.state.totalCompanies,
            activeSessions: this.state.activeSessions,
            loginAttempts: this.state.loginAttempts,
            failedAttempts: this.state.failedAttempts,
            blockedIPs: this.state.blockedIPs.size,
            roles: Object.keys(this.roles).length,
            tiers: Object.keys(this.tierFeatures).length,
            auditLogsSize: this.auditLogs.length
        };
    }

    // =============================================
    // GET COMPANY USERS
    // =============================================
    getCompanyUsers(companyId) {
        const company = this.companies.get(companyId);
        if (!company) return [];
        
        return company.users.map(userId => {
            const user = this.users.get(userId);
            return {
                id: user.id,
                name: user.name,
                email: user.email,
                role: user.role,
                roleName: this.roles[user.role].name,
                lastLogin: user.lastLogin,
                isActive: user.isActive
            };
        });
    }

    // =============================================
    // SWITCH COMPANY (Super Admin only)
    // =============================================
    switchCompany(sessionToken, targetCompanyId) {
        const session = this.sessions.get(sessionToken);
        if (!session) return { success: false, error: 'Invalid session' };
        
        const user = this.users.get(session.userId);
        if (!user || user.role !== 'SUPER_ADMIN') {
            return { success: false, error: 'Only Super Admin can switch companies' };
        }
        
        const targetCompany = this.companies.get(targetCompanyId);
        if (!targetCompany) return { success: false, error: 'Company not found' };
        
        session.companyId = targetCompanyId;
        return {
            success: true,
            company: {
                id: targetCompany.id,
                name: targetCompany.name,
                tier: targetCompany.tier
            }
        };
    }

    reset() {
        this.users.clear();
        this.companies.clear();
        this.sessions.clear();
        this.auditLogs = [];
        this.state.totalUsers = 0;
        this.state.totalCompanies = 0;
        this.state.activeSessions = 0;
        this.initialize();
        return { status: 'RESET' };
    }
}

