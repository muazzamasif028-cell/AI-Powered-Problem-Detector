                id: companyId,
                name: companyData.name,
                tier: companyData.tier || 'SMALL',
                code: this.generateCompanyCode(companyData.name),
                industry: companyData.industry || 'Technology',
                size: companyData.size || '1-10',
                users: [],
                createdAt: new Date().toISOString(),
                features: this.tierFeatures[companyData.tier || 'SMALL'],
                billing: {
                    plan: companyData.tier || 'SMALL',
                    status: 'TRIAL',
                    trialEnds: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString()
                }
            };

            // Create admin user
            const userId = 'USER-' + Date.now().toString(36).toUpperCase();
            const user = {
                id: userId,
                email: adminData.email.toLowerCase(),
                password: this.hashPassword(adminData.password),
                name: adminData.name,
