    // =============================================
    // SIGN IN — COMPANY BASED
    // =============================================
    async signIn(email, password, companyId = null) {
        const loginId = 'LOGIN-' + Date.now().toString(36) + '-' + 
                       Math.random().toString(36).substr(2, 6).toUpperCase();
        
        const ipAddress = this.getClientIP();
        
        console.log(`🤫 [AUTH]: ${loginId} — Sign in attempt: ${email}`);
        
        this.state.loginAttempts++;

        try {
            // Step 1: Validate input
            if (!email || !password) {
                return this.authFailed(loginId, 'Email and password required');
            }

            // Step 2: Check rate limiting
            if (this.isRateLimited(ipAddress)) {
                this.state.blockedIPs.add(ipAddress);
                return this.authFailed(loginId, 'Too many attempts. IP blocked for 15 minutes.');
            }

            // Step 3: Find user
            const user = this.users.get(email.toLowerCase());
            if (!user) {
                return this.authFailed(loginId, 'Invalid credentials');
            }

            // Step 4: Verify password
            if (!this.verifyPassword(password, user.password)) {
                this.state.failedAttempts++;
                return this.authFailed(loginId, 'Invalid credentials');
            }

            // Step 5: Check account status
            if (!user.isActive) {
                return this.authFailed(loginId, 'Account is deactivated');
            }

            // Step 6: Company verification
            if (companyId && user.companyId !== companyId) {
                return this.authFailed(loginId, 'Company mismatch');
            }

            // Step 7: Check session limits
            if (!this.canCreateSession(user)) {
                return this.authFailed(loginId, 'Maximum sessions reached');
            }

            // Step 8: Get company data
            const company = this.companies.get(user.companyId);
            if (!company) {
                return this.authFailed(loginId, 'Company not found');
            }

            // Step 9: Create session
            const session = this.createSession(user, company, ipAddress);
            
            // Step 10: Update user
            user.lastLogin = new Date().toISOString();
            
            // Step 11: Generate user features based on role and tier
            const userFeatures = this.generateUserFeatures(user, company);
            
            // Step 12: Log audit
            this.logAudit('SIGN_IN', user.id, company.id, ipAddress);

            console.log(`🤫 [AUTH]: ${loginId} — Success: ${user.name} (${user.role}) → ${company.name}`);

            return {
                success: true,
                loginId,
                session: {
                    token: session.token,
                    expiresAt: session.expiresAt,
                    sessionId: session.id
                },
                user: {
                    id: user.id,
                    name: user.name,
                    email: user.email,
                    role: user.role,
                    roleName: this.roles[user.role].name,
                    permissions: user.permissions,
                    twoFactorEnabled: user.twoFactorEnabled
                },
                company: {
                    id: company.id,
                    name: company.name,
                    tier: company.tier,
                    features: userFeatures.companyFeatures,
                    maxUsers: userFeatures.maxUsers,
                    currentUsers: company.users.length
                },
                features: userFeatures.accessibleFeatures,
                restrictions: userFeatures.restrictions,
                dashboard: userFeatures.dashboardConfig,
                timestamp: new Date().toISOString()
            };

        } catch (error) {
            console.error(`🤫 [AUTH]: ${loginId} — Error: ${error.message}`);
            return this.authFailed(loginId, 'System error');
        }
    }

    // =============================================
    // SIGN IN WITH COMPANY CODE
    // =============================================
    async signInWithCompanyCode(email, password, companyCode) {
        // Find company by code
        let companyId = null;
        for (let [id, company] of this.companies) {
            if (company.code === companyCode || company.name.toLowerCase().includes(companyCode.toLowerCase())) {
                companyId = id;
                break;
            }
        }

        if (!companyId) {
            return this.authFailed('COMP-CODE', 'Invalid company code');
        }

        return this.signIn(email, password, companyId);
    }

