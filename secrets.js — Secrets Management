// 🔐 src/security/secrets.js
// Secrets Manager — Never hardcode secrets
// ============================================================
const crypto = require('crypto');

class SecretsManager {
    constructor() {
        this.provider = process.env.SECRETS_PROVIDER || 'env'; // env | vault | aws | gcp
        this.cache = new Map();
        this.cacheExpiry = 5 * 60 * 1000; // 5 minutes
        
        // Encryption key for local secrets
        this.encryptionKey = process.env.ENCRYPTION_KEY;
        
        if (this.provider === 'vault') {
            this.initVault();
        }
    }

    /**
     * Initialize HashiCorp Vault
     */
    initVault() {
        const vault = require('node-vault')({
            apiVersion: 'v1',
            endpoint: process.env.VAULT_ADDR,
            token: process.env.VAULT_TOKEN
        });
        this.vault = vault;
    }

    /**
     * Get a secret
     */
    async get(key) {
        // Check cache first
        const cached = this.cache.get(key);
        if (cached && (Date.now() - cached.timestamp) < this.cacheExpiry) {
            return cached.value;
        }

        let value;

        switch (this.provider) {
            case 'vault':
                value = await this.getFromVault(key);
                break;
                
            case 'aws':
                value = await this.getFromAWS(key);
                break;
                
            case 'gcp':
                value = await this.getFromGCP(key);
                break;
                
            case 'env':
            default:
                value = this.getFromEnv(key);
                break;
        }

        // Cache the value
        if (value) {
            this.cache.set(key, { value, timestamp: Date.now() });
        }

        return value;
    }

    /**
     * Get from environment variables
     */
    getFromEnv(key) {
        const value = process.env[key];
        
        // If encrypted, decrypt
        if (value && value.startsWith('enc:')) {
            return this.decrypt(value.replace('enc:', ''));
        }
        
        return value;
    }

    /**
     * Get from HashiCorp Vault
     */
    async getFromVault(key) {
        try {
            const result = await this.vault.read(`secret/data/${key}`);
            return result.data.data.value;
        } catch (error) {
            console.error(`Vault error for ${key}:`, error.message);
            return null;
        }
    }

    /**
     * Get from AWS Secrets Manager
     */
    async getFromAWS(key) {
        const AWS = require('aws-sdk');
        const secretsManager = new AWS.SecretsManager({
            region: process.env.AWS_REGION
        });

        try {
            const result = await secretsManager.getSecretValue({
                SecretId: key
            }).promise();
            
            return JSON.parse(result.SecretString)[key];
        } catch (error) {
            console.error(`AWS Secrets error for ${key}:`, error.message);
            return null;
        }
    }

    /**
     * Get from GCP Secret Manager
     */
    async getFromGCP(key) {
        const { SecretManagerServiceClient } = require('@google-cloud/secret-manager');
        const client = new SecretManagerServiceClient();

        try {
            const [version] = await client.accessSecretVersion({
                name: `projects/${process.env.GCP_PROJECT}/secrets/${key}/versions/latest`
            });
            
            return version.payload.data.toString();
        } catch (error) {
            console.error(`GCP Secret error for ${key}:`, error.message);
            return null;
        }
    }

    /**
     * Get all secrets for a service
     */
    async getServiceSecrets(serviceName) {
        const secrets = {};
        const prefix = `${serviceName.toUpperCase()}_`;

        for (const [key, value] of Object.entries(process.env)) {
            if (key.startsWith(prefix)) {
                secrets[key.replace(prefix, '')] = await this.get(key);
            }
        }

        return secrets;
    }

    /**
     * Encrypt a value
     */
    encrypt(value) {
        const iv = crypto.randomBytes(16);
        const cipher = crypto.createCipheriv('aes-256-gcm', 
            Buffer.from(this.encryptionKey, 'hex'), iv);
        
        let encrypted = cipher.update(value, 'utf8', 'hex');
        encrypted += cipher.final('hex');
        
        const authTag = cipher.getAuthTag();
        
        return `enc:${iv.toString('hex')}:${authTag.toString('hex')}:${encrypted}`;
    }

    /**
     * Decrypt a value
     */
    decrypt(encryptedValue) {
        const parts = encryptedValue.split(':');
        const iv = Buffer.from(parts[0], 'hex');
        const authTag = Buffer.from(parts[1], 'hex');
        const encrypted = parts[2];

        const decipher = crypto.createDecipheriv('aes-256-gcm',
            Buffer.from(this.encryptionKey, 'hex'), iv);
        
        decipher.setAuthTag(authTag);
        
        let decrypted = decipher.update(encrypted, 'hex', 'utf8');
        decrypted += decipher.final('utf8');
        
        return decrypted;
    }

    /**
     * Rotate encryption key
     */
    async rotateKey() {
        const newKey = crypto.randomBytes(32).toString('hex');
        
        // Re-encrypt all cached secrets with new key
        const oldKey = this.encryptionKey;
        this.encryptionKey = newKey;
        
        // Clear cache to force re-fetch with new key
        this.cache.clear();
        
        return { success: true, message: 'Encryption key rotated' };
    }

    /**
     * Clear cache
     */
    clearCache() {
        this.cache.clear();
    }
}

module.exports = new SecretsManager();
