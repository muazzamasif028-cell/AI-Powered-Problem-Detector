    // =============================================
    // 🧠 MAIN ROUTE METHOD
    // =============================================
    route(problem) {
        const routeId = 'ROUTE-' + Date.now().toString(36);
        const startTime = Date.now();

        // Step 1: Understand the problem (Natural Language)
        const problemType = this.understandProblem(problem);

        // Step 2: Look up routing table
        const routingInfo = this.routingTable[problemType];

        // Step 3: If not found, find closest match
        if (!routingInfo) {
            return this.routeUnknown(problem, routeId);
        }

        // Step 4: Build routing decision
        const decision = {
            routeId,
            timestamp: new Date().toISOString(),
            problem: typeof problem === 'string' ? problem : problem.description,
            problemType,
            routing: {
                pillars: routingInfo.pillars,
                pillarCount: routingInfo.pillars.length,
                severity: routingInfo.severity,
                autoFix: routingInfo.autoFix,
                estimatedTime: routingInfo.timeToFix,
                description: routingInfo.description
            },
            action: this.buildActionPlan(routingInfo),
            processingTime: (Date.now() - startTime) + 'ms'
        };

        this.state.totalProblems++;
        this.state.routedCorrectly++;

        return decision;
    }

    // =============================================
    // 🧠 UNDERSTAND PROBLEM (NLP)
    // =============================================
    understandProblem(problem) {
        const text = typeof problem === 'string' ? problem.toLowerCase() : 
                    (problem.description || problem.input || '').toLowerCase();

        let bestMatch = null;
        let highestScore = 0;

        // Check all patterns
        for (let [problemType, patterns] of Object.entries(this.nlRouter.patterns)) {
            for (let pattern of patterns) {
                if (text.includes(pattern)) {
                    const score = pattern.length; // Longer match = better
                    if (score > highestScore) {
                        highestScore = score;
                        bestMatch = problemType;
                    }
                }
            }
        }

        return bestMatch || 'UNKNOWN';
    }

    // =============================================
    // 🧠 ROUTE UNKNOWN PROBLEMS
    // =============================================
    routeUnknown(problem, routeId) {
        // For unknown problems, activate the most relevant pillars
        const text = typeof problem === 'string' ? problem.toLowerCase() : '';

        let severity = 'MEDIUM';
        let pillars = [];

        // Emergency keywords
        if (text.includes('critical') || text.includes('emergency') || text.includes('urgent') ||
            text.includes('crash') || text.includes('down') || text.includes('failure')) {
            severity = 'CRITICAL';
            pillars = ['GLOBAL_META_SCHEDULER', 'PREDICTIVE_INTELLIGENCE', 'MICRO_KERNEL_SELF_HEALING'];
        }
        // High severity keywords
        else if (text.includes('high') || text.includes('severe') || text.includes('major') ||
                 text.includes('error') || text.includes('problem') || text.includes('issue')) {
            severity = 'HIGH';
            pillars = ['PREDICTIVE_INTELLIGENCE', 'RESOURCE_INTERCEPTOR'];
        }
        // Default
        else {
            pillars = ['PREDICTIVE_INTELLIGENCE'];
        }

        return {
            routeId,
            timestamp: new Date().toISOString(),
            problem: typeof problem === 'string' ? problem : 'Unknown problem',
            problemType: 'UNKNOWN',
            routing: {
                pillars,
                pillarCount: pillars.length,
                severity,
                autoFix: severity !== 'CRITICAL',
                estimatedTime: severity === 'CRITICAL' ? 'Immediate' : '5-15 minutes',
                description: 'Unknown problem — Activating intelligent analysis pillars'
            },
            action: {
                immediate: pillars,
                investigation: 'AI Co-Pilot analyzing for pattern matching',
                escalation: severity === 'CRITICAL' ? 'NOTIFY_ADMIN' : 'LOG_ONLY'
            },
            processingTime: '0.5ms'
        };
    }

    // =============================================
    // 🧠 BUILD ACTION PLAN
    // =============================================
    buildActionPlan(routingInfo) {
        const plan = {
            immediate: [],
            shortTerm: [],
            longTerm: []
        };

        // Immediate actions (within seconds)
        if (routingInfo.autoFix) {
            plan.immediate = routingInfo.pillars.map(p => `ACTIVATE_${p}`);
        }

        // Short-term actions (within minutes)
        plan.shortTerm = [
            'VERIFY_FIX_APPLIED',
            'CHECK_SYSTEM_HEALTH',
            'LOG_INCIDENT'
        ];

        // Long-term actions
        plan.longTerm = [
            'UPDATE_LEARNING_MODEL',
            'ADJUST_PREDICTION_THRESHOLD',
            'GENERATE_CASE_STUDY'
        ];

        return plan;
    }

    // =============================================
    // 🧠 BATCH ROUTE — Multiple Problems
    // =============================================
    routeBatch(problems) {
        const results = problems.map(p => this.route(p));
        
        return {
            total: problems.length,
            routed: results.filter(r => r.problemType !== 'UNKNOWN').length,
            unknown: results.filter(r => r.problemType === 'UNKNOWN').length,
            criticalCount: results.filter(r => r.routing?.severity === 'CRITICAL').length,
            results,
            timestamp: new Date().toISOString()
        };
    }

    // =============================================
    // 🧠 GET ROUTING STATISTICS
    // =============================================
    getStatistics() {
        return {
            totalProblems: this.state.totalProblems,
            routedCorrectly: this.state.routedCorrectly,
            accuracyRate: this.state.accuracyRate + '%',
            avgRoutingTime: this.state.avgRoutingTime,
            knownProblemTypes: Object.keys(this.routingTable).length,
            nlpPatterns: Object.keys(this.nlRouter.patterns).length,
            pillarsCovered: [...new Set(
                Object.values(this.routingTable).flatMap(r => r.pillars)
            )].length
        };
    }

