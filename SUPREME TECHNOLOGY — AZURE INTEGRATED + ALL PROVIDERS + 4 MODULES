        <!-- Selector Bar: AI Providers + Sub-Modules -->
        <div class="selector-bar">
            <span class="selector-label">AI:</span>
            <span class="selector-chip active" data-provider="supreme" onclick="selectProvider('supreme', this)">⚡SUPREME</span>
            <span class="selector-chip" data-provider="openai" onclick="selectProvider('openai', this)">🧠GPT-5</span>
