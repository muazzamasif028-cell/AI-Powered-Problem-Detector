            <span class="selector-chip" data-provider="google" onclick="selectProvider('google', this)">🔮Gemini</span>
            <span class="selector-chip" data-provider="meta" onclick="selectProvider('meta', this)">🦙Llama</span>
            <span class="selector-chip" data-provider="deepseek" onclick="selectProvider('deepseek', this)">🐋DeepSeek</span>
            <span class="selector-chip" data-provider="xai" onclick="selectProvider('xai', this)">🚀Grok</span>
            <span class="selector-chip" data-provider="mistral" onclick="selectProvider('mistral', this)">🌪️Mistral</span>
            
            <span class="selector-divider"></span>
            <span class="selector-label">SUB:</span>
            <span class="selector-chip active" data-submodule="auto" onclick="selectSubModule('auto', this)">🤖AUTO</span>
            <span class="selector-chip" data-submodule="llm" onclick="selectSubModule('llm', this)">📝LLM</span>
            <span class="selector-chip" data-submodule="vision" onclick="selectSubModule('vision', this)">👁️VISION</span>
            <span class="selector-chip" data-submodule="trading" onclick="selectSubModule('trading', this)">📊TRADING</span>
            <span class="selector-chip" data-submodule="fraud" onclick="selectSubModule('fraud', this)">🛡️FRAUD</span>
            <span class="selector-chip" data-submodule="mesh" onclick="selectSubModule('mesh', this)">🌐MESH</span>
            <span class="selector-chip" data-submodule="pipeline" onclick="selectSubModule('pipeline', this)">📡PIPELINE</span>
        </div>
        
        <!-- Chat Area -->
        <div class="chat-area" id="chatArea">
            <div class="message bot-msg">
                <div class="bubble bot-bubble">
                    <div class="tag-line">
                        <span class="tag tag-provider">⚡ SUPREME</span>
                        <span class="tag tag-module">🧠 COGNITIVE</span>
                        <span class="tag tag-azure">☁️ AZURE</span>
                    </div>
                    👋 Welcome to <b>TechSolve Enterprise</b> — Powered by <b>Supreme Technology + Microsoft Azure</b>.<br><br>
                    ☁️ <b>Azure:</b> Enterprise-Grade Infrastructure | Hardware-Level Security<br>
                    🧠 <b>4 Core Modules:</b> Cognitive | Robotics | Financial | Infrastructure<br>
                    🤖 <b>8 AI Providers:</b> All integrated via Supreme Mesh<br>
                    🛡️ <b>30 Defense Pillars:</b> Active on Azure Confidential Computing<br><br>
                    <i>Describe your problem — routed through Azure infrastructure to the optimal AI module.</i>
                </div>
            </div>
        </div>
        
        <!-- Input Area -->
        <div class="input-area">
            <input type="text" class="message-input" id="messageInput" 
                   placeholder="Describe your problem... (Azure-powered routing)"
                   onkeypress="if(event.key==='Enter') sendMessage()">
            <button class="send-btn" onclick="sendMessage()">➤</button>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- 🤫 SUPREME + AZURE — COMPLETE ENGINE          -->
    <!-- ============================================ -->
    <script>
        // ============================================
        // ☁️ AZURE INFRASTRUCTURE MODULE
        // ============================================
        class AzureInfrastructure {
            constructor() {
                this.regions = 60;
                this.services = {
                    compute: { name: 'Azure Compute', status: 'ACTIVE', desc: 'Virtual Machines, AKS, Functions, Confidential Computing' },
                    ai: { name: 'Azure AI', status: 'ACTIVE', desc: 'Azure OpenAI Service, Cognitive Services, ML Studio' },
                    security: { name: 'Azure Security', status: 'ACTIVE', desc: 'Defender, Sentinel, Key Vault, Hardware TPM' },
                    network: { name: 'Azure Networking', status: 'ACTIVE', desc: 'Virtual Network, ExpressRoute, CDN, DDoS Protection' },
                    data: { name: 'Azure Data', status: 'ACTIVE', desc: 'Cosmos DB, SQL, Data Lake, Synapse Analytics' },
                    iot: { name: 'Azure IoT', status: 'ACTIVE', desc: 'IoT Hub, Digital Twins, Edge Computing' }
                };
                this.uptime = '99.999%';
                this.compliance = 'SOC2, ISO 27001, GDPR, HIPAA, FedRAMP';
                console.log('☁️ [AZURE]: Enterprise Infrastructure Active | 60 Regions | Hardware-Level Security');
            }

            process(input) {
                return {
                    infrastructure: 'Azure Global Network',
                    regions: `${this.regions} regions worldwide`,
                    security: 'Hardware TPM + Confidential Computing',
                    compliance: this.compliance,
                    response: `☁️ Azure Infrastructure: Processed through ${this.regions} global regions. Hardware-level security (TPM 2.0). Confidential Computing enabled. ${this.compliance} compliant.`
                };
            }
        }

        // ============================================
        // 🧠 MODULE 1: CORE COGNITIVE
        // ============================================
        class CognitiveModule {
            constructor() {
                this.subModules = {
                    llm: { name: 'LLM / Frontier Model', status: 'ACTIVE' },
                    reasoning: { name: 'Reasoning & Logic Engine', status: 'ACTIVE' },
                    agent: { name: 'Cognitive Agent Module', status: 'ACTIVE' },
                    memory: { name: 'Memory & Context Management', status: 'ACTIVE' }
                };
                this.agentCount = 22;
                console.log('🧠 [COGNITIVE]: LLM + Reasoning + Agent + Memory Active');
            }
            process() {
                return { module: 'Cognitive', response: `🧠 Cognitive Engine: ${this.agentCount} autonomous agents coordinated. Multi-step reasoning optimized. Context retrieved from QUANTUM-DB.` };
            }
        }

        // ============================================
        // 🚗 MODULE 2: ROBOTICS
        // ============================================
        class RoboticsModule {
            constructor() {
                this.subModules = {
                    perception: { name: 'Perception & Computer Vision', status: 'ACTIVE' },
                    slam: { name: 'Localization & Mapping (SLAM)', status: 'ACTIVE' },
                    navigation: { name: 'Path Planning & Navigation', status: 'ACTIVE' },
                    sensor: { name: 'Sensor Fusion', status: 'ACTIVE' },
                    actuation: { name: 'Actuation & Control', status: 'ACTIVE' }
                };
                console.log('🚗 [ROBOTICS]: Perception + SLAM + Navigation + Sensor + Actuation Active');
            }
            process() {
                return { module: 'Robotics', response: '🚗 Robotics Engine: 360° LiDAR active. 0ms decision latency. 1000+ objects/sec detection. 1cm GPS accuracy.' };
            }
        }

        // ============================================
        // 💰 MODULE 3: FINANCIAL
        // ============================================
        class FinancialModule {
            constructor() {
                this.subModules = {
                    trading: { name: 'Algorithmic Trading', status: 'ACTIVE' },
                    risk: { name: 'Risk Assessment & Credit Scoring', status: 'ACTIVE' },
                    fraud: { name: 'Fraud Detection & Anomaly Prevention', status: 'ACTIVE' },
                    clearing: { name: 'Automated Clearing & Ledger', status: 'ACTIVE' }
                };
                console.log('💰 [FINANCIAL]: Trading + Risk + Fraud + Clearing Active');
            }
            process() {
                return { module: 'Financial', response: '💰 Financial Engine: Settlement 0.3ms. Fraud detection 99.999%. $1Q transaction capacity. Quantum-safe transactions.' };
            }
        }

        // ============================================
        // ⚙️ MODULE 4: INFRASTRUCTURE
        // ============================================
        class InfrastructureModule {
            constructor() {
                this.subModules = {
                    orchestration: { name: 'Orchestration & Gateway', status: 'ACTIVE' },
                    pipeline: { name: 'Data Pipeline & Ingestion', status: 'ACTIVE' },
                    mesh: { name: 'Agent Communication (MESH)', status: 'ACTIVE' },
                    security: { name: 'Security & Guardrails', status: 'ACTIVE' }
                };
                console.log('⚙️ [INFRA]: Orchestration + Pipeline + MESH + Security Active');
            }
            process() {
                return { module: 'Infrastructure', response: '⚙️ Infrastructure Engine: MESH 0ms latency. 30 Defense Pillars. Self-healing 4-layer. 7.5Q nodes scalable.' };
            }
        }

        // ============================================
        // 🔀 SUPREME ROUTER
        // ============================================
        class SupremeRouter {
            constructor() {
                this.keywords = {
                    cognitive: ['think','reason','plan','write','code','explain','summarize','translate','analyze','research','logic','solve','learn','llm'],
                    robotics: ['robot','drone','car','autonomous','navigation','lidar','camera','slam','perception','path','motion','sensor','actuator','vehicle'],
                    financial: ['trade','stock','market','fraud','transaction','payment','bank','credit','risk','loan','settlement','trading','crypto','finance'],
                    infrastructure: ['server','database','network','api','deploy','pipeline','docker','kubernetes','mesh','orchestration','gateway','scale','infrastructure','backup']
                };
            }
            route(input) {
                const lc = input.toLowerCase();
                let scores = { cognitive: 0, robotics: 0, financial: 0, infrastructure: 0 };
                for (let [mod, keys] of Object.entries(this.keywords)) {
                    scores[mod] = keys.filter(k => lc.includes(k)).length;
                }
                let best = 'cognitive', bestScore = 0;
                for (let [m, s] of Object.entries(scores)) { if (s > bestScore) { bestScore = s; best = m; } }
                return best;
            }
        }

        // ============================================
        // 🤖 SUB-MODULE ENGINE
        // ============================================
        class SubModuleEngine {
            getResponse(sub, input, provider) {
                const responses = {
                    llm: `📝 [LLM Engine]\nNatural language processing via ${provider.name}...\n✅ Context: Full history. Response generated with multi-step reasoning.`,
                    vision: `👁️ [Computer Vision]\nVisual input processing...\n✅ Objects detected. Scene mapped. Spatial coordinates calculated.`,
                    trading: `📊 [Algorithmic Trading]\nReal-time market analysis via Azure infrastructure...\n✅ Trade signals generated. Execution: 0.3ms. Risk-adjusted.`,
                    fraud: `🛡️ [Fraud Detection]\nTransaction stream monitoring on Azure Confidential Computing...\n✅ Anomaly scan complete. Accuracy: 99.999%. 0 suspicious patterns.`,
                    mesh: `🌐 [Agent MESH Communication]\nPeer-to-peer protocol via Azure Virtual Network...\n✅ Secure channel established. 0ms latency. All agents synchronized.`,
                    pipeline: `📡 [Data Pipeline]\nData ingestion through Azure Data Factory...\n✅ Streams collected, cleaned, labeled. Throughput: Unlimited.`,
                    auto: `🤖 [Auto-Routing]\nOptimal sub-module selected based on query analysis...\n✅ Routed through most relevant engine.`
                };
                return responses[sub] || responses.auto;
            }
        }

        // ============================================
        // 🌐 PROVIDERS + INFRA
        // ============================================
        const AI_PROVIDERS = {
            supreme: { name: 'SUPREME TECHNOLOGY', icon: '⚡' },
            openai: { name: 'OpenAI GPT-5', icon: '🧠' },
            anthropic: { name: 'Anthropic Claude', icon: '🏛️' },
            google: { name: 'Google Gemini', icon: '🔮' },
            meta: { name: 'Meta Llama', icon: '🦙' },
            deepseek: { name: 'DeepSeek', icon: '🐋' },
            xai: { name: 'xAI Grok', icon: '🚀' },
            mistral: { name: 'Mistral AI', icon: '🌪️' }
        };

        const INFRA_NAMES = {
            azure: { name: 'AZURE', icon: '☁️' },
            cognitive: { name: 'COGNITIVE', icon: '🧠' },
            robotics: { name: 'ROBOTICS', icon: '🚗' },
            financial: { name: 'FINANCIAL', icon: '💰' },
            infrastructure: { name: 'INFRA', icon: '⚙️' }
        };

        // ============================================
        // ⚡ INITIALIZE ALL SYSTEMS
        // ============================================
        const azure = new AzureInfrastructure();
        const cognitive = new CognitiveModule();
        const robotics = new RoboticsModule();
        const financial = new FinancialModule();
        const infra = new InfrastructureModule();
        const router = new SupremeRouter();
        const subEngine = new SubModuleEngine();

        const modules = { cognitive, robotics, financial, infrastructure };
        const allInfra = { azure, cognitive, robotics, financial, infrastructure };

        let selectedProvider = 'supreme';
        let selectedInfra = 'azure';
        let selectedSubModule = 'auto';

        console.log('☁️╔══════════════════════════════════════════╗');
        console.log('☁️║ SUPREME TECHNOLOGY + MICROSOFT AZURE   ║');
        console.log('☁️║ ☁️ Azure:   60 Regions | HW Security   ║');
        console.log('☁️║ 🧠 Cognitive:  LLM + Reasoning         ║');
        console.log('☁️║ 🚗 Robotics:   Perception + SLAM       ║');
        console.log('☁️║ 💰 Financial:  Trading + Fraud         ║');
        console.log('☁️║ ⚙️ Infra:      MESH + Pipeline         ║');
        console.log('☁️║ Status: AZURE-POWERED | OPERATIONAL    ║');
        console.log('☁️╚══════════════════════════════════════════╝');

        // ============================================
        // 💬 CHAT FUNCTIONS
        // ============================================
        function selectProvider(id, el) {
            selectedProvider = id;
            document.querySelectorAll('[data-provider]').forEach(c => c.classList.remove('active'));
            el.classList.add('active');
        }

        function selectInfra(id, el) {
            selectedInfra = id;
            document.querySelectorAll('.infra-item').forEach(i => i.classList.remove('active'));
            el.classList.add('active');
        }

        function selectSubModule(id, el) {
            selectedSubModule = id;
            document.querySelectorAll('[data-submodule]').forEach(c => c.classList.remove('active'));
            el.classList.add('active');
        }

        function addMessage(text, isUser = false, tags = null) {
            const area = document.getElementById('chatArea');
            const div = document.createElement('div');
            div.className = `message ${isUser ? 'user-msg' : 'bot-msg'}`;
            const bubble = document.createElement('div');
            bubble.className = `bubble ${isUser ? 'user-bubble' : 'bot-bubble'}`;
            
            if (!isUser && tags) {
                bubble.innerHTML = `
                    <div class="tag-line">
                        <span class="tag tag-azure">☁️ ${tags.azureName}</span>
                        <span class="tag tag-provider">${tags.providerIcon} ${tags.providerName}</span>
                        <span class="tag tag-module">${tags.infraIcon} ${tags.infraName}</span>
                    </div>
                    ${text.replace(/\n/g, '<br>')}
                `;
            } else {
                bubble.innerHTML = text.replace(/\n/g, '<br>');
            }
            
            div.appendChild(bubble);
            area.appendChild(div);
            area.scrollTop = area.scrollHeight;
        }

        function addTyping() {
            const area = document.getElementById('chatArea');
            const div = document.createElement('div');
            div.className = 'message bot-msg';
            div.id = 'typingIndicator';
            div.innerHTML = '<div class="typing-indicator"><div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div></div>';
            area.appendChild(div);
            area.scrollTop = area.scrollHeight;
        }

        function removeTyping() {
            const el = document.getElementById('typingIndicator');
            if (el) el.remove();
        }

        async function sendMessage() {
            const input = document.getElementById('messageInput');
            const msg = input.value.trim();
            if (!msg) return;

            addMessage(msg, true);
            input.value = '';
            addTyping();

            setTimeout(() => {
                removeTyping();

                // Route to module
                const routed = router.route(msg);
                if (selectedSubModule === 'auto') {
                    selectedInfra = routed;
                    document.querySelectorAll('.infra-item').forEach(i => i.classList.remove('active'));
                    const idx = { cognitive: 1, robotics: 2, financial: 3, infrastructure: 4 };
                    const items = document.querySelectorAll('.infra-item');
                    if (items[idx[routed]]) items[idx[routed]].classList.add('active');
                }

                // Process through Azure + Module
                const azureResult = azure.process(msg);
                const moduleResult = selectedInfra === 'azure' ? 
                    { module: 'Azure', response: azureResult.response } : 
                    (modules[selectedInfra] ? modules[selectedInfra].process() : azure.process(msg));
                
                const subResponse = subEngine.getResponse(selectedSubModule, msg, AI_PROVIDERS[selectedProvider]);

                const provider = AI_PROVIDERS[selectedProvider];
                const infraInfo = INFRA_NAMES[selectedInfra] || INFRA_NAMES.azure;
                const refId = 'SUP-AZ-' + Date.now().toString(36).toUpperCase();

                const fullResponse = `
☁️ <b>Azure Infrastructure Active</b>
🏢 ${azure.regions} Regions | Hardware TPM | Confidential Computing

<b>${moduleResult.module} Engine:</b>
${moduleResult.response}

${selectedSubModule !== 'auto' ? `\n📌 <b>Sub-Module:</b> ${subResponse}` : ''}

✅ <b>Processing Complete</b>
📋 Ref: ${refId}
⏱ Time: 0ms (Azure + Supreme Mesh)
🔒 Security: ${azure.compliance}
                `;

                addMessage(fullResponse, false, {
                    azureName: 'AZURE',
                    providerIcon: provider.icon,
                    providerName: provider.name,
                    infraIcon: infraInfo.icon,
                    infraName: infraInfo.name
                });

                console.log(`☁️ [AZURE ROUTE]: "${msg.substring(0,40)}..." → ${routed} | Provider: ${provider.name}`);
            }, 1000);
        }

        // Heartbeat
        setInterval(() => {
            console.log('☁️ [AZURE HEARTBEAT]: 60 Regions Online | Compute:✓ | AI:✓ | Security:✓ | Network:✓ | Data:✓ | IoT:✓');
        }, 60000);
    </script>
</body>
</html>
