<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechSolve Enterprise | Supreme Technology + Azure</title>
    <style>
        :root {
            --company-primary: #1a1a2e;
            --company-secondary: #16213e;
            --company-accent: #0f3460;
            --company-gold: #e94560;
            --text-light: #eee;
            --chat-bg: #0d1117;
            --user-bubble: #238636;
            --bot-bubble: #21262d;
            --azure: #0078d4;
            --openai: #10a37f;
            --anthropic: #d97757;
            --google: #4285f4;
            --meta: #0668e1;
            --deepseek: #4d6bfe;
            --xai: #ffffff;
            --mistral: #facc15;
            --module-cognitive: #10a37f;
            --module-robotics: #ff9800;
            --module-financial: #f0c040;
            --module-infrastructure: #4285f4;
        }
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Segoe UI', sans-serif;
            background: var(--company-primary);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .main-container {
            width: 100%;
            max-width: 1200px;
            height: 97vh;
            background: var(--company-secondary);
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 25px 60px rgba(0,0,0,0.5);
            overflow: hidden;
        }
        
        /* Header */
        .company-header {
            background: linear-gradient(135deg, var(--company-accent), var(--company-gold));
            padding: 14px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 2px solid rgba(255,255,255,0.1);
        }
        .company-logo {
            width: 38px; height: 38px;
            background: white; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px; font-weight: bold; color: var(--company-accent);
        }
        .company-info h2 { color: white; font-size: 1em; font-weight: 600; letter-spacing: 0.5px; }
        .company-info p { color: rgba(255,255,255,0.8); font-size: 0.65em; margin-top: 1px; }

        /* Infrastructure Bar */
        .infra-bar {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 1px;
            background: rgba(0,0,0,0.6);
            padding: 1px;
        }
        .infra-item {
            padding: 8px 6px;
            text-align: center;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }
        .infra-item.azure { 
            color: #ffffff; 
            background: linear-gradient(135deg, #0078d4, #005a9e);
            border-bottom: 2px solid #00bcf2;
        }
        .infra-item.cognitive { color: var(--module-cognitive); background: rgba(16,163,127,0.1); }
        .infra-item.robotics { color: var(--module-robotics); background: rgba(255,152,0,0.1); }
        .infra-item.financial { color: var(--module-financial); background: rgba(240,192,64,0.1); }
        .infra-item.infrastructure { color: var(--module-infrastructure); background: rgba(66,133,244,0.1); }
        .infra-item.active { border-bottom-width: 3px; filter: brightness(1.3); }
        .infra-dot { width: 5px; height: 5px; border-radius: 50%; background: #00c853; animation: pulse 2s infinite; }
        @keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

        /* Provider + Sub-Module Selector */
        .selector-bar {
            display: flex; gap: 4px; padding: 6px 14px;
            background: rgba(0,0,0,0.3);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            flex-wrap: wrap; align-items: center;
        }
        .selector-label {
            font-size: 7px; color: rgba(255,255,255,0.4);
            letter-spacing: 2px; margin-right: 2px;
        }
        .selector-chip {
            padding: 3px 9px; border-radius: 12px;
            font-size: 8px; font-weight: 600; cursor: pointer;
            transition: all 0.3s;
            border: 1px solid rgba(255,255,255,0.1);
            background: transparent; color: rgba(255,255,255,0.5);
            white-space: nowrap;
        }
        .selector-chip:hover { border-color: rgba(255,255,255,0.3); color: rgba(255,255,255,0.8); }
        .selector-chip.active {
            background: var(--company-gold); color: white; border-color: var(--company-gold);
        }
        .selector-chip.azure-active {
            background: var(--azure); color: white; border-color: #00bcf2;
        }
        .selector-divider {
            width: 1px; height: 16px;
            background: rgba(255,255,255,0.1); margin: 0 3px;
        }

        /* Chat Area */
        .chat-area {
            flex: 1; overflow-y: auto;
            padding: 16px; background: var(--chat-bg);
            display: flex; flex-direction: column; gap: 10px;
        }
        .message { display: flex; animation: slideIn 0.3s ease; }
        @keyframes slideIn { from{opacity:0;transform:translateY(10px);} to{opacity:1;transform:translateY(0);} }
        .user-msg { justify-content: flex-end; }
        .bot-msg { justify-content: flex-start; }
        .bubble {
            max-width: 78%; padding: 10px 14px;
            border-radius: 14px; line-height: 1.5; font-size: 0.85em;
        }
        .user-bubble { background: var(--user-bubble); color: white; border-bottom-right-radius: 3px; margin-left: 30px; }
        .bot-bubble { background: var(--bot-bubble); color: var(--text-light); border-bottom-left-radius: 3px; margin-right: 30px; border: 1px solid rgba(255,255,255,0.08); }
        .tag-line { font-size: 7px; letter-spacing: 1px; margin-bottom: 5px; display: flex; gap: 4px; flex-wrap: wrap; }
        .tag { padding: 2px 6px; border-radius: 6px; font-weight: 600; }
        .tag-provider { background: rgba(233,69,96,0.2); color: #e94560; }
        .tag-module { background: rgba(16,163,127,0.2); color: #10a37f; }
        .tag-azure { background: rgba(0,120,212,0.3); color: #00bcf2; }

        .typing-indicator { display: flex; gap: 4px; padding: 10px 14px; background: var(--bot-bubble); border-radius: 14px; border-bottom-left-radius: 3px; width: fit-content; }
        .typing-dot { width: 6px; height: 6px; background: var(--company-gold); border-radius: 50%; animation: typing 1.4s infinite; }
        .typing-dot:nth-child(2) { animation-delay: 0.2s; }
        .typing-dot:nth-child(3) { animation-delay: 0.4s; }
        @keyframes typing { 0%,60%,100%{opacity:0.3;transform:scale(0.8);} 30%{opacity:1;transform:scale(1);} }

        /* Input */
        .input-area {
            padding: 14px 18px; background: var(--company-secondary);
            border-top: 1px solid rgba(255,255,255,0.08);
            display: flex; gap: 8px;
        }
        .message-input {
            flex: 1; padding: 11px 16px;
            background: var(--chat-bg);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 22px; color: white;
            font-size: 0.85em; outline: none;
            transition: all 0.3s;
        }
        .message-input:focus { border-color: var(--company-gold); box-shadow: 0 0 0 3px rgba(233,69,96,0.1); }
        .send-btn {
            width: 40px; height: 40px;
            background: var(--company-gold); border: none;
            border-radius: 50%; cursor: pointer;
            font-size: 16px; display: flex;
            align-items: center; justify-content: center;
            transition: all 0.3s; color: white;
        }
        .send-btn:hover { background: #ff6b81; transform: scale(1.05); box-shadow: 0 5px 20px rgba(233,69,96,0.4); }

        /* Azure Status Panel */
        .azure-panel {
            position: fixed; top: 10px; right: 10px;
            background: linear-gradient(135deg, #001a33, #003366);
            border: 1px solid #0078d4; border-radius: 10px;
            padding: 8px 12px; font-size: 8px; letter-spacing: 1px;
            display: flex; align-items: center; gap: 8px;
            z-index: 1000; box-shadow: 0 4px 20px rgba(0,120,212,0.3);
        }
        .azure-panel .az-logo { font-size: 14px; }
        .azure-panel .az-text { color: #00bcf2; }
        .azure-panel .az-status { color: #00c853; }

        .chat-area::-webkit-scrollbar { width: 3px; }
        .chat-area::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.06); border-radius: 10px; }

        @media (max-width: 768px) {
            .infra-bar { grid-template-columns: repeat(3, 1fr); }
            .selector-bar { gap: 2px; padding: 4px 8px; }
            .selector-chip { font-size: 7px; padding: 2px 6px; }
            .bubble { max-width: 92%; }
        }
    </style>
</head>
<body>

    <!-- Azure Status Panel -->
    <div class="azure-panel">
        <span class="az-logo">☁️</span>
        <span class="az-text"><b>AZURE</b></span>
        <span style="color:rgba(255,255,255,0.5);">|</span>
