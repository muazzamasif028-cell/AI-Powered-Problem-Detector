<script>
    // ============================================
    // 🧠 LLM PROVIDERS DATABASE
    // ============================================
    const providers = [{
        id: 'openai',
        name: 'OpenAI',
        icon: '🧠',
        color: '#10a37f',
        status: 'available',
        endpoint: 'https://api.openai.com/v1/chat/completions',
        models: [
            { name: 'gpt-4o', tier: 'flagship' },
            { name: 'o3-mini', tier: 'reasoning' }
        ],
        strength: 'Agentic orchestration, multi-step reasoning'
    }, {
        id: 'google',
        name: 'Google DeepMind',
        icon: '🔮',
        color: '#4285f4',
        status: 'available',
        endpoint: 'https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent',
        models: [
            { name: 'gemini-1.5-pro', tier: 'flagship' },
            { name: 'gemini-1.5-flash', tier: 'budget' }
        ],
        strength: 'Multi-million token context, video-to-code'
    }, {
        id: 'deepseek',
        name: 'DeepSeek',
        icon: '🐋',
        color: '#4d6bfe',
        status: 'available',
        endpoint: 'https://api.deepseek.com/v1/chat/completions',
        models: [
            { name: 'deepseek-chat', tier: 'flagship' },
            { name: 'deepseek-reasoner', tier: 'reasoning' }
        ],
        strength: 'Test-time reasoning, cost-efficient architecture'
    }, {
        id: 'anthropic',
        name: 'Anthropic',
        icon: '🏛️',
        color: '#d97757',
        status: 'available',
        endpoint: 'https://api.anthropic.com/v1/messages',
        models: [
            { name: 'claude-3-5-sonnet-latest', tier: 'flagship' }
        ],
        strength: 'Enterprise compliance, long-horizon coding'
    }];

    // ============================================
    // STATE SYSTEM
    // ============================================
    let selectedProvider = 'supreme'; // Default to Supreme multi-mode
    let connectedProviders = JSON.parse(localStorage.getItem('supreme_llm_connected') || '{}');

    // ============================================
    // RENDER PROVIDERS UI
    // ============================================
    function renderProviders() {
        const grid = document.getElementById('providerGrid');
        if (!grid) return;
        grid.innerHTML = '';

        providers.forEach(p => {
            const isConnected = connectedProviders[p.id] === true;
            const card = document.createElement('div');
            card.className = 'provider-card';
            card.innerHTML = `
                <div class="provider-header">
                    <div class="provider-name">
                        <span class="provider-icon">${p.icon}</span>
                        ${p.name}
                    </div>
                    <span class="provider-status ${isConnected ? 'status-connected' : 'status-available'}">
                        ${isConnected ? '✅ CONNECTED' : '⚡ AVAILABLE'}
                    </span>
                </div>
                <div class="provider-models">
                    ${p.models.map(m => `<span class="model-chip ${m.tier}">${m.name}</span>`).join('')}
                </div>
                <div style="font-size:11px;color:var(--text-dim);margin:6px 0;">
                    💪 ${p.strength}
                </div>
                <div class="provider-footer">
                    <button class="btn btn-connect" onclick="toggleConnection('${p.id}')">
                        ${isConnected ? '🔄 Disconnect' : '🔗 Connect'}
                    </button>
                    <button class="btn btn-configure" onclick="configureProvider('${p.id}')">
                        ⚙️ Configure Key
                    </button>
                </div>
            `;
            grid.appendChild(card);
        });

        renderChatProviders();
        renderDashboard();
    }

    function toggleConnection(id) {
        if (connectedProviders[id]) {
            delete connectedProviders[id];
            showToast(`❌ ${id} disconnected`);
        } else {
            const keys = JSON.parse(localStorage.getItem('supreme_llm_keys') || '{}');
            if (!keys[id]) {
                configureProvider(id);
                return;
            }
            connectedProviders[id] = true;
            showToast(`✅ ${id} activated`);
        }
        localStorage.setItem('supreme_llm_connected', JSON.stringify(connectedProviders));
        renderProviders();
    }

    function configureProvider(id) {
        const p = providers.find(pr => pr.id === id);
        const key = prompt(`Enter your official ${p.name} API Key:`);
        if (key) {
            const keys = JSON.parse(localStorage.getItem('supreme_llm_keys') || '{}');
            keys[id] = key;
            localStorage.setItem('supreme_llm_keys', JSON.stringify(keys));
            connectedProviders[id] = true;
            localStorage.setItem('supreme_llm_connected', JSON.stringify(connectedProviders));
            renderProviders();
            showToast(`🔑 Key saved for ${p.name}`);
        }
    }

    function renderChatProviders() {
        const container = document.getElementById('chatProviderSelect');
        if (!container) return;
        container.innerHTML = '';

        // SUPREME Sovereign Parallel Engine
        const supremeChip = document.createElement('span');
        supremeChip.className = 'chat-chip ' + (selectedProvider === 'supreme' ? 'active' : '');
        supremeChip.textContent = '⚡ SUPREME (ALL ON)';
        supremeChip.onclick = () => selectProvider('supreme');
        container.appendChild(supremeChip);

        // Individual Connected APIs
        Object.keys(connectedProviders).forEach(id => {
            const p = providers.find(pr => pr.id === id);
            if (!p) return;
            const chip = document.createElement('span');
            chip.className = 'chat-chip ' + (selectedProvider === id ? 'active' : '');
            chip.textContent = p.icon + ' ' + p.name;
            chip.onclick = () => selectProvider(id);
            container.appendChild(chip);
        });
    }

    function selectProvider(id) {
        selectedProvider = id;
        renderChatProviders();
        showToast(`Switched channel to: ${id.toUpperCase()}`);
    }

    // ============================================
    // 🚀 CORE REAL-TIME API FETCH ROUTER
    // ============================================
    async function hitRealAPI(providerId, promptText, targetBubbleId) {
        const keys = JSON.parse(localStorage.getItem('supreme_llm_keys') || '{}');
        const key = keys[providerId];
        const bubble = document.getElementById(targetBubbleId);
        const pData = providers.find(p => p.id === providerId);

        if (!key) {
            bubble.innerHTML = `<span style="color:var(--accent);">⚠️ Configuration key missing for ${providerId.toUpperCase()}. Please configure it in the Providers tab.</span>`;
            return;
        }

        try {
            let responseText = '';

            // 1. OPENAI OR DEEPSEEK ROUTING (Standard OpenAI Spec)
            if (providerId === 'openai' || providerId === 'deepseek') {
                const activeModel = pData.models[0].name;
                const response = await fetch(pData.endpoint, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${key}`
                    },
                    body: JSON.stringify({
                        model: activeModel,
                        messages: [{ role: 'user', content: promptText }]
                    })
                });
                const data = await response.json();
                if (data.error) throw new Error(data.error.message);
                responseText = data.choices[0].message.content;
            } 
            
            // 2. GOOGLE GEMINI ROUTING
            else if (providerId === 'google') {
                const activeModel = pData.models[0].name;
                const response = await fetch(`${pData.endpoint}?key=${key}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: promptText }] }]
                    })
                });
                const data = await response.json();
                if (data.error) throw new Error(data.error.message);
                responseText = data.candidates[0].content.parts[0].text;
            }

            // 3. ANTHROPIC CLAUDE ROUTING
            else if (providerId === 'anthropic') {
                const response = await fetch(pData.endpoint, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'x-api-key': key,
                        'anthropic-version': '2023-06-01',
                        'dangerously-allow-browser': 'true' // Client side testing flag
                    },
                    body: JSON.stringify({
                        model: pData.models[0].name,
                        max_tokens: 1024,
                        messages: [{ role: 'user', content: promptText }]
                    })
                });
                const data = await response.json();
                if (data.error) throw new Error(data.error.message);
                responseText = data.content[0].text;
            }

            // Clean & Render response safely
            bubble.innerHTML = `
                <div class="provider-tag">${pData.icon} ${pData.name.toUpperCase()}</div>
                ${responseText.replace(/\n/g, '<br>')}
                <div style="margin-top:6px;font-size:10px;color:var(--text-dim);">⚡ Live API Sync Active</div>
            `;

        } catch (err) {
            bubble.innerHTML = `<span style="color:var(--accent);">❌ Error: ${err.message}</span>`;
        }
        
        const container = document.getElementById('chatMessages');
        container.scrollTop = container.scrollHeight;
    }

    // ============================================
    // SEND CHAT MESSAGE CONTROLLER
    // ============================================
    function sendChatMessage() {
        const input = document.getElementById('chatInput');
        const msg = input.value.trim();
        if (!msg) return;

        const container = document.getElementById('chatMessages');

        // Append User Message Bubble
        const userDiv = document.createElement('div');
        userDiv.className = 'msg user-msg';
        userDiv.innerHTML = `<div class="bubble user-bubble">${msg}</div>`;
        container.appendChild(userDiv);
        input.value = '';

        // Resolve active target paths
        let targets = [];
        if (selectedProvider === 'supreme') {
            targets = Object.keys(connectedProviders);
            if (targets.length === 0) {
                // Fallback notice if nothing is connected
                const botDiv = document.createElement('div');
                botDiv.className = 'msg bot-msg';
                botDiv.innerHTML = `<div class="bubble bot-bubble">⚠️ Supreme Engine requires at least one connected provider. Please click "Connect" on any model first!</div>`;
                container.appendChild(botDiv);
                return;
            }
        } else {
            targets = [selectedProvider];
        }

        // Fire parallel asynchronous requests for all target networks
        targets.forEach(id => {
            const p = providers.find(pr => pr.id === id);
            const targetBubbleId = `bubble_${id}_${Date.now()}`;

            const botDiv = document.createElement('div');
            botDiv.className = 'msg bot-msg';
            botDiv.innerHTML = `
                <div class="bubble bot-bubble" id="${targetBubbleId}">
                    <div class="provider-tag" style="color:${p?.color || '#fff'}">${p?.icon || '⚙️'} ${p?.name.toUpperCase()}</div>
                    <span style="color:var(--text-dim);">🔄 Quantum routing stream resolving response...</span>
                </div>
            `;
            container.appendChild(botDiv);
            
            // Execute non-blocking network fetch
            hitRealAPI(id, msg, targetBubbleId);
        });

        container.scrollTop = container.scrollHeight;
    }

    // ============================================
    // DASHBOARD & TOAST SYSTEM
    // ============================================
    function renderDashboard() {
        const container = document.getElementById('dashboardContent');
        if (!container) return;
        container.innerHTML = '';

        const connected = Object.keys(connectedProviders);
        const total = providers.length;

        const stats = [
            { label: 'Active Channels', value: `${connected.length}/${total}`, desc: 'Network link integrity' },
            { label: 'Total Models Mounted', value: providers.reduce((sum, p) => sum + p.models.length, 0), desc: 'Sovereign LLM cluster code' },
            { label: 'System Mode', value: selectedProvider === 'supreme' ? '⚡ SUPREME' : '🎯 ISOLATED', desc: 'Active processing logic' },
            { label: 'Network Latency', value: 'Dynamic', desc: 'Direct client-to-frontier edge' }
        ];

        stats.forEach(s => {
            const card = document.createElement('div');
            card.style.cssText = 'background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:16px;text-align:center;';
            card.innerHTML = `
                <div style="font-size:20px;font-weight:700;color:var(--gold);">${s.value}</div>
                <div style="font-size:11px;color:var(--text-dim); margin: 4px 0;">${s.label}</div>
                <div style="font-size:9px;color:var(--text-dim); opacity:0.6;">${s.desc}</div>
            `;
            container.appendChild(card);
        });
    }

    function showToast(msg) {
        const t = document.createElement('div');
        t.style.cssText = `
            position:fixed; top:20px; right:20px;
            background:var(--bg-card); border:1px solid var(--gold);
            border-radius:10px; padding:12px 18px; z-index:999;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5); font-size:12px; color:var(--text);
        `;
        t.textContent = msg;
        document.body.appendChild(t);
        setTimeout(() => t.remove(), 2500);
    }

    function switchSection(section) {
        document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
        document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
        document.getElementById(section + 'Section').classList.add('active');
        const activeNav = document.querySelector(`[data-section="${section}"]`);
        if (activeNav) activeNav.classList.add('active');
    }

    document.querySelectorAll('.nav-link').forEach(link => {
        link.addEventListener('click', function() {
            switchSection(this.dataset.section);
        });
    });

    // Run on initialize
    renderProviders();
</script>
