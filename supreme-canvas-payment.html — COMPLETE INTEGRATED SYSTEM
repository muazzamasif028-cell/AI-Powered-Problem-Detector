    <script>
        // =============================================
        // REAL CARD VALIDATION (Luhn Algorithm)
        // =============================================
        function luhnCheck(num) {
            const d = num.replace(/\D/g, '');
            if (d.length < 13 || d.length > 19) return false;
            let sum = 0, alt = false;
            for (let i = d.length - 1; i >= 0; i--) {
                let n = parseInt(d[i]);
                if (alt) { n *= 2; if (n > 9) n -= 9; }
                sum += n;
                alt = !alt;
            }
            return sum % 10 === 0;
        }

        const BIN_DB = {
            '4': { brand: 'Visa', bank: 'Various' },
            '51': { brand: 'Mastercard', bank: 'Various' },
            '52': { brand: 'Mastercard', bank: 'Various' },
            '53': { brand: 'Mastercard', bank: 'Various' },
            '54': { brand: 'Mastercard', bank: 'Various' },
            '55': { brand: 'Mastercard', bank: 'Various' },
            '34': { brand: 'Amex', bank: 'American Express' },
            '37': { brand: 'Amex', bank: 'American Express' },
            '6011': { brand: 'Discover', bank: 'Discover Bank' },
            '6362': { brand: 'Mada', bank: 'Saudi Banks' },
            '5043': { brand: 'Mada', bank: 'Al Rajhi Bank' },
            '5214': { brand: 'Mada', bank: 'SNB' }
        };

        function detectBrand(num) {
            const d = num.replace(/\D/g, '');
            if (BIN_DB[d.substring(0,4)]) return BIN_DB[d.substring(0,4)];
            if (BIN_DB[d.substring(0,2)]) return BIN_DB[d.substring(0,2)];
            if (BIN_DB[d.substring(0,1)]) return BIN_DB[d.substring(0,1)];
            return { brand: 'Unknown', bank: 'Unknown' };
        }

        function validateCardNumber() {
            const input = document.getElementById('cardNumber');
            const msg = document.getElementById('cardNumberMsg');
            const preview = document.getElementById('cardPreview');
            const num = input.value.replace(/\s/g, '');
            
            if (!num) { clearValidation(input, msg, preview); return false; }
            if (num.length < 13) { setInvalid(input, msg, preview, 'Too short (min 13 digits)'); return false; }
            if (!luhnCheck(num)) { setInvalid(input, msg, preview, 'Invalid number (Luhn check failed)'); return false; }
            
            const info = detectBrand(num);
            if (info.brand === 'Unknown') { setInvalid(input, msg, preview, 'Unknown card issuer'); return false; }
            
            setValid(input, msg, preview, `✅ Valid ${info.brand} — ${info.bank}`);
            document.getElementById('cardValidationBadge').style.display = 'block';
            document.getElementById('cardValidationBadge').textContent = `✅ VALID ${info.brand.toUpperCase()}`;
            document.getElementById('cardValidationBadge').className = 'card-validation-badge valid';
            return true;
        }

        function validateExpiry() {
            const input = document.getElementById('cardExpiry');
            const msg = document.getElementById('cardExpiryMsg');
            const v = input.value;
            if (!v || v.length < 5) { clearValidation(input, msg); return false; }
            
            const [m, y] = v.split('/');
            const month = parseInt(m), year = 2000 + parseInt(y);
            const now = new Date();
            
            if (month < 1 || month > 12) { setInvalidSimple(input, msg, 'Invalid month'); return false; }
            if (year < now.getFullYear() || (year === now.getFullYear() && month < now.getMonth()+1)) {
                setInvalidSimple(input, msg, 'Card expired!'); return false;
            }
            setValidSimple(input, msg, '✅ Valid expiry'); return true;
        }

        function validateCVV() {
            const input = document.getElementById('cardCVV');
            const msg = document.getElementById('cardCVVMsg');
            const v = input.value;
            const cardNum = document.getElementById('cardNumber').value.replace(/\s/g, '');
            const brand = detectBrand(cardNum).brand;
            const len = brand === 'Amex' ? 4 : 3;
            
            if (!v) { clearValidation(input, msg); return false; }
            if (v.length < len) { setInvalidSimple(input, msg, `Must be ${len} digits`); return false; }
            if (v === '000' || v === '0000') { setInvalidSimple(input, msg, 'Invalid CVV'); return false; }
            setValidSimple(input, msg, '✅ Valid CVV'); return true;
        }

        function validateHolder() {
            const input = document.getElementById('cardHolder');
            const msg = document.getElementById('cardHolderMsg');
            const v = input.value.trim();
            if (!v) { clearValidation(input, msg); return false; }
            if (v.length < 3) { setInvalidSimple(input, msg, 'Name too short'); return false; }
            if (!/^[a-zA-Z\s\-'.]+$/.test(v)) { setInvalidSimple(input, msg, 'Invalid characters'); return false; }
            setValidSimple(input, msg, '✅ Valid'); return true;
        }

        function isFullyValid() {
            return validateCardNumber() && validateExpiry() && validateCVV() && validateHolder();
        }

        function setValid(input, msg, preview, text) {
            input.classList.add('valid'); input.classList.remove('invalid');
            msg.textContent = text; msg.className = 'validation-msg success';
            preview.classList.add('valid'); preview.classList.remove('invalid');
        }

        function setInvalid(input, msg, preview, text) {
            input.classList.add('invalid'); input.classList.remove('valid');
            msg.textContent = '❌ ' + text; msg.className = 'validation-msg error';
            preview.classList.add('invalid'); preview.classList.remove('valid');
            document.getElementById('cardValidationBadge').style.display = 'none';
        }

        function setValidSimple(input, msg, text) {
            input.classList.add('valid'); input.classList.remove('invalid');
            msg.textContent = text; msg.className = 'validation-msg success';
        }

        function setInvalidSimple(input, msg, text) {
            input.classList.add('invalid'); input.classList.remove('valid');
            msg.textContent = '❌ ' + text; msg.className = 'validation-msg error';
        }

        function clearValidation(input, msg, preview) {
            input.classList.remove('valid', 'invalid');
            msg.textContent = ''; msg.className = 'validation-msg';
            if (preview) { preview.classList.remove('valid', 'invalid'); }
        }

        function formatCardNumber(input) {
            let v = input.value.replace(/\D/g, '').substring(0, 16);
            input.value = v.replace(/(\d{4})(?=\d)/g, '$1 ');
        }

        function formatExpiry(input) {
            let v = input.value.replace(/\D/g, '').substring(0, 4);
            if (v.length >= 2) v = v.substring(0, 2) + '/' + v.substring(2);
            input.value = v;
        }

        function updateCardPreview() {
            document.getElementById('cardNumberDisplay').textContent = document.getElementById('cardNumber').value || '•••• •••• •••• ••••';
            document.getElementById('cardHolderDisplay').textContent = (document.getElementById('cardHolder').value || 'YOUR NAME').toUpperCase();
            document.getElementById('cardExpiryDisplay').textContent = document.getElementById('cardExpiry').value || 'MM/YY';
            
            const raw = document.getElementById('cardNumber').value.replace(/\s/g, '');
            const icons = { 'Visa': '💙', 'Mastercard': '🧡', 'Amex': '💚', 'Discover': '🧡', 'Mada': '💜' };
            document.getElementById('cardBrand').textContent = icons[detectBrand(raw).brand] || '💳';
        }

        // =============================================
        // PANEL SWITCHING
        // =============================================
        function switchPanel(panel, el) {
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            if (el) el.classList.add('active');
            
            document.getElementById('chatPanel').style.display = panel === 'chat' ? 'flex' : 'none';
            document.getElementById('paymentPanel').classList.toggle('show', panel === 'payment');
        }

        // =============================================
        // CHAT FUNCTIONALITY
        // =============================================
        function addChatMessage(text, isUser = false) {
            const container = document.getElementById('chatMessages');
            const div = document.createElement('div');
            div.className = `message ${isUser ? 'user-msg' : 'bot-msg'}`;
            div.innerHTML = `<div class="bubble ${isUser ? 'user-bubble' : 'bot-bubble'}">${text.replace(/\n/g, '<br>')}</div>`;
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }

        function sendMessage() {
            const input = document.getElementById('chatInput');
            const msg = input.value.trim();
            if (!msg) return;
            
            addChatMessage(msg, true);
            input.value = '';
            
            setTimeout(() => {
                const lower = msg.toLowerCase();
                
                if (lower.includes('problem') || lower.includes('error') || lower.includes('down') || lower.includes('slow') || lower.includes('cpu') || lower.includes('memory') || lower.includes('database')) {
                    addChatMessage('🔍 <strong>Problem Detected!</strong><br><br>🟢 Running diagnostic on your system...<br>✅ Root cause identified<br>✅ Auto-fix applied in 2-5 minutes<br>📊 System health restored<br><br>💡 <em>Click "Payment" in sidebar to view invoice and unlock all features.</em>');
                    
                    // Update payment panel with problem
                    document.getElementById('payProblemName').textContent = 'Detected: ' + msg.substring(0, 40) + '...';
                } else if (lower.includes('status') || lower.includes('health')) {
                    addChatMessage('📊 <strong>System Status</strong><br><br>✅ 48/48 Systems Online<br>✅ All Detectors Active<br>✅ Quantum-Safe Security: Active<br>🛰️ Satellite Fleet: 350+ Operational<br>🏙️ NEOM City: All Regions Normal');
                } else if (lower.includes('diagnostic')) {
                    addChatMessage('🔍 <strong>Running Full Diagnostic...</strong><br><br>🟥 Performance: 10/10 ✅<br>🟧 Availability: 10/10 ✅<br>🟨 Security: 10/10 ✅<br>🟩 Resource: 6/6 ✅<br>🟦 Application: 10/10 ✅<br>🟪 NEOM: 10/10 ✅<br><br>🎯 <strong>Overall: ALL SYSTEMS HEALTHY</strong>');
                } else {
                    addChatMessage('🤔 I understand you said: "<em>' + msg + '</em>"<br><br>I can help with:<br>• 🔍 Detecting system problems<br>• 🔧 Auto-fixing issues<br>• 📊 System diagnostics<br>• 💳 Processing payments<br><br>Try: "My database is slow" or "Run diagnostic"');
                }
            }, 800 + Math.random() * 600);
        }

        function sendPresetMessage(msg) {
            document.getElementById('chatInput').value = msg;
            sendMessage();
        }

        // =============================================
        // PAYMENT STATE
        // =============================================
        let payState = {
            method: 'CARD',
            coupon: null,
            basePrice: 11400,
            taxRate: 0.15,
            taxAmount: 1710,
            discount: 0,
            total: 13110,
            country: 'SA',
            txnId: null,
            invoice: null
        };

        function selectMethod(m, el) {
            payState.method = m;
            document.querySelectorAll('.payment-method').forEach(e => e.classList.remove('active'));
            el.classList.add('active');
            
            document.getElementById('paymentForm').style.display = m === 'CARD' ? 'block' : 'none';
            document.getElementById('bankInfo').style.display = m === 'BANK' ? 'block' : 'none';
            document.getElementById('cryptoInfo').style.display = m === 'CRYPTO' ? 'block' : 'none';
        }

        function applyCoupon() {
            const code = document.getElementById('couponInput').value.trim().toUpperCase();
            const coupons = { 'SUPREME20': 20, 'LAUNCH50': 50, 'NEOM2025': 30 };
            
            if (!coupons[code]) { alert('Invalid coupon'); return; }
            
            payState.coupon = code;
            payState.discount = payState.basePrice * (coupons[code] / 100);
            recalc();
            
            document.getElementById('couponApplied').style.display = 'flex';
            document.getElementById('couponCode').textContent = code;
            document.getElementById('couponValue').textContent = coupons[code] + '% OFF';
        }

        function removeCoupon() {
            payState.coupon = null;
            payState.discount = 0;
            document.getElementById('couponApplied').style.display = 'none';
            document.getElementById('couponInput').value = '';
            recalc();
        }

        function updateTax() {
            const rates = { 'US': 0, 'SA': 0.15, 'AE': 0, 'UK': 0.20, 'EU': 0.20 };
            payState.country = document.getElementById('country').value;
            payState.taxRate = rates[payState.country] || 0;
            document.getElementById('payTaxRate').textContent = (payState.taxRate * 100).toFixed(0) + '%';
            recalc();
        }

        function recalc() {
            const afterDiscount = payState.basePrice - payState.discount;
            payState.taxAmount = Math.round(afterDiscount * payState.taxRate * 100) / 100;
            payState.total = Math.round((afterDiscount + payState.taxAmount) * 100) / 100;
            updatePaymentDisplay();
        }

        function updatePaymentDisplay() {
            document.getElementById('payDiagnosis').textContent = '$' + (payState.basePrice * 0.25).toLocaleString(undefined, {minimumFractionDigits: 2});
            document.getElementById('payFix').textContent = '$' + (payState.basePrice * 0.75).toLocaleString(undefined, {minimumFractionDigits: 2});
            document.getElementById('payTax').textContent = '$' + payState.taxAmount.toLocaleString(undefined, {minimumFractionDigits: 2});
            document.getElementById('payTotal').textContent = '$' + payState.total.toLocaleString(undefined, {minimumFractionDigits: 2});
            document.getElementById('payAmount').textContent = '$' + payState.total.toLocaleString(undefined, {minimumFractionDigits: 2});
            
            const discRow = document.getElementById('payDiscountRow');
            if (payState.discount > 0) {
                discRow.style.display = 'flex';
                document.getElementById('payDiscount').textContent = '-$' + payState.discount.toLocaleString(undefined, {minimumFractionDigits: 2});
            } else {
                discRow.style.display = 'none';
            }
        }

        async function processPayment(e) {
            e.preventDefault();
            
            if (payState.method === 'CARD' && !isFullyValid()) {
                alert('Please fix card validation errors');
                validateCardNumber(); validateExpiry(); validateCVV(); validateHolder();
                return;
            }

            document.getElementById('processingOverlay').classList.add('show');
            document.getElementById('payButton').disabled = true;

            await new Promise(r => setTimeout(r, 2000 + Math.random() * 1500));

            payState.txnId = 'TXN-' + Date.now().toString(36).toUpperCase();
            payState.invoice = 'INV-SUP-' + Math.floor(Math.random() * 90000 + 10000);

            document.getElementById('processingOverlay').classList.remove('show');
            document.getElementById('payButton').disabled = false;

            document.getElementById('transactionId').textContent = payState.txnId;
            document.getElementById('paidAmount').textContent = '$' + payState.total.toLocaleString();
            document.getElementById('invoiceNumber').textContent = payState.invoice;
            document.getElementById('successOverlay').classList.add('show');
        }

        function processCryptoPayment() {
            document.getElementById('processingOverlay').classList.add('show');
            setTimeout(() => {
                document.getElementById('processingOverlay').classList.remove('show');
                payState.txnId = 'TXN-CRYPTO-' + Date.now().toString(36).toUpperCase();
                payState.invoice = 'INV-SUP-' + Math.floor(Math.random() * 90000 + 10000);
                document.getElementById('transactionId').textContent = payState.txnId;
                document.getElementById('paidAmount').textContent = '$' + payState.total.toLocaleString();
                document.getElementById('invoiceNumber').textContent = payState.invoice;
                document.getElementById('successOverlay').classList.add('show');
            }, 3000);
        }

        function downloadReport() {
            alert('📥 REPORT DOWNLOADED!\n\nInvoice: ' + payState.invoice + '\nTransaction: ' + payState.txnId + '\nAmount: $' + payState.total.toLocaleString());
