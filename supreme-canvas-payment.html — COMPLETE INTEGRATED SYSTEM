<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supreme Platform — Canvas + Payment</title>
    <style>
        :root {
            --bg-deep: #08080f;
            --bg-panel: #0e0e1a;
            --bg-card: #12122a;
            --accent: #e94560;
            --quantum: #00ffff;
            --gold: #ffd700;
            --success: #3fb950;
            --warning: #f0883e;
            --danger: #da3633;
            --text: #e0e0e0;
            --text-dim: #8888aa;
            --border: rgba(255,255,255,0.06);
            --input-bg: #0d1117;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: var(--bg-deep);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* ============================================ */
        /* MAIN CANVAS CONTAINER                        */
        /* ============================================ */
        .main-container {
            width: 100%;
            max-width: 1300px;
            height: 95vh;
            background: var(--bg-panel);
            border-radius: 24px;
            display: flex;
            box-shadow: 0 30px 80px rgba(0,0,0,0.8), 0 0 0 1px var(--border);
            overflow: hidden;
            position: relative;
        }

        /* ============================================ */
        /* SIDEBAR (Dashboard)                          */
        /* ============================================ */
        .sidebar {
            width: 280px;
            background: var(--bg-card);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            padding: 16px 12px;
            gap: 6px;
            overflow-y: auto;
        }

        .sidebar-header {
            padding: 10px;
            text-align: center;
            border-bottom: 1px solid var(--border);
            margin-bottom: 6px;
        }

        .sidebar-header h3 {
            color: var(--quantum);
            font-size: 0.85em;
            letter-spacing: 1px;
        }

        .sidebar-header .version {
            color: var(--text-dim);
            font-size: 0.6em;
            margin-top: 2px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
            color: var(--text-dim);
            font-size: 0.82em;
            border: 1px solid transparent;
        }

        .nav-item:hover {
            background: rgba(255,255,255,0.03);
            color: var(--text);
        }

        .nav-item.active {
            background: rgba(233,69,96,0.1);
            border-color: rgba(233,69,96,0.3);
            color: var(--text);
        }

        .nav-item .nav-icon { font-size: 1.2em; width: 24px; text-align: center; }

        .nav-section {
            color: var(--text-dim);
            font-size: 0.6em;
            text-transform: uppercase;
            letter-spacing: 2px;
            padding: 12px 14px 4px;
            margin-top: 8px;
        }

        /* ============================================ */
        /* MAIN CONTENT AREA                            */
        /* ============================================ */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .top-bar {
            background: linear-gradient(135deg, #0f0f23 0%, #1a1a3e 50%, #e94560 150%);
            padding: 14px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--border);
            min-height: 60px;
        }

        .company-logo {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #e94560, #ff6b81);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: white;
            animation: logoGlow 3s ease-in-out infinite;
        }

        @keyframes logoGlow {
            0%, 100% { box-shadow: 0 0 20px rgba(233,69,96,0.3); }
            50% { box-shadow: 0 0 35px rgba(0,255,255,0.5); }
        }

        .company-info h2 { color: white; font-size: 1.1em; font-weight: 700; }
        .company-info p { color: rgba(255,255,255,0.6); font-size: 0.65em; }

        .top-bar-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.65em;
            font-weight: 600;
        }

        .badge.success {
            background: rgba(63,185,80,0.15);
            color: var(--success);
            border: 1px solid rgba(63,185,80,0.2);
        }

        .content-area {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            background: var(--bg-deep);
        }

        /* ============================================ */
        /* CANVAS CHAT AREA                             */
        /* ============================================ */
        .chat-container {
            display: flex;
            flex-direction: column;
            height: 100%;
            gap: 12px;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding-right: 8px;
        }

        .message {
            display: flex;
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .user-msg { justify-content: flex-end; }
        .bot-msg { justify-content: flex-start; }

        .bubble {
            max-width: 72%;
            padding: 12px 16px;
            border-radius: 16px;
            line-height: 1.5;
            font-size: 0.88em;
        }

        .user-bubble {
            background: linear-gradient(135deg, #238636, #2ea043);
            color: white;
            border-bottom-right-radius: 4px;
            margin-left: 30px;
        }

        .bot-bubble {
            background: #1a1a2e;
            color: var(--text);
            border-bottom-left-radius: 4px;
            margin-right: 30px;
            border: 1px solid var(--border);
        }

        .chat-input-area {
            display: flex;
            gap: 10px;
            padding: 12px 0 0;
            border-top: 1px solid var(--border);
        }

        .chat-input {
            flex: 1;
            padding: 12px 18px;
            background: var(--input-bg);
            border: 1px solid var(--border);
            border-radius: 24px;
            color: white;
            font-size: 0.9em;
            outline: none;
            font-family: inherit;
            transition: all 0.3s;
        }

        .chat-input:focus {
            border-color: rgba(0,255,255,0.4);
            box-shadow: 0 0 0 3px rgba(0,255,255,0.05);
        }

        .send-btn {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #e94560, #ff6b81);
            border: none;
            border-radius: 50%;
            cursor: pointer;
            font-size: 16px;
            color: white;
            transition: all 0.3s;
        }

        .send-btn:hover { transform: scale(1.06); }

        /* ============================================ */
        /* PAYMENT PANEL (Hidden by default)            */
        /* ============================================ */
        .payment-panel {
            display: none;
            flex-direction: column;
            height: 100%;
        }

        .payment-panel.show {
            display: flex;
        }

        .payment-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            flex: 1;
            overflow-y: auto;
            padding-right: 8px;
        }

        @media (max-width: 900px) {
            .payment-grid { grid-template-columns: 1fr; }
        }

        .payment-card {
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 20px;
        }

        .problem-summary {
            background: var(--bg-card);
            border: 1px solid rgba(233,69,96,0.2);
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 14px;
        }

        .problem-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 16px;
            font-size: 0.65em;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .problem-badge.critical {
            background: rgba(218,54,51,0.2);
            color: #da3633;
            border: 1px solid rgba(218,54,51,0.3);
        }

        .problem-name { font-size: 1em; font-weight: 600; margin-bottom: 4px; }
        .problem-detail { font-size: 0.75em; color: var(--text-dim); line-height: 1.4; }

        .fix-status {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 10px;
            padding: 8px 12px;
            background: rgba(63,185,80,0.1);
            border: 1px solid rgba(63,185,80,0.2);
            border-radius: 6px;
            font-size: 0.78em;
            color: var(--success);
        }

        .price-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255,255,255,0.03);
            font-size: 0.82em;
        }

        .price-row.total {
            margin-top: 6px;
            padding-top: 12px;
            border-top: 2px solid var(--border);
            font-size: 1em;
            font-weight: 700;
        }

        .price-row.total .price-value { color: var(--gold); font-size: 1.2em; }
        .price-label { color: var(--text-dim); }
        .price-value { font-weight: 600; color: var(--text); }
        .price-value.discount { color: var(--success); }

        /* ============================================ */
        /* CREDIT CARD PREVIEW                          */
        /* ============================================ */
        .credit-card-preview {
            background: linear-gradient(135deg, #1a1a3e 0%, #0f3460 50%, #e94560 150%);
            border-radius: 14px;
            padding: 18px 22px;
            margin-bottom: 16px;
            position: relative;
            overflow: hidden;
            min-height: 170px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.5);
            transition: all 0.3s;
        }

        .credit-card-preview.valid { border: 2px solid var(--success); }
        .credit-card-preview.invalid { border: 2px solid var(--danger); }

        .card-chip {
            width: 42px;
            height: 34px;
            background: linear-gradient(135deg, #ffd700, #c0a000);
            border-radius: 6px;
            margin-bottom: 16px;
            position: relative;
            z-index: 1;
        }

        .card-number-display {
            font-family: 'Courier New', monospace;
            font-size: 1.1em;
            letter-spacing: 3px;
            color: white;
            margin-bottom: 12px;
            position: relative;
            z-index: 1;
        }

        .card-info-row {
            display: flex;
            justify-content: space-between;
            position: relative;
            z-index: 1;
        }

        .card-info-label {
            font-size: 0.5em;
            color: rgba(255,255,255,0.5);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 2px;
        }

        .card-info-value {
            font-family: 'Courier New', monospace;
            font-size: 0.85em;
            color: white;
        }

        .card-brand {
            position: absolute;
            top: 18px;
            right: 22px;
            z-index: 1;
            font-size: 2em;
            opacity: 0.9;
        }

        .card-validation-badge {
            position: absolute;
            bottom: 12px;
            right: 22px;
            z-index: 1;
            font-size: 0.6em;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 10px;
        }

        .card-validation-badge.valid {
            background: rgba(63,185,80,0.2);
            color: var(--success);
        }

        .card-validation-badge.invalid {
            background: rgba(218,54,51,0.2);
            color: var(--danger);
        }

        /* ============================================ */
        /* FORM INPUTS                                   */
        /* ============================================ */
        .form-group { margin-bottom: 12px; }

        .form-label {
            display: block;
            font-size: 0.7em;
            font-weight: 600;
            color: var(--text-dim);
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-input {
            width: 100%;
            padding: 10px 14px;
            background: var(--input-bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text);
            font-size: 0.85em;
            font-family: inherit;
            transition: all 0.3s;
            outline: none;
        }

        .form-input:focus { border-color: var(--accent); }
        .form-input.valid { border-color: var(--success); }
        .form-input.invalid { border-color: var(--danger); animation: shake 0.4s ease; }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-6px); }
            75% { transform: translateX(6px); }
        }

        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

        .validation-msg {
            font-size: 0.65em;
            margin-top: 3px;
            min-height: 14px;
        }

        .validation-msg.error { color: var(--danger); }
        .validation-msg.success { color: var(--success); }

        /* ============================================ */
        /* PAYMENT METHODS                              */
        /* ============================================ */
        .payment-methods {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
            margin-bottom: 14px;
        }

        .payment-method {
            padding: 10px 6px;
            background: var(--bg-card);
            border: 2px solid var(--border);
            border-radius: 8px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.7em;
            color: var(--text-dim);
        }

        .payment-method:hover { border-color: rgba(233,69,96,0.3); }

        .payment-method.active {
            border-color: var(--accent);
            background: rgba(233,69,96,0.1);
            color: var(--text);
        }

        .payment-method .method-icon { font-size: 1.3em; display: block; margin-bottom: 2px; }

        /* ============================================ */
        /* BUTTONS                                      */
        /* ============================================ */
        .btn {
            width: 100%;
            padding: 12px 20px;
            border: none;
            border-radius: 10px;
            font-size: 0.9em;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            font-family: inherit;
        }

        .btn-primary {
            background: linear-gradient(135deg, #e94560, #ff6b81);
            color: white;
            box-shadow: 0 4px 15px rgba(233,69,96,0.3);
        }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(233,69,96,0.5);
        }

        .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

        .btn-secondary {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-dim);
        }

        /* ============================================ */
        /* SUCCESS OVERLAY                              */
        /* ============================================ */
        .success-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.85);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .success-overlay.show { display: flex; }

        .success-modal {
            background: var(--bg-panel);
            border: 1px solid var(--success);
            border-radius: 18px;
            padding: 30px;
            text-align: center;
            max-width: 480px;
            width: 90%;
            animation: slideUp 0.4s ease;
            max-height: 85vh;
            overflow-y: auto;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .success-icon { font-size: 3.5em; margin-bottom: 12px; }
        .success-title { font-size: 1.3em; font-weight: 700; color: var(--success); margin-bottom: 6px; }
        .success-message { color: var(--text-dim); font-size: 0.82em; margin-bottom: 16px; }

        .transaction-id {
            font-family: 'Courier New', monospace;
            background: var(--bg-card);
            padding: 8px 14px;
            border-radius: 6px;
            color: var(--quantum);
            font-size: 0.78em;
            margin-bottom: 12px;
        }

        .features-unlocked {
            text-align: left;
            margin: 12px 0;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 0;
            border-bottom: 1px solid rgba(255,255,255,0.03);
            font-size: 0.75em;
            color: var(--text);
        }

        .feature-item .check { color: var(--success); }

        /* ============================================ */
        /* PROCESSING OVERLAY                           */
        /* ============================================ */
        .processing-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7);
            z-index: 998;
            justify-content: center;
            align-items: center;
        }

        .processing-overlay.show { display: flex; }

        .spinner {
            width: 50px;
            height: 50px;
            border: 3px solid rgba(255,255,255,0.1);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        /* ============================================ */
        /* COUPON                                       */
        /* ============================================ */
        .coupon-row { display: flex; gap: 6px; margin-bottom: 12px; }

        .coupon-input {
            flex: 1;
            padding: 8px 12px;
            background: var(--input-bg);
            border: 1px dashed var(--gold);
            border-radius: 6px;
            color: var(--gold);
            font-family: 'Courier New', monospace;
            font-size: 0.8em;
            text-transform: uppercase;
            letter-spacing: 1px;
            outline: none;
        }

        .btn-coupon {
            background: transparent;
            border: 1px dashed var(--gold);
            color: var(--gold);
            padding: 8px 14px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.72em;
            font-family: inherit;
        }

        .coupon-applied {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 12px;
            background: rgba(63,185,80,0.1);
            border: 1px solid rgba(63,185,80,0.2);
            border-radius: 6px;
            color: var(--success);
            font-size: 0.78em;
            margin-bottom: 12px;
        }

        /* Scrollbar */
        .content-area::-webkit-scrollbar,
        .chat-messages::-webkit-scrollbar,
        .sidebar::-webkit-scrollbar { width: 3px; }
        .content-area::-webkit-scrollbar-thumb,
        .chat-messages::-webkit-scrollbar-thumb,
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.06); border-radius: 10px; }
    </style>
</head>
<body>

    <div class="main-container">
        
        <!-- ======================================== -->
        <!-- SIDEBAR                                   -->
        <!-- ======================================== -->
        <div class="sidebar">
            <div class="sidebar-header">
                <h3>⚡ SUPREME PLATFORM</h3>
                <div class="version">v9.0 • Quantum-Safe</div>
            </div>

            <div class="nav-section">MAIN</div>
            <div class="nav-item active" data-panel="chat" onclick="switchPanel('chat', this)">
                <span class="nav-icon">💬</span> Problem Chat
            </div>
            <div class="nav-item" data-panel="payment" onclick="switchPanel('payment', this)">
                <span class="nav-icon">💳</span> Payment
            </div>

            <div class="nav-section">MONITORING</div>
            <div class="nav-item" onclick="switchPanel('chat', this); sendPresetMessage('Show system status')">
                <span class="nav-icon">📊</span> System Status
            </div>
            <div class="nav-item" onclick="switchPanel('chat', this); sendPresetMessage('Run full diagnostic')">
                <span class="nav-icon">🔍</span> Run Diagnostic
            </div>

            <div class="nav-section">TOOLS</div>
            <div class="nav-item" onclick="switchPanel('chat', this); sendPresetMessage('Show detected problems')">
                <span class="nav-icon">🐛</span> View Problems
            </div>
            <div class="nav-item" onclick="switchPanel('chat', this); sendPresetMessage('Show before after report')">
                <span class="nav-icon">📈</span> Before vs After
            </div>

            <div style="margin-top:auto;padding:12px;background:rgba(0,255,255,0.03);border:1px solid rgba(0,255,255,0.1);border-radius:10px;text-align:center;">
                <div style="color:var(--quantum);font-size:0.7em;font-weight:700;">🔐 QUANTUM-SAFE</div>
                <div style="color:var(--text-dim);font-size:0.55em;">CRYSTALS-Kyber-1024</div>
            </div>
        </div>

        <!-- ======================================== -->
        <!-- MAIN CONTENT                              -->
        <!-- ======================================== -->
        <div class="main-content">
            
            <!-- Top Bar -->
            <div class="top-bar">
                <div class="company-logo">⚡</div>
                <div class="company-info">
                    <h2>Supreme Problem Detector</h2>
                    <p>v9.0 • 56 Problems • 7000+ Languages</p>
                </div>
                <div class="top-bar-right">
                    <span class="badge success" id="headerStatus">🟢 ALL SYSTEMS ONLINE</span>
                </div>
            </div>

            <!-- Content Area -->
            <div class="content-area">
                
                <!-- ======================================== -->
                <!-- CHAT PANEL                              -->
                <!-- ======================================== -->
                <div class="chat-container" id="chatPanel">
                    <div class="chat-messages" id="chatMessages">
                        <div class="message bot-msg">
                            <div class="bubble bot-bubble">
                                👋 <strong>Welcome to Supreme Platform!</strong><br><br>
                                I detect and fix 56 types of problems across your infrastructure.<br><br>
                                🔍 Describe your problem and I'll:<br>
                                • Auto-detect the issue<br>
                                • Find root cause<br>
                                • Apply fix automatically<br>
                                • Show before/after results<br>
                                • Generate payment invoice<br><br>
                                <em>Type your problem below or click "Run Diagnostic" in sidebar.</em>
                            </div>
                        </div>
                    </div>
                    <div class="chat-input-area">
                        <input type="text" class="chat-input" id="chatInput" 
                               placeholder="Describe your problem here..." 
                               onkeypress="if(event.key==='Enter') sendMessage()">
                        <button class="send-btn" onclick="sendMessage()">➤</button>
                    </div>
                </div>

                <!-- ======================================== -->
                <!-- PAYMENT PANEL (Hidden initially)         -->
                <!-- ======================================== -->
                <div class="payment-panel" id="paymentPanel">
                    <div class="payment-grid">
                        
                        <!-- Left: Problem + Price -->
                        <div class="payment-card">
                            <div style="font-weight:700;margin-bottom:14px;color:var(--text);">🔍 Problem Resolution</div>
                            
                            <div class="problem-summary">
                                <span class="problem-badge critical">🚨 CRITICAL</span>
                                <div class="problem-name" id="payProblemName">Database Connection Pool Full</div>
                                <div class="problem-detail" id="payProblemDetail">
                                    📍 Production Database Server<br>
                                    💥 500 users affected<br>
                                    ✅ Auto-Fix Applied in 3 min
                                </div>
                                <div class="fix-status">
                                    ✅ Fix Applied Successfully — System Healthy
                                </div>
                            </div>

