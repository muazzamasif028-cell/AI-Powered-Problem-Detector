            document.getElementById('payButton').disabled = false;
            document.getElementById('payButton').textContent = '🔒 PAY $' + state.totalAmount.toLocaleString() + ' NOW';

            // Show success
            document.getElementById('transactionId').textContent = txnId;
            document.getElementById('paidAmount').textContent = '$' + state.totalAmount.toLocaleString();
            document.getElementById('invoiceNumber').textContent = state.invoiceNumber;
            document.getElementById('successOverlay').classList.add('show');

            // Store transaction
            const transaction = {
                transactionId: txnId,
                invoiceNumber: state.invoiceNumber,
                amount: state.totalAmount,
                currency: 'USD',
                method: state.selectedMethod,
                tier: state.tier,
                coupon: state.couponApplied,
                discount: state.discountAmount,
                tax: state.taxAmount,
                country: state.country,
                timestamp: new Date().toISOString(),
                status: 'COMPLETED',
                cardLast4: state.selectedMethod === 'CARD' ? 
                    document.getElementById('cardNumber').value.replace(/\s/g, '').slice(-4) : null
            };

            const transactions = JSON.parse(localStorage.getItem('supreme_transactions') || '[]');
            transactions.push(transaction);
            localStorage.setItem('supreme_transactions', JSON.stringify(transactions));

            console.log('💳 REAL PAYMENT COMPLETED:', transaction);
            showToast('✅ Payment of $' + state.totalAmount.toLocaleString() + ' completed! Invoice: ' + state.invoiceNumber, 'success');
        }

