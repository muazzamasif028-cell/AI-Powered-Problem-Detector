                coupon.discount + '% OFF' : '$' + coupon.discount + ' OFF';

            recalculateTotal();
            showToast('✅ Coupon applied! ' + coupon.discount + (coupon.type === 'PERCENT' ? '%' : '$') + ' off', 'success');
