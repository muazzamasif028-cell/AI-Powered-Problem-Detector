        function updateTax() {
            const taxRates = {
                'US': 0, 'SA': 0.15, 'AE': 0, 'UK': 0.20,
                'EU': 0.20, 'IN': 0.18, 'SG': 0.09, 'JP': 0.10
            };
            state.country = document.getElementById('country').value;
            state.taxRate = taxRates[state.country] || 0;
            document.getElementById('taxRateDisplay').textContent = (state.taxRate * 100).toFixed(0) + '%';
            recalculateTotal();
        }

        function recalculateTotal() {
            const subtotal = state.basePrice;
            let discount = state.discountPercent > 0 ? subtotal * (state.discountPercent / 100) : state.discountAmount;
            const afterDiscount = subtotal - discount;
            const tax = afterDiscount * state.taxRate;
            const total = afterDiscount + tax;
            
            state.discountAmount = discount;
            state.taxAmount = Math.round(tax * 100) / 100;
            state.totalAmount = Math.round(total * 100) / 100;
            
            updateAllDisplays();
        }

        function updateAllDisplays() {
            document.getElementById('diagnosisFee').textContent = '$' + (state.basePrice * 0.25).toLocaleString(undefined, {minimumFractionDigits: 2});
