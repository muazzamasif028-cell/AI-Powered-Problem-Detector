        function applyCoupon() {
            const code = document.getElementById('couponInput').value.trim().toUpperCase();
            const coupons = {
                'SUPREME20': { discount: 20, type: 'PERCENT' },
                'LAUNCH50': { discount: 50, type: 'PERCENT' },
                'NEOM2025': { discount: 30, type: 'PERCENT' },
                'STARTUP100': { discount: 100, type: 'FIXED' },
                'ENTERPRISE500': { discount: 500, type: 'FIXED' }
            };

            if (!coupons[code]) {
                showToast('❌ Invalid coupon code: ' + code, 'error');
                return;
            }

            const coupon = coupons[code];
            state.couponApplied = code;
            state.discountPercent = coupon.type === 'PERCENT' ? coupon.discount : 0;
            
            if (coupon.type === 'FIXED') {
                state.discountAmount = coupon.discount;
                state.discountPercent = 0;
            }

            document.getElementById('couponApplied').style.display = 'flex';
