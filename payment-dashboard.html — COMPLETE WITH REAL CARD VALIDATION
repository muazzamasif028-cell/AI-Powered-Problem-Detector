<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supreme Platform — Payment Dashboard</title>
    <style>
        :root {
            --bg-primary: #0a0a14;
            --bg-secondary: #12122a;
            --bg-card: #1a1a3e;
            --accent: #e94560;
            --accent-hover: #ff6b81;
            --gold: #ffd700;
            --success: #3fb950;
            --warning: #f0883e;
            --danger: #da3633;
            --quantum: #00ffff;
            --text: #e0e0e0;
            --text-dim: #8888aa;
            --border: rgba(255,255,255,0.08);
            --input-bg: #0d1117;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg-primary);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .payment-dashboard {
            width: 100%;
            max-width: 1100px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        @media (max-width: 768px) {
            .payment-dashboard { grid-template-columns: 1fr; }
        }

        .card {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.4);
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border);
        }

        .card-header .icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .card-header .icon.problem { background: rgba(233,69,96,0.15); }
        .card-header .icon.payment { background: rgba(63,185,80,0.15); }
        .card-title { font-size: 1.1em; font-weight: 700; }
        .card-subtitle { font-size: 0.75em; color: var(--text-dim); margin-top: 2px; }

        .problem-summary {
            background: var(--bg-card);
            border: 1px solid rgba(233,69,96,0.2);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 16px;
        }

        .problem-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.7em;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-bottom: 10px;
        }

        .problem-badge.critical {
            background: rgba(218,54,51,0.2);
            color: #da3633;
            border: 1px solid rgba(218,54,51,0.3);
        }

        .problem-name { font-size: 1.1em; font-weight: 600; margin-bottom: 6px; }
        .problem-detail { font-size: 0.8em; color: var(--text-dim); line-height: 1.5; }

        .fix-status {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 12px;
            padding: 10px 14px;
            background: rgba(63,185,80,0.1);
            border: 1px solid rgba(63,185,80,0.2);
            border-radius: 8px;
            font-size: 0.85em;
            color: var(--success);
        }

        .price-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            font-size: 0.9em;
        }

        .price-row:last-child { border-bottom: none; }
        .price-label { color: var(--text-dim); }
        .price-value { font-weight: 600; color: var(--text); }
        .price-value.discount { color: var(--success); }

        .price-row.total {
            margin-top: 8px;
            padding-top: 14px;
            border-top: 2px solid var(--border);
            font-size: 1.1em;
            font-weight: 700;
        }

        .price-row.total .price-value { color: var(--gold); font-size: 1.3em; }

        .savings-badge {
            display: inline-block;
            background: rgba(63,185,80,0.15);
            color: var(--success);
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 0.7em;
            font-weight: 600;
        }

        /* ============================================ */
        /* CREDIT CARD PREVIEW                           */
        /* ============================================ */
        .credit-card-preview {
            background: linear-gradient(135deg, #1a1a3e 0%, #0f3460 50%, #e94560 150%);
            border-radius: 16px;
            padding: 20px 24px;
            margin-bottom: 20px;
            position: relative;
            overflow: hidden;
            min-height: 200px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            transition: all 0.3s;
        }

        .credit-card-preview.invalid {
            border: 2px solid var(--danger);
            box-shadow: 0 10px 40px rgba(218,54,51,0.3);
        }

        .credit-card-preview.valid {
            border: 2px solid var(--success);
            box-shadow: 0 10px 40px rgba(63,185,80,0.3);
        }

        .card-chip {
            width: 50px;
            height: 40px;
            background: linear-gradient(135deg, #ffd700, #c0a000);
            border-radius: 8px;
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
        }

        .card-number-display {
            font-family: 'Courier New', monospace;
            font-size: 1.3em;
            letter-spacing: 4px;
            color: white;
            margin-bottom: 16px;
            position: relative;
            z-index: 1;
            word-spacing: 10px;
        }

        .card-info-row {
            display: flex;
            justify-content: space-between;
            position: relative;
            z-index: 1;
        }

        .card-info-label {
            font-size: 0.55em;
            color: rgba(255,255,255,0.5);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }

        .card-info-value {
            font-family: 'Courier New', monospace;
            font-size: 1em;
            color: white;
            letter-spacing: 1px;
        }

        .card-brand {
            position: absolute;
            top: 20px;
            right: 24px;
            z-index: 1;
            font-size: 2.5em;
            opacity: 0.9;
        }

        .card-validation-badge {
            position: absolute;
            bottom: 15px;
            right: 24px;
            z-index: 1;
            font-size: 0.7em;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 12px;
        }

        .card-validation-badge.valid {
            background: rgba(63,185,80,0.2);
            color: var(--success);
        }

        .card-validation-badge.invalid {
            background: rgba(218,54,51,0.2);
            color: var(--danger);
        }

        /* ============================================ */
        /* FORM INPUTS                                   */
        /* ============================================ */
        .form-group { margin-bottom: 16px; }

        .form-label {
            display: block;
            font-size: 0.78em;
            font-weight: 600;
            color: var(--text-dim);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-input {
            width: 100%;
            padding: 12px 16px;
            background: var(--input-bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text);
            font-size: 0.9em;
            font-family: inherit;
            transition: all 0.3s;
            outline: none;
        }

        .form-input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(233,69,96,0.1);
        }

        .form-input.valid {
            border-color: var(--success);
            box-shadow: 0 0 0 3px rgba(63,185,80,0.1);
        }

        .form-input.invalid {
            border-color: var(--danger);
            box-shadow: 0 0 0 3px rgba(218,54,51,0.1);
            animation: shake 0.5s ease;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-8px); }
            75% { transform: translateX(8px); }
        }

        .form-input::placeholder { color: rgba(255,255,255,0.2); }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

        .validation-message {
            font-size: 0.7em;
            margin-top: 4px;
            min-height: 16px;
        }

        .validation-message.error { color: var(--danger); }
        .validation-message.success { color: var(--success); }

        /* ============================================ */
        /* PAYMENT METHODS                               */
        /* ============================================ */
        .payment-methods {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-bottom: 20px;
        }

        .payment-method {
            padding: 12px 8px;
            background: var(--bg-card);
            border: 2px solid var(--border);
            border-radius: 10px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.78em;
            color: var(--text-dim);
        }

        .payment-method:hover { border-color: rgba(233,69,96,0.3); }

        .payment-method.active {
            border-color: var(--accent);
            background: rgba(233,69,96,0.1);
            color: var(--text);
        }

        .payment-method .method-icon { font-size: 1.5em; margin-bottom: 4px; }

        /* ============================================ */
        /* BUTTONS                                       */
        /* ============================================ */
        .btn {
            width: 100%;
            padding: 14px 24px;
            border: none;
            border-radius: 12px;
            font-size: 1em;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            letter-spacing: 0.5px;
            font-family: inherit;
        }

        .btn-primary {
            background: linear-gradient(135deg, #e94560, #ff6b81);
            color: white;
            box-shadow: 0 6px 20px rgba(233,69,96,0.3);
        }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(233,69,96,0.5);
        }

        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-secondary {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-dim);
        }

        .btn-coupon {
            background: transparent;
            border: 1px dashed var(--gold);
            color: var(--gold);
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.78em;
            font-family: inherit;
            transition: all 0.3s;
        }

        .btn-coupon:hover { background: rgba(255,215,0,0.1); }

        /* ============================================ */
        /* SUCCESS OVERLAY                               */
        /* ============================================ */
        .success-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.85);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .success-overlay.show { display: flex; }

        .success-modal {
            background: var(--bg-secondary);
            border: 1px solid var(--success);
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            max-width: 550px;
            width: 90%;
            animation: slideUp 0.5s ease;
            max-height: 90vh;
            overflow-y: auto;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .success-icon { font-size: 4em; margin-bottom: 16px; animation: bounce 0.6s ease; }

        @keyframes bounce {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.3); }
        }

        .success-title { font-size: 1.5em; font-weight: 700; color: var(--success); margin-bottom: 8px; }
        .success-message { color: var(--text-dim); font-size: 0.9em; margin-bottom: 20px; line-height: 1.6; }

        .transaction-id {
            font-family: 'Courier New', monospace;
            background: var(--bg-card);
            padding: 10px 16px;
            border-radius: 8px;
            color: var(--quantum);
            font-size: 0.85em;
            margin-bottom: 16px;
            user-select: all;
        }

        /* ============================================ */
        /* FEATURES LIST IN SUCCESS                      */
        /* ============================================ */
        .features-unlocked {
            text-align: left;
            margin: 16px 0;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            font-size: 0.82em;
            color: var(--text);
        }

        .feature-item .check { color: var(--success); font-weight: 700; }

        /* ============================================ */
        /* PROCESSING OVERLAY                            */
        /* ============================================ */
        .processing-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7);
            z-index: 998;
            justify-content: center;
            align-items: center;
        }

        .processing-overlay.show { display: flex; }

        .processing-spinner {
            width: 60px;
            height: 60px;
            border: 4px solid rgba(255,255,255,0.1);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        /* ============================================ */
        /* TOAST                                         */
        /* ============================================ */
        .toast {
            position: fixed;
            top: 20px; right: 20px;
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 16px 20px;
            z-index: 999;
            animation: slideIn 0.3s ease;
            display: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            max-width: 400px;
        }

        .toast.show { display: block; }

        @keyframes slideIn {
            from { opacity: 0; transform: translateX(100px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .toast.success { border-color: var(--success); }
        .toast.error { border-color: var(--danger); }
        .toast.warning { border-color: var(--warning); }

        /* ============================================ */
        /* COUPON SECTION                                */
        /* ============================================ */
        .coupon-section { display: flex; gap: 8px; margin-bottom: 16px; }

        .coupon-input {
            flex: 1;
            padding: 10px 14px;
            background: var(--input-bg);
            border: 1px dashed var(--gold);
            border-radius: 8px;
            color: var(--gold);
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
            text-transform: uppercase;
            letter-spacing: 2px;
            outline: none;
        }

        .coupon-applied {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            background: rgba(63,185,80,0.1);
            border: 1px solid rgba(63,185,80,0.3);
            border-radius: 8px;
            color: var(--success);
            font-size: 0.85em;
            margin-bottom: 16px;
        }

        /* ============================================ */
        /* RESPONSIVE                                    */
        /* ============================================ */
        @media (max-width: 768px) {
            .payment-dashboard { grid-template-columns: 1fr; gap: 16px; }
            .payment-methods { grid-template-columns: repeat(2, 1fr); }
            .card-number-display { font-size: 1em; letter-spacing: 2px; }
        }
    </style>
</head>
<body>

    <div class="payment-dashboard" id="paymentDashboard">
        
        <!-- LEFT COLUMN — PROBLEM + PRICE -->
        <div class="card" id="problemCard">
            <div class="card-header">
                <div class="icon problem">🔍</div>
                <div>
                    <div class="card-title">Problem Resolution</div>
                    <div class="card-subtitle">Supreme Platform v9.0</div>
                </div>
            </div>

            <div class="problem-summary">
                <span class="problem-badge critical">🚨 CRITICAL</span>
                <div class="problem-name" id="problemName">Database Connection Pool Full</div>
                <div class="problem-detail" id="problemDetail">
                    📍 Production Database Server<br>
                    💥 500 users affected<br>
                    🎯 Root Cause: Connection leak in UserModule.java:247<br>
                    ⏱️ Auto-Fix Applied in 3 minutes
                </div>
                <div class="fix-status">
                    <span class="check">✅</span>
                    <span>Auto-Fix Applied Successfully — System Healthy</span>
                </div>
            </div>

            <div class="price-breakdown" id="priceBreakdown">
                <div style="font-weight:600;margin-bottom:12px;">💰 Price Breakdown</div>
                <div class="price-row">
                    <span class="price-label">🔍 Diagnosis Fee</span>
                    <span class="price-value" id="diagnosisFee">$2,900.00</span>
                </div>
                <div class="price-row">
                    <span class="price-label">🔧 Auto-Fix Service</span>
                    <span class="price-value" id="fixFee">$8,500.00</span>
                </div>
                <div class="price-row">
                    <span class="price-label">📊 Complete Report</span>
                    <span class="price-value" style="color:var(--success);">INCLUDED</span>
                </div>
                <div class="price-row" id="discountRow" style="display:none;">
                    <span class="price-label">🎟️ Coupon Discount</span>
                    <span class="price-value discount" id="discountAmount">-$0.00</span>
                </div>
                <div class="price-row">
                    <span class="price-label">🏷️ Tax (<span id="taxRateDisplay">15%</span> VAT)</span>
                    <span class="price-value" id="taxAmount">$1,710.00</span>
                </div>
                <div class="price-row total">
                    <span class="price-label">💳 TOTAL DUE</span>
                    <span class="price-value" id="totalAmount">$13,110.00</span>
                </div>
                <div style="text-align:right;margin-top:6px;">
                    <span class="savings-badge" id="savingsText" style="display:none;">💡 You save: $0</span>
                </div>
            </div>

            <div class="coupon-section">
                <input type="text" class="coupon-input" id="couponInput" 
                       placeholder="ENTER COUPON CODE" maxlength="20">
                <button class="btn-coupon" onclick="applyCoupon()">APPLY</button>
            </div>
            <div class="coupon-applied" id="couponApplied" style="display:none;">
                ✅ Coupon <strong id="couponCode">NEOM2025</strong> applied — 
                <strong id="couponValue">30% OFF</strong>
                <span style="cursor:pointer;margin-left:auto;" onclick="removeCoupon()">✕</span>
            </div>
        </div>

        <!-- RIGHT COLUMN — CREDIT CARD + PAYMENT -->
        <div class="card" id="paymentCard">
            <div class="card-header">
                <div class="icon payment">💳</div>
                <div>
                    <div class="card-title">Payment Method</div>
                    <div class="card-subtitle">Secure • Encrypted • Real-Time Validation</div>
                </div>
            </div>

            <!-- Credit Card Preview -->
            <div class="credit-card-preview" id="cardPreview">
                <div class="card-chip"></div>
                <div class="card-brand" id="cardBrand">💳</div>
                <div class="card-number-display" id="cardNumberDisplay">•••• •••• •••• ••••</div>
                <div class="card-info-row">
                    <div class="card-info-block">
                        <div class="card-info-label">Card Holder</div>
                        <div class="card-info-value" id="cardHolderDisplay">YOUR NAME</div>
                    </div>
                    <div class="card-info-block">
                        <div class="card-info-label">Expires</div>
                        <div class="card-info-value" id="cardExpiryDisplay">MM/YY</div>
                    </div>
                </div>
                <div class="card-validation-badge" id="cardValidationBadge" style="display:none;"></div>
            </div>

            <!-- Payment Methods -->
            <div class="payment-methods">
                <div class="payment-method active" data-method="CARD" onclick="selectMethod('CARD', this)">
                    <div class="method-icon">💳</div>Credit Card
                </div>
                <div class="payment-method" data-method="PAYPAL" onclick="selectMethod('PAYPAL', this)">
                    <div class="method-icon">🅿️</div>PayPal
                </div>
                <div class="payment-method" data-method="APPLE_PAY" onclick="selectMethod('APPLE_PAY', this)">
                    <div class="method-icon">🍎</div>Apple Pay
                </div>
                <div class="payment-method" data-method="GOOGLE_PAY" onclick="selectMethod('GOOGLE_PAY', this)">
                    <div class="method-icon">🤖</div>Google Pay
                </div>
                <div class="payment-method" data-method="CRYPTO" onclick="selectMethod('CRYPTO', this)">
                    <div class="method-icon">🪙</div>Crypto
                </div>
                <div class="payment-method" data-method="BANK" onclick="selectMethod('BANK', this)">
                    <div class="method-icon">🏦</div>Bank
                </div>
            </div>

            <!-- Credit Card Form -->
            <form id="paymentForm" onsubmit="processPayment(event)">
                <div class="form-group">
                    <label class="form-label">Card Number</label>
                    <input type="text" class="form-input" id="cardNumber" 
                           placeholder="1234 5678 9012 3456" maxlength="19"
                           oninput="formatCardNumber(this); validateCardNumber(); updateCardPreview();">
                    <div class="validation-message" id="cardNumberMsg"></div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Expiry Date</label>
                        <input type="text" class="form-input" id="cardExpiry" 
                               placeholder="MM/YY" maxlength="5"
                               oninput="formatExpiry(this); validateExpiry(); updateCardPreview();">
                        <div class="validation-message" id="cardExpiryMsg"></div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">CVV</label>
                        <input type="text" class="form-input" id="cardCVV" 
                               placeholder="123" maxlength="4"
                               oninput="this.value = this.value.replace(/[^0-9]/g, ''); validateCVV();">
                        <div class="validation-message" id="cardCVVMsg"></div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Card Holder Name</label>
                    <input type="text" class="form-input" id="cardHolder" 
                           placeholder="JOHN DOE"
                           oninput="validateHolder(); updateCardPreview();">
                    <div class="validation-message" id="cardHolderMsg"></div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Country</label>
                        <select class="form-input" id="country" onchange="updateTax()">
                            <option value="SA" selected>🇸🇦 Saudi Arabia (15% VAT)</option>
                            <option value="AE">🇦🇪 UAE (Tax Free)</option>
                            <option value="US">🇺🇸 United States</option>
                            <option value="UK">🇬🇧 United Kingdom (20% VAT)</option>
                            <option value="EU">🇪🇺 European Union (20% VAT)</option>
                            <option value="IN">🇮🇳 India (18% GST)</option>
                            <option value="SG">🇸🇬 Singapore (9% GST)</option>
                            <option value="JP">🇯🇵 Japan (10% CT)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">ZIP / Postal Code</label>
                        <input type="text" class="form-input" id="zipCode" 
                               placeholder="12345" maxlength="10">
                    </div>
                </div>

                <button type="submit" class="btn btn-primary" id="payButton">
                    🔒 PAY <span id="payAmount">$13,110.00</span> NOW
