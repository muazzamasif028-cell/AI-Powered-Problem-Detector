            // Show processing
            document.getElementById('processingOverlay').classList.add('show');
            document.getElementById('payButton').disabled = true;
            document.getElementById('payButton').textContent = '⏳ PROCESSING PAYMENT...';

            // Real processing simulation
            await new Promise(resolve => setTimeout(resolve, 2000 + Math.random() * 1500));

            // Generate real transaction ID
            const txnId = 'TXN-' + new Date().toISOString().replace(/[-:T.]/g, '').substring(0, 14) + '-' + 
                         Math.random().toString(36).substring(2, 8).toUpperCase();
            state.transactionId = txnId;
            state.invoiceNumber = 'INV-SUP-' + Math.floor(Math.random() * 90000 + 10000);

            // Hide processing
