        function detectCardBrand(cardNumber) {
            const digits = cardNumber.replace(/\D/g, '');
            
            // Check 4-digit BINs first
            const bin4 = digits.substring(0, 4);
            if (BIN_DATABASE[bin4]) return BIN_DATABASE[bin4];
            
            // Check 2-digit BINs
            const bin2 = digits.substring(0, 2);
            if (BIN_DATABASE[bin2]) return BIN_DATABASE[bin2];
            
            // Check 1-digit BIN
            const bin1 = digits.substring(0, 1);
            if (BIN_DATABASE[bin1]) return BIN_DATABASE[bin1];
            
            return { brand: 'Unknown', type: 'Unknown', bank: 'Unknown', country: 'Unknown' };
        }

        // Real card number validation
        function validateCardNumber() {
            const input = document.getElementById('cardNumber');
            const msgEl = document.getElementById('cardNumberMsg');
            const cardNumber = input.value.replace(/\s/g, '');
            const preview = document.getElementById('cardPreview');
            
            if (cardNumber.length === 0) {
                input.classList.remove('valid', 'invalid');
                msgEl.textContent = '';
                msgEl.className = 'validation-message';
                preview.classList.remove('valid', 'invalid');
                document.getElementById('cardValidationBadge').style.display = 'none';
                return false;
            }

            if (cardNumber.length < 13) {
                input.classList.add('invalid');
                input.classList.remove('valid');
                msgEl.textContent = '❌ Card number too short (minimum 13 digits)';
                msgEl.className = 'validation-message error';
                preview.classList.add('invalid');
                preview.classList.remove('valid');
                document.getElementById('cardValidationBadge').style.display = 'none';
                return false;
            }

            // REAL Luhn algorithm check
            if (!luhnCheck(cardNumber)) {
                input.classList.add('invalid');
                input.classList.remove('valid');
                msgEl.textContent = '❌ Invalid card number (failed Luhn check)';
                msgEl.className = 'validation-message error';
                preview.classList.add('invalid');
                preview.classList.remove('valid');
                document.getElementById('cardValidationBadge').style.display = 'none';
                return false;
            }

            // Detect brand
            const cardInfo = detectCardBrand(cardNumber);
            
            if (cardInfo.brand === 'Unknown') {
                input.classList.add('invalid');
                input.classList.remove('valid');
                msgEl.textContent = '⚠️ Unknown card issuer';
                msgEl.className = 'validation-message error';
                preview.classList.remove('valid', 'invalid');
                document.getElementById('cardValidationBadge').style.display = 'none';
                return false;
            }

            // VALID CARD!
            input.classList.add('valid');
            input.classList.remove('invalid');
            msgEl.textContent = `✅ Valid ${cardInfo.brand} (${cardInfo.type}) — ${cardInfo.bank}`;
            msgEl.className = 'validation-message success';
            preview.classList.add('valid');
            preview.classList.remove('invalid');
            
            // Show validation badge
            const badge = document.getElementById('cardValidationBadge');
            badge.style.display = 'block';
            badge.textContent = `✅ VALID ${cardInfo.brand.toUpperCase()}`;
            badge.className = 'card-validation-badge valid';

            return true;
        }

        function validateExpiry() {
            const input = document.getElementById('cardExpiry');
            const msgEl = document.getElementById('cardExpiryMsg');
            const value = input.value;
            
            if (value.length === 0) {
                input.classList.remove('valid', 'invalid');
                msgEl.textContent = '';
                msgEl.className = 'validation-message';
                return false;
            }

            if (value.length < 5) {
                input.classList.add('invalid');
                input.classList.remove('valid');
                msgEl.textContent = '❌ Enter full expiry (MM/YY)';
                msgEl.className = 'validation-message error';
                return false;
            }

            const parts = value.split('/');
            const month = parseInt(parts[0]);
            const year = parseInt('20' + parts[1]);

            if (month < 1 || month > 12) {
                input.classList.add('invalid');
                input.classList.remove('valid');
                msgEl.textContent = '❌ Invalid month (01-12)';
                msgEl.className = 'validation-message error';
                return false;
            }

            const now = new Date();
            const currentMonth = now.getMonth() + 1;
            const currentYear = now.getFullYear();

            if (year < currentYear || (year === currentYear && month < currentMonth)) {
                input.classList.add('invalid');
                input.classList.remove('valid');
                msgEl.textContent = '❌ Card has expired!';
                msgEl.className = 'validation-message error';
                return false;
            }

            if (year > currentYear + 10) {
                input.classList.add('invalid');
                input.classList.remove('valid');
                msgEl.textContent = '❌ Expiry too far in future';
                msgEl.className = 'validation-message error';
                return false;
            }

            // Valid expiry
            input.classList.add('valid');
            input.classList.remove('invalid');
            msgEl.textContent = '✅ Valid expiry date';
            msgEl.className = 'validation-message success';
            return true;
        }

        function validateCVV() {
            const input = document.getElementById('cardCVV');
            const msgEl = document.getElementById('cardCVVMsg');
            const value = input.value;
            const cardNumber = document.getElementById('cardNumber').value.replace(/\s/g, '');
            const cardInfo = detectCardBrand(cardNumber);
            
            const expectedLength = cardInfo.brand === 'Amex' ? 4 : 3;

            if (value.length === 0) {
                input.classList.remove('valid', 'invalid');
                msgEl.textContent = '';
                msgEl.className = 'validation-message';
                return false;
            }

            if (value.length < expectedLength) {
                input.classList.add('invalid');
                input.classList.remove('valid');
                msgEl.textContent = `❌ CVV must be ${expectedLength} digits`;
                msgEl.className = 'validation-message error';
                return false;
            }

            // Real CVV validation — no 000 allowed
            if (value === '000' || value === '0000') {
                input.classList.add('invalid');
                input.classList.remove('valid');
                msgEl.textContent = '❌ Invalid CVV code';
                msgEl.className = 'validation-message error';
                return false;
            }

            // Valid CVV
            input.classList.add('valid');
            input.classList.remove('invalid');
            msgEl.textContent = '✅ Valid CVV';
            msgEl.className = 'validation-message success';
            return true;
        }

        function validateHolder() {
            const input = document.getElementById('cardHolder');
            const msgEl = document.getElementById('cardHolderMsg');
            const value = input.value.trim();

            if (value.length === 0) {
                input.classList.remove('valid', 'invalid');
                msgEl.textContent = '';
                msgEl.className = 'validation-message';
                return false;
            }

            if (value.length < 3) {
                input.classList.add('invalid');
                input.classList.remove('valid');
                msgEl.textContent = '❌ Name too short';
                msgEl.className = 'validation-message error';
                return false;
            }

            if (!/^[a-zA-Z\s\-'.]+$/.test(value)) {
                input.classList.add('invalid');
                input.classList.remove('valid');
                msgEl.textContent = '❌ Invalid characters in name';
                msgEl.className = 'validation-message error';
                return false;
            }

            // Valid holder name
            input.classList.add('valid');
            input.classList.remove('invalid');
            msgEl.textContent = '✅ Valid name';
            msgEl.className = 'validation-message success';
            return true;
        }

        function isCardFullyValid() {
            const cardValid = validateCardNumber();
            const expiryValid = validateExpiry();
            const cvvValid = validateCVV();
            const holderValid = validateHolder();
            
            return cardValid && expiryValid && cvvValid && holderValid;
        }

