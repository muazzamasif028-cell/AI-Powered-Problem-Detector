        // Luhn Algorithm — REAL card number validation
        function luhnCheck(cardNumber) {
            const digits = cardNumber.replace(/\D/g, '');
            if (digits.length < 13 || digits.length > 19) return false;
            
            let sum = 0;
            let isEven = false;
            
            for (let i = digits.length - 1; i >= 0; i--) {
                let digit = parseInt(digits[i]);
                
                if (isEven) {
                    digit *= 2;
                    if (digit > 9) digit -= 9;
                }
                
                sum += digit;
                isEven = !isEven;
            }
            
            return sum % 10 === 0;
        }

        // Real BIN (Bank Identification Number) database
        const BIN_DATABASE = {
            '4': { brand: 'Visa', type: 'Credit/Debit', bank: 'Various', country: 'Global' },
            '40': { brand: 'Visa', type: 'Debit', bank: 'Various', country: 'Global' },
