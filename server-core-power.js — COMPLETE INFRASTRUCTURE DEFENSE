                            impact: 'Freed 1-4GB memory'
                        });
                        
                        actions.push({
                            action: 'RESTART_LEAKING_SERVICE',
                            command: 'systemctl restart nginx && systemctl restart node-app',
                            description: 'Restarted services with memory leaks',
                            impact: 'Memory leak temporarily resolved'
                        });
