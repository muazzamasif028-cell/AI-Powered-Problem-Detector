                async reroute(source, destination, networkData) {
                    const actions = [];
                    
                    if (networkData.packetLoss >= 35) {
                        console.log('🚨 SEVERE PACKET LOSS! Emergency rerouting...');
                        
                        // Find alternative route
                        const alternativeRoute = this.findBestRoute(source, destination);
                        
                        actions.push({
                            action: 'EMERGENCY_REROUTE',
                            command: `ip route replace ${destination} via ${alternativeRoute.gateway} metric 10`,
                            description: `Rerouted through ${alternativeRoute.path}`,
