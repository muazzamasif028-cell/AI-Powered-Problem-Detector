                        name: 'node-app',
                        memory: Math.floor(Math.random() * 4000) + 500
                    };
                },
                
                calculateMemoryFreed(actions) {
                    return actions.reduce((sum, a) => sum + (a.impact?.match(/(\d+)/)?.[1] || 500), 0);
                },
                
                getNativeCommands() {
                    return {
