                            action: 'FINE_TUNE_ANTENNA',
                            command: `satctl --satellite ${satelliteId} --antenna --fine-tune`,
                            description: 'Antenna fine-tuned for maximum gain',
                            impact: 'Signal improved by 15%'
                        });
                    }
                    
                    return {
                        triggered: actions.length > 0,
                        severity: signalData.strength <= 15 ? 'CRITICAL' : 'WARNING',
                        actions,
                        signalBefore: signalData.strength + '%',
                        signalAfter: Math.min(100, signalData.strength + 30) + '%',
                        timestamp: Date.now()
                    };
                }
            },

            // 7. HIGH-LATENCY NETWORK REROUTING
            networkRerouting: {
                name: 'High-Latency Network Rerouting',
                status: 'ACTIVE',
                thresholds: {
                    packetLoss: 20,       // 20% packet loss
                    criticalLoss: 35,     // 35% = emergency
