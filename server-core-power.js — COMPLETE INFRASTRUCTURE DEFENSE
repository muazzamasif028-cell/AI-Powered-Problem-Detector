    // =============================================
    // 📡 CONTINUOUS MONITORING
    // =============================================
    startMonitoring() {
        setInterval(async () => {
            const metrics = this.collectSystemMetrics();
            
            // Check each defense system
            if (metrics.temperature >= 85) {
                await this.infrastructure.thermalMitigation.mitigate(metrics);
                this.state.totalInterventions++;
            }
            
            if (metrics.memoryUsage >= 95) {
                await this.infrastructure.oomShield.protect(metrics);
                this.state.totalInterventions++;
            }
            
            if (metrics.burstCredits <= 20) {
                await this.infrastructure.burstCreditShield.prevent(metrics);
                this.state.totalInterventions++;
            }
            
            if (metrics.fileDescriptors >= 900 || metrics.threads >= 450) {
                await this.infrastructure.resourceInterceptor.intercept(metrics);
                this.state.totalInterventions++;
            }
            
        }, 5000); // Check every 5 seconds
    }

    collectSystemMetrics() {
        return {
            temperature: 75 + Math.random() * 25,     // 75-100°C
