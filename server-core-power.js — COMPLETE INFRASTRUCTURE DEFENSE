                            'echo 3 > /proc/sys/vm/drop_caches',           // Clear all caches
                            'echo 1 > /proc/sys/vm/compact_memory',        // Compact memory
                            'swapoff -a && swapon -a',                      // Reset swap
                            'ps aux --sort=-%mem | head -10',              // Top memory processes
                            'cat /proc/meminfo | grep -E "MemTotal|MemFree|MemAvailable"' // Memory info
