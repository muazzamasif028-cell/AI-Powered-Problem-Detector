                            impact: 'Improved memory allocation efficiency'
                        });
                        
                    } else if (currentMetrics.memoryUsage >= 95) {
                        console.log('⚠️ CRITICAL MEMORY: Proactive cleanup...');
                        
                        actions.push({
                            action: 'CLEAR_CACHES',
                            command: 'echo 1 > /proc/sys/vm/drop_caches',
