    // =============================================
    // INITIALIZE
    // =============================================
    initialize() {
        console.log('🤫 [NEOM COMMAND CENTER]: Initializing...');
        console.log('🤫 [NEOM]: THE LINE | OXAGON | TROJENA | SINDALAH | INDUSTRIAL ZONE');
        console.log('🤫 [SYSTEMS]: 48 total systems across 5 regions');
        console.log('🤫 [TEAMS]: 8 response teams ready');
        
        this.state.initialized = true;
        
        return {
            status: 'READY',
            regions: Object.keys(this.regions).length,
            totalSystems: this.state.totalSystems,
            responseTeams: Object.keys(this.responseTeams).length,
            timestamp: new Date().toISOString()
        };
    }

    // =============================================
    // FULL CITY SCAN — ALL SYSTEMS
    // =============================================
    async fullCityScan() {
        const scanId = 'NEOM-CITY-' + Date.now().toString(36) + '-' + 
                      Math.random().toString(36).substr(2, 6).toUpperCase();
        
        console.log(`🤫 [NEOM]: ${scanId} — Full city scan initiated`);

        const results = {
            scanId,
            timestamp: new Date().toISOString(),
            regions: {},
            systems: {},
            infrastructure: this.criticalInfra,
            metrics: this.cityMetrics,
            teams: this.getTeamStatus()
        };

        // Scan each region
        for (let [regionKey, region] of Object.entries(this.regions)) {
            results.regions[regionKey] = this.scanRegion(regionKey, region);
        }

        // Scan integrated systems
        for (let [sysKey, sys] of Object.entries(this.integratedSystems)) {
            results.systems[sysKey] = this.scanIntegratedSystem(sysKey, sys);
        }

        // Update city status
        this.updateCityStatus(results);

        // Check for critical incidents
        const criticalRegions = Object.values(results.regions).filter(r => r.status === 'CRITICAL');
        if (criticalRegions.length > 0) {
            this.state.cityStatus = 'EMERGENCY';
            this.triggerEmergencyResponse(criticalRegions);
        }

        console.log(`🤫 [NEOM]: ${scanId} — City status: ${this.state.cityStatus}`);

        return results;
    }

    // =============================================
    // SCAN REGION
    // =============================================
    scanRegion(regionKey, region) {
        const alerts = [];
        let criticalCount = 0;
        let warningCount = 0;

        // Simulate system checks
        region.systems.forEach(system => {
            const health = Math.random();
            if (health < 0.05) {
                alerts.push({ system, status: 'CRITICAL', message: `${system} malfunction detected` });
                criticalCount++;
            } else if (health < 0.15) {
                alerts.push({ system, status: 'WARNING', message: `${system} needs maintenance` });
                warningCount++;
            }
        });

        const status = criticalCount > 0 ? 'CRITICAL' : warningCount > 0 ? 'WARNING' : 'OPERATIONAL';
        
        // Update region status
        this.regions[regionKey].status = status;
        this.regions[regionKey].alerts = alerts;

        return {
            name: region.name,
            population: region.population,
            systemsTotal: region.systems.length,
            systemsOnline: region.systems.length - criticalCount,
            alerts,
            criticalCount,
            warningCount,
            status,
            responseTeam: this.getNearestTeam(regionKey)
        };
    }

    // =============================================
    // SCAN INTEGRATED SYSTEM
    // =============================================
    scanIntegratedSystem(sysKey, sys) {
        const problemCount = Math.floor(Math.random() * 5);
        const criticalCount = problemCount > 2 ? Math.floor(Math.random() * 2) : 0;
        
        const status = criticalCount > 0 ? 'CRITICAL' : problemCount > 0 ? 'WARNING' : 'ONLINE';

        this.integratedSystems[sysKey].status = status;
        this.integratedSystems[sysKey].problems = problemCount;
        this.integratedSystems[sysKey].critical = criticalCount;

        return {
            name: sysKey,
            status,
            problems: problemCount,
            critical: criticalCount,
            healthPercent: ((1 - problemCount / 10) * 100).toFixed(1) + '%'
        };
    }

    // =============================================
    // UPDATE CITY STATUS
    // =============================================
    updateCityStatus(results) {
        const allAlerts = Object.values(results.regions).flatMap(r => r.alerts);
        const criticalAlerts = allAlerts.filter(a => a.status === 'CRITICAL');
        
        this.state.activeIncidents = allAlerts.length;
        this.state.citizensAffected = criticalAlerts.length * 10000;

        if (criticalAlerts.length >= 3) {
            this.state.cityStatus = 'EMERGENCY';
        } else if (criticalAlerts.length >= 1) {
            this.state.cityStatus = 'ALERT';
        } else if (allAlerts.length > 0) {
            this.state.cityStatus = 'WARNING';
        } else {
            this.state.cityStatus = 'OPERATIONAL';
        }
    }

    // =============================================
    // TRIGGER EMERGENCY RESPONSE
    // =============================================
    triggerEmergencyResponse(criticalRegions) {
        const incident = {
            id: 'INC-' + Date.now().toString(36).toUpperCase(),
            timestamp: new Date().toISOString(),
            regions: criticalRegions.map(r => r.name),
            severity: 'CRITICAL',
            teamsDeployed: []
        };

        // Auto-deploy nearest teams
        criticalRegions.forEach(region => {
            const team = this.getNearestTeam(region.name);
            if (team && this.responseTeams[team]) {
                const deployed = Math.ceil(this.responseTeams[team].size * 0.3);
                this.responseTeams[team].available -= deployed;
                incident.teamsDeployed.push({
                    team,
                    deployed,
                    remaining: this.responseTeams[team].available,
                    eta: this.responseTeams[team].eta
                });
            }
        });

        this.incidents.push(incident);
        if (this.incidents.length > this.maxIncidents) this.incidents.shift();

        console.log(`🤫 [NEOM EMERGENCY]: Incident ${incident.id} — ${incident.teamsDeployed.length} teams deployed`);
    }

    // =============================================
    // GET NEAREST RESPONSE TEAM
    // =============================================
    getNearestTeam(regionName) {
        const teamMapping = {
            THE_LINE: 'POWER_GRID',
            OXAGON: 'ENGINEERING',
            TROJENA: 'FIRE_RESCUE',
            SINDALAH: 'SECURITY_FORCE',
            INDUSTRIAL_ZONE: 'HAZMAT'
        };
        return teamMapping[regionName] || 'ENGINEERING';
    }

    // =============================================
    // GET TEAM STATUS
    // =============================================
    getTeamStatus() {
        const teams = {};
        for (let [key, team] of Object.entries(this.responseTeams)) {
            teams[key] = {
                ...team,
                utilizationPercent: ((1 - team.available / team.size) * 100).toFixed(1) + '%'
            };
        }
        return teams;
    }

    // =============================================
    // REGION DETAIL REPORT
    // =============================================
    getRegionReport(regionKey) {
        const region = this.regions[regionKey];
        if (!region) return { error: 'Region not found' };

        return {
            region: {
                name: region.name,
                description: region.description,
                population: region.population.toLocaleString(),
                status: region.status,
                systems: region.systems.map(sys => ({
                    name: sys,
                    status: region.alerts.some(a => a.system === sys && a.status === 'CRITICAL') ? 'CRITICAL' :
                            region.alerts.some(a => a.system === sys && a.status === 'WARNING') ? 'WARNING' : 'ONLINE'
                })),
                alerts: region.alerts,
                activeAlerts: region.alerts.length
            },
            responseTeam: {
                name: this.getNearestTeam(regionKey),
                ...this.responseTeams[this.getNearestTeam(regionKey)]
            }
        };
    }

    // =============================================
    // FULL NEOM DASHBOARD
    // =============================================
    getFullDashboard() {
        return {
            city: {
                name: 'NEOM Smart City',
                status: this.state.cityStatus,
                activeIncidents: this.state.activeIncidents,
                citizensAffected: this.state.citizensAffected.toLocaleString(),
                totalPopulation: Object.values(this.regions).reduce((sum, r) => sum + r.population, 0).toLocaleString()
            },
            regions: Object.entries(this.regions).map(([key, region]) => ({
                key,
                name: region.name,
                status: region.status,
                population: region.population.toLocaleString(),
                systemsOnline: region.systems.length - region.alerts.filter(a => a.status === 'CRITICAL').length,
                alerts: region.alerts.length
            })),
            integratedSystems: Object.entries(this.integratedSystems).map(([key, sys]) => ({
                name: key,
                status: sys.status,
                problems: sys.problems
            })),
            infrastructure: this.criticalInfra,
            teams: this.getTeamStatus(),
            cityMetrics: this.cityMetrics,
            recentIncidents: this.incidents.slice(-5),
            timestamp: new Date().toISOString()
        };
    }

