        ${dashboard.city.status === 'OPERATIONAL' ? '✅ CITY OPERATIONAL' : dashboard.city.status === 'EMERGENCY' ? '🚨 EMERGENCY ACTIVE' : '⚠️ ALERT STATE'}
        </span>
        </div>
        </div>

        <!-- QUICK STATS -->
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:14px;">
        <div style="background:rgba(139,92,246,0.1);padding:10px;border-radius:8px;text-align:center;">
        <div style="color:#8b5cf6;font-size:1.3em;font-weight:700;">5</div>
        <div style="color:rgba(255,255,255,0.5);font-size:0.6em;">REGIONS</div>
        </div>
        <div style="background:rgba(0,255,255,0.1);padding:10px;border-radius:8px;text-align:center;">
        <div style="color:#00ffff;font-size:1.3em;font-weight:700;">${dashboard.city.totalPopulation}</div>
        <div style="color:rgba(255,255,255,0.5);font-size:0.6em;">POPULATION</div>
