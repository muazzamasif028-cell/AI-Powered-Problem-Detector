        <div style="color:rgba(255,255,255,0.5);font-size:0.6em;">SYSTEMS</div>
        </div>
        <div style="background:rgba(240,136,62,0.1);padding:10px;border-radius:8px;text-align:center;">
        <div style="color:#f0883e;font-size:1.3em;font-weight:700;">${dashboard.city.activeIncidents}</div>
        <div style="color:rgba(255,255,255,0.5);font-size:0.6em;">INCIDENTS</div>
        </div>
        </div>

        <!-- REGIONS STATUS -->
        <div style="color:#8b5cf6;font-weight:700;margin-bottom:6px;">📍 REGIONS</div>`;

        dashboard.regions.forEach(region => {
            const statusColor = region.status === 'OPERATIONAL' ? '#3fb950' : region.status === 'CRITICAL' ? '#da3633' : '#f0883e';
            const icon = region.status === 'OPERATIONAL' ? '✅' : region.status === 'CRITICAL' ? '🚨' : '⚠️';
            html += `
            <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 8px;margin:2px 0;background:rgba(255,255,255,0.02);border-radius:6px;">
            <span style="color:#e0e0e0;">${region.name}</span>
            <span style="color:rgba(255,255,255,0.4);font-size:0.7em;">👥 ${region.population}</span>
