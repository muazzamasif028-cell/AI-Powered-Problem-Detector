        });

        // INTEGRATED SYSTEMS
        html += `<div style="color:#00ffff;font-weight:700;margin:10px 0 6px;">⚙️ INTEGRATED SYSTEMS</div>`;

        dashboard.integratedSystems.forEach(sys => {
            const color = sys.status === 'ONLINE' ? '#3fb950' : sys.status === 'CRITICAL' ? '#da3633' : '#f0883e';
            html += `
            <div style="display:flex;justify-content:space-between;padding:4px 8px;margin:1px 0;">
            <span style="color:#e0e0e0;">${sys.name}</span>
            <span style="color:${color};">${sys.status}</span>
            <span style="color:rgba(255,255,255,0.4);">🐛 ${sys.problems}</span>
            </div>`;
        });

        // CRITICAL INFRASTRUCTURE
        html += `<div style="color:#f0883e;font-weight:700;margin:10px 0 6px;">🏗️ CRITICAL INFRASTRUCTURE</div>`;

        Object.entries(dashboard.infrastructure).forEach(([key, infra]) => {
            html += `
            <div style="display:flex;justify-content:space-between;padding:4px 8px;margin:1px 0;">
            <span style="color:#e0e0e0;">${key.replace(/_/g, ' ')}</span>
            <span style="color:#3fb950;">${infra.online}/${infra.total} ONLINE</span>
            <span style="color:rgba(255,255,255,0.4);font-size:0.65em;">${infra.type}</span>
            </div>`;
        });

        // CITY METRICS
        html += `<div style="color:#ffd700;font-weight:700;margin:10px 0 6px;">🌡️ ENVIRONMENTAL METRICS</div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px;">`;

        Object.entries(dashboard.cityMetrics).forEach(([key, metric]) => {
            html += `
            <div style="background:rgba(255,215,0,0.05);padding:6px;border-radius:4px;text-align:center;">
            <div style="color:#ffd700;font-weight:600;">${metric.current} ${metric.unit || ''}</div>
            <div style="color:rgba(255,255,255,0.4);font-size:0.55em;">${key}</div>
            </div>`;
        });

        html += `</div>
        <div style="text-align:center;margin-top:10px;color:rgba(255,255,255,0.3);font-size:0.55em;">
        🛰️ Satellite Fleet: 350+ Active | 🤖 AI Core: 5.9B Layers | ⚡ Power: Solar + Hydrogen + Fusion
        </div>
        </div>`;

        return html;
    }

    // =============================================
    // SYSTEM STATUS
    // =============================================
    getStatus() {
        return {
            initialized: this.state.initialized,
            cityStatus: this.state.cityStatus,
            activeIncidents: this.state.activeIncidents,
            citizensAffected: this.state.citizensAffected,
            regions: Object.keys(this.regions).length,
            totalSystems: this.state.totalSystems,
            systemsOnline: this.state.systemsOnline,
            teamsAvailable: Object.values(this.responseTeams).reduce((sum, t) => sum + t.available, 0)
        };
    }

    reset() {
        Object.keys(this.regions).forEach(key => {
            this.regions[key].status = 'OPERATIONAL';
            this.regions[key].alerts = [];
        });
        Object.keys(this.integratedSystems).forEach(key => {
            this.integratedSystems[key] = { status: 'ONLINE', problems: 0, critical: 0 };
        });
        this.state.cityStatus = 'OPERATIONAL';
        this.state.activeIncidents = 0;
        this.incidents = [];
        return { status: 'RESET' };
    }
}

