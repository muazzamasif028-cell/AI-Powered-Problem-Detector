#include <stdio.h>
#include <stdint.h>

// Read MSR (Model Specific Register)
uint64_t read_msr(uint32_t msr) {
    uint32_t low, high;
    asm volatile("rdmsr" : "=a"(low), "=d"(high) : "c"(msr));
    return ((uint64_t)high << 32) | low;
}

// Check CPU thermal status
void check_thermal() {
    uint64_t status = read_msr(0x19C);  // IA32_THERM_STATUS
    int temp = (status >> 16) & 0x7F;
    printf("CPU Temperature: %d°C\\n", temp);
    
    if (temp > 90) {
        printf("⚠️ THERMAL THROTTLING DETECTED!\\n");
        printf("Chip: Reducing frequency to prevent damage\\n");
    }
}

// Check voltage status
void check_voltage() {
    uint64_t perf_status = read_msr(0x198);  // IA32_PERF_STATUS
    uint32_t voltage = perf_status & 0xFFFF;
    printf("CPU Voltage: %d mV\\n", voltage);
    
    if (voltage < 800 || voltage > 1500) {
        printf("⚠️ VOLTAGE IRREGULARITY! PSU or VRM may be failing\\n");
    }
}
