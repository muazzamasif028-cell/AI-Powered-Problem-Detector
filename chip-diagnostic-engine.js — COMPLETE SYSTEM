library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity chip_diagnostic is
    Port ( 
        clk : in STD_LOGIC;
        temp_sensor : in STD_LOGIC_VECTOR(7 downto 0);
        voltage_sensor : in STD_LOGIC_VECTOR(7 downto 0);
        chip_ok : out STD_LOGIC;
        error_code : out STD_LOGIC_VECTOR(3 downto 0)
    );
end chip_diagnostic;

architecture Behavioral of chip_diagnostic is
    signal temperature : integer range 0 to 255;
    signal voltage : integer range 0 to 255;
begin
    process(clk)
    begin
        if rising_edge(clk) then
            temperature <= to_integer(unsigned(temp_sensor));
            voltage <= to_integer(unsigned(voltage_sensor));
            
            -- Check thermal threshold
            if temperature > 90 then
                chip_ok <= '0';
