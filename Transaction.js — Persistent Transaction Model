// =============================================
// 🔍 STATICS
// =============================================

/**
 * Find by idempotency key (prevents duplicate transactions)
 */
TransactionSchema.statics.findByIdempotencyKey = function(key) {
    return this.findOne({ idempotencyKey: key });
};

/**
 * Find pending transactions that need processing
 */
TransactionSchema.statics.findPending = function(limit = 10) {
    return this.find({
        status: 'pending',
        'error.retryCount': { $lt: 3 }
    })
    .sort({ priority: -1, createdAt: 1 })
    .limit(limit);
};

/**
 * Find stuck transactions (processing for too long)
 */
TransactionSchema.statics.findStuck = function(timeoutMinutes = 30) {
    const cutoff = new Date(Date.now() - timeoutMinutes * 60 * 1000);
    return this.find({
        status: 'processing',
        updatedAt: { $lt: cutoff }
    });
};

/**
 * Get transaction statistics
 */
TransactionSchema.statics.getStats = async function(userId = null) {
    const match = userId ? { userId: mongoose.Types.ObjectId(userId) } : {};
    
    const stats = await this.aggregate([
        { $match: match },
        { $group: {
            _id: '$status',
            count: { $sum: 1 },
            totalRevenue: { $sum: '$pricing.total' }
        }}
    ]);
    
    return stats;
};

module.exports = mongoose.model('Transaction', TransactionSchema);
