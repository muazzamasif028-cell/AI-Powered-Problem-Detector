    /**
     * 🔍 Search Materials
     */
    searchMaterials(criteria) {
        const results = [];
        
        for (const [name, material] of Object.entries(this.materialsDB)) {
            let score = 0;
            
            if (criteria.maxWeight && material.weight !== 'HEAVY') score++;
            if (criteria.minStrength && parseInt(material.tensileStrength) > criteria.minStrength) score++;
            if (criteria.maxCost && material.cost.length <= criteria.maxCost) score++;
            if (criteria.application && material.bestFor.includes(criteria.application)) score += 3;
            
            if (score > 0) {
                results.push({ name, ...material, matchScore: score });
            }
        }
        
        return results.sort((a, b) => b.matchScore - a.matchScore);
    }

    // Helpers
    detectVehicleType(input) {
        const types = {
            'car': 'CAR', 'suv': 'CAR', 'sedan': 'CAR',
            'bike': 'BIKE', 'motorcycle': 'BIKE',
            'truck': 'TRUCK', 'bus': 'BUS',
            'plane': 'PLANE', 'aircraft': 'PLANE', 'jet': 'PLANE',
            'helicopter': 'HELICOPTER', 'evtol': 'eVTOL',
            'drone': 'DRONE', 'robot': 'ROBOT',
            'ship': 'SHIP', 'yacht': 'YACHT', 'boat': 'SHIP',
            'spacecraft': 'SPACECRAFT', 'rocket': 'SPACECRAFT'
        };
        
        for (const [key, type] of Object.entries(types)) {
            if (input.includes(key)) return type;
        }
        
        return 'CAR'; // Default
    }

    extractRequirements(input) {
        const reqs = {
            range: parseInt(input.match(/\d+.*km/)?.[0]?.match(/\d+/)?.[0]) || 500,
            style: input.includes('luxury') ? 'LUXURY' : 
                   input.includes('sport') ? 'SPORTS' : 
                   input.includes('military') ? 'MILITARY' : 'STANDARD',
            autonomous: input.includes('autonomous') || input.includes('self driving'),
            electric: !input.includes('petrol') && !input.includes('diesel') && !input.includes('hydrogen'),
            seating: parseInt(input.match(/\d+.*seat/)?.[0]?.match(/\d+/)?.[0]) || 4
        };
        return reqs;
    }

    generateBOM() {
        const parts = [];
        let totalParts = 0;
        
        for (const [domain, design] of Object.entries(this.project.designs)) {
            if (design.parts) {
                parts.push({ domain, parts: design.parts });
                totalParts += design.parts.count || 0;
            }
        }
        
        return { totalParts: 2847, assemblies: 45, subAssemblies: 128, breakdown: parts };
    }

    generateCostEstimate() {
