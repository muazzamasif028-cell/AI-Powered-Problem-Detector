        // ============================================
        this.manufacturing = new ManufacturingGuide(this);
        
        // Project state
        this.project = null;
        this.currentStep = 0;
        this.totalSteps = 15;
    }

    /**
     * 🎤 Interactive AI Assistant — Natural Language Understanding
     */
    async processUserInput(input) {
        console.log(`\n👤 User: "${input}"\n`);
        
        const lower = input.toLowerCase();
        
        // Detect vehicle type
        const vehicleType = this.detectVehicleType(lower);
        
        if (vehicleType) {
            return await this.startNewProject(vehicleType, input);
        }
        
        // Detect specific requests
        if (lower.includes('range') || lower.includes('km')) {
            const range = parseInt(lower.match(/\d+/)?.[0] || '500');
            this.project.requirements.range = range;
        }
        
        if (lower.includes('luxury')) {
            this.project.requirements.style = 'LUXURY';
        }
        
        if (lower.includes('sport') || lower.includes('sports')) {
            this.project.requirements.style = 'SPORTS';
        }
        
        if (lower.includes('military') || lower.includes('armored')) {
            this.project.requirements.style = 'MILITARY';
        }
        
        if (lower.includes('autonomous') || lower.includes('self driving')) {
            this.project.requirements.autonomous = true;
        }
        
        return await this.continueDesign();
    }

    /**
     * 🚀 Start New Engineering Project
     */
    async startNewProject(vehicleType, userInput) {
        console.log(`🧠 SUPREME Engineering AI: "Main is ${vehicleType} ke har part ko engineering standards ke mutabiq design karunga."\n`);
        
        this.project = {
            type: vehicleType,
            userInput,
            requirements: this.extractRequirements(userInput),
            designs: {},
            step: 0
        };
        
        this.currentStep = 0;
        
        // Step 1: Chassis
        return await this.nextStep();
    }

    /**
     * ⏭️ Continue to Next Engineering Step
     */
    async nextStep() {
        this.currentStep++;
        this.project.step = this.currentStep;
        
        const domainNames = Object.keys(this.domains);
        
        if (this.currentStep > domainNames.length) {
            return await this.finalizeProject();
        }
        
        const domainName = domainNames[this.currentStep - 1];
        const domain = this.domains[domainName];
        
        console.log(`\n${'='.repeat(60)}`);
        console.log(`🛠 STEP ${this.currentStep}/${this.totalSteps}: ${domain.name.toUpperCase()}`);
        console.log(`${'='.repeat(60)}\n`);
        
        // AI asks questions
        const questions = domain.askQuestions(this.project);
        
        // AI designs the component
        const design = await domain.design(this.project);
        
        // Store design
        this.project.designs[domainName] = design;
        
        // AI explains the design
        domain.explain(design);
        
        // AI suggests next step
        if (this.currentStep < this.totalSteps) {
            const nextDomain = Object.keys(this.domains)[this.currentStep];
            console.log(`\n➡️ Next: ${this.domains[nextDomain].name}`);
        }
        
        return {
            step: this.currentStep,
            totalSteps: this.totalSteps,
            domain: domainName,
            design,
            nextDomain: this.currentStep < this.totalSteps ? 
                Object.keys(this.domains)[this.currentStep] : null
        };
    }

    /**
     * 🏁 Finalize Project — Complete Manufacturing Guide
     */
    async finalizeProject() {
        console.log('\n' + '='.repeat(60));
        console.log('🏁 FINALIZING COMPLETE ENGINEERING PROJECT');
        console.log('='.repeat(60) + '\n');
        
        const manufacturingGuide = await this.manufacturing.generate(this.project);
        
        const summary = {
            project: this.project.type,
            requirements: this.project.requirements,
            designs: Object.keys(this.project.designs).length,
            totalSteps: this.totalSteps,
            manufacturing: manufacturingGuide,
            bom: this.generateBOM(),
            costEstimate: this.generateCostEstimate()
        };
        
        console.log('\n✅ COMPLETE ENGINEERING PROJECT READY!');
        console.log(`   Vehicle: ${this.project.type}`);
        console.log(`   Domains Designed: ${Object.keys(this.project.designs).length}/15`);
        console.log(`   Manufacturing Steps: ${manufacturingGuide.steps.length}`);
        console.log(`   Estimated Cost: ${summary.costEstimate.total}\n`);
        
        return summary;
    }

