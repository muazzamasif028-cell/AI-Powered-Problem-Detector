        if (!company) {
            return {
                allowed: false,
                reason: 'UNKNOWN COMPANY DNA',
                action: 'BLOCK + INVESTIGATE'
            };
        }

        const [companyName, companyData] = company;

        // Check if function is allowed
        const isAllowed = companyData.allowedFunctions.some(f => 
            requestedFunction.toUpperCase().includes(f)
        );

        // Check if function is forbidden
        const isForbidden = companyData.forbiddenFunctions.some(f => 
            requestedFunction.toUpperCase().includes(f)
        );

        if (isForbidden) {
            console.log(`🚫 [ISOLATION] ${companyName} tried FORBIDDEN: ${requestedFunction}`);
            return {
                allowed: false,
                reason: `FORBIDDEN — ${companyName} cannot perform ${requestedFunction}`,
                action: 'BLOCKED + CEO ALERTED + SECURITY LOGGED',
                company: companyName,
                dna: companyDNA,
                violation: 'CROSS_COMPANY_FUNCTION'
            };
        }

        if (!isAllowed) {
            console.log(`⚠️ [ISOLATION] ${companyName} tried UNKNOWN: ${requestedFunction}`);
            return {
                allowed: false,
                reason: `NOT IN ALLOWED LIST — ${companyName} can only: ${companyData.allowedFunctions.join(', ')}`,
                action: 'BLOCKED + ADMIN NOTIFIED',
                company: companyName
            };
        }

        console.log(`✅ [ISOLATION] ${companyName} allowed: ${requestedFunction}`);
        return {
            allowed: true,
            company: companyName,
            function: requestedFunction,
            isolationLevel: companyData.isolationLevel
        };
    }

