{
  "name": "supreme-planetary-os",
  "version": "11.0.0",
  "description": "SUPREME Planetary Operating System — AI + Cloud + Developer + Business Ecosystem with Production Authentication",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:auth": "nodemon src/auth/server.js",
    "cluster": "node cluster.js",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:build": "docker build -t supreme-os .",
    "docker:build:auth": "docker build -t supreme-auth -f Dockerfile.auth .",
    "docker:run": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "k8s:deploy": "kubectl apply -f kubernetes/",
    "k8s:deploy:auth": "kubectl apply -f kubernetes/auth/",
    "migrate": "node scripts/migrate.js",
    "migrate:auth": "node scripts/migrate-auth.js",
    "seed": "node scripts/seed.js",
    "seed:auth": "node scripts/seed-auth.js",
    "backup": "node scripts/backup.sh",
    "backup:auth": "node scripts/backup-auth.sh",
    "restore": "node scripts/restore.js",
    "db:reset": "npm run migrate && npm run seed",
    "generate:docs": "swagger-jsdoc -d swagger.yaml -o swagger.json",
    "security:audit": "npm audit --audit-level=high",
    "prepare": "husky install"
  },
  "dependencies": {
