    "sharp": "^0.33.2",
    "pdfkit": "^0.14.0",
    "nodemailer": "^6.9.8",
    "twilio": "^4.21.0",
    "stripe": "^14.14.0",
    "paypal-rest-sdk": "^1.8.1",
    "crypto-js": "^4.2.0",
