{
  "name": "supreme-problem-detector",
  "version": "7.0.0",
  "description": "Supreme Problem Detector — AI-Powered Platform with 7000+ Languages, 2.5T Nodes, 5.9B Layers, 500B Components, Satellite Control, Quantum-Safe Security, and Self-Learning AI",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "debug": "node --inspect server.js",
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write '**/*.js'",
    "format:check": "prettier --check '**/*.js'",
    "build": "npm run clean && npm run bundle",
    "clean": "rm -rf dist/",
    "bundle": "webpack --config webpack.config.js --mode production",
    "docker:build": "docker build -t supreme-platform:v7.0.0 .",
    "docker:run": "docker run -p 5000:5000 --env-file .env supreme-platform:v7.0.0",
    "docker:compose": "docker-compose up -d",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:backup": "node scripts/backup.js",
    "deploy": "node scripts/deploy.js",
    "monitor": "node scripts/monitor.js",
    "health": "curl http://localhost:5000/api/health",
    "docs": "jsdoc -c jsdoc.json",
    "release": "standard-version",
    "prepare": "husky install"
  },
  "keywords": [
    "problem-detector",
    "ai-diagnostics",
    "root-cause-analysis",
    "automated-fix",
    "satellite-control",
    "quantum-safe",
    "self-learning",
    "enterprise",
    "infrastructure-monitoring",
    "smart-city",
    "supreme"
  ],
  "author": {
    "name": "Supreme Technologies",
    "email": "supreme@admin.com",
    "url": "https://supreme-platform.com"
  },
  "contributors": [
    {
      "name": "Supreme Controller",
      "email": "controller@supreme-platform.com",
      "role": "Lead Architect"
    }
  ],
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/supreme-technologies/supreme-problem-detector.git"
  },
  "bugs": {
    "url": "https://github.com/supreme-technologies/supreme-problem-detector/issues",
    "email": "support@supreme-platform.com"
  },
  "homepage": "https://supreme-platform.com",

  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.4",
    "express-session": "^1.17.3",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0",
    "crypto-js": "^4.2.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "mongoose": "^8.0.3",
    "redis": "^4.6.11",
    "winston": "^3.11.0",
    "morgan": "^1.10.0",
    "joi": "^17.11.0",
    "axios": "^1.6.2",
    "node-cron": "^3.0.3",
    "socket.io": "^4.7.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "stripe": "^14.9.0",
    "puppeteer": "^21.6.1",
    "cheerio": "^1.0.0-rc.12",
    "chart.js": "^4.4.1",
    "pdfkit": "^0.13.0",
    "csv-parse": "^5.5.2",
    "xml2js": "^0.6.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.1.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "standard-version": "^9.5.0",
    "jsdoc": "^4.0.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0",
    "babel-jest": "^29.7.0",
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "docker-compose": "^0.23.19",
    "artillery": "^2.0.4",
    "madge": "^6.1.0",
    "dependency-cruiser": "^15.5.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "./coverage",
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!dist/**",
      "!coverage/**",
      "!scripts/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/coverage/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "globalTeardown": "<rootDir>/tests/teardown.js"
  },
  "eslintConfig": {
    "extends": "airbnb-base",
    "env": {
      "node": true,
      "jest": true,
      "es2024": true
    },
    "rules": {
      "no-console": "off",
      "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
      "max-len": ["error", { "code": 120 }],
      "no-param-reassign": "off",
      "consistent-return": "off"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "printWidth": 120,
    "trailingComma": "none",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "endOfLine": "lf"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version"]
  }
}
