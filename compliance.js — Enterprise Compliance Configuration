    getDataResidencyOptions: (country) => {
        const region = Object.entries(complianceConfig.dataResidency.regions)
            .find(([key, value]) => value.dataCenters.some(dc => dc.includes(country?.toLowerCase())));
        
        return region ? {
            region: region[0],
            dataCenters: region[1].dataCenters,
            regulations: region[1].regulations,
            dataLocalizationRequired: complianceConfig.dataResidency.dataLocalizationRequired.includes(country)
        } : {
            region: complianceConfig.dataResidency.defaultRegion,
            dataCenters: ['us-east-1']
        };
