<!-- Workspace Status Bar -->
<div class="workspace-status-bar">
    <div class="status-item" title="Auto-save status">
        <span class="status-dot" id="saveStatusDot" style="background:#3fb950;"></span>
        <span id="saveStatusText">All changes saved</span>
    </div>
    <div class="status-item" title="Last saved">
        <span>💾</span>
        <span id="lastSavedTime">Just now</span>
    </div>
    <div class="status-item" title="Connected devices">
        <span>🔗</span>
        <span id="connectedDevices">1 device</span>
    </div>
    <div class="status-item" title="Workspace uptime">
        <span>⏱️</span>
        <span id="workspaceUptime">0h 0m</span>
    </div>
</div>

<script>
    // Update save status every 3 seconds
    setInterval(async () => {
        const res = await fetch('/api/workspace/current');
        const data = await res.json();
        
        if (data.success && data.workspace) {
            const ws = data.workspace;
            
            // Update last saved
            const lastSaved = new Date(ws.metadata?.lastSaved);
            const secondsAgo = Math.floor((Date.now() - lastSaved) / 1000);
            
            document.getElementById('saveStatusText').textContent = 
                secondsAgo < 5 ? 'All changes saved' : 
                secondsAgo < 30 ? 'Saving...' : 'Saved ' + secondsAgo + 's ago';
            
            document.getElementById('saveStatusDot').style.background = 
                secondsAgo < 10 ? '#3fb950' : secondsAgo < 30 ? '#d29922' : '#f85149';
            
            document.getElementById('lastSavedTime').textContent = 
                secondsAgo < 60 ? 'Just now' : 
                secondsAgo < 3600 ? Math.floor(secondsAgo / 60) + 'm ago' : 
                Math.floor(secondsAgo / 3600) + 'h ago';
            
            // Update uptime
            const uptime = ws.metadata?.totalUptime || 0;
            const h = Math.floor(uptime / 3600);
            const m = Math.floor((uptime % 3600) / 60);
            document.getElementById('workspaceUptime').textContent = `${h}h ${m}m`;
        }
    }, 3000);
</script>

<style>
    .workspace-status-bar {
        display: flex;
        gap: 20px;
        padding: 8px 16px;
        background: rgba(15, 23, 42, 0.9);
        border-bottom: 1px solid rgba(71, 85, 105, 0.3);
        font-size: 12px;
        color: #94a3b8;
    }
    .status-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        transition: background 0.3s;
    }
</style>
