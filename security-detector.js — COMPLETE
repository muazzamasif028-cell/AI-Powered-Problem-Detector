    // =============================================
    // DETECT ALL SECURITY PROBLEMS
    // =============================================
    async detectAll(systemMetrics = {}) {
        const scanId = 'SEC-' + Date.now().toString(36) + '-' + 
                      Math.random().toString(36).substr(2, 8).toUpperCase();
        
        const startTime = performance.now();
        
        console.log(`🤫 [SECURITY]: ${scanId} — Full security scan started`);

        const results = {};
        
        for (let [problemKey, problemConfig] of Object.entries(this.problems)) {
            const result = this.detectProblem(problemKey, problemConfig, systemMetrics);
            results[problemKey] = result;
            
            this.problemStatus[problemKey].lastChecked = new Date().toISOString();
            this.problemStatus[problemKey].detectionCount++;
            
            if (result.detected) {
                this.problemStatus[problemKey].status = result.severity;
                this.state.threatsFound++;
                
                if (result.severity === 'CRITICAL') {
                    this.state.criticalCount++;
                    this.problemStatus[problemKey].incidents.push({
                        timestamp: new Date().toISOString(),
                        severity: 'CRITICAL',
                        value: result.currentValue
                    });
                    
                    // Auto-block if emergency
                    if (result.currentValue >= problemConfig.thresholds.emergency) {
                        this.autoBlock(result);
                    }
                }
                if (result.severity === 'WARNING') this.state.warningCount++;
            } else {
                this.problemStatus[problemKey].status = 'SECURE';
            }
        }

        this.state.totalScans++;
        this.updateSecurityScore(results);

        const summary = this.generateSummary(results);
        
        const scanResult = {
            scanId,
            timestamp: new Date().toISOString(),
            results,
            summary,
            securityScore: this.state.securityScore,
            blockedIPs: this.blockedIPs.size,
            threatIntel: this.threatIntelligence.slice(-5),
            processingTime_ms: (performance.now() - startTime).toFixed(2)
        };

        this.incidents.push(scanResult);
        if (this.incidents.length > this.maxIncidents) {
            this.incidents.shift();
        }

        console.log(`🤫 [SECURITY]: ${scanId} — ${summary.problemsDetected} threats found | Score: ${this.state.securityScore}/100`);

        return scanResult;
    }

