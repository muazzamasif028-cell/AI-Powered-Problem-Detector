            ip: threatIP,
            threat: result.problemName,
            severity: result.severity,
            blockedAt: new Date().toISOString(),
            autoBlocked: true
        });
        
        console.log(`🤫 [SECURITY]: Auto-blocked ${threatIP} — ${result.problemName}`);
    }

    // =============================================
    // SCAN INPUT FOR ATTACK SIGNATURES
    // =============================================
    scanForAttacks(input) {
        const detectedAttacks = [];
        const inputStr = typeof input === 'string' ? input : JSON.stringify(input);
        
        for (let [attackType, signatures] of Object.entries(this.attackSignatures)) {
            for (let signature of signatures) {
                if (inputStr.toLowerCase().includes(signature.toLowerCase())) {
                    detectedAttacks.push({
                        type: attackType,
                        signature: signature,
                        confidence: 0.95
                    });
                    break;
                }
            }
        }
        
        return {
            attacksDetected: detectedAttacks.length,
            attacks: detectedAttacks,
            safe: detectedAttacks.length === 0
        };
    }

    // =============================================
    // GET PROBLEM METRICS
    // =============================================
    getProblemMetrics(problemKey, systemMetrics) {
        const defaultMetrics = {
            failed_attempts: Math.floor(Math.random() * 25),
            unauthorized_count: Math.floor(Math.random() * 6),
            sqli_attempts: Math.floor(Math.random() * 12),
            xss_attempts: Math.floor(Math.random() * 25),
            request_rate: Math.floor(Math.random() * 12000),
            ports_scanned: Math.floor(Math.random() * 1200),
            days_since_disclosure: Math.floor(Math.random() * 40),
            weak_password_count: Math.floor(Math.random() * 12),
            exposed_keys: Math.floor(Math.random() * 6),
            unencrypted_percent: Math.floor(Math.random() * 35)
        };

        return { ...defaultMetrics, ...systemMetrics };
    }

    // =============================================
    // UPDATE SECURITY SCORE
    // =============================================
    updateSecurityScore(results) {
        let score = 100;
        
        Object.values(results).forEach(result => {
            if (result.detected) {
                if (result.severity === 'CRITICAL') score -= 15;
                else if (result.severity === 'WARNING') score -= 5;
            }
        });
        
        this.state.securityScore = Math.max(0, Math.min(100, score));
    }

    // =============================================
    // GET UNIT FOR PROBLEM
    // =============================================
    getUnit(problemKey) {
        const units = {
            FAILED_LOGIN_ATTEMPTS: 'attempts',
            UNAUTHORIZED_ACCESS: 'incidents',
            SQL_INJECTION: 'attempts',
            XSS_ATTEMPT: 'attempts',
            DDOS_ATTACK: 'req/sec',
            PORT_SCANNING: 'ports',
            KNOWN_VULNERABILITY: 'days',
            WEAK_PASSWORD: 'users',
            API_KEY_EXPOSED: 'keys',
            UNENCRYPTED_TRAFFIC: '%'
        };
        return units[problemKey] || '';
    }

    // =============================================
    // GENERATE SUMMARY
    // =============================================
    generateSummary(results) {
        const threatsDetected = Object.values(results).filter(r => r.detected);
        const criticals = threatsDetected.filter(r => r.severity === 'CRITICAL');
        const warnings = threatsDetected.filter(r => r.severity === 'WARNING');
        const secure = Object.values(results).filter(r => !r.detected);

        return {
            totalProblems: Object.keys(results).length,
            problemsDetected: threatsDetected.length,
            criticalCount: criticals.length,
            warningCount: warnings.length,
            secureCount: secure.length,
            securityScore: this.state.securityScore + '/100',
            criticalThreats: criticals.map(r => r.problemName),
            warningThreats: warnings.map(r => r.problemName),
            overallStatus: criticals.length > 0 ? 'CRITICAL' : 
                          warnings.length > 0 ? 'WARNING' : 'SECURE'
        };
    }

    // =============================================
    // GET ALL PROBLEMS STATUS TABLE
    // =============================================
    getProblemsTable() {
        const table = [];
        
        for (let [key, status] of Object.entries(this.problemStatus)) {
            const config = this.problems[key];
            table.push({
                number: config.id.replace('SEC-', ''),
                problem: config.name,
                category: config.category,
                severity: config.severity,
                status: status.status,
                statusIcon: this.getStatusIcon(status.status),
                lastChecked: status.lastChecked,
                detectionCount: status.detectionCount,
                incidents: status.incidents.length,
                resolved: status.resolved
            });
        }

        return table;
    }

    // =============================================
    // GET STATUS ICON
    // =============================================
    getStatusIcon(status) {
        const icons = {
            'SECURE': '✅',
            'PENDING': '⏳',
            'WARNING': '⚠️',
            'CRITICAL': '🚨',
            'RESOLVED': '✔️',
            'BLOCKED': '🛡️'
        };
        return icons[status] || '❓';
    }

    // =============================================
    // FORMAT FOR CHAT DISPLAY
    // =============================================
    formatForChat(scanResult) {
        const { results, summary } = scanResult;
        
        let html = `
        <div style="background:rgba(26,26,46,0.6);border:1px solid rgba(255,215,0,0.3);border-radius:12px;padding:14px;font-family:'Courier New',monospace;font-size:0.8em;">
        <div style="color:#ffd700;font-weight:700;margin-bottom:10px;">
        🟨 SECURITY DIAGNOSTIC — ${scanResult.scanId}
        </div>
        <div style="color:rgba(255,255,255,0.5);font-size:0.7em;margin-bottom:4px;">
        Security Score: <span style="color:${this.state.securityScore >= 80 ? '#3fb950' : this.state.securityScore >= 50 ? '#f0883e' : '#da3633'};font-weight:700;">${this.state.securityScore}/100</span>
        </div>
        <div style="color:rgba(255,255,255,0.5);font-size:0.7em;margin-bottom:8px;">
        Threats: ${summary.problemsDetected}/${summary.totalProblems} | Critical: ${summary.criticalCount} | Blocked IPs: ${this.blockedIPs.size}
        </div>
        <table style="width:100%;border-collapse:collapse;color:#e0e0e0;">
        <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
        <th style="text-align:left;padding:4px;">#</th>
        <th style="text-align:left;padding:4px;">Threat</th>
        <th style="text-align:left;padding:4px;">Status</th>
        <th style="text-align:left;padding:4px;">Value</th>
        </tr>`;

        Object.entries(results).forEach(([key, result], index) => {
            const statusColor = result.severity === 'CRITICAL' ? '#da3633' : 
                               result.severity === 'WARNING' ? '#f0883e' : '#3fb950';
            const statusIcon = result.detected ? (result.severity === 'CRITICAL' ? '🚨' : '⚠️') : '✅';
            const blockedBadge = result.autoBlocked ? ' 🛡️' : '';
            
            html += `
            <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
            <td style="padding:4px;">${index + 1}</td>
            <td style="padding:4px;">${result.problemName}</td>
            <td style="padding:4px;color:${statusColor};">${statusIcon} ${result.severity}${blockedBadge}</td>
            <td style="padding:4px;">${result.currentValue} ${result.unit}</td>
            </tr>`;
        });

        html += `
        </table>
        <div style="margin-top:10px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.1);text-align:center;font-weight:700;color:${
            summary.overallStatus === 'SECURE' ? '#3fb950' : 
            summary.overallStatus === 'WARNING' ? '#f0883e' : '#da3633'
        };">
        ${summary.overallStatus === 'SECURE' ? '✅ ALL SYSTEMS SECURE' : 
          summary.overallStatus === 'WARNING' ? '⚠️ SECURITY ISSUES DETECTED' : 
          '🚨 CRITICAL SECURITY THREATS — IMMEDIATE ACTION REQUIRED'}
        </div>
        </div>`;

        return html;
    }

    // =============================================
    // SYSTEM STATUS
    // =============================================
    getStatus() {
        return {
            initialized: this.state.initialized,
            totalScans: this.state.totalScans,
            threatsFound: this.state.threatsFound,
            threatsBlocked: this.state.threatsBlocked,
            criticalCount: this.state.criticalCount,
            warningCount: this.state.warningCount,
            securityScore: this.state.securityScore + '/100',
            blockedIPs: this.blockedIPs.size,
            problemTable: this.getProblemsTable(),
            timestamp: new Date().toISOString()
        };
    }

    // =============================================
    // RESET
    // =============================================
    reset() {
        this.incidents = [];
        this.blockedIPs.clear();
        this.ipThreatScores.clear();
        this.threatIntelligence = [];
        this.state.totalScans = 0;
        this.state.threatsFound = 0;
        this.state.threatsBlocked = 0;
        this.state.criticalCount = 0;
        this.state.warningCount = 0;
        this.state.securityScore = 100;
        
        Object.keys(this.problemStatus).forEach(key => {
            this.problemStatus[key] = {
                status: 'PENDING',
                lastChecked: null,
                detectionCount: 0,
                severity: this.problems[key].severity,
                resolved: false,
                incidents: []
            };
        });

        return { status: 'RESET', timestamp: new Date().toISOString() };
    }
}

