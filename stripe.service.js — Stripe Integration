const stripe = require('stripe')(process.env.STRIPE_SECRET_KEY);
const Domain = require('../../models/Domain');
const Transaction = require('../../models/Transaction');

class StripeService {
    constructor() {
        this.webhookSecret = process.env.STRIPE_WEBHOOK_SECRET;
        this.products = new Map();
        this.prices = new Map();
        
        this.initializeProducts();
    }

    /**
     * Initialize Stripe products
     */
    async initializeProducts() {
        // Domain registration product
        await this.createOrGetProduct('domain_registration', 'Domain Registration', 
            'Register a domain name on SUPREME Planetary OS');
        
        // Platform plans
        await this.createOrGetProduct('platform_plan_starter', 'Starter Domain Plan', 
            'Basic domain management features');
        await this.createOrGetProduct('platform_plan_business', 'Business Domain Plan', 
            'Advanced domain management with priority support');
        await this.createOrGetProduct('platform_plan_enterprise', 'Enterprise Domain Plan', 
            'Full enterprise domain suite with dedicated support');
        
        // Quantum addons
        await this.createOrGetProduct('quantum_business', 'Business Quantum Layer', 
            '8 Quantum Layers for enhanced security & performance');
        await this.createOrGetProduct('quantum_enterprise', 'Enterprise Quantum Layer', 
            '32 Quantum Layers for enterprise-grade infrastructure');
        await this.createOrGetProduct('quantum_sovereign', 'Sovereign Quantum Layer', 
            '256 Quantum Layers for government & critical infrastructure');
    }

    /**
     * Create or get existing product
     */
    async createOrGetProduct(productId, name, description) {
        try {
            // Check if product exists in metadata
            const products = await stripe.products.list({
                limit: 100,
                active: true
            });
            
            const existing = products.data.find(p => p.metadata.productId === productId);
            
            if (existing) {
                this.products.set(productId, existing);
                
                // Get associated price
                const prices = await stripe.prices.list({
                    product: existing.id,
                    active: true,
                    limit: 1
                });
                
                if (prices.data.length > 0) {
                    this.prices.set(productId, prices.data[0]);
                }
                
                return existing;
            }
            
            // Create new product
            const product = await stripe.products.create({
                name,
                description,
                metadata: { productId }
            });
            
            this.products.set(productId, product);
            return product;
            
        } catch (error) {
            console.error(`Stripe product error: ${error.message}`);
            return null;
        }
    }

    /**
     * Create checkout session for domain purchase
     */
    async createCheckoutSession(params) {
        const {
            userId,
            customerEmail,
            domain,
            tld,
            years = 1,
            plan = 'starter',
            quantumTier = 'standard',
            successUrl,
            cancelUrl,
            promoCode
        } = params;

        // Get pricing
        const pricingEngine = require('../pricing-engine.service');
        const price = pricingEngine.calculateTotalPrice({
            tld,
            plan,
            quantumTier,
            years,
            promoCode
        });

        // Build line items
        const lineItems = [];

        // Domain registration
        lineItems.push({
            price_data: {
                currency: 'usd',
                product_data: {
                    name: `Domain: ${domain}.${tld}`,
                    description: `${years} year(s) registration`,
                    metadata: { type: 'domain', tld, domain }
                },
                unit_amount: Math.round(price.pricing.tld.registerPrice * 100)
            },
            quantity: years
        });

        // Platform plan (if not free)
        if (price.pricing.plan.price > 0) {
            lineItems.push({
                price_data: {
                    currency: 'usd',
                    product_data: {
                        name: price.pricing.plan.name,
                        description: 'Platform management plan',
                        metadata: { type: 'plan', plan }
                    },
                    unit_amount: Math.round(price.pricing.plan.price * 100)
                },
                quantity: years
            });
        }

        // Quantum addon (if selected)
        if (price.pricing.quantum.price > 0) {
            lineItems.push({
                price_data: {
                    currency: 'usd',
                    product_data: {
                        name: price.pricing.quantum.name,
                        description: `${price.pricing.quantum.layers} Quantum Layers`,
                        metadata: { type: 'quantum', tier: quantumTier }
                    },
                    unit_amount: Math.round(price.pricing.quantum.price * 100)
                },
                quantity: years
            });
        }

        // Create Stripe session
        const session = await stripe.checkout.sessions.create({
            customer_email: customerEmail,
            client_reference_id: userId,
            mode: 'payment',
            success_url: `${successUrl}?session_id={CHECKOUT_SESSION_ID}`,
            cancel_url: cancelUrl,
            line_items: lineItems,
            discounts: promoCode ? [{
                coupon: promoCode // Must be created in Stripe dashboard first
            }] : [],
            metadata: {
                userId,
                domain: `${domain}.${tld}`,
                tld,
                years: years.toString(),
                plan,
                quantumTier,
                promoCode: promoCode || 'none'
            },
            payment_intent_data: {
                metadata: {
                    userId,
                    domain: `${domain}.${tld}`,
                    type: 'domain_purchase'
                }
            },
            allow_promotion_codes: true,
            billing_address_collection: 'required',
            tax_id_collection: { enabled: true }
        });

        return {
            sessionId: session.id,
            url: session.url,
            expiresAt: new Date(session.expires_at * 1000).toISOString()
        };
    }

    /**
     * Create subscription for recurring billing
     */
    async createSubscription(params) {
        const {
            customerId,
            priceId,
            quantity = 1,
            trialDays = 0,
            metadata = {}
        } = params;

        const subscription = await stripe.subscriptions.create({
            customer: customerId,
            items: [{ price: priceId, quantity }],
            trial_period_days: trialDays,
            metadata,
            payment_behavior: 'default_incomplete',
            expand: ['latest_invoice.payment_intent']
        });

        return subscription;
    }

    /**
     * Create customer
     */
    async createCustomer(params) {
        const { email, name, metadata = {} } = params;

        const customer = await stripe.customers.create({
            email,
            name,
            metadata
        });

        return customer;
    }

    /**
     * Handle Stripe webhook
     */
    async handleWebhook(signature, rawBody) {
        try {
            const event = stripe.webhooks.constructEvent(
                rawBody,
                signature,
                this.webhookSecret
            );

            switch (event.type) {
                case 'checkout.session.completed':
                    await this.handleCheckoutCompleted(event.data.object);
                    break;
                    
                case 'payment_intent.succeeded':
                    await this.handlePaymentSucceeded(event.data.object);
                    break;
                    
                case 'payment_intent.payment_failed':
                    await this.handlePaymentFailed(event.data.object);
                    break;
                    
                case 'charge.refunded':
                    await this.handleRefund(event.data.object);
                    break;
                    
                case 'customer.subscription.created':
                    await this.handleSubscriptionCreated(event.data.object);
                    break;
                    
                case 'customer.subscription.deleted':
                    await this.handleSubscriptionCancelled(event.data.object);
                    break;
                    
                case 'invoice.paid':
                    await this.handleInvoicePaid(event.data.object);
                    break;
                    
                case 'invoice.payment_failed':
                    await this.handleInvoiceFailed(event.data.object);
                    break;
                    
                default:
                    console.log(`Unhandled event type: ${event.type}`);
            }

            return { received: true, type: event.type };
            
        } catch (error) {
            console.error('Webhook error:', error.message);
            throw error;
        }
    }

    /**
     * Handle successful checkout
     */
    async handleCheckoutCompleted(session) {
        console.log(`✅ Checkout completed: ${session.id}`);
        console.log(`   Domain: ${session.metadata.domain}`);
        console.log(`   Amount: $${(session.amount_total / 100).toFixed(2)}`);
        
        // Update transaction in database
        const transactionService = require('../transaction.service');
        const transaction = await transactionService.getTransactionBySessionId(session.id);
        
        if (transaction) {
            await transactionService.processPayment(transaction.id, {
                stripeSessionId: session.id,
                stripePaymentIntent: session.payment_intent,
                amount: session.amount_total / 100,
                currency: session.currency
            });
        }
    }

    /**
     * Handle successful payment
     */
    async handlePaymentSucceeded(paymentIntent) {
        console.log(`💳 Payment succeeded: ${paymentIntent.id}`);
        console.log(`   Amount: $${(paymentIntent.amount / 100).toFixed(2)}`);
        
        // Generate invoice receipt
        await this.generateReceipt(paymentIntent);
    }

    /**
     * Handle failed payment
     */
    async handlePaymentFailed(paymentIntent) {
        console.error(`❌ Payment failed: ${paymentIntent.id}`);
        console.error(`   Error: ${paymentIntent.last_payment_error?.message}`);
        
        // Notify customer
        // Send email notification
    }

    /**
     * Handle refund
     */
    async handleRefund(charge) {
        console.log(`↩️ Refund processed: ${charge.id}`);
        console.log(`   Amount: $${(charge.amount_refunded / 100).toFixed(2)}`);
    }

    /**
     * Handle subscription created
     */
    async handleSubscriptionCreated(subscription) {
        console.log(`📋 Subscription created: ${subscription.id}`);
        console.log(`   Customer: ${subscription.customer}`);
        console.log(`   Status: ${subscription.status}`);
    }

    /**
     * Handle subscription cancelled
     */
    async handleSubscriptionCancelled(subscription) {
        console.log(`❌ Subscription cancelled: ${subscription.id}`);
    }

    /**
     * Handle invoice paid
     */
    async handleInvoicePaid(invoice) {
        console.log(`📄 Invoice paid: ${invoice.id}`);
        console.log(`   Amount: $${(invoice.amount_paid / 100).toFixed(2)}`);
    }

    /**
     * Handle invoice failed
     */
    async handleInvoiceFailed(invoice) {
        console.error(`❌ Invoice failed: ${invoice.id}`);
    }

    /**
     * Generate receipt
     */
    async generateReceipt(paymentIntent) {
        // In production, generate PDF receipt and email to customer
        console.log(`📄 Receipt generated for payment: ${paymentIntent.id}`);
    }

    /**
     * Get customer by email
     */
    async getCustomerByEmail(email) {
        const customers = await stripe.customers.list({ email, limit: 1 });
        return customers.data[0] || null;
    }

    /**
     * Get payment methods for customer
     */
    async getPaymentMethods(customerId) {
        const methods = await stripe.paymentMethods.list({
            customer: customerId,
            type: 'card'
        });
        
        return methods.data.map(method => ({
            id: method.id,
            brand: method.card.brand,
            last4: method.card.last4,
            expMonth: method.card.exp_month,
            expYear: method.card.exp_year,
            isDefault: method.metadata.default === 'true'
        }));
    }
}

// Singleton
const stripeService = new StripeService();

module.exports = stripeService;
