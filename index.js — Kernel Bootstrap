const identityEngine = require('./engines/identity.engine');
const securityEngine = require('./engines/security.engine');
const aiEngine = require('./engines/ai.engine');
const eventEngine = require('./engines/event.engine');
const serviceEngine = require('./engines/service.engine');
const pluginEngine = require('./engines/plugin.engine');
const workflowEngine = require('./engines/workflow.engine');
const billingEngine = require('./engines/billing.engine');
const searchEngine = require('./engines/search.engine');
const storageEngine = require('./engines/storage.engine');
const computeEngine = require('./engines/compute.engine');
const networkEngine = require('./engines/network.engine');
const monitorEngine = require('./engines/monitor.engine');
const licenseEngine = require('./engines/license.engine');
const featureEngine = require('./engines/feature.engine');
const configEngine = require('./engines/config.engine');

class SupremeKernel {
    constructor(config = {}) {
        this.config = config;
        this.engines = new Map();
        this.status = 'initializing';
        this.startTime = null;
    }

    /**
     * Initialize all kernel engines
     */
    async initialize() {
        console.log('🔮 SUPREME Kernel initializing...');
        this.startTime = Date.now();
        
        // Initialize engines in dependency order
        const engineOrder = [
            { name: 'config', engine: configEngine },
            { name: 'event', engine: eventEngine },
            { name: 'security', engine: securityEngine },
            { name: 'identity', engine: identityEngine },
            { name: 'license', engine: licenseEngine },
            { name: 'feature', engine: featureEngine },
            { name: 'monitor', engine: monitorEngine },
            { name: 'network', engine: networkEngine },
            { name: 'storage', engine: storageEngine },
            { name: 'compute', engine: computeEngine },
            { name: 'search', engine: searchEngine },
            { name: 'billing', engine: billingEngine },
            { name: 'workflow', engine: workflowEngine },
            { name: 'ai', engine: aiEngine },
            { name: 'plugin', engine: pluginEngine },
            { name: 'service', engine: serviceEngine }
        ];
        
        for (const { name, engine } of engineOrder) {
            try {
                console.log(`  ⚙️  Initializing ${name} engine...`);
                this.engines.set(name, engine);
                eventEngine.publish('kernel:engine:initialized', { engine: name });
            } catch (error) {
                console.error(`  ❌ Failed to initialize ${name} engine: ${error.message}`);
                throw error;
            }
        }
        
        this.status = 'running';
        
        const bootTime = Date.now() - this.startTime;
        console.log(`✅ SUPREME Kernel ready (${bootTime}ms)`);
        
        eventEngine.publish('kernel:started', { 
            bootTime,
            engines: Array.from(this.engines.keys()),
            version: '13.0.0'
        });
        
        return this;
    }

    /**
     * Get engine by name
     */
    getEngine(name) {
        const engine = this.engines.get(name);
        if (!engine) {
            throw new Error(`Engine not found: ${name}`);
        }
        return engine;
    }

    /**
     * Graceful shutdown
     */
    async shutdown() {
        console.log('🔮 SUPREME Kernel shutting down...');
        this.status = 'shutting_down';
        
        eventEngine.publish('kernel:stopping');
        
        // Shutdown in reverse order
        const reverseOrder = Array.from(this.engines.keys()).reverse();
        
        for (const name of reverseOrder) {
            const engine = this.engines.get(name);
            if (engine.shutdown) {
                await engine.shutdown();
            }
        }
        
        this.status = 'stopped';
        console.log('✅ SUPREME Kernel stopped');
    }

    /**
     * Get kernel health
     */
    getHealth() {
        const engineStatus = {};
        
        for (const [name, engine] of this.engines) {
            engineStatus[name] = {
                status: engine.status || 'unknown',
                stats: engine.getStats ? engine.getStats() : {}
            };
        }
        
        return {
            status: this.status,
            uptime: Date.now() - this.startTime,
            version: '13.0.0',
            engines: engineStatus,
            memory: process.memoryUsage()
        };
    }
}

// Create and export kernel instance
const kernel = new SupremeKernel();

// Make globally available
global.kernel = kernel;
global.eventEngine = eventEngine;

module.exports = kernel;
