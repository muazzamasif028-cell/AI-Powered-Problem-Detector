    // =============================================
    // DETECT ALL PERFORMANCE PROBLEMS
    // =============================================
    async detectAll(systemMetrics = {}) {
        const scanId = 'PERF-' + Date.now().toString(36) + '-' + 
                      Math.random().toString(36).substr(2, 8).toUpperCase();
        
        const startTime = performance.now();
        
        console.log(`🤫 [PERFORMANCE]: ${scanId} — Full scan started`);

        const results = {};
        
        for (let [problemKey, problemConfig] of Object.entries(this.problems)) {
            const result = this.detectProblem(problemKey, problemConfig, systemMetrics);
            results[problemKey] = result;
            
            // Update status
            this.problemStatus[problemKey].lastChecked = new Date().toISOString();
            this.problemStatus[problemKey].detectionCount++;
            
            if (result.detected) {
                this.problemStatus[problemKey].status = result.severity;
                this.state.problemsFound++;
                
                if (result.severity === 'CRITICAL') this.state.criticalCount++;
                if (result.severity === 'WARNING') this.state.warningCount++;
            } else {
                this.problemStatus[problemKey].status = 'HEALTHY';
            }
        }

        this.state.totalScans++;

        const summary = this.generateSummary(results);
        
        const scanResult = {
            scanId,
            timestamp: new Date().toISOString(),
            results,
            summary,
            processingTime_ms: (performance.now() - startTime).toFixed(2)
        };

        this.detectionHistory.push(scanResult);
        if (this.detectionHistory.length > this.maxHistorySize) {
            this.detectionHistory.shift();
        }

        console.log(`🤫 [PERFORMANCE]: ${scanId} — ${summary.problemsDetected} problems found`);

        return scanResult;
    }

