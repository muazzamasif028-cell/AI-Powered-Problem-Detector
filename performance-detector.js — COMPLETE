    // =============================================
    // RESOLVE PROBLEM
    // =============================================
    resolveProblem(problemKey, solution) {
        if (!this.problemStatus[problemKey]) {
            return { error: 'Problem not found' };
        }

        this.problemStatus[problemKey].status = 'RESOLVED';
        this.problemStatus[problemKey].resolved = true;
        this.state.problemsResolved++;

        return {
            problem: this.problems[problemKey].name,
            status: 'RESOLVED',
            solution,
            timestamp: new Date().toISOString()
        };
    }

    // =============================================
    // GET PROBLEM DETAILS
    // =============================================
    getProblemDetails(problemKey) {
        if (!this.problems[problemKey]) {
            return { error: 'Problem not found' };
        }

        const config = this.problems[problemKey];
        const status = this.problemStatus[problemKey];

        return {
            ...config,
            status: status.status,
            lastChecked: status.lastChecked,
            detectionCount: status.detectionCount,
            resolved: status.resolved,
            allSolutions: config.solutions,
            autoFixSolutions: config.solutions.filter(s => s.autoFix),
            manualSolutions: config.solutions.filter(s => !s.autoFix)
        };
    }

    // =============================================
    // SYSTEM STATUS
    // =============================================
    getStatus() {
        return {
            initialized: this.state.initialized,
            totalScans: this.state.totalScans,
            problemsFound: this.state.problemsFound,
            problemsResolved: this.state.problemsResolved,
            criticalCount: this.state.criticalCount,
            warningCount: this.state.warningCount,
            problemTable: this.getProblemsTable(),
            categories: {
                CPU: this.getCategoryStatus('CPU'),
                MEMORY: this.getCategoryStatus('MEMORY'),
                DISK: this.getCategoryStatus('DISK'),
                NETWORK: this.getCategoryStatus('NETWORK'),
                DATABASE: this.getCategoryStatus('DATABASE')
            },
            timestamp: new Date().toISOString()
        };
    }

    // =============================================
    // GET CATEGORY STATUS
    // =============================================
    getCategoryStatus(category) {
        const categoryProblems = Object.entries(this.problems)
            .filter(([, config]) => config.category === category);
        
        const statuses = categoryProblems.map(([key]) => this.problemStatus[key]?.status);
        
        return {
            total: categoryProblems.length,
            healthy: statuses.filter(s => s === 'HEALTHY').length,
            warning: statuses.filter(s => s === 'WARNING').length,
            critical: statuses.filter(s => s === 'CRITICAL').length,
            pending: statuses.filter(s => s === 'PENDING').length,
            resolved: statuses.filter(s => s === 'RESOLVED').length
        };
    }

    // =============================================
    // FORMAT FOR CHAT DISPLAY
    // =============================================
    formatForChat(scanResult) {
        const { results, summary } = scanResult;
        
        let html = `
        <div style="background:rgba(26,26,46,0.6);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:14px;font-family:'Courier New',monospace;font-size:0.8em;">
        <div style="color:#e94560;font-weight:700;margin-bottom:10px;">
        🟥 PERFORMANCE DIAGNOSTIC — ${scanResult.scanId}
        </div>
        <div style="color:rgba(255,255,255,0.5);font-size:0.7em;margin-bottom:8px;">
        Health Score: ${summary.healthScore} | ${summary.problemsDetected}/${summary.totalProblems} issues
        </div>
        <table style="width:100%;border-collapse:collapse;color:#e0e0e0;">
        <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
        <th style="text-align:left;padding:4px;">#</th>
        <th style="text-align:left;padding:4px;">Problem</th>
        <th style="text-align:left;padding:4px;">Status</th>
        <th style="text-align:left;padding:4px;">Value</th>
        </tr>`;

        Object.entries(results).forEach(([key, result], index) => {
            const statusColor = result.severity === 'CRITICAL' ? '#da3633' : 
                               result.severity === 'WARNING' ? '#f0883e' : '#3fb950';
            const statusIcon = result.detected ? (result.severity === 'CRITICAL' ? '🚨' : '⚠️') : '✅';
            
            html += `
            <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
            <td style="padding:4px;">${index + 1}</td>
            <td style="padding:4px;">${result.problemName}</td>
            <td style="padding:4px;color:${statusColor};">${statusIcon} ${result.severity}</td>
            <td style="padding:4px;">${result.currentValue}${result.unit}</td>
            </tr>`;
        });

        html += `
        </table>
        <div style="margin-top:10px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.1);text-align:center;font-weight:700;color:${
            summary.overallStatus === 'CRITICAL' ? '#da3633' : 
            summary.overallStatus === 'WARNING' ? '#f0883e' : '#3fb950'
        };">
        ${summary.overallStatus === 'HEALTHY' ? '✅ ALL SYSTEMS OPTIMAL' : 
          summary.overallStatus === 'WARNING' ? '⚠️ PERFORMANCE ISSUES DETECTED' : 
          '🚨 CRITICAL PERFORMANCE PROBLEMS'}
        </div>
        </div>`;

        return html;
    }

    // =============================================
    // RESET
    // =============================================
    reset() {
        this.detectionHistory = [];
        this.state.totalScans = 0;
        this.state.problemsFound = 0;
        this.state.problemsResolved = 0;
        this.state.criticalCount = 0;
        this.state.warningCount = 0;
        
        Object.keys(this.problemStatus).forEach(key => {
            this.problemStatus[key] = {
                status: 'PENDING',
                lastChecked: null,
                detectionCount: 0,
                severity: this.problems[key].severity,
                resolved: false
            };
        });

        return { status: 'RESET', timestamp: new Date().toISOString() };
    }
}

