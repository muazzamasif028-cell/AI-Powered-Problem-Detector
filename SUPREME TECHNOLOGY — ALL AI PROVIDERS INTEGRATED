    <style>
        :root {
            --bg-deep: #050510;
            --bg-card: #0a0a1a;
            --bg-input: #0d0d25;
            --accent: #e94560;
            --accent-glow: #ff6b81;
            --gold: #f0c040;
            --text: #e0e0e0;
            --text-dim: #777;
            --border: rgba(255,255,255,0.06);
            --success: #00c853;
            --openai: #10a37f;
            --anthropic: #d97757;
            --google: #4285f4;
            --meta: #0668e1;
            --deepseek: #4d6bfe;
            --xai: #ffffff;
            --mistral: #facc15;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg-deep);
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ========== TOP NAV ========== */
        .top-nav {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            padding: 12px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-logo { display: flex; align-items: center; gap: 10px; }
        .logo-icon {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, var(--accent), var(--gold));
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px;
        }
        .logo-text { font-size: 13px; font-weight: 700; letter-spacing: 1px; }
        .logo-text span { font-size: 9px; color: var(--text-dim); letter-spacing: 3px; display: block; }

        .nav-links { display: flex; gap: 20px; align-items: center; }
        .nav-link {
            color: var(--text-dim); text-decoration: none;
            font-size: 12px; cursor: pointer; transition: all 0.3s;
            padding: 6px 0; border-bottom: 2px solid transparent;
        }
        .nav-link:hover { color: var(--text); }
        .nav-link.active { color: var(--accent); border-bottom-color: var(--accent); }

        .nav-btn {
            padding: 8px 18px;
            background: linear-gradient(135deg, var(--accent), var(--accent-glow));
            border: none; border-radius: 20px;
            color: white; font-size: 12px; font-weight: 600;
            cursor: pointer; transition: all 0.3s;
        }
        .nav-btn:hover { transform: scale(1.03); box-shadow: 0 6px 20px rgba(233,69,96,0.3); }

        /* ========== SECTION CONTROL ========== */
        .section { display: none; }
        .section.active { display: block; }

        /* ========== HERO ========== */
        .hero {
            text-align: center; padding: 40px 30px;
            background: radial-gradient(ellipse at center, rgba(233,69,96,0.06) 0%, transparent 70%);
        }
        .hero h1 {
            font-size: 36px; font-weight: 800; letter-spacing: -1px;
            margin-bottom: 12px;
            background: linear-gradient(135deg, #fff, var(--gold));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero p { font-size: 14px; color: var(--text-dim); max-width: 700px; margin: 0 auto 20px; }

        /* ========== PROVIDER GRID ========== */
        .providers-section { padding: 30px; max-width: 1600px; margin: 0 auto; }

        .provider-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
            gap: 20px;
        }

        .provider-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.3s;
        }
        .provider-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.4);
        }

        .provider-header {
            padding: 20px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border);
        }

        .provider-logo {
            display: flex; align-items: center; gap: 12px;
        }

        .provider-icon {
            width: 44px; height: 44px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; font-weight: 700;
        }

        .provider-name { font-size: 15px; font-weight: 700; }
        .provider-family { font-size: 11px; color: var(--text-dim); margin-top: 2px; }

        .provider-status {
            display: flex; align-items: center; gap: 6px;
            font-size: 10px; letter-spacing: 1px;
            padding: 5px 12px; border-radius: 12px;
            font-weight: 600;
        }
        .status-connected { background: rgba(0,200,83,0.12); color: var(--success); }
        .status-available { background: rgba(240,192,64,0.12); color: var(--gold); }

        .provider-body { padding: 20px 24px; }
        .provider-strength {
            font-size: 12px; color: var(--text-dim);
            margin-bottom: 16px; padding: 10px 14px;
            background: var(--bg-input); border-radius: 8px;
            line-height: 1.5;
        }

        .model-list {
            display: flex; flex-direction: column; gap: 6px;
            margin-bottom: 16px;
        }

        .model-item {
            display: flex; align-items: center; justify-content: space-between;
            padding: 8px 12px;
            background: var(--bg-input);
            border-radius: 8px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
            border: 1px solid transparent;
        }
        .model-item:hover { border-color: rgba(255,255,255,0.1); background: rgba(255,255,255,0.03); }
        .model-item.selected { border-color: var(--accent); background: rgba(233,69,96,0.08); }

        .model-name { font-weight: 500; }
        .model-tier {
            font-size: 9px; padding: 2px 8px; border-radius: 8px;
            letter-spacing: 0.5px;
        }
        .tier-flagship { background: rgba(233,69,96,0.2); color: var(--accent); }
        .tier-reasoning { background: rgba(240,192,64,0.2); color: var(--gold); }
        .tier-production { background: rgba(0,200,83,0.2); color: var(--success); }
        .tier-budget { background: rgba(41,121,255,0.2); color: #4285f4; }

        .provider-footer {
            padding: 16px 24px;
            border-top: 1px solid var(--border);
            display: flex; gap: 10px;
        }

        .btn {
            flex: 1; padding: 10px 16px;
            border-radius: 10px; font-size: 12px;
            font-weight: 600; cursor: pointer;
            transition: all 0.3s; text-align: center;
            letter-spacing: 0.5px;
        }
        .btn-connect {
            background: var(--accent); color: white;
            border: none;
        }
        .btn-connect:hover { background: var(--accent-glow); }
        .btn-configure {
            background: transparent; color: var(--text);
            border: 1px solid var(--border);
        }
        .btn-configure:hover { background: rgba(255,255,255,0.03); }

        /* ========== CHAT INTERFACE ========== */
        .chat-section { padding: 30px; max-width: 900px; margin: 0 auto; }
        .chat-container {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
        }
        .chat-header {
            padding: 16px 24px;
            border-bottom: 1px solid var(--border);
            display: flex; align-items: center; justify-content: space-between;
        }
        .chat-provider-select {
            display: flex; gap: 8px; flex-wrap: wrap;
        }
        .chat-provider-chip {
            padding: 6px 12px; border-radius: 16px;
            font-size: 10px; font-weight: 600;
            cursor: pointer; transition: all 0.3s;
            border: 1px solid var(--border);
            background: transparent; color: var(--text-dim);
        }
        .chat-provider-chip:hover { border-color: rgba(255,255,255,0.2); }
        .chat-provider-chip.active { background: var(--accent); color: white; border-color: var(--accent); }

        .chat-messages {
            height: 400px; overflow-y: auto; padding: 20px;
            display: flex; flex-direction: column; gap: 12px;
        }
        .chat-message {
            max-width: 80%; padding: 12px 16px;
            border-radius: 14px; font-size: 13px; line-height: 1.5;
        }
        .chat-message.user {
            align-self: flex-end;
            background: var(--accent); color: white;
        }
        .chat-message.ai {
            align-self: flex-start;
            background: var(--bg-input); border: 1px solid var(--border);
        }
        .chat-message .provider-tag {
            font-size: 9px; opacity: 0.7; margin-bottom: 4px;
            letter-spacing: 1px;
        }

        .chat-input-area {
            padding: 16px 24px; border-top: 1px solid var(--border);
            display: flex; gap: 10px;
        }
        .chat-input {
            flex: 1; padding: 12px 16px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 12px; color: white;
            font-size: 13px; outline: none;
            font-family: inherit;
        }
        .chat-input:focus { border-color: var(--accent); }
        .chat-send {
            padding: 12px 20px;
            background: var(--accent); color: white;
            border: none; border-radius: 12px;
            cursor: pointer; font-weight: 600;
            transition: all 0.3s;
        }
        .chat-send:hover { background: var(--accent-glow); }

        /* ========== MODAL ========== */
        .modal-overlay {
            display: none; position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.8); z-index: 1000;
            justify-content: center; align-items: center;
        }
        .modal-overlay.show { display: flex; }
        .modal {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 20px; padding: 30px;
            max-width: 500px; width: 90%;
        }
        .modal h2 { font-size: 18px; margin-bottom: 16px; }
        .modal p { font-size: 13px; color: var(--text-dim); margin-bottom: 20px; line-height: 1.6; }
        .api-key-input {
            width: 100%; padding: 12px 16px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 10px; color: white;
            font-family: 'Courier New', monospace;
            font-size: 14px; margin-bottom: 16px;
            outline: none;
        }
        .api-key-input:focus { border-color: var(--accent); }

        /* ========== RESPONSIVE ========== */
        @media (max-width: 768px) {
            .provider-grid { grid-template-columns: 1fr; }
            .hero h1 { font-size: 24px; }
            .nav-links { display: none; }
        }
    </style>
</head>
