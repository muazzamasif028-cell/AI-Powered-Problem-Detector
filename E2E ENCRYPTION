const crypto = require('crypto');

class E2EEncryption {
    constructor(masterKey = null) {
        // Generate or use provided master key
        this.masterKey = masterKey || crypto.randomBytes(32);
        
        // Key rotation settings
        this.keyRotationInterval = 3600000; // 1 hour
        this.lastRotation = Date.now();
        this.sessionKeys = new Map();
        
        // Algorithm configuration
        this.algorithm = 'aes-256-gcm';
        this.keyLength = 32;
        this.ivLength = 16;
        this.tagLength = 16;
        this.saltLength = 64;
    }

    /**
     * Encrypt payload
     */
    async encrypt(data) {
        try {
            // Generate session key (or use existing)
            const sessionKey = this.getSessionKey();
            
            // Generate random IV
            const iv = crypto.randomBytes(this.ivLength);
            
            // Create cipher
            const cipher = crypto.createCipheriv(
                this.algorithm,
                sessionKey,
                iv
            );

            // Convert data to string
            const plaintext = JSON.stringify(data);
            
            // Encrypt
            let encrypted = cipher.update(plaintext, 'utf8', 'hex');
            encrypted += cipher.final('hex');
            
            // Get auth tag
            const authTag = cipher.getAuthTag();

            // Create envelope
            const envelope = {
                version: '14.0',
                algorithm: this.algorithm,
                iv: iv.toString('hex'),
                authTag: authTag.toString('hex'),
                keyId: this.getCurrentKeyId(),
                ciphertext: encrypted,
                timestamp: Date.now()
            };

            return envelope;

        } catch (error) {
            console.error('🔐 Encryption failed:', error);
            throw error;
        }
    }

    /**
     * Decrypt payload
     */
    async decrypt(envelope) {
        try {
            // Get session key by keyId
            const sessionKey = this.getSessionKey(envelope.keyId);
            
            // Create decipher
            const decipher = crypto.createDecipheriv(
                envelope.algorithm,
                sessionKey,
                Buffer.from(envelope.iv, 'hex')
            );

            // Set auth tag
            decipher.setAuthTag(Buffer.from(envelope.authTag, 'hex'));

            // Decrypt
            let decrypted = decipher.update(envelope.ciphertext, 'hex', 'utf8');
            decrypted += decipher.final('utf8');

            return JSON.parse(decrypted);

        } catch (error) {
            console.error('🔐 Decryption failed:', error);
            throw new Error('Decryption failed: Invalid key or tampered data');
        }
    }

    /**
     * Get or generate session key
     */
    getSessionKey(keyId = null) {
        // Check if we need to rotate keys
        this.checkKeyRotation();

        if (keyId && this.sessionKeys.has(keyId)) {
            return this.sessionKeys.get(keyId);
        }

        // Generate new session key
        const newKeyId = this.generateKeyId();
        const sessionKey = this.deriveKey(this.masterKey, newKeyId);
        
        this.sessionKeys.set(newKeyId, sessionKey);
        
        return sessionKey;
    }

    /**
     * Derive key using HKDF
     */
    deriveKey(masterKey, keyId) {
        const salt = crypto.createHash('sha256')
            .update(keyId)
            .digest();
        
        return crypto.hkdfSync(
            'sha512',
            masterKey,
            salt,
            `SUPREME-TELEMETRY-${keyId}`,
            this.keyLength
        );
    }

    /**
     * Check and perform key rotation
     */
    checkKeyRotation() {
        const now = Date.now();
        if (now - this.lastRotation > this.keyRotationInterval) {
            this.rotateKeys();
        }
    }

    /**
     * Rotate encryption keys
     */
    rotateKeys() {
        console.log('🔄 [ENCRYPTION]: Rotating keys...');
        
        // Generate new master key
        const newMasterKey = crypto.randomBytes(32);
        
        // Keep old keys for decryption of in-flight messages
        const oldKeys = new Map(this.sessionKeys);
        
        // Update master key
        this.masterKey = newMasterKey;
        this.lastRotation = Date.now();
        
        // Clear old session keys after grace period
        setTimeout(() => {
            oldKeys.clear();
            console.log('🗑️ [ENCRYPTION]: Old keys cleared');
        }, 300000); // 5 minutes grace period
    }

    /**
     * Generate unique key ID
     */
    generateKeyId() {
        return `KEY_${Date.now()}_${crypto.randomBytes(8).toString('hex')}`;
    }

    /**
     * Get current key ID
     */
    getCurrentKeyId() {
        return Array.from(this.sessionKeys.keys()).pop() || this.generateKeyId();
    }

    /**
     * Get encryption status
     */
    getStatus() {
        return {
            algorithm: this.algorithm,
            keyLength: this.keyLength * 8, // bits
            activeKeys: this.sessionKeys.size,
            lastRotation: new Date(this.lastRotation).toISOString(),
            nextRotation: new Date(this.lastRotation + this.keyRotationInterval).toISOString()
        };
    }
}

module.exports = E2EEncryption;
