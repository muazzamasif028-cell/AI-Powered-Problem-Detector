class TruthEngine {
    constructor() {
        this.factDatabase = new Map();
        this.verificationSources = new Map();
        this.truthThreshold = 0.85;
        this.crossCheckCount = 3;
    }

    /**
     * Verify AI response against multiple sources
     */
    async verify(userId, query, response, provider) {
        const verificationResults = {
            originalResponse: response,
            provider,
            timestamp: new Date().toISOString(),
            checks: [],
            finalVerdict: 'unverified',
            confidenceScore: 0
        };

        // 1. Cross-check with other AI models
        const crossCheck = await this.crossCheckWithModels(query, response);
        verificationResults.checks.push(crossCheck);

        // 2. Check against internal knowledge base
        const kbCheck = await this.checkKnowledgeBase(query, response);
        verificationResults.checks.push(kbCheck);

        // 3. Check against documents
        const docCheck = await this.checkDocuments(userId, query, response);
        verificationResults.checks.push(docCheck);

        // 4. Check against APIs
        const apiCheck = await this.checkAPIs(query, response);
        verificationResults.checks.push(apiCheck);

        // 5. Fact consistency check
        const factCheck = await this.checkFacts(response);
        verificationResults.checks.push(factCheck);

        // 6. Source verification
        const sourceCheck = await this.verifySources(response);
        verificationResults.checks.push(sourceCheck);

        // Calculate overall confidence
        verificationResults.confidenceScore = this.calculateConfidence(verificationResults.checks);
        verificationResults.finalVerdict = this.determineVerdict(verificationResults.confidenceScore);

        // If confidence is low, get alternative response
        if (verificationResults.finalVerdict !== 'verified') {
            verificationResults.alternativeResponses = await this.getAlternativeResponses(query);
            verificationResults.disagreements = this.findDisagreements(verificationResults.checks);
        }

        return verificationResults;
    }

    /**
     * Cross-check with multiple AI models
     */
    async crossCheckWithModels(query, response) {
        const models = ['claude', 'gemini', 'perplexity'];
        const results = [];

        for (const model of models) {
            try {
                const altResponse = await this.queryModel(model, query);
                const similarity = this.calculateSimilarity(response, altResponse);
                
                results.push({
                    model,
                    agrees: similarity > this.truthThreshold,
                    similarity,
                    alternativeResponse: similarity < this.truthThreshold ? altResponse : null
                });
            } catch (error) {
                results.push({ model, error: error.message });
            }
        }

        const agreementRate = results.filter(r => r.agrees).length / results.length;

        return {
            type: 'cross_check',
            label: 'Multi-Model Verification',
            passed: agreementRate >= 0.66,
            score: agreementRate,
            details: results,
            message: agreementRate >= 0.66 
                ? `${Math.round(agreementRate * 100)}% of models agree`
                : 'Significant disagreement between models'
        };
    }

    /**
     * Check against internal knowledge base
     */
    async checkKnowledgeBase(query, response) {
        const kbResults = await this.searchKnowledgeBase(query);
        
        if (kbResults.length === 0) {
            return {
                type: 'knowledge_base',
                label: 'Knowledge Base Check',
                passed: null,
                score: 0.5,
                message: 'No relevant knowledge base entries found'
            };
        }

        const matches = kbResults.filter(kb => 
            this.calculateSimilarity(response, kb.content) > 0.7
        );

        return {
            type: 'knowledge_base',
            label: 'Knowledge Base Verification',
            passed: matches.length > 0,
            score: matches.length / kbResults.length,
            details: { totalEntries: kbResults.length, matches: matches.length },
            message: matches.length > 0 
                ? `Matches ${matches.length}/${kbResults.length} knowledge base entries`
                : 'No matching knowledge base entries'
        };
    }

    /**
     * Check against user documents
     */
    async checkDocuments(userId, query, response) {
        const docs = await this.getUserDocuments(userId);
        const relevantDocs = docs.filter(doc => 
            this.calculateSimilarity(query, doc.content) > 0.5
        );

        if (relevantDocs.length === 0) {
            return {
                type: 'documents',
                label: 'Document Verification',
                passed: null,
                score: 0.5,
                message: 'No relevant documents found'
            };
        }

        const matches = relevantDocs.filter(doc =>
            this.calculateSimilarity(response, doc.content) > 0.7
        );

        return {
            type: 'documents',
            label: 'Document Cross-Reference',
            passed: matches.length > 0,
            score: matches.length / relevantDocs.length,
            details: { documentsChecked: relevantDocs.length, matches: matches.length },
            message: `Verified against ${matches.length} documents`
        };
    }

    /**
     * Check against APIs
     */
    async checkAPIs(query, response) {
        const apis = ['weather-api', 'stock-api', 'news-api', 'fact-check-api'];
        const results = [];

        for (const api of apis) {
            try {
                const apiResponse = await this.queryAPI(api, query);
                if (apiResponse) {
                    results.push({
                        api,
                        verified: this.calculateSimilarity(response, apiResponse) > 0.8
                    });
                }
            } catch (error) {
                // API unavailable — skip
            }
        }

        return {
            type: 'api',
            label: 'API Verification',
            passed: results.length > 0,
            score: results.filter(r => r.verified).length / Math.max(results.length, 1),
            details: results,
            message: `Verified with ${results.filter(r => r.verified).length}/${results.length} APIs`
        };
    }

    /**
     * Check facts in response
     */
    async checkFacts(response) {
        const facts = this.extractFacts(response);
        const verifiedFacts = [];
        const unverifiedFacts = [];
        const falseFacts = [];

        for (const fact of facts) {
            const verification = await this.verifyFact(fact);
            
            if (verification.verified) {
                verifiedFacts.push({ fact, source: verification.source });
            } else if (verification.false) {
                falseFacts.push({ fact, correction: verification.correction });
            } else {
                unverifiedFacts.push({ fact });
            }
        }

        return {
            type: 'facts',
            label: 'Fact Verification',
            passed: falseFacts.length === 0,
            score: facts.length > 0 ? verifiedFacts.length / facts.length : 0.5,
            details: {
                total: facts.length,
                verified: verifiedFacts.length,
                unverified: unverifiedFacts.length,
                false: falseFacts.length
            },
            falseFacts,
            message: falseFacts.length > 0 
                ? `⚠️ Found ${falseFacts.length} incorrect facts`
                : `✅ ${verifiedFacts.length}/${facts.length} facts verified`
        };
    }

    /**
     * Verify sources cited in response
     */
    async verifySources(response) {
        const sources = this.extractSources(response);
        const verifiedSources = [];

        for (const source of sources) {
            const exists = await this.checkSourceExists(source);
            verifiedSources.push({
                source,
                exists,
                verified: exists,
                lastAccessed: exists ? new Date() : null
            });
        }

        return {
            type: 'sources',
            label: 'Source Verification',
            passed: verifiedSources.every(s => s.exists),
            score: verifiedSources.filter(s => s.exists).length / Math.max(sources.length, 1),
            details: verifiedSources,
            message: `${verifiedSources.filter(s => s.exists).length}/${sources.length} sources verified`
        };
    }

    /**
     * Extract facts from text
     */
    extractFacts(text) {
        // Extract sentences that contain factual claims
        const sentences = text.match(/[^.!?]+[.!?]+/g) || [];
        
        return sentences
            .filter(s => {
                const factIndicators = [
                    'is', 'are', 'was', 'were', 'has', 'have', 'had',
                    'contains', 'includes', 'consists', 'comprises',
                    'located', 'founded', 'established', 'created',
                    'released', 'published', 'announced', 'reported',
                    /\d+/, // Contains numbers
                    /\$\d+/, // Contains prices
                    /\d+%/, // Contains percentages
                ];
                return factIndicators.some(indicator => {
                    if (typeof indicator === 'string') return s.toLowerCase().includes(indicator);
                    return indicator.test(s);
                });
            })
            .map(s => s.trim());
    }

    /**
     * Extract sources from text
     */
    extractSources(text) {
        const sources = [];
        
        // URLs
        const urls = text.match(/https?:\/\/[^\s]+/g) || [];
        sources.push(...urls);

        // Named sources
        const namedSources = text.match(/(?:according to|source:|reference:|cited by|from)\s+([^,.]+)/gi) || [];
        sources.push(...namedSources.map(s => s.replace(/(?:according to|source:|reference:|cited by|from)\s+/i, '').trim()));

        return [...new Set(sources)];
    }

    /**
     * Get alternative responses from other models
     */
    async getAlternativeResponses(query) {
        const models = ['claude', 'gemini', 'perplexity'];
        const responses = [];

        for (const model of models) {
            try {
                const response = await this.queryModel(model, query);
                responses.push({ model, response });
            } catch (error) {
                // Skip failed models
            }
        }

        return responses;
    }

    /**
     * Find disagreements between checks
     */
    findDisagreements(checks) {
        return checks
            .filter(c => !c.passed && c.passed !== null)
            .map(c => ({
                type: c.type,
                label: c.label,
                message: c.message,
                details: c.details
            }));
    }

    /**
     * Calculate overall confidence
     */
    calculateConfidence(checks) {
        const validChecks = checks.filter(c => c.passed !== null);
        if (validChecks.length === 0) return 0.5;

        const weights = {
            'cross_check': 0.30,
            'knowledge_base': 0.15,
            'documents': 0.15,
            'api': 0.10,
            'facts': 0.20,
            'sources': 0.10
        };

        let weightedSum = 0;
        let totalWeight = 0;

        for (const check of validChecks) {
            const weight = weights[check.type] || 0.1;
            weightedSum += check.score * weight;
            totalWeight += weight;
        }

        return totalWeight > 0 ? weightedSum / totalWeight : 0.5;
    }

    /**
     * Determine final verdict
     */
    determineVerdict(confidence) {
        if (confidence >= 0.95) return 'verified';
        if (confidence >= 0.85) return 'likely_accurate';
        if (confidence >= 0.70) return 'needs_review';
        if (confidence >= 0.50) return 'uncertain';
        return 'unreliable';
    }

    // Helper methods
    calculateSimilarity(text1, text2) {
        if (!text1 || !text2) return 0;
        const words1 = new Set(text1.toLowerCase().split(/\s+/));
        const words2 = new Set(text2.toLowerCase().split(/\s+/));
        const intersection = new Set([...words1].filter(x => words2.has(x)));
        const union = new Set([...words1, ...words2]);
        return union.size > 0 ? intersection.size / union.size : 0;
    }

    async queryModel(model, query) {
        const aiRouter = require('../integrations/core/ai-router');
        const result = await aiRouter.route('chatbot', 'chat', {
            messages: [{ role: 'user', content: query }]
        });
        return result?.content || '';
    }

    async searchKnowledgeBase(query) { return []; }
    async getUserDocuments(userId) { return []; }
    async queryAPI(api, query) { return null; }
    async verifyFact(fact) { return { verified: true }; }
    async checkSourceExists(source) { return true; }
}

module.exports = new TruthEngine();
