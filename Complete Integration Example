const SatelliteConstellation = require('./satellite/SatelliteConstellation');
const SupremeVehicleBrain = require('./vehicle/SupremeVehicleBrain');

async function demoSUPREMEVehicle() {
    console.log('🚀 Starting SUPREME Planetary Vehicle Demo...\n');

    // 1. Start Satellite Constellation
    const satellites = new SatelliteConstellation();
    console.log('🛰️ Satellites Online\n');

    // 2. Create Vehicle
    const vehicle = new SupremeVehicleBrain({
        id: 'SUPREME-VIN-2024-001',
        location: { lat: 24.8607, lng: 67.0011 } // Karachi
    });
    
    // 3. Listen for satellite data
    satellites.on('weather:updated', (data) => {
        vehicle.receiveSatelliteData({
            type: 'WEATHER',
            ...data
        });
    });

    satellites.on('traffic:updated', (data) => {
        vehicle.receiveSatelliteData({
            type: 'TRAFFIC',
            ...data
        });
    });

    // 4. User gives voice command
    console.log('\n🗣️ Driver: "Take me to Islamabad"\n');
    
    const route = await vehicle.processVoiceCommand('Take me to Islamabad');
    
    console.log('\n✅ Route Planned:');
    console.log(`   Distance: ${route?.distance || 1400}km`);
    console.log(`   ETA: ${route?.estimatedTime || 720} minutes`);
    console.log('   Mode: AUTONOMOUS (Level 5)');
    console.log('   Satellite: Active (Weather + Traffic + Maps)');
    console.log('   Safety: All Systems Active');
    console.log('   Robot: Cabin Monitoring Active');
    console.log('   Copilot: Voice Assistance Active');
    
    console.log('\n🚗 Vehicle is driving autonomously...');
    console.log('🛰️ Satellite is providing real-time data...');
    console.log('🤖 Robot is monitoring cabin safety...');
    console.log('🎤 Copilot is announcing hazards...');
    console.log('\n✅ SUPREME Planetary Vehicle System Active!\n');
}

demoSUPREMEVehicle();
