    async welcomePrincipal() {
        this.state.lighting = 'WELCOME';
        this.state.smartGlass = 'TRANSPARENT';
        
        // Adjust seat to principal's saved preferences
        this.seats.principal.position = 'EXECUTIVE';
        this.seats.principal.massage = 'SHIATSU';
        
        // Activate signature fragrance
        this.state.fragrance = 'BESPOKE_SIGNATURE';
        
        return { success: true };
    }

    async setTemperature(temp) {
        this.state.temperature = Math.max(18, Math.min(28, temp));
        return { success: true, temperature: this.state.temperature };
    }

    async setSmartGlass(mode) {
        const modes = ['TRANSPARENT', 'SEMI_OPAQUE', 'OPAQUE', 'ONE_WAY'];
        if (modes.includes(mode)) {
            this.state.smartGlass = mode;
        }
        return { success: true, glass: this.state.smartGlass };
    }

    async activatePrivacyMode() {
        this.state.smartGlass = 'OPAQUE';
        this.state.privacyShield = 'ACTIVE';
        this.state.acousticShield = 'ACTIVE';
        return { success: true, privacy: 'MAXIMUM' };
    }

    async activateAcousticShield() {
        this.state.acousticShield = 'ACTIVE';
        return { success: true, message: 'Cabin is now soundproof' };
    }

    async deactivateAcousticShield() {
        this.state.acousticShield = 'INACTIVE';
        return { success: true };
    }

    async activateMeetingMode() {
        this.state.meetingMode = true;
        this.state.lighting = 'BRIGHT';
        
