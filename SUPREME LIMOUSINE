const SupremeLimousine = require('./limousine/SupremeLimousine');

async function demoLimousine() {
    console.log('👑 SUPREME LIMOUSINE — Presidential AI Transport');
    console.log('═══════════════════════════════════════════════════\n');
    
    // Create Founder Armored Edition
    const limo = new SupremeLimousine({
        vin: 'SUPREME-LIMO-FOUNDER-001',
        edition: 'FOUNDER',
        protectionLevel: 'ARMORED',
        location: { lat: 38.8977, lng: -77.0365 } // White House coordinates
    });
    
    await limo.initialize();
    
    // Full security authentication
    console.log('\n🔐 Full Security Authentication...');
    const auth = await limo.vipSecurity.fullAuthentication();
    console.log(`   Result: ${auth.passed ? '✅ AUTHENTICATED' : '❌ FAILED'}`);
    
    // Pre-departure sweep
    console.log('\n🔍 Pre-Departure Security Sweep...');
    const sweep = await limo.vipSecurity.preDepartureSweep();
    console.log(`   Clear: ${sweep.clear ? '✅ CLEAR' : '❌ ISSUE DETECTED'}`);
    
    // Start limousine
    console.log('\n👑 Principal: "Start Limousine"\n');
    await limo.processVoiceCommand('Start Limousine', 'PRINCIPAL');
    
    // Set destination
    console.log('\n👑 Principal: "Navigate to Capitol Hill"\n');
    await limo.processVoiceCommand('Navigate to Capitol Hill', 'PRINCIPAL');
    
    // Privacy mode
    console.log('\n👑 Principal: "Open Privacy Mode"\n');
    await limo.processVoiceCommand('Open Privacy Mode', 'PRINCIPAL');
    
    // Meeting mode
    console.log('\n👑 Principal: "Activate Meeting Mode"\n');
    await limo.processVoiceCommand('Activate Meeting Mode', 'PRINCIPAL');
    
    // Status check
    console.log('\n👑 Principal: "Status"\n');
    await limo.processVoiceCommand('Status', 'PRINCIPAL');
    
    console.log('\n👑 SUPREME LIMOUSINE in transport...');
    console.log('🛡 Armored protection active (B7 Level)');
    console.log('🔒 Privacy mode: Cabin completely secure');
    console.log('📡 Command Center: Real-time tracking');
    console.log('🤖 AI Chauffeur: Monitoring all systems');
    
    console.log('\n✅ SUPREME LIMOUSINE Demo Complete!\n');
}

demoLimousine();
