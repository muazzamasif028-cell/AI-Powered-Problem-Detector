# ============================================================
# 🔗 infrastructure/kubernetes/istio/service-mesh.yaml
# SUPREME Service Mesh — Istio Configuration
# ============================================================

---
# =============================================
# 📡 GATEWAY — ENTRY POINT
# =============================================
apiVersion: networking.istio.io/v1beta1
kind: Gateway
metadata:
  name: supreme-gateway
  namespace: supreme-platform
spec:
  selector:
    istio: ingressgateway
  servers:
  - port:
      number: 443
      name: https
      protocol: HTTPS
    tls:
      mode: SIMPLE
      credentialName: supreme-tls-cert
    hosts:
    - "*.supreme-os.com"
    - "api.supreme-os.com"
  - port:
      number: 80
      name: http
      protocol: HTTP
    hosts:
    - "*.supreme-os.com"
    tls:
      httpsRedirect: true

---
# =============================================
# 🎯 VIRTUAL SERVICE — TRAFFIC ROUTING
# =============================================
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: supreme-api-vs
  namespace: supreme-platform
spec:
  hosts:
  - "api.supreme-os.com"
  gateways:
  - supreme-gateway
  http:
  - match:
    - uri:
        prefix: /api/v2
    route:
    - destination:
        host: supreme-api
        subset: v2
        port:
          number: 3000
      weight: 90
    - destination:
        host: supreme-api
        subset: v1
        port:
          number: 3000
      weight: 10
  - match:
    - uri:
        prefix: /api/
    route:
    - destination:
        host: supreme-api
        subset: v1
        port:
          number: 3000

---
# =============================================
# 🎯 DESTINATION RULE — SUBSETS
# =============================================
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: supreme-api-dr
  namespace: supreme-platform
spec:
  host: supreme-api
  subsets:
  - name: v1
    labels:
      version: v1
  - name: v2
    labels:
      version: v2
  trafficPolicy:
    loadBalancer:
      simple: LEAST_REQUEST
    connectionPool:
      tcp:
        maxConnections: 1000
      http:
        http1MaxPendingRequests: 100
        http2MaxRequests: 1000
        maxRequestsPerConnection: 100
    outlierDetection:
      consecutive5xxErrors: 3
      interval: 30s
      baseEjectionTime: 30s
      maxEjectionPercent: 50

---
# =============================================
# 🔒 PEER AUTHENTICATION — mTLS
# =============================================
apiVersion: security.istio.io/v1beta1
kind: PeerAuthentication
metadata:
  name: supreme-mtls
  namespace: supreme-platform
spec:
  mtls:
    mode: STRICT

---
# =============================================
# 🛡️ AUTHORIZATION POLICY
# =============================================
apiVersion: security.istio.io/v1beta1
kind: AuthorizationPolicy
metadata:
  name: supreme-auth-policy
  namespace: supreme-platform
spec:
  selector:
    matchLabels:
      app: supreme-api
  rules:
  - from:
    - source:
        principals: ["cluster.local/ns/supreme-platform/sa/supreme-api"]
    to:
    - operation:
        methods: ["GET", "POST", "PUT", "DELETE"]
        paths: ["/api/*"]
  - from:
    - source:
        namespaces: ["supreme-monitoring"]
    to:
    - operation:
        methods: ["GET"]
        paths: ["/metrics", "/health"]

---
# =============================================
# 📊 TELEMETRY
# =============================================
apiVersion: telemetry.istio.io/v1alpha1
kind: Telemetry
metadata:
  name: supreme-telemetry
  namespace: supreme-platform
spec:
  tracing:
  - providers:
    - name: otel
    randomSamplingPercentage: 10.0
  metrics:
  - providers:
    - name: prometheus
    overrides:
    - match:
        metric: REQUEST_COUNT
      tagOverrides:
        destination_port:
          value: "true"
    - match:
        metric: REQUEST_DURATION
      tagOverrides:
        destination_port:
          value: "true"
