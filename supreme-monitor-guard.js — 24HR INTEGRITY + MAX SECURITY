    getAllAssetsStatus() {
        const status = {};
        for (let [category, assets] of Object.entries(this.assets)) {
            status[category] = assets.map(a => ({
                name: a.name,
                value: a.value,
                integrity: a.integrity + '%',
                growth: '+' + a.growth + '%',
                status: a.integrity === 100 ? '✅ HEALTHY' : '⚠️ ATTENTION'
            }));
        }
        return status;
    }

