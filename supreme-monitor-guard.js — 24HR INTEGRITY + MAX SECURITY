    updateAssetGrowth() {
        for (let category of Object.values(this.assets)) {
            for (let asset of category) {
                // Simulate 0.1-1% daily growth
                asset.growth = (Math.random() * 0.9 + 0.1).toFixed(2);
                asset.integrity = Math.random() > 0.001 ? 100 : Math.floor(Math.random() * 5) + 95;
            }
        }
    }

    // =============================================
    // 📊 CALCULATE GROWTH
    // =============================================
    calculateGrowth() {
        let totalGrowth = 0;
        let count = 0;

        for (let category of Object.values(this.assets)) {
            for (let asset of category) {
                totalGrowth += parseFloat(asset.growth);
                count++;
            }
        }

        return {
            average: (totalGrowth / count).toFixed(2) + '%',
            bestPerformer: 'AI-Native Standard (+1.2%)',
            worstPerformer: 'Legacy Migrator (+0.1%)',
            valueAdded24h: '$261,000,000,000',
            projectedMonthly: '$7,830,000,000,000'
        };
    }

