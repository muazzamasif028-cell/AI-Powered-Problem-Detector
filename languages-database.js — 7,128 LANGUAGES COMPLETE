        });

        html += `
        <div style="text-align:center;margin-top:8px;color:rgba(255,255,255,0.4);font-size:0.6em;">
        + 5 Additional Categories (DSL, Scientific, Educational, Concurrent, Security)
        </div>
        </div>`;

        return html;
    }

    reset() {
        this.languageIndex.clear();
        this.buildLanguageIndex();
        return { status: 'RESET', timestamp: new Date().toISOString() };
    }
}

