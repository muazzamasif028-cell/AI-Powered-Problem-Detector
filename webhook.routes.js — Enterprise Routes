// ==========================================
// 🅿️ PAYPAL WEBHOOK
// ==========================================
router.post('/paypal',
    express.json(),
    async (req, res) => {
        const provider = 'paypal';
        let eventId = 'unknown';

        try {
            eventId = webhookLogger.extractEventId(provider, req);
            await webhookLogger.logReceived(provider, req);

            const verification = await webhookSecurity.verify(provider, req);
            await webhookLogger.logVerification(provider, eventId, verification);

            if (!verification.verified) {
                return res.status(401).json({
                    success: false,
                    error: 'Invalid signature',
                    reason: verification.reason
                });
            }

            const dedupCheck = await webhookDedup.isDuplicate(provider, eventId);
            if (dedupCheck.duplicate) {
                return res.status(200).json({ success: true, duplicate: true });
            }

            const result = await webhookHandler.processEvent(provider, req.body);
            await webhookDedup.markAsProcessed(provider, eventId, result);

            return res.status(200).json({
                success: true,
                eventId,
                result
            });

        } catch (error) {
            console.error(`❌ PayPal webhook error:`, error.message);
            await webhookDedup.markAsFailed(provider, eventId, error);
            await webhookRetry.addToRetry(provider, req.body, error);

            return res.status(500).json({
                success: false,
                error: error.message
            });
        }
    }
);

// ==========================================
// 📊 WEBHOOK STATS (Admin)
// ==========================================
router.get('/stats', async (req, res) => {
    const { provider, days = 7 } = req.query;
    const stats = await webhookLogger.getStats(provider, parseInt(days));
    const dedupStats = webhookDedup.getStats();
    const retryStats = webhookRetry.getStats();

    res.json({
        success: true,
        stats,
        dedup: dedupStats,
        retry: retryStats
    });
});

// ==========================================
// 📋 WEBHOOK LOGS (Admin)
// ==========================================
router.get('/logs', async (req, res) => {
    const { provider, limit = 50, type } = req.query;
    const logs = await webhookLogger.getLogs(provider, parseInt(limit), type);
    res.json({ success: true, logs });
});

module.exports = router;
