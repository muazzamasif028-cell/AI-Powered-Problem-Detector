// supreme-billing/UniversalBillingLayer.js
// One abstraction for ALL payment processors worldwide

export class UniversalBillingLayer {
    constructor() {
        this.processors = {
            paddle: new PaddleProcessor(),      // Global MoR
            stripe: new StripeProcessor(),      // Where available
            safepay: new SafePayProcessor(),    // Pakistan
            payoneer: new PayoneerProcessor(),  // Freelancers
            razorpay: new RazorpayProcessor(),  // India
            paypal: new PayPalProcessor(),      // Global
            crypto: new CryptoProcessor()       // Future
        };
        
        this.router = new PaymentRouter();
        this.taxEngine = new GlobalTaxEngine();
        this.invoiceEngine = new InvoiceEngine();
    }

    /**
     * Route payment to optimal processor
     */
    async processPayment(payment) {
        // 1. Select best processor based on country, currency, amount
        const processor = await this.router.select({
            country: payment.country,
            currency: payment.currency,
            amount: payment.amount,
            requirements: payment.requirements || {}
        });

        // 2. Calculate tax
        const tax = await this.taxEngine.calculate({
            amount: payment.amount,
            country: payment.country,
            type: payment.type,
            customerType: payment.customerType
        });

        // 3. Process payment
        const result = await processor.charge({
            ...payment,
            tax
        });

        // 4. Generate invoice
        const invoice = await this.invoiceEngine.generate({
            payment: result,
            tax,
            customer: payment.customer
        });

        return {
            transactionId: result.id,
            processor: processor.name,
            amount: payment.amount,
            tax,
            total: payment.amount + tax,
            invoice: invoice.url,
            receipt: result.receiptUrl
        };
    }

    /**
     * Get available processors for a country
     */
    getAvailableProcessors(country) {
        return Object.values(this.processors)
            .filter(p => p.supportsCountry(country))
            .map(p => ({
                name: p.name,
                currencies: p.supportedCurrencies,
                fees: p.fees,
                settlementTime: p.settlementTime
            }));
    }
}
