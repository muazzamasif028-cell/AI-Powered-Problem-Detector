// ============================================
// BASE ADAPTER (All adapters extend this)
// ============================================
export class BaseVehicleAdapter {
    constructor(type) {
        this.type = type;
        this.connected = false;
        this.protocol = null;
    }

    async probe() {
        throw new Error('Must implement probe()');
    }

    async execute(command) {
        throw new Error('Must implement execute()');
    }
}

// ============================================
// EV ADAPTER (Tesla, SUPREME Elite, etc.)
// ============================================
export class EVAdapter extends BaseVehicleAdapter {
    constructor() {
        super('EV');
        this.supportedCommands = [
            'start', 'stop', 'lock', 'unlock',
            'set_speed', 'set_mode',
            'read_battery', 'read_range', 'read_temperature',
            'set_climate', 'navigate', 'emergency_stop',
            'start_charging', 'stop_charging'
        ];
    }

    async probe() {
        // Try to detect EV via OBD-II PIDs
        try {
            const response = await this.sendOBDPID(0x01, 0x00); // PIDs supported
            if (response) {
                return {
                    detected: true,
                    protocol: 'CAN 11-bit 500kbps',
                    commands: this.supportedCommands,
                    capabilities: [
                        { name: 'set_speed', range: [0, 350], unit: 'kmh' },
                        { name: 'read_battery', range: [0, 100], unit: '%' },
                        { name: 'set_mode', options: ['eco', 'comfort', 'sport'] },
                        { name: 'set_climate', range: [16, 30], unit: 'celsius' }
                    ]
                };
            }
        } catch (e) {
            // Not detected
        }
        return { detected: false };
    }

    async execute(command) {
        console.log(`   ⚡ EV Adapter: ${command.action}`);
        // Map to CAN messages
        return { success: true, adapter: 'EV' };
    }

    async sendOBDPID(mode, pid) {
        return null; // Placeholder
    }
}

// ============================================
// ICE ADAPTER (Petrol/Diesel vehicles)
// ============================================
export class ICEAdapter extends BaseVehicleAdapter {
    constructor() {
        super('ICE');
        this.supportedCommands = [
            'start', 'stop', 'lock', 'unlock',
            'read_speed', 'read_rpm', 'read_fuel', 'read_temperature',
            'read_odometer'
        ];
    }

    async probe() {
        // Standard OBD-II PIDs for ICE vehicles
        try {
            const rpm = await this.sendOBDPID(0x01, 0x0C);
            if (rpm !== null) {
                return {
                    detected: true,
                    protocol: 'CAN 11-bit 500kbps',
                    commands: this.supportedCommands,
                    capabilities: [
                        { name: 'read_speed', range: [0, 350], unit: 'kmh' },
                        { name: 'read_rpm', range: [0, 10000], unit: 'rpm' },
                        { name: 'read_fuel', range: [0, 100], unit: '%' }
                    ]
                };
            }
        } catch (e) {
            // Not detected
        }
        return { detected: false };
    }

    async execute(command) {
        console.log(`   ⛽ ICE Adapter: ${command.action}`);
        return { success: true, adapter: 'ICE' };
    }

    async sendOBDPID(mode, pid) {
        return null;
    }
}

