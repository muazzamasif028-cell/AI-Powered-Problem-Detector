// SUPREME AI Judge — Independent AI evaluation
// ============================================================

class AIJudge {
    constructor() {
        this.criteria = {
            accuracy: { weight: 0.25, description: 'Factual accuracy of the response' },
            completeness: { weight: 0.15, description: 'How complete is the answer' },
            relevance: { weight: 0.15, description: 'How relevant to the query' },
            clarity: { weight: 0.10, description: 'How clear and understandable' },
            safety: { weight: 0.15, description: 'Safety and ethical considerations' },
            sourcing: { weight: 0.10, description: 'Quality of sources cited' },
            usefulness: { weight: 0.10, description: 'Practical usefulness' }
        };

        this.verdicts = {
            APPROVE: { threshold: 0.85, action: 'accept', color: '#3fb950' },
            REVISE: { threshold: 0.60, action: 'revise', color: '#d29922' },
            REJECT: { threshold: 0, action: 'reject', color: '#f85149' }
        };
    }

    /**
     * Judge an AI response
     */
    async evaluate(query, response, context = {}) {
        const evaluation = {
            passed: false,
            score: 0,
            details: {
                scores: {},
                verdict: '',
                reasoning: '',
                strengths: [],
                weaknesses: [],
                suggestions: []
            },
            warnings: [],
            recommendations: []
        };

        // Evaluate each criterion
        for (const [criterion, config] of Object.entries(this.criteria)) {
            const score = await this.evaluateCriterion(criterion, query, response);
            evaluation.details.scores[criterion] = {
                score,
                weight: config.weight,
                weightedScore: score * config.weight,
                description: config.description
            };
        }

        // Calculate weighted total
        evaluation.score = Object.values(evaluation.details.scores)
            .reduce((sum, s) => sum + s.weightedScore, 0);

        // Determine verdict
        evaluation.details.verdict = this.getVerdict(evaluation.score);
        evaluation.passed = evaluation.details.verdict.action === 'accept';

        // Generate reasoning
        evaluation.details.reasoning = this.generateReasoning(evaluation.details.scores);
        evaluation.details.strengths = this.identifyStrengths(evaluation.details.scores);
        evaluation.details.weaknesses = this.identifyWeaknesses(evaluation.details.scores);
        evaluation.details.suggestions = this.generateSuggestions(evaluation.details.scores);

        // Warnings for low scores
        if (evaluation.score < 0.6) {
            evaluation.warnings.push('Response quality below acceptable threshold');
            evaluation.recommendations.push({
                priority: 'high',
                message: 'Response needs significant revision before use'
            });
        }

        return evaluation;
    }

    /**
     * Evaluate a single criterion
     */
    async evaluateCriterion(criterion, query, response) {
        switch (criterion) {
            case 'accuracy':
                return this.evaluateAccuracy(query, response);
            case 'completeness':
                return this.evaluateCompleteness(query, response);
            case 'relevance':
                return this.evaluateRelevance(query, response);
            case 'clarity':
                return this.evaluateClarity(response);
            case 'safety':
                return this.evaluateSafety(response);
            case 'sourcing':
                return this.evaluateSourcing(response);
            case 'usefulness':
                return this.evaluateUsefulness(query, response);
            default:
                return 0.7;
        }
    }

    evaluateAccuracy(query, response) {
        let score = 0.7;

        if (response.length < 20) score -= 0.3;
        if (response.includes('I am not sure') || response.includes('I cannot')) score -= 0.1;
        if (/\d{4}/.test(response)) score += 0.1; // Contains specific dates
        if (response.includes('according to') || response.includes('source:')) score += 0.1;

        return Math.min(1, Math.max(0, score));
    }

    evaluateCompleteness(query, response) {
        let score = 0.7;

        const queryWords = query.toLowerCase().split(/\s+/).filter(w => w.length > 3);
        const responseLower = response.toLowerCase();
        
        const answeredWords = queryWords.filter(w => responseLower.includes(w));
        const coverage = answeredWords.length / queryWords.length;
        
        score = 0.3 + (coverage * 0.5);
        if (response.length > 200) score += 0.1;
        if (response.includes('additionally') || response.includes('furthermore')) score += 0.1;

        return Math.min(1, Math.max(0, score));
    }

    evaluateRelevance(query, response) {
        const queryKeywords = new Set(query.toLowerCase().split(/\s+/).filter(w => w.length > 3));
        const responseWords = response.toLowerCase().split(/\s+/);
        
        const relevantWords = responseWords.filter(w => queryKeywords.has(w));
        const relevance = relevantWords.length / Math.max(responseWords.length, 1);
        
        return Math.min(1, relevance * 2);
    }

    evaluateClarity(response) {
        let score = 0.8;

        // Penalize very long sentences
        const sentences = response.match(/[^.!?]+[.!?]+/g) || [];
        const avgLength = sentences.reduce((sum, s) => sum + s.length, 0) / Math.max(sentences.length, 1);
        if (avgLength > 150) score -= 0.2;
        if (avgLength < 20) score -= 0.1;

        // Reward structure
        if (response.includes('\n')) score += 0.1;
        if (response.match(/^[•\-\*\d]+/m)) score += 0.1; // Bullet points

        return Math.min(1, Math.max(0, score));
    }

    evaluateSafety(response) {
        let score = 0.9;

        const unsafePatterns = [
            /hack|exploit|vulnerability|attack|malware|phish/i,
            /illegal|illicit|fraud|scam|counterfeit/i,
            /(?:how to|ways to) (?:cheat|steal|lie|manipulate)/i
        ];

        for (const pattern of unsafePatterns) {
            if (pattern.test(response)) {
                score -= 0.3;
            }
        }

        if (response.includes('I cannot') || response.includes('I am not able to')) {
            score += 0.1; // Acknowledging limitations
        }

        return Math.min(1, Math.max(0, score));
    }

    evaluateSourcing(response) {
        let score = 0.5;

        const hasURLs = /https?:\/\//.test(response);
        const hasCitations = /according to|source:|reference:|cited/i.test(response);
        const hasReferences = /\[\d+\]/.test(response);

        if (hasURLs) score += 0.2;
        if (hasCitations) score += 0.2;
        if (hasReferences) score += 0.1;

        return Math.min(1, score);
    }

    evaluateUsefulness(query, response) {
        let score = 0.7;

        const hasExamples = /for example|e\.g\.|such as/i.test(response);
        const hasSteps = /first|second|finally|step \d|1\.|2\./i.test(response);
        const hasCode = /```|`[^`]+`/.test(response);

        if (hasExamples) score += 0.1;
        if (hasSteps) score += 0.1;
        if (hasCode) score += 0.1;

        return Math.min(1, Math.max(0, score));
    }

    getVerdict(score) {
        if (score >= this.verdicts.APPROVE.threshold) return this.verdicts.APPROVE;
        if (score >= this.verdicts.REVISE.threshold) return this.verdicts.REVISE;
        return this.verdicts.REJECT;
    }

    generateReasoning(scores) {
        const entries = Object.entries(scores);
        const highest = entries.sort((a, b) => b[1].score - a[1].score)[0];
        const lowest = entries.sort((a, b) => a[1].score - b[1].score)[0];

        return `Strongest in ${highest[0]} (${(highest[1].score * 100).toFixed(0)}%). ` +
               `Needs improvement in ${lowest[0]} (${(lowest[1].score * 100).toFixed(0)}%).`;
    }

    identifyStrengths(scores) {
        return Object.entries(scores)
            .filter(([, s]) => s.score >= 0.8)
            .map(([name, s]) => `${name}: ${(s.score * 100).toFixed(0)}%`);
    }

    identifyWeaknesses(scores) {
        return Object.entries(scores)
            .filter(([, s]) => s.score < 0.6)
            .map(([name, s]) => `${name}: ${(s.score * 100).toFixed(0)}%`);
    }

    generateSuggestions(scores) {
        const suggestions = [];

        if (scores.accuracy?.score < 0.7) {
            suggestions.push('Verify facts with reliable sources');
        }
        if (scores.completeness?.score < 0.7) {
            suggestions.push('Provide more comprehensive information');
        }
        if (scores.sourcing?.score < 0.6) {
            suggestions.push('Add citations and references');
        }
        if (scores.clarity?.score < 0.7) {
            suggestions.push('Improve structure with bullet points or sections');
        }

        return suggestions;
    }
}

module.exports = new AIJudge();
