    async detectAll(metrics = {}) {
        const scanId = 'NEOM-' + Date.now().toString(36) + '-' + Math.random().toString(36).substr(2, 8).toUpperCase();
        const results = {};

        for (let [key, config] of Object.entries(this.problems)) {
            const result = this.detectProblem(key, config, metrics);
            results[key] = result;
            this.problemStatus[key].lastChecked = new Date().toISOString();
            if (result.detected) { this.problemStatus[key].status = result.severity; this.state.problemsFound++; if (result.severity === 'CRITICAL') this.state.criticalCount++; }
            else { this.problemStatus[key].status = 'NORMAL'; }
        }

        this.state.totalScans++;
        this.state.cityStatus = Object.values(results).some(r => r.severity === 'CRITICAL') ? 'EMERGENCY' : 
                               Object.values(results).some(r => r.severity === 'WARNING') ? 'ALERT' : 'OPERATIONAL';

        return { scanId, timestamp: new Date().toISOString(), results, cityStatus: this.state.cityStatus, summary: this.generateSummary(results) };
    }

    detectProblem(key, config, metrics) {
        const defaults = {
            THE_LINE_POWER_OUTAGE: metrics.affected_sections || Math.floor(Math.random() * 6),
            OXAGON_CRANE_FAILURE: metrics.crane_count || Math.floor(Math.random() * 4),
            DRONE_FLEET_LOST: metrics.drones_lost || Math.floor(Math.random() * 25),
            SILICON_CHIP_FAILURE: metrics.defective_chips || Math.floor(Math.random() * 1200),
            HYDROGEN_PLANT_LEAK: metrics.leak_detected ? 1 : 0,
            SECURITY_BREACH: metrics.breach_attempts || Math.floor(Math.random() * 4),
            TRAFFIC_CONGESTION: metrics.congestion_level || Math.floor(Math.random() * 100),
            AIR_QUALITY_ALERT: metrics.aqi_level || Math.floor(Math.random() * 250),
            WATER_SHORTAGE: metrics.reservoir_level_percent ? 100 - metrics.reservoir_level_percent : Math.floor(Math.random() * 100),
            FIRE_DETECTION: metrics.fire_detected ? Math.floor(Math.random() * 5) : 0
        };

        const currentValue = defaults[key] || 0;
        let detected = false;
        let severity = 'NORMAL';

        if (currentValue >= config.thresholds.emergency) { detected = true; severity = 'CRITICAL'; }
        else if (currentValue >= config.thresholds.critical) { detected = true; severity = 'WARNING'; }
        else if (currentValue >= config.thresholds.warning) { detected = true; severity = 'WARNING'; }

        return {
            problemId: config.id,
            problemName: config.name,
            location: config.location,
            category: config.category,
            detected,
            severity,
            currentValue: currentValue.toFixed(2),
            unit: config.unit,
            coordinates: config.coordinates,
            symptoms: detected ? config.symptoms : [],
            solutions: detected ? config.solutions.filter(s => s.autoFix).slice(0, 3) : [],
            impact: detected ? config.impact : 'None'
        };
    }

    generateSummary(results) {
        const detected = Object.values(results).filter(r => r.detected);
        const criticals = detected.filter(r => r.severity === 'CRITICAL');
        const warnings = detected.filter(r => r.severity === 'WARNING');
        const normal = Object.values(results).filter(r => !r.detected);

        return {
            totalProblems: 10,
            problemsDetected: detected.length,
            criticalCount: criticals.length,
            warningCount: warnings.length,
            normalCount: normal.length,
            completionRate: (normal.length / 10 * 100).toFixed(0) + '%',
            overallStatus: this.state.cityStatus,
            score: '10/10 ✅'
        };
    }

    formatForChat(scanResult) {
