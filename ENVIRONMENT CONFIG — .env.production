# ============================================================
# 🤫 SUPREME PLATFORM — PRODUCTION ENVIRONMENT
# ============================================================

NODE_ENV=production
PORT=5000

# Domain
DOMAIN=https://supreme-platform.com
ALLOWED_ORIGINS=https://supreme-platform.com,https://app.supreme-platform.com

# Session
SESSION_SECRET=your-production-session-secret-here-change-me

# Database
MONGODB_URI=mongodb://supreme_admin:your-db-password@mongodb:27017/supreme-platform
REDIS_URL=redis://:your-redis-password@redis:6379

# JWT
JWT_SECRET=your-production-jwt-secret-change-me
JWT_EXPIRES_IN=24h

# Payment
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret

# Email
SMTP_HOST=smtp.supreme-platform.com
SMTP_PORT=587
SMTP_USER=noreply@supreme-platform.com
SMTP_PASS=your-email-password

# Satellite
SATELLITE_API_KEY=your-satellite-api-key

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
LOG_LEVEL=info

# Grafana
GRAFANA_USER=admin
GRAFANA_PASS=your-grafana-password

# Features
FEATURE_GHOST_ENGINE=true
FEATURE_PRIVACY_SHIELD=true
FEATURE_SHAPE_SHIFTER=true
FEATURE_COGNITIVE_AUDIT=true
FEATURE_ZERO_CODE=true
FEATURE_PRE_COGNITION=true
FEATURE_CHIP_DIAGNOSTIC=true
