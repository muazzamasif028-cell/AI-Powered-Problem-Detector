        <div style="color:#8b5cf6;font-weight:700;margin-bottom:6px;">🟪 NEOM SMART CITY DIAGNOSTIC — ${scanResult.scanId}</div>
        <div style="color:rgba(255,255,255,0.5);font-size:0.7em;margin-bottom:8px;">City Status: <span style="color:${scanResult.cityStatus === 'OPERATIONAL' ? '#3fb950' : scanResult.cityStatus === 'ALERT' ? '#f0883e' : '#da3633'};font-weight:700;">${scanResult.cityStatus}</span></div>
        <table style="width:100%;border-collapse:collapse;color:#e0e0e0;">
        <tr style="border-bottom:1px solid rgba(255,255,255,0.1);"><th style="text-align:left;padding:4px;">#</th><th style="text-align:left;padding:4px;">Location</th><th style="text-align:left;padding:4px;">Problem</th><th style="text-align:left;padding:4px;">Status</th></tr>`;

        Object.entries(scanResult.results).forEach(([key, r], i) => {
            const color = r.severity === 'CRITICAL' ? '#da3633' : r.severity === 'WARNING' ? '#f0883e' : '#3fb950';
            const icon = r.detected ? (r.severity === 'CRITICAL' ? '🚨' : '⚠️') : '✅';
            html += `<tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
            <td style="padding:4px;">${i + 1}</td><td style="padding:4px;">${r.location}</td>
            <td style="padding:4px;">${r.problemName}</td><td style="padding:4px;color:${color};">${icon} ${r.severity}</td></tr>`;
        });

        html += `</table></div>`;
        return html;
    }

    getStatus() { return { initialized: this.state.initialized, cityStatus: this.state.cityStatus, totalScans: this.state.totalScans }; }
    reset() {
        Object.keys(this.problemStatus).forEach(k => { this.problemStatus[k] = { status: 'PENDING', lastChecked: null, detectionCount: 0, severity: this.problems[k].severity, resolved: false }; });
        this.state.totalScans = 0; this.state.problemsFound = 0; this.state.criticalCount = 0; this.state.cityStatus = 'OPERATIONAL';
