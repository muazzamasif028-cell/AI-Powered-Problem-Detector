class DigitalTwinEarth {
    constructor() {
        this.mapVersion = '1.0.0';
        this.updateInterval = 1000; // 1 second updates
        
        // Global infrastructure database
        this.infrastructure = {
            submarineCables: new Map(),
            dataCenters: new Map(),
            ixpLocations: new Map(),
            ispNetworks: new Map(),
            satelliteConstellations: new Map(),
            cloudRegions: new Map(),
            edgeLocations: new Map(),
            fiberRoutes: new Map()
        };

        this.liveMetrics = {
            globalLatency: new Map(),
            packetLoss: new Map(),
            bandwidthUtilization: new Map(),
            activeThreats: new Map(),
            networkHealth: new Map()
        };

        this.initializeEarthMap();
        this.startLiveUpdates();
    }

    /**
     * Initialize Earth's digital twin
     */
    initializeEarthMap() {
        // Major submarine cables
        const cables = [
            { name: 'SEA-ME-WE 5', path: ['Singapore', 'Malaysia', 'Indonesia', 'Sri Lanka', 'Pakistan', 'UAE', 'Egypt', 'France'], capacity: '24 Tbps', length: '20,000 km' },
            { name: 'AAE-1', path: ['Hong Kong', 'Vietnam', 'Singapore', 'Thailand', 'India', 'Pakistan', 'Oman', 'UAE', 'Egypt', 'France'], capacity: '40 Tbps', length: '25,000 km' },
            { name: 'PEACE Cable', path: ['China', 'Pakistan', 'Kenya', 'Egypt', 'France'], capacity: '16 Tbps', length: '15,000 km' },
            { name: '2Africa', path: ['South Africa', 'Kenya', 'Saudi Arabia', 'Egypt', 'Spain', 'UK'], capacity: '180 Tbps', length: '45,000 km' }
        ];

        cables.forEach(cable => {
            this.infrastructure.submarineCables.set(cable.name, cable);
        });

        // Cloud regions
        const cloudRegions = [
            { provider: 'AWS', region: 'us-east-1', city: 'Virginia', lat: 38.9072, lng: -77.0369 },
            { provider: 'AWS', region: 'me-south-1', city: 'Bahrain', lat: 26.0667, lng: 50.5577 },
            { provider: 'Azure', region: 'uaenorth', city: 'Dubai', lat: 25.2048, lng: 55.2708 },
            { provider: 'GCP', region: 'asia-south1', city: 'Mumbai', lat: 19.0760, lng: 72.8777 }
        ];

        cloudRegions.forEach(region => {
            const key = `${region.provider}-${region.region}`;
            this.infrastructure.cloudRegions.set(key, region);
        });

        console.log(`🌎 Digital Twin Earth initialized: ${cables.length} cables, ${cloudRegions.length} cloud regions`);
    }

    /**
     * Start live updates
     */
    startLiveUpdates() {
        setInterval(() => {
            this.updateLiveMetrics();
        }, this.updateInterval);
    }

    /**
     * Update live metrics
     */
    async updateLiveMetrics() {
        // Update latency map
        const locations = ['Karachi', 'Dubai', 'Singapore', 'London', 'New York'];
        locations.forEach(loc => {
            this.liveMetrics.globalLatency.set(loc, {
                latency: Math.floor(Math.random() * 100 + 30),
                packetLoss: (Math.random() * 2).toFixed(2),
                bandwidth: Math.floor(Math.random() * 1000 + 100),
                status: Math.random() > 0.05 ? '🟢 Healthy' : '🟡 Degraded'
            });
        });
    }

    /**
     * Get live Earth map data
     */
    async getEarthMap() {
        return {
            version: this.mapVersion,
            timestamp: new Date().toISOString(),
            infrastructure: {
                submarineCables: this.infrastructure.submarineCables.size,
                cloudRegions: this.infrastructure.cloudRegions.size,
                totalCapacity: this.calculateTotalCapacity()
            },
            liveMetrics: {
                globalLatency: Object.fromEntries(this.liveMetrics.globalLatency),
                averageGlobalLatency: this.calculateAverageLatency(),
                healthyNodes: this.countHealthyNodes(),
                totalNodes: this.liveMetrics.globalLatency.size
            },
            visualization: {
                cables: Array.from(this.infrastructure.submarineCables.values()).map(c => ({
                    name: c.name,
                    path: c.path,
                    capacity: c.capacity,
                    status: Math.random() > 0.02 ? 'active' : 'degraded'
                })),
                cloudRegions: Array.from(this.infrastructure.cloudRegions.values()).map(r => ({
                    provider: r.provider,
                    city: r.city,
                    lat: r.lat,
                    lng: r.lng
                }))
            }
        };
    }

    calculateTotalCapacity() {
        let total = 0;
        this.infrastructure.submarineCables.forEach(cable => {
            total += parseInt(cable.capacity);
        });
        return total + ' Tbps';
    }

    calculateAverageLatency() {
        let sum = 0;
        let count = 0;
        this.liveMetrics.globalLatency.forEach((data) => {
            sum += data.latency;
            count++;
        });
        return count > 0 ? Math.round(sum / count) + 'ms' : 'N/A';
    }

    countHealthyNodes() {
        let healthy = 0;
        this.liveMetrics.globalLatency.forEach((data) => {
            if (data.status.includes('Healthy')) healthy++;
        });
        return healthy;
    }
}

module.exports = new DigitalTwinEarth();
