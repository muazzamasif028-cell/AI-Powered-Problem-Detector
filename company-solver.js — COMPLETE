    // =============================================
    // SUBMIT PROBLEM (COMPANY-ISOLATED)
    // =============================================
    async submitProblem(companyId, problem, context = {}) {
        const problemId = 'PRB-' + Date.now().toString(36) + '-' + 
                         Math.random().toString(36).substr(2, 6).toUpperCase();
        
        const company = this.companies.get(companyId);
        if (!company) {
            return { success: false, error: 'Company not found', code: 'COMPANY_NOT_FOUND' };
        }

        // Check tier limits
        const limits = this.tierLimits[company.tier];
        if (company.activeProblems.length >= limits.maxConcurrentProblems) {
            return { 
                success: false, 
                error: `Concurrent problem limit reached (${limits.maxConcurrentProblems}). Upgrade your plan.`,
                code: 'LIMIT_EXCEEDED',
                currentUsage: company.activeProblems.length,
                limit: limits.maxConcurrentProblems
            };
        }

        console.log(`🤫 [COMPANY SOLVER]: ${company.name} submitted problem: ${problemId}`);

        try {
            // Step 1: Classify problem
            const classification = this.classifyProblem(problem);
            
            // Step 2: Prioritize
            const priority = this.prioritizeProblem(classification, company.tier);
            
            // Step 3: Create problem ticket
            const ticket = {
                problemId,
                companyId,
                companyName: company.name,
                tier: company.tier,
                problem: typeof problem === 'string' ? problem.substring(0, 200) : 'Complex problem',
                fullDescription: problem,
                classification,
                priority,
                status: 'OPEN',
                assignedTo: null,
                assignedEngineer: null,
                createdAt: new Date().toISOString(),
                updatedAt: new Date().toISOString(),
                resolution: null,
                resolutionTime: null,
                category: classification.category,
                severity: classification.severity,
                autoFixAttempted: false,
                autoFixSuccess: false,
                context: {
                    ...context,
                    submittedBy: context.userId || 'unknown',
                    channel: context.channel || 'API'
                }
            };

            // Step 4: Add to company queue
            company.activeProblems.push(ticket);
            this.problemQueues.get(companyId)[priority.toLowerCase()].push(ticket);
            
            // Step 5: Auto-assign engineer if available
            if (limits.autoFixEnabled || priority === 'CRITICAL') {
                const assigned = await this.autoAssignEngineer(companyId, ticket);
                if (assigned) {
                    ticket.assignedTo = assigned.engineerId;
                    ticket.assignedEngineer = assigned.engineerName;
                }
            }

            // Step 6: Attempt auto-fix for eligible problems
            if (limits.autoFixEnabled && classification.autoFixable) {
                const autoFixResult = await this.attemptAutoFix(companyId, ticket);
                ticket.autoFixAttempted = true;
                ticket.autoFixSuccess = autoFixResult.success;
                
                if (autoFixResult.success) {
                    ticket.status = 'RESOLVED';
                    ticket.resolution = autoFixResult.solution;
                    ticket.resolutionTime = new Date().toISOString();
                    ticket.resolvedAt = new Date().toISOString();
                    
                    // Move to resolved
                    company.activeProblems = company.activeProblems.filter(p => p.problemId !== problemId);
                    company.resolvedProblems.push(ticket);
                    company.problemHistory.push(ticket);
                    
                    this.state.totalResolved++;
                }
            }

            this.state.totalProblems++;

            console.log(`🤫 [COMPANY SOLVER]: Problem ${problemId} — ${ticket.status} | Priority: ${priority}`);

            return {
                success: true,
                problemId,
                ticket: {
                    problemId: ticket.problemId,
                    status: ticket.status,
                    priority: ticket.priority,
                    category: ticket.category,
                    severity: ticket.severity,
                    assignedEngineer: ticket.assignedEngineer,
                    autoFixApplied: ticket.autoFixSuccess,
                    estimatedResponse: limits.responseTime,
                    createdAt: ticket.createdAt
                },
                company: {
                    name: company.name,
                    tier: company.tier,
                    activeProblems: company.activeProblems.length,
                    limit: limits.maxConcurrentProblems
                }
            };

        } catch (error) {
            console.error(`🤫 [COMPANY SOLVER]: Error submitting problem: ${error.message}`);
            return { success: false, error: 'Problem submission failed', code: 'SUBMISSION_ERROR' };
        }
    }

    // =============================================
    // CLASSIFY PROBLEM
    // =============================================
    classifyProblem(problem) {
        const problemStr = typeof problem === 'string' ? problem.toLowerCase() : JSON.stringify(problem).toLowerCase();
        
        let category = 'SYSTEM';
        let severity = 'MEDIUM';
        let autoFixable = false;
        let confidence = 0;

        // Performance classification
        const perfKeywords = ['cpu', 'memory', 'disk', 'slow', 'latency', 'database', 'network', 'i/o', 'swap', 'thread', 'connection pool'];
        const perfMatches = perfKeywords.filter(k => problemStr.includes(k));
        
        // Availability classification
        const availKeywords = ['down', 'offline', 'timeout', 'dns', 'ssl', 'expired', 'unavailable', 'cache miss', 'rate limit', '503', '502'];
        const availMatches = availKeywords.filter(k => problemStr.includes(k));
        
        // Security classification
        const secKeywords = ['login', 'unauthorized', 'injection', 'xss', 'ddos', 'port scan', 'vulnerability', 'weak password', 'api key', 'unencrypted', 'breach', 'attack'];
        const secMatches = secKeywords.filter(k => problemStr.includes(k));

        if (secMatches.length > perfMatches.length && secMatches.length > availMatches.length) {
            category = 'SECURITY';
            severity = secMatches.length > 3 ? 'CRITICAL' : 'HIGH';
            autoFixable = secMatches.length <= 2;
        } else if (availMatches.length > perfMatches.length) {
            category = 'AVAILABILITY';
            severity = availMatches.length > 3 ? 'CRITICAL' : 'HIGH';
            autoFixable = availMatches.length <= 3;
        } else {
            category = 'PERFORMANCE';
            severity = perfMatches.length > 3 ? 'HIGH' : 'MEDIUM';
            autoFixable = perfMatches.length <= 4;
        }

        confidence = Math.min(0.95, (Math.max(perfMatches.length, availMatches.length, secMatches.length) * 0.15) + 0.4);

        return {
            category,
            severity,
            autoFixable,
            confidence: confidence.toFixed(2),
            detectedPatterns: {
                performance: perfMatches,
                availability: availMatches,
                security: secMatches
            }
        };
    }

    // =============================================
    // PRIORITIZE PROBLEM
    // =============================================
    prioritizeProblem(classification, tier) {
        const tierPriority = {
            GLOBAL: 5,
            ENTERPRISE: 4,
            BUSINESS: 3,
            MEDIUM: 2,
            SMALL: 1
        };

        const severityPriority = {
            CRITICAL: 10,
            HIGH: 7,
            MEDIUM: 4,
            LOW: 2
        };

        const score = (tierPriority[tier] || 1) + (severityPriority[classification.severity] || 4);

        if (score >= 12) return 'CRITICAL';
        if (score >= 8) return 'HIGH';
        if (score >= 5) return 'MEDIUM';
        return 'LOW';
    }

    // =============================================
    // AUTO-ASSIGN ENGINEER
    // =============================================
    async autoAssignEngineer(companyId, ticket) {
        const companyEngineers = Array.from(this.engineers.values())
            .filter(e => e.companyId === companyId && e.available);
        
        if (companyEngineers.length === 0) return null;

        // Assign to engineer with least workload
        companyEngineers.sort((a, b) => a.assignedProblems.length - b.assignedProblems.length);
        
        const assignedEngineer = companyEngineers[0];
        assignedEngineer.assignedProblems.push(ticket.problemId);
        
        if (assignedEngineer.assignedProblems.length >= 5) {
            assignedEngineer.available = false;
        }

        return {
            engineerId: assignedEngineer.id,
            engineerName: `Engineer ${assignedEngineer.id}`,
            currentLoad: assignedEngineer.assignedProblems.length
        };
    }

    // =============================================
    // ATTEMPT AUTO-FIX
    // =============================================
    async attemptAutoFix(companyId, ticket) {
        console.log(`🤫 [AUTO-FIX]: Attempting for ${ticket.problemId}`);
        
        // Simulate auto-fix based on category
        const successRates = {
            PERFORMANCE: 0.75,
            AVAILABILITY: 0.60,
            SECURITY: 0.40,
            SYSTEM: 0.65
        };

        const success = Math.random() < (successRates[ticket.classification.category] || 0.5);

        if (success) {
            return {
                success: true,
                solution: `Automated fix applied for ${ticket.classification.category} issue`,
                method: 'AUTO_PATCH',
                appliedAt: new Date().toISOString()
            };
        }

        return {
            success: false,
            reason: 'Auto-fix not applicable — requires manual intervention',
            recommendation: 'Assign to engineer for manual resolution'
        };
    }

    // =============================================
    // RESOLVE PROBLEM (MANUAL)
    // =============================================
    async resolveProblem(companyId, problemId, resolution) {
        const company = this.companies.get(companyId);
        if (!company) return { success: false, error: 'Company not found' };

        const problemIndex = company.activeProblems.findIndex(p => p.problemId === problemId);
        if (problemIndex === -1) return { success: false, error: 'Problem not found' };

        const problem = company.activeProblems[problemIndex];
        
        problem.status = 'RESOLVED';
        problem.resolution = resolution.solution || 'Manually resolved';
        problem.resolutionTime = new Date().toISOString();
        problem.resolvedAt = new Date().toISOString();
        problem.resolvedBy = resolution.engineerId || 'unknown';
        problem.resolutionMethod = resolution.method || 'MANUAL';
        problem.resolutionNotes = resolution.notes || '';
        problem.updatedAt = new Date().toISOString();

        // Move to resolved
        company.activeProblems.splice(problemIndex, 1);
        company.resolvedProblems.push(problem);
        company.problemHistory.push(problem);

        // Update engineer
        if (resolution.engineerId && this.engineers.has(resolution.engineerId)) {
            const engineer = this.engineers.get(resolution.engineerId);
            engineer.assignedProblems = engineer.assignedProblems.filter(p => p !== problemId);
            engineer.resolvedCount++;
            engineer.available = engineer.assignedProblems.length < 5;
        }

        // Update resolution history
        const history = this.resolutionHistory.get(companyId);
        history.push({
            problemId,
            category: problem.category,
            resolutionTime: new Date().toISOString(),
            method: resolution.method
        });

        this.state.totalResolved++;

        console.log(`🤫 [COMPANY SOLVER]: Problem ${problemId} resolved for ${company.name}`);

        return {
            success: true,
            problemId,
            status: 'RESOLVED',
            resolutionTime: problem.resolutionTime,
            company: {
                name: company.name,
                activeProblems: company.activeProblems.length,
                totalResolved: company.resolvedProblems.length
            }
        };
    }

    // =============================================
    // GET COMPANY DASHBOARD
    // =============================================
    getCompanyDashboard(companyId) {
        const company = this.companies.get(companyId);
        if (!company) return { error: 'Company not found' };

        const limits = this.tierLimits[company.tier];
        const activeProblems = company.activeProblems || [];
        const resolvedProblems = company.resolvedProblems || [];
        const engineers = Array.from(this.engineers.values()).filter(e => e.companyId === companyId);

        // Calculate stats
        const byCategory = {};
        const bySeverity = { CRITICAL: 0, HIGH: 0, MEDIUM: 0, LOW: 0 };
        
        activeProblems.forEach(p => {
            byCategory[p.category] = (byCategory[p.category] || 0) + 1;
            bySeverity[p.severity] = (bySeverity[p.severity] || 0) + 1;
        });

        const avgResolutionTime = resolvedProblems.length > 0
            ? resolvedProblems.reduce((sum, p) => {
                const resolved = new Date(p.resolvedAt);
                const created = new Date(p.createdAt);
                return sum + (resolved - created);
              }, 0) / resolvedProblems.length / 1000
            : 0;

        return {
            company: {
                id: company.id,
                name: company.name,
                tier: company.tier,
                industry: company.industry,
                subscription: company.subscription,
                joinedAt: company.joinedAt
            },
            limits,
            stats: {
                activeProblems: activeProblems.length,
                resolvedToday: resolvedProblems.filter(p => {
                    const resolved = new Date(p.resolvedAt);
                    const today = new Date();
                    return resolved.toDateString() === today.toDateString();
                }).length,
                totalResolved: resolvedProblems.length,
                averageResolutionTime: avgResolutionTime.toFixed(0) + 's',
                autoFixRate: resolvedProblems.filter(p => p.autoFixSuccess).length / Math.max(1, resolvedProblems.length) * 100
            },
            problemsByCategory: byCategory,
            problemsBySeverity: bySeverity,
            engineers: engineers.map(e => ({
                id: e.id,
                assignedProblems: e.assignedProblems.length,
                resolvedCount: e.resolvedCount,
                rating: e.rating,
                available: e.available
            })),
            activeProblems: activeProblems.slice(0, 10).map(p => ({
                problemId: p.problemId,
                category: p.category,
                severity: p.severity,
                status: p.status,
                priority: p.priority,
                assignedEngineer: p.assignedEngineer,
                createdAt: p.createdAt,
                autoFixApplied: p.autoFixSuccess
            })),
            recentResolved: resolvedProblems.slice(-5).map(p => ({
                problemId: p.problemId,
                category: p.category,
                resolutionTime: p.resolutionTime,
                method: p.resolutionMethod
            }))
        };
    }

