        if (!this.tierLimits[newTier]) return { success: false, error: 'Invalid tier' };

        const oldTier = company.tier;
        company.tier = newTier;

        console.log(`🤫 [COMPANY SOLVER]: ${company.name} upgraded from ${oldTier} to ${newTier}`);

        return {
            success: true,
            company: company.name,
            oldTier,
            newTier,
            newLimits: this.tierLimits[newTier],
            timestamp: new Date().toISOString()
        };
    }

