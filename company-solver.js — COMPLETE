        <div style="color:#3fb950;font-size:1.5em;font-weight:700;">${stats.totalResolved}</div>
        <div style="color:rgba(255,255,255,0.5);font-size:0.65em;">TOTAL RESOLVED</div>
        </div>
        <div style="background:rgba(240,136,62,0.05);padding:8px;border-radius:8px;text-align:center;">
        <div style="color:#f0883e;font-size:1.5em;font-weight:700;">${stats.resolvedToday}</div>
        <div style="color:rgba(255,255,255,0.5);font-size:0.65em;">RESOLVED TODAY</div>
        </div>
        <div style="background:rgba(139,92,246,0.05);padding:8px;border-radius:8px;text-align:center;">
        <div style="color:#8b5cf6;font-size:1.5em;font-weight:700;">${stats.autoFixRate.toFixed(0)}%</div>
        <div style="color:rgba(255,255,255,0.5);font-size:0.65em;">AUTO-FIX RATE</div>
        </div>
        </div>
        
        <div style="color:rgba(255,255,255,0.7);font-weight:600;margin:8px 0;">📊 Problems by Category:</div>
        <div style="display:flex;gap:8px;margin-bottom:10px;">`;

        Object.entries(problemsByCategory).forEach(([cat, count]) => {
            const colors = { PERFORMANCE: '#3fb950', AVAILABILITY: '#f0883e', SECURITY: '#ffd700', SYSTEM: '#8b5cf6' };
            html += `
            <div style="flex:1;background:${colors[cat] || '#666'}22;border:1px solid ${colors[cat] || '#666'}44;border-radius:6px;padding:6px;text-align:center;">
            <div style="color:${colors[cat] || '#666'};font-weight:700;">${count}</div>
            <div style="color:rgba(255,255,255,0.4);font-size:0.55em;">${cat}</div>
            </div>`;
        });

        html += `
        </div>
        <div style="color:rgba(255,255,255,0.5);font-size:0.6em;text-align:center;">
        Response Time: ${limits.responseTime} | Max Concurrent: ${limits.maxConcurrentProblems} | Auto-Fix: ${limits.autoFixEnabled ? '✅' : '❌'}
        </div>
        </div>`;

        return html;
    }

    // =============================================
    // SYSTEM STATUS
    // =============================================
    getStatus() {
        return {
            initialized: this.state.initialized,
            totalCompanies: this.state.totalCompanies,
            totalProblems: this.state.totalProblems,
            activeProblems: this.state.totalProblems - this.state.totalResolved,
            totalResolved: this.state.totalResolved,
            averageResolutionTime: this.state.averageResolutionTime + 's',
            tiers: Object.keys(this.tierLimits).length,
            categories: Object.keys(this.problemCategories).length,
            timestamp: new Date().toISOString()
        };
    }

    // =============================================
    // RESET
    // =============================================
    reset() {
        this.companies.clear();
        this.problemQueues.clear();
        this.resolutionHistory.clear();
        this.engineers.clear();
        this.assignmentQueue = [];
        this.state.totalCompanies = 0;
        this.state.totalProblems = 0;
        this.state.totalResolved = 0;
        this.state.averageResolutionTime = 0;
        
        this.initialize();
        
        return { status: 'RESET', timestamp: new Date().toISOString() };
    }
}

