    getAllCompaniesOverview() {
        const overview = [];

        for (let [companyId, company] of this.companies) {
            const limits = this.tierLimits[company.tier];
            
            overview.push({
                id: company.id,
                name: company.name,
                tier: company.tier,
                subscription: company.subscription,
                activeProblems: company.activeProblems.length,
                totalResolved: company.resolvedProblems.length,
                problemLimit: limits.maxConcurrentProblems,
                usagePercent: ((company.activeProblems.length / limits.maxConcurrentProblems) * 100).toFixed(1) + '%',
                engineers: Array.from(this.engineers.values()).filter(e => e.companyId === companyId).length,
                status: company.activeProblems.filter(p => p.severity === 'CRITICAL').length > 0 ? 'CRITICAL' :
                        company.activeProblems.length > limits.maxConcurrentProblems * 0.8 ? 'WARNING' : 'HEALTHY'
            });
        }

        return {
            totalCompanies: this.state.totalCompanies,
            totalActiveProblems: this.state.totalProblems - this.state.totalResolved,
            totalResolved: this.state.totalResolved,
            companies: overview.sort((a, b) => b.activeProblems - a.activeProblems),
            timestamp: new Date().toISOString()
        };
    }

