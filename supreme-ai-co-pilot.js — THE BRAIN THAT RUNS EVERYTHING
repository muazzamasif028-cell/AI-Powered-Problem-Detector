                    show: ['ARCHITECTURE_VIEW', 'SECURITY_DASHBOARD', 'SCALE_METRICS'],
                    hide: ['INVOICE_GENERATOR', 'HR_PORTAL'],
                    message: 'All 22 pillars operational. Quantum-safe security active. 4.7Q nodes online.'
                },
                DEVOPS_ENGINEER: {
                    needs: 'Real-time alerts, auto-fix status, deployment pipeline',
                    show: ['ALERT_CONSOLE', 'AUTO_FIX_LOG', 'DEPLOYMENT_DASHBOARD'],
                    hide: ['FINANCIAL_REPORTS', 'EXECUTIVE_SUMMARY'],
                    message: '3 issues auto-fixed in last hour. Zero downtime. Pipeline green.'
                },
                SECURITY_ANALYST: {
