                    show: ['THREAT_MAP', 'ATTACK_LOGS', 'VULNERABILITY_SCANNER'],
                    hide: ['MARKETING_TOOLS', 'SALES_PIPELINE'],
                    message: '12 attacks thwarted today. Kinetic defense mutated 1.2M times.'
                },
                NEOM_OPERATOR: {
