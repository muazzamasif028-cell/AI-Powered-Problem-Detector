                satellite: '350+ satellite control',
                neom: 'NEOM Smart City ready',
                quantum: 'Zero-latency communication',
                eternal: 'Entropy reversal — never dies'
            },

            // The Brain knows WHO should use WHAT
            userProfiles: {
