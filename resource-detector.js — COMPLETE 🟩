class ResourceDetector {
    constructor() {
        this.state = {
            initialized: false,
            totalScans: 0,
            problemsFound: 0,
            criticalCount: 0,
            warningCount: 0
        };

        this.problems = {
            DISK_IOPS_LIMIT: {
                id: 'RES-001',
                name: 'Disk IOPS Limit',
                severity: 'CRITICAL',
                category: 'DISK',
                thresholds: { warning: 3000, critical: 4500, emergency: 4800 },
                symptoms: ['Slow disk operations', 'Queue buildup', 'Timeout errors', 'Database slow'],
                rootCauses: ['Insufficient provisioned IOPS', 'Burst credit exhausted', 'High workload', 'Noisy neighbor'],
                solutions: [
                    { action: 'INCREASE_IOPS', description: 'Increase provisioned IOPS', autoFix: true, risk: 'LOW' },
                    { action: 'OPTIMIZE_QUERIES', description: 'Optimize disk-heavy queries', autoFix: false, risk: 'MEDIUM' },
                    { action: 'ADD_CACHING', description: 'Add caching layer to reduce I/O', autoFix: true, risk: 'LOW' },
                    { action: 'UPGRADE_STORAGE', description: 'Upgrade to higher IOPS storage', autoFix: true, risk: 'MEDIUM' }
                ],
                metrics: ['current_iops', 'provisioned_iops', 'burst_balance', 'queue_depth', 'latency_ms'],
                unit: 'IOPS',
                impact: 'Application slowdown, database timeout, user experience degradation'
            },

            FILE_DESCRIPTOR_LIMIT: {
                id: 'RES-002',
                name: 'File Descriptor Limit',
                severity: 'CRITICAL',
                category: 'SYSTEM',
                thresholds: { warning: 800, critical: 950, emergency: 1000 },
                symptoms: ['Too many open files error', 'Cannot accept connections', 'Service crash', 'Socket failures'],
                rootCauses: ['Connection leak', 'File handle leak', 'Default limit too low', 'High concurrency'],
                solutions: [
                    { action: 'INCREASE_LIMIT', description: 'Increase file descriptor limit', autoFix: true, risk: 'LOW' },
                    { action: 'FIX_LEAK', description: 'Fix file handle leak in code', autoFix: false, risk: 'HIGH' },
                    { action: 'CLOSE_IDLE', description: 'Close idle connections', autoFix: true, risk: 'MEDIUM' },
                    { action: 'MONITOR_FD', description: 'Add FD usage monitoring', autoFix: true, risk: 'LOW' }
                ],
                metrics: ['fd_used', 'fd_limit', 'fd_percent', 'leak_rate', 'oldest_handle_age'],
                unit: 'handles',
                impact: 'Service unable to accept new connections, cascading failures'
            },

            PROCESS_LIMIT: {
                id: 'RES-003',
                name: 'Process Limit',
                severity: 'WARNING',
                category: 'SYSTEM',
                thresholds: { warning: 200, critical: 400, emergency: 500 },
                symptoms: ['Fork failures', 'Cannot start new process', 'System sluggish', 'Zombie processes'],
                rootCauses: ['Process leak', 'Fork bomb', 'Cron job accumulation', 'Uncontrolled spawning'],
                solutions: [
                    { action: 'INCREASE_LIMIT', description: 'Increase process limit', autoFix: true, risk: 'LOW' },
                    { action: 'KILL_ZOMBIES', description: 'Kill zombie processes', autoFix: true, risk: 'LOW' },
                    { action: 'FIX_FORK', description: 'Fix process spawning logic', autoFix: false, risk: 'HIGH' },
                    { action: 'PROCESS_POOL', description: 'Implement process pool', autoFix: false, risk: 'MEDIUM' }
                ],
                metrics: ['process_count', 'process_limit', 'zombie_count', 'fork_rate', 'cpu_per_process'],
                unit: 'processes',
                impact: 'New services cannot start, system degradation'
            },

            THREAD_LIMIT: {
                id: 'RES-004',
                name: 'Thread Limit',
                severity: 'WARNING',
                category: 'SYSTEM',
                thresholds: { warning: 300, critical: 450, emergency: 500 },
                symptoms: ['Thread creation failed', 'Thread pool exhausted', 'Tasks queuing', 'Deadlock risk'],
                rootCauses: ['Thread leak', 'Pool size too small', 'Blocking operations', 'High concurrency demand'],
                solutions: [
                    { action: 'INCREASE_LIMIT', description: 'Increase thread limit', autoFix: true, risk: 'LOW' },
                    { action: 'ASYNC_REFACTOR', description: 'Convert to async/non-blocking', autoFix: false, risk: 'HIGH' },
                    { action: 'THREAD_POOL', description: 'Optimize thread pool size', autoFix: true, risk: 'MEDIUM' },
                    { action: 'KILL_STUCK', description: 'Kill stuck threads', autoFix: true, risk: 'MEDIUM' }
                ],
                metrics: ['thread_count', 'thread_limit', 'blocked_threads', 'pool_utilization', 'deadlock_risk'],
                unit: 'threads',
                impact: 'Application hangs, request timeouts'
            },

            INODE_USAGE_FULL: {
                id: 'RES-005',
                name: 'Inode Usage Full',
                severity: 'CRITICAL',
                category: 'DISK',
                thresholds: { warning: 80, critical: 90, emergency: 95 },
                symptoms: ['Cannot create files', 'Disk has space but writes fail', 'Email server errors', 'Temp file failures'],
                rootCauses: ['Too many small files', 'Session files accumulation', 'Cache files not cleaned', 'Email queue buildup'],
                solutions: [
                    { action: 'CLEAN_FILES', description: 'Clean up small/unnecessary files', autoFix: true, risk: 'LOW' },
                    { action: 'ARCHIVE_OLD', description: 'Archive old files to object storage', autoFix: true, risk: 'LOW' },
                    { action: 'INCREASE_INODES', description: 'Reformat with more inodes', autoFix: false, risk: 'HIGH' },
                    { action: 'FILE_ROTATION', description: 'Implement aggressive file rotation', autoFix: true, risk: 'LOW' }
                ],
                metrics: ['inode_used', 'inode_total', 'inode_percent', 'files_created_per_hour', 'largest_directories'],
                unit: '%',
                impact: 'Cannot create new files despite free space'
            },

            QUOTA_EXCEEDED: {
                id: 'RES-006',
                name: 'Quota Exceeded',
                severity: 'WARNING',
                category: 'STORAGE',
                thresholds: { warning: 85, critical: 95, emergency: 98 },
                symptoms: ['Disk quota exceeded error', 'User cannot write', 'Upload failures', 'Email quota warnings'],
                rootCauses: ['User storage limit reached', 'Log file growth', 'Backup accumulation', 'No cleanup policy'],
                solutions: [
                    { action: 'INCREASE_QUOTA', description: 'Temporarily increase quota', autoFix: true, risk: 'LOW' },
                    { action: 'CLEAN_USER', description: 'Clean user storage', autoFix: true, risk: 'MEDIUM' },
                    { action: 'NOTIFY_USER', description: 'Notify user to clean up', autoFix: true, risk: 'LOW' },
                    { action: 'ARCHIVE_DATA', description: 'Archive old data to cold storage', autoFix: true, risk: 'LOW' }
                ],
                metrics: ['quota_used_gb', 'quota_limit_gb', 'quota_percent', 'user_id', 'largest_files'],
                unit: '%',
                impact: 'User cannot save data, productivity loss'
            }
        };

        this.detectionHistory = [];
        this.problemStatus = {};

        Object.keys(this.problems).forEach(key => {
            this.problemStatus[key] = {
                status: 'PENDING',
                lastChecked: null,
                detectionCount: 0,
                severity: this.problems[key].severity,
                resolved: false
            };
        });

        console.log('🤫 [RESOURCE DETECTOR 🟩]: System created — 6 problems configured');
    }

    initialize() {
        this.state.initialized = true;
        console.log('🤫 [RESOURCE DETECTOR 🟩]: Ready — 6 resource problems monitored');
        return { status: 'READY', problems: Object.keys(this.problems).length };
    }

    async detectAll(systemMetrics = {}) {
        const scanId = 'RES-' + Date.now().toString(36) + '-' + Math.random().toString(36).substr(2, 8).toUpperCase();
        const results = {};

        for (let [key, config] of Object.entries(this.problems)) {
            const result = this.detectProblem(key, config, systemMetrics);
            results[key] = result;
            this.problemStatus[key].lastChecked = new Date().toISOString();
            this.problemStatus[key].detectionCount++;
            
            if (result.detected) {
                this.problemStatus[key].status = result.severity;
                this.state.problemsFound++;
                if (result.severity === 'CRITICAL') this.state.criticalCount++;
                if (result.severity === 'WARNING') this.state.warningCount++;
            } else {
                this.problemStatus[key].status = 'NORMAL';
            }
        }

        this.state.totalScans++;
        return {
            scanId,
            timestamp: new Date().toISOString(),
            results,
            summary: this.generateSummary(results)
        };
    }

    detectProblem(key, config, metrics) {
        let currentValue = 0;
        let detected = false;
        let severity = 'NORMAL';

        const defaults = {
            DISK_IOPS_LIMIT: metrics.current_iops || Math.floor(Math.random() * 5000),
            FILE_DESCRIPTOR_LIMIT: metrics.fd_used || Math.floor(Math.random() * 1024),
            PROCESS_LIMIT: metrics.process_count || Math.floor(Math.random() * 512),
            THREAD_LIMIT: metrics.thread_count || Math.floor(Math.random() * 512),
            INODE_USAGE_FULL: metrics.inode_percent || Math.floor(Math.random() * 100),
            QUOTA_EXCEEDED: metrics.quota_percent || Math.floor(Math.random() * 100)
        };

        currentValue = defaults[key] || 0;

        if (key.includes('INODE') || key.includes('QUOTA')) {
            if (currentValue >= config.thresholds.emergency) { detected = true; severity = 'CRITICAL'; }
            else if (currentValue >= config.thresholds.critical) { detected = true; severity = 'WARNING'; }
            else if (currentValue >= config.thresholds.warning) { detected = true; severity = 'WARNING'; }
        } else {
            if (currentValue >= config.thresholds.emergency) { detected = true; severity = 'CRITICAL'; }
            else if (currentValue >= config.thresholds.critical) { detected = true; severity = 'WARNING'; }
            else if (currentValue >= config.thresholds.warning) { detected = true; severity = 'WARNING'; }
        }

        return {
            problemId: config.id,
            problemName: config.name,
            category: config.category,
            detected,
            severity,
            currentValue: currentValue.toFixed(2),
            unit: config.unit,
            threshold: config.thresholds,
            symptoms: detected ? config.symptoms : [],
            solutions: detected ? config.solutions.filter(s => s.autoFix).slice(0, 2) : [],
            impact: detected ? config.impact : 'None'
        };
    }

    generateSummary(results) {
        const detected = Object.values(results).filter(r => r.detected);
        return {
            totalProblems: 6,
            problemsDetected: detected.length,
            criticalCount: detected.filter(r => r.severity === 'CRITICAL').length,
            warningCount: detected.filter(r => r.severity === 'WARNING').length,
            overallStatus: detected.some(r => r.severity === 'CRITICAL') ? 'CRITICAL' : 
                          detected.length > 0 ? 'WARNING' : 'HEALTHY'
        };
    }

    formatForChat(scanResult) {
        let html = `<div style="background:rgba(26,26,46,0.6);border:1px solid rgba(63,185,80,0.3);border-radius:12px;padding:14px;font-family:'Courier New',monospace;font-size:0.8em;">
        <div style="color:#3fb950;font-weight:700;margin-bottom:10px;">🟩 RESOURCE DIAGNOSTIC — ${scanResult.scanId}</div>
        <table style="width:100%;border-collapse:collapse;color:#e0e0e0;">
        <tr style="border-bottom:1px solid rgba(255,255,255,0.1);"><th style="text-align:left;padding:4px;">#</th><th style="text-align:left;padding:4px;">Resource</th><th style="text-align:left;padding:4px;">Status</th><th style="text-align:left;padding:4px;">Value</th></tr>`;

        Object.entries(scanResult.results).forEach(([key, r], i) => {
            const color = r.severity === 'CRITICAL' ? '#da3633' : r.severity === 'WARNING' ? '#f0883e' : '#3fb950';
            const icon = r.detected ? (r.severity === 'CRITICAL' ? '🚨' : '⚠️') : '✅';
            html += `<tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
            <td style="padding:4px;">${i + 1}</td><td style="padding:4px;">${r.problemName}</td>
            <td style="padding:4px;color:${color};">${icon} ${r.severity}</td><td style="padding:4px;">${r.currentValue} ${r.unit}</td></tr>`;
        });

        html += `</table></div>`;
        return html;
    }

    getStatus() {
        return { initialized: this.state.initialized, totalScans: this.state.totalScans, problemsFound: this.state.problemsFound };
    }

    reset() {
        Object.keys(this.problemStatus).forEach(k => {
            this.problemStatus[k] = { status: 'PENDING', lastChecked: null, detectionCount: 0, severity: this.problems[k].severity, resolved: false };
        });
        this.state.totalScans = 0; this.state.problemsFound = 0; this.state.criticalCount = 0; this.state.warningCount = 0;
        return { status: 'RESET' };
    }
}

if (typeof module !== 'undefined' && module.exports) module.exports = ResourceDetector;
if (typeof window !== 'undefined') { window.ResourceDetector = ResourceDetector; window.__SUPREME_RESOURCE_DETECTOR = new ResourceDetector(); window.__SUPREME_RESOURCE_DETECTOR.initialize(); }
