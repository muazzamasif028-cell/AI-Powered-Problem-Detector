/**
 * SUPREME Framework - Master Agentic Loop Controller
 * Manages the data pipeline transfer from Planner -> Executor -> Reflection -> Verification
 */

const { PlannerAgent, ExecutorAgent, ReflectionAgent, VerificationAgent } = require('./agent_swarm');
const TelemetryBridge = require('./telemetry_bridge'); // Connecting straight to our telemetry layer

class AgenticLoopOrchestrator {
    constructor() {
        this.planner = new PlannerAgent('SupremePlanner', 'Macro-Decompiler', 'MPU');
        this.executor = new ExecutorAgent('SupremeExecutor', 'Low-Level-Dispatcher', 'PTU');
        this.reflector = new ReflectionAgent('SupremeReflector', 'Continuous-Auditor', 'MPU');
        this.verifier = new VerificationAgent('SupremeVerifier', 'Cryptographic-Guard', 'MPU');
        
        this.telemetry = new TelemetryBridge();
    }

    /**
     * Executes the complete autonomous engineering lifecycle loop
     * @param {string} userIntent - High-level directive from the Planetary OS platform
     */
    async executeAutonomousCycle(userIntent) {
        console.log(`\n============== STARTING AGENTIC SOVEREIGN CYCLE ==============`);
        console.log(`Target Directive: "${userIntent}"`);
        
        const cycleStartTime = Date.now();

        try {
            // Step 1: Planning Layer Execution
            this.telemetry.logHardwareHit('MPU', 'AGENT_PLANNER_START', { directive: userIntent });
            const executionPlan = await this.planner.generatePlan(userIntent);
            
            let masterClusterOutputs = [];

            // Step 2: Iterating through tasks generated by the Planner
            for (const task of executionPlan) {
                console.log(`\n--- Processing Cycle Step: ${task.id} ---`);
                
                // Track execution targets via telemetry bus
                this.telemetry.logHardwareHit(task.target, `AGENT_EXEC_START_${task.id}`, { description: task.desc });
                
                // Execute individual task blocks
                const taskResult = await this.executor.executeTask(task);
                
                // Step 3: Reflection Layer Auditing
                const auditReport = await this.reflector.auditOutput(taskResult);
                
                // Step 4: Verification Guard Check
                const verificationResult = await this.verifier.finalSignOff(taskResult, auditReport);
                
                masterClusterOutputs.push({
                    task: task.id,
                    status: 'VERIFIED_AND_LOCKED',
                    ledgerKey: verificationResult.internalLedgerLock,
                    optimizationRequired: auditReport.requiresOptimization
                });

                this.telemetry.logHardwareHit(task.target, `AGENT_EXEC_COMPLETED_${task.id}`, { status: 'VERIFIED' });
            }

            const totalDuration = Date.now() - cycleStartTime;
            console.log(`\n=============================================================`);
            console.log(`👑 [CYCLE COMPLETE] Macro directive fulfilled safely in ${totalDuration}ms.`);
            console.log(`Cluster Execution Summary Log:`, JSON.stringify(masterClusterOutputs, null, 2));
            
            this.telemetry.logSystemEvent('AGENTIC_CYCLE_SUCCESS', { executionTimeMs: totalDuration });
            return masterClusterOutputs;

        } catch (criticalFault) {
            console.error(`\n❌ [CRITICAL STRUCTURAL FAULT] Agentic pipeline crashed:`, criticalFault.message);
            this.telemetry.logSystemEvent('AGENTIC_CYCLE_CRITICAL_FAILURE', { cause: criticalFault.message });
            // Here, the system can trigger the A/B controller logic to shift state banks to safety
        }
    }
}

module.exports = AgenticLoopOrchestrator;
