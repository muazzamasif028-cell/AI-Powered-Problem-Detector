const SupremeVehicleLexer = require('./SupremeVehicleLexer');
const SupremeVehicleParser = require('./SupremeVehicleParser');

class SupremeVehicleCompiler {
    compile(source) {
        console.log('🚗 SPL-V v2.0 COMPILER\n');
        
        // Lex
        const lexer = new SupremeVehicleLexer(source);
        const tokens = lexer.tokenize();
        console.log(`🔧 Lexer: ${tokens.length} tokens`);
        
        // Parse
        const parser = new SupremeVehicleParser(tokens);
        const ast = parser.parse();
        console.log(`🔍 Parser: ${ast.modules.length} modules`);
        
        // Generate Vehicle Commands
        const commands = this.generateCommands(ast);
        console.log(`⚡ Generated: ${commands.length} commands\n`);
        
        return { tokens, ast, commands };
    }

    generateCommands(ast) {
        const commands = [];
        
        for (const module of ast.modules) {
            switch (module.type) {
                case 'CopilotConfig':
                    for (const event of module.events || []) {
                        commands.push({ module: 'copilot', action: 'register_event', data: event });
                    }
                    break;
                    
                case 'AutonomousConfig':
                    if (module.navigation) {
                        commands.push({ module: 'autonomous', action: 'set_navigation', data: module.navigation });
                    }
                    break;
                    
                case 'SafetyConfig':
                    for (const pillar of module.pillars || []) {
                        commands.push({ module: 'safety', action: 'register_pillar', data: pillar });
                    }
                    break;
                    
                default:
                    commands.push({ module: module.type, action: 'configure', data: module });
            }
        }
        
        return commands;
    }
}

module.exports = SupremeVehicleCompiler;
