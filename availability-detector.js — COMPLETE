    // =============================================
    // DETECT ALL AVAILABILITY PROBLEMS
    // =============================================
    async detectAll(systemMetrics = {}) {
        const scanId = 'AVL-' + Date.now().toString(36) + '-' + 
                      Math.random().toString(36).substr(2, 8).toUpperCase();
        
        const startTime = performance.now();
        
        console.log(`🤫 [AVAILABILITY]: ${scanId} — Full scan started`);

        const results = {};
        
        for (let [problemKey, problemConfig] of Object.entries(this.problems)) {
            const result = this.detectProblem(problemKey, problemConfig, systemMetrics);
            results[problemKey] = result;
            
            this.problemStatus[problemKey].lastChecked = new Date().toISOString();
            this.problemStatus[problemKey].detectionCount++;
            
            if (result.detected) {
                this.problemStatus[problemKey].status = result.severity;
                this.problemStatus[problemKey].downtimeSeconds += 30;
                this.state.problemsFound++;
                
                if (result.severity === 'CRITICAL') this.state.criticalCount++;
                if (result.severity === 'WARNING') this.state.warningCount++;
            } else {
                this.problemStatus[problemKey].status = 'AVAILABLE';
            }
        }

        this.state.totalScans++;
        this.updateUptime(results);

        const summary = this.generateSummary(results);
        
        const scanResult = {
            scanId,
            timestamp: new Date().toISOString(),
            results,
            summary,
            uptime: this.getUptimeStats(),
            processingTime_ms: (performance.now() - startTime).toFixed(2)
        };

        this.detectionHistory.push(scanResult);
        if (this.detectionHistory.length > this.maxHistorySize) {
            this.detectionHistory.shift();
        }

        console.log(`🤫 [AVAILABILITY]: ${scanId} — ${summary.problemsDetected} problems found`);

        return scanResult;
    }

    // =============================================
    // DETECT INDIVIDUAL PROBLEM
    // =============================================
    detectProblem(problemKey, config, systemMetrics) {
        const metrics = this.getProblemMetrics(problemKey, systemMetrics);
        const thresholds = config.thresholds;
        
        let detected = false;
        let currentSeverity = 'AVAILABLE';
        let currentValue = 0;
        let responseTime = 0;
        let statusCode = 200;

        switch (problemKey) {
            case 'SERVICE_DOWN':
                statusCode = metrics.status_code || (Math.random() > 0.9 ? 503 : 200);
                responseTime = metrics.response_time_ms || Math.random() * 2000;
                
                if (statusCode >= 500 && responseTime > thresholds.emergency) {
                    detected = true;
                    currentSeverity = 'CRITICAL';
                } else if (statusCode >= 500) {
                    detected = true;
                    currentSeverity = 'CRITICAL';
                } else if (responseTime > thresholds.critical) {
                    detected = true;
                    currentSeverity = 'WARNING';
                } else if (responseTime > thresholds.warning) {
                    detected = true;
                    currentSeverity = 'WARNING';
                }
                currentValue = responseTime;
                break;

            case 'NODE_OFFLINE':
                const lastSeen = metrics.last_seen_seconds || (Math.random() > 0.9 ? 120 : 5);
                
                if (lastSeen >= thresholds.emergency) {
                    detected = true;
                    currentSeverity = 'CRITICAL';
                } else if (lastSeen >= thresholds.critical) {
                    detected = true;
                    currentSeverity = 'WARNING';
                } else if (lastSeen >= thresholds.warning) {
                    detected = true;
                    currentSeverity = 'WARNING';
                }
                currentValue = lastSeen;
                break;

            case 'DATABASE_DOWN':
                const dbErrors = metrics.connection_errors || (Math.random() > 0.9 ? 50 : 0);
                
                if (dbErrors >= thresholds.emergency) {
                    detected = true;
                    currentSeverity = 'CRITICAL';
                } else if (dbErrors >= thresholds.critical) {
                    detected = true;
                    currentSeverity = 'WARNING';
                } else if (dbErrors >= thresholds.warning) {
                    detected = true;
                    currentSeverity = 'WARNING';
                }
                currentValue = dbErrors;
                break;

            case 'API_TIMEOUT':
                const timeoutCount = metrics.timeout_count || (Math.random() > 0.9 ? 30000 : 100);
                
                if (timeoutCount >= thresholds.emergency) {
                    detected = true;
                    currentSeverity = 'CRITICAL';
                } else if (timeoutCount >= thresholds.critical) {
                    detected = true;
                    currentSeverity = 'WARNING';
                } else if (timeoutCount >= thresholds.warning) {
                    detected = true;
                    currentSeverity = 'WARNING';
                }
                currentValue = timeoutCount;
                break;

            case 'DNS_FAIL':
                const dnsTime = metrics.dns_resolution_ms || (Math.random() > 0.9 ? 5000 : 50);
                
                if (dnsTime >= thresholds.emergency) {
                    detected = true;
                    currentSeverity = 'CRITICAL';
                } else if (dnsTime >= thresholds.critical) {
                    detected = true;
                    currentSeverity = 'WARNING';
                } else if (dnsTime >= thresholds.warning) {
                    detected = true;
                    currentSeverity = 'WARNING';
                }
                currentValue = dnsTime;
                break;

            case 'SSL_EXPIRED':
                const daysLeft = metrics.cert_expiry_days || (Math.random() > 0.9 ? 3 : 365);
                
                if (daysLeft <= thresholds.emergency) {
                    detected = true;
                    currentSeverity = 'CRITICAL';
                } else if (daysLeft <= thresholds.critical) {
                    detected = true;
                    currentSeverity = 'CRITICAL';
                } else if (daysLeft <= thresholds.warning) {
                    detected = true;
                    currentSeverity = 'WARNING';
                }
                currentValue = daysLeft;
                break;

            case 'LOAD_BALANCER_DOWN':
                const lbErrors = metrics.error_rate || (Math.random() > 0.9 ? 80 : 5);
                
                if (lbErrors >= thresholds.emergency) {
                    detected = true;
                    currentSeverity = 'CRITICAL';
                } else if (lbErrors >= thresholds.critical) {
                    detected = true;
                    currentSeverity = 'WARNING';
                } else if (lbErrors >= thresholds.warning) {
                    detected = true;
                    currentSeverity = 'WARNING';
                }
                currentValue = lbErrors;
                break;

            case 'STORAGE_UNAVAILABLE':
                const storageErrors = metrics.storage_status === 'UNAVAILABLE' ? 5000 : 
                                     (Math.random() > 0.9 ? 5000 : 0);
                
                if (storageErrors >= thresholds.emergency) {
                    detected = true;
                    currentSeverity = 'CRITICAL';
                } else if (storageErrors >= thresholds.critical) {
                    detected = true;
                    currentSeverity = 'WARNING';
                } else if (storageErrors >= thresholds.warning) {
                    detected = true;
                    currentSeverity = 'WARNING';
                }
                currentValue = storageErrors;
                break;

            case 'CACHE_MISS_HIGH':
                const missRate = metrics.cache_miss_rate || (Math.random() > 0.9 ? 70 : 20);
                
                if (missRate >= thresholds.emergency) {
                    detected = true;
                    currentSeverity = 'CRITICAL';
                } else if (missRate >= thresholds.critical) {
                    detected = true;
                    currentSeverity = 'WARNING';
                } else if (missRate >= thresholds.warning) {
                    detected = true;
                    currentSeverity = 'WARNING';
                }
                currentValue = missRate;
                break;

            case 'RATE_LIMIT_EXCEEDED':
                const limitUsage = metrics.limit_usage || (Math.random() > 0.9 ? 95 : 40);
                
                if (limitUsage >= thresholds.emergency) {
                    detected = true;
                    currentSeverity = 'CRITICAL';
                } else if (limitUsage >= thresholds.critical) {
