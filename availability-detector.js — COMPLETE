                    currentSeverity = 'WARNING';
                } else if (limitUsage >= thresholds.warning) {
                    detected = true;
                    currentSeverity = 'WARNING';
                }
                currentValue = limitUsage;
                break;
        }

        return {
            problemId: config.id,
            problemName: config.name,
            category: config.category,
            detected,
            severity: currentSeverity,
            currentValue: typeof currentValue === 'number' ? currentValue.toFixed(2) : currentValue,
            threshold: {
                warning: thresholds.warning,
                critical: thresholds.critical,
                emergency: thresholds.emergency
            },
            unit: this.getUnit(problemKey),
            statusCode: statusCode || undefined,
            symptoms: detected ? config.symptoms : [],
            rootCauses: detected ? config.rootCauses.slice(0, 3) : [],
            recommendedSolutions: detected ? config.solutions.filter(s => s.autoFix).slice(0, 2) : [],
            impact: detected ? config.impact : 'None',
            timestamp: new Date().toISOString()
        };
    }

    // =============================================
    // GET PROBLEM METRICS
    // =============================================
    getProblemMetrics(problemKey, systemMetrics) {
        const defaultMetrics = {
            status_code: Math.random() > 0.9 ? 503 : 200,
            response_time_ms: Math.random() * 2000,
            last_seen_seconds: Math.random() > 0.9 ? 120 : 5,
            connection_errors: Math.random() > 0.9 ? 50 : 0,
            timeout_count: Math.random() > 0.9 ? 30000 : 100,
            dns_resolution_ms: Math.random() > 0.9 ? 5000 : 50,
            cert_expiry_days: Math.random() > 0.9 ? 3 : 365,
            error_rate: Math.random() > 0.9 ? 80 : 5,
            storage_status: Math.random() > 0.9 ? 'UNAVAILABLE' : 'AVAILABLE',
            cache_miss_rate: Math.random() > 0.9 ? 70 : 20,
            limit_usage: Math.random() > 0.9 ? 95 : 40
        };

        return { ...defaultMetrics, ...systemMetrics };
    }

    // =============================================
    // GET UNIT FOR PROBLEM
    // =============================================
    getUnit(problemKey) {
        const units = {
            SERVICE_DOWN: 'ms',
            NODE_OFFLINE: 'sec',
            DATABASE_DOWN: 'errors',
            API_TIMEOUT: 'ms',
            DNS_FAIL: 'ms',
            SSL_EXPIRED: 'days',
            LOAD_BALANCER_DOWN: 'errors/sec',
            STORAGE_UNAVAILABLE: 'ms',
            CACHE_MISS_HIGH: '%',
            RATE_LIMIT_EXCEEDED: '%'
        };
        return units[problemKey] || '';
    }

    // =============================================
    // UPDATE UPTIME
    // =============================================
    updateUptime(results) {
        const now = Date.now();
        this.uptime.totalSeconds = (now - this.uptime.startTime) / 1000;
        
        let currentDowntime = 0;
        Object.values(results).forEach(result => {
            if (result.detected && result.severity === 'CRITICAL') {
                currentDowntime += 30;
            }
        });
        
        this.uptime.downtimeSeconds += currentDowntime;
        
        if (currentDowntime > 0) {
            this.uptime.incidents.push({
                timestamp: new Date().toISOString(),
                downtimeSeconds: currentDowntime,
                criticalCount: Object.values(results).filter(r => r.detected && r.severity === 'CRITICAL').length
            });
        }
        
        this.state.uptimePercentage = this.uptime.totalSeconds > 0
            ? ((1 - this.uptime.downtimeSeconds / this.uptime.totalSeconds) * 100).toFixed(4)
            : 100;
    }

    // =============================================
    // GET UPTIME STATS
    // =============================================
    getUptimeStats() {
        return {
            totalSeconds: Math.floor(this.uptime.totalSeconds),
            downtimeSeconds: Math.floor(this.uptime.downtimeSeconds),
            uptimePercentage: this.state.uptimePercentage + '%',
            incidents: this.uptime.incidents.length,
            sla: this.getSLALevel(this.state.uptimePercentage)
        };
    }

    // =============================================
    // GET SLA LEVEL
    // =============================================
    getSLALevel(uptime) {
        const num = parseFloat(uptime);
        if (num >= 99.999) return 'FIVE_NINES';
        if (num >= 99.99) return 'FOUR_NINES';
        if (num >= 99.9) return 'THREE_NINES';
        if (num >= 99.0) return 'TWO_NINES';
        return 'BELOW_SLA';
    }

    // =============================================
    // GENERATE SUMMARY
    // =============================================
    generateSummary(results) {
        const problemsDetected = Object.values(results).filter(r => r.detected);
        const criticals = problemsDetected.filter(r => r.severity === 'CRITICAL');
        const warnings = problemsDetected.filter(r => r.severity === 'WARNING');
        const available = Object.values(results).filter(r => !r.detected);

        return {
            totalProblems: Object.keys(results).length,
            problemsDetected: problemsDetected.length,
            criticalCount: criticals.length,
            warningCount: warnings.length,
            availableCount: available.length,
            availabilityScore: ((available.length / Object.keys(results).length) * 100).toFixed(1) + '%',
            criticalProblems: criticals.map(r => r.problemName),
            warningProblems: warnings.map(r => r.problemName),
            overallStatus: criticals.length > 0 ? 'CRITICAL' : 
                          warnings.length > 0 ? 'WARNING' : 'AVAILABLE'
        };
    }

    // =============================================
    // GET ALL PROBLEMS STATUS TABLE
    // =============================================
    getProblemsTable() {
        const table = [];
        
        for (let [key, status] of Object.entries(this.problemStatus)) {
            const config = this.problems[key];
            table.push({
                number: config.id.replace('AVL-', ''),
                problem: config.name,
                category: config.category,
                severity: config.severity,
                status: status.status,
                statusIcon: this.getStatusIcon(status.status),
                lastChecked: status.lastChecked,
                detectionCount: status.detectionCount,
                downtimeSeconds: status.downtimeSeconds,
                resolved: status.resolved
            });
        }

        return table;
    }

    // =============================================
    // GET STATUS ICON
    // =============================================
    getStatusIcon(status) {
        const icons = {
            'AVAILABLE': '✅',
            'PENDING': '⏳',
            'WARNING': '⚠️',
            'CRITICAL': '🚨',
            'RESOLVED': '✔️'
        };
        return icons[status] || '❓';
    }

    // =============================================
    // FORMAT FOR CHAT DISPLAY
    // =============================================
    formatForChat(scanResult) {
        const { results, summary, uptime } = scanResult;
        
        let html = `
        <div style="background:rgba(26,26,46,0.6);border:1px solid rgba(255,136,62,0.2);border-radius:12px;padding:14px;font-family:'Courier New',monospace;font-size:0.8em;">
        <div style="color:#f0883e;font-weight:700;margin-bottom:10px;">
        🟧 AVAILABILITY DIAGNOSTIC — ${scanResult.scanId}
        </div>
        <div style="color:rgba(255,255,255,0.5);font-size:0.7em;margin-bottom:4px;">
        Availability: ${summary.availabilityScore} | Uptime: ${uptime.uptimePercentage} | SLA: ${uptime.sla}
        </div>
        <div style="color:rgba(255,255,255,0.5);font-size:0.7em;margin-bottom:8px;">
        Issues: ${summary.problemsDetected}/${summary.totalProblems} | Critical: ${summary.criticalCount} | Warnings: ${summary.warningCount}
        </div>
        <table style="width:100%;border-collapse:collapse;color:#e0e0e0;">
        <tr style="border-bottom:1px solid rgba(255,255,255,0.1);">
        <th style="text-align:left;padding:4px;">#</th>
        <th style="text-align:left;padding:4px;">Problem</th>
        <th style="text-align:left;padding:4px;">Status</th>
        <th style="text-align:left;padding:4px;">Value</th>
        </tr>`;

        Object.entries(results).forEach(([key, result], index) => {
            const statusColor = result.severity === 'CRITICAL' ? '#da3633' : 
                               result.severity === 'WARNING' ? '#f0883e' : '#3fb950';
            const statusIcon = result.detected ? (result.severity === 'CRITICAL' ? '🚨' : '⚠️') : '✅';
            
            html += `
            <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
            <td style="padding:4px;">${index + 1}</td>
            <td style="padding:4px;">${result.problemName}</td>
            <td style="padding:4px;color:${statusColor};">${statusIcon} ${result.severity}</td>
            <td style="padding:4px;">${result.currentValue} ${result.unit}</td>
            </tr>`;
        });

        html += `
        </table>
        <div style="margin-top:10px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.1);text-align:center;font-weight:700;color:${
            summary.overallStatus === 'CRITICAL' ? '#da3633' : 
            summary.overallStatus === 'WARNING' ? '#f0883e' : '#3fb950'
        };">
        ${summary.overallStatus === 'AVAILABLE' ? '✅ ALL SERVICES AVAILABLE' : 
          summary.overallStatus === 'WARNING' ? '⚠️ AVAILABILITY ISSUES DETECTED' : 
          '🚨 CRITICAL AVAILABILITY PROBLEMS — IMMEDIATE ACTION REQUIRED'}
        </div>
        </div>`;

        return html;
    }

    // =============================================
    // SYSTEM STATUS
    // =============================================
    getStatus() {
        return {
            initialized: this.state.initialized,
            totalScans: this.state.totalScans,
            problemsFound: this.state.problemsFound,
            problemsResolved: this.state.problemsResolved,
            criticalCount: this.state.criticalCount,
            warningCount: this.state.warningCount,
            uptimePercentage: this.state.uptimePercentage + '%',
            sla: this.getSLALevel(this.state.uptimePercentage),
            problemTable: this.getProblemsTable(),
            timestamp: new Date().toISOString()
        };
    }

    // =============================================
    // RESET
    // =============================================
    reset() {
        this.detectionHistory = [];
        this.state.totalScans = 0;
        this.state.problemsFound = 0;
        this.state.problemsResolved = 0;
        this.state.criticalCount = 0;
        this.state.warningCount = 0;
        this.state.uptimePercentage = 100;
        this.uptime = { startTime: Date.now(), totalSeconds: 0, downtimeSeconds: 0, incidents: [] };
        
        Object.keys(this.problemStatus).forEach(key => {
            this.problemStatus[key] = {
                status: 'PENDING',
                lastChecked: null,
                detectionCount: 0,
                severity: this.problems[key].severity,
                resolved: false,
                downtimeSeconds: 0
            };
        });

        return { status: 'RESET', timestamp: new Date().toISOString() };
    }
}

